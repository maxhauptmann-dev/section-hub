// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model SectionPreview {
  id              String    @id @default(cuid())
  shop            String
  sectionId       String
  themeId         String    // GID of the preview theme
  themeName       String
  sectionFileName String
  createdAt       DateTime  @default(now())
  expiresAt       DateTime  // When the preview should be removed
  removed         Boolean   @default(false)
  removedAt       DateTime?

  @@unique([shop, sectionId])
  @@index([expiresAt])
  @@index([removed])
}

model AiSection {
  id              String    @id @default(cuid())
  shop            String
  name            String
  slug            String
  prompt          String
  style           String
  colorScheme     String
  model           String
  liquidCode      String
  sectionType     String
  tokensUsed      Int       @default(0)
  installed       Boolean   @default(false)
  installedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([shop, slug])
  @@index([shop])
}

model SectionPurchase {
  id              String    @id @default(cuid())
  shop            String
  sectionHandle   String    // single section ID or comma-separated IDs for bundles
  appPurchaseId   String
  amount          Float
  currency        String    @default("EUR")
  status          String    @default("PENDING")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([shop])
  @@index([sectionHandle])
  @@index([appPurchaseId])
}

model Subscription {
  id               String    @id @default(cuid())
  shop             String    @unique
  plan             String    @default("free") // "free" | "premium"
  chargeId         String?   // Shopify recurring charge ID
  status           String    @default("active") // "active" | "cancelling" | "cancelled" | "expired"
  activatedAt      DateTime  @default(now())
  cancelledAt      DateTime?
  currentPeriodEnd DateTime? // End of billing period – blocks stay active until this date
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([shop])
}

model SectionInstallation {
  id               String    @id @default(cuid())
  shop             String
  sectionHandle    String    // section ID e.g. "hero-banner"
  installedVersion String    // version at time of install e.g. "1.0.0"
  themeId          String?   // GID of the theme it's installed on
  installedAt      DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([shop, sectionHandle])
  @@index([shop])
}

model StoreAnalysis {
  id               String    @id @default(cuid())
  shop             String    @unique
  storeScore       Int       @default(0)
  activeCount      Int       @default(0)
  totalTypes       Int       @default(14)
  missingCritical  String    @default("[]") // JSON array of {key, label, icon}
  missingHigh      String    @default("[]") // JSON array of {key, label, icon}
  // Extended fields for detailed analyzer view
  mainThemeName    String    @default("Unknown")
  totalThemeSections Int     @default(0)
  sectionHubInstalled Int    @default(0)
  activeSectionsCount Int    @default(0)
  results          String    @default("[]") // JSON array of full Result objects
  pageMap          String    @default("{}") // JSON object {page: [sections]}
  analyzedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([shop])
}

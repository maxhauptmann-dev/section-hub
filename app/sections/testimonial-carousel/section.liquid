{% comment %}
  Section Hub – Testimonial Carousel v2.0
  Fully customisable carousel with flexible layout, sizing & spacing.
{% endcomment %}

{{ 'section-testimonial-carousel.css' | asset_url | stylesheet_tag }}

<section
  class="tcar"
  id="tcar-{{ section.id }}"
  style="
    --tcar-bg: {{ section.settings.background_color }};
    --tcar-text: {{ section.settings.text_color }};
    --tcar-accent: {{ section.settings.accent_color }};
    --tcar-card-bg: {{ section.settings.card_background }};
    --tcar-card-border: {{ section.settings.card_border_color }};
    --tcar-card-radius: {{ section.settings.card_radius }}px;
    --tcar-card-padding: {{ section.settings.card_padding }}px;
    --tcar-gap: {{ section.settings.card_gap }}px;
    --tcar-per-view: {{ section.settings.cards_per_view }};
    --tcar-max-width: {{ section.settings.max_width }}px;
    --tcar-heading-size: {{ section.settings.heading_size }}px;
    --tcar-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --tcar-quote-size: {{ section.settings.quote_size }}px;
    --tcar-name-size: {{ section.settings.name_size }}px;
    --tcar-star-size: {{ section.settings.star_size }}px;
    --tcar-avatar-size: {{ section.settings.avatar_size }}px;
    --tcar-padding-top: {{ section.settings.padding_top }}px;
    --tcar-padding-bottom: {{ section.settings.padding_bottom }}px;
    --tcar-card-border-width: {{ section.settings.card_border_width }}px;
    --tcar-nav-size: {{ section.settings.nav_button_size }}px;
    --tcar-dot-size: {{ section.settings.dot_size }}px;
  "
>
  <div class="tcar__container">

    {%- comment -%} ── Header ── {%- endcomment -%}
    {% if section.settings.heading != blank or section.settings.eyebrow != blank %}
      <div class="tcar__header" style="text-align:{{ section.settings.header_alignment }};">
        {% if section.settings.eyebrow != blank %}
          <span class="tcar__eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="tcar__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="tcar__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    {%- comment -%} ── Carousel viewport ── {%- endcomment -%}
    <div class="tcar__viewport">
      <div class="tcar__track" id="tcar-track-{{ section.id }}">
        {% for block in section.blocks %}
          <div class="tcar__card" {{ block.shopify_attributes }} style="text-align:{{ section.settings.card_alignment }};">

            {%- comment -%} Stars {%- endcomment -%}
            {% if block.settings.rating > 0 %}
              <div class="tcar__stars" style="justify-content:{{ section.settings.card_alignment }};">
                {% for i in (1..5) %}
                  {% if i <= block.settings.rating %}
                    <svg class="tcar__star" viewBox="0 0 24 24" fill="var(--tcar-accent)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
                  {% else %}
                    <svg class="tcar__star" viewBox="0 0 24 24" fill="none" stroke="var(--tcar-accent)" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            {%- comment -%} Title {%- endcomment -%}
            {% if block.settings.title != blank %}
              <h3 class="tcar__title">{{ block.settings.title }}</h3>
            {% endif %}

            {%- comment -%} Quote {%- endcomment -%}
            <blockquote class="tcar__quote">{{ block.settings.quote }}</blockquote>

            {%- comment -%} Author row {%- endcomment -%}
            <div class="tcar__author" style="justify-content:{{ section.settings.card_alignment }};">
              {% if block.settings.avatar != blank %}
                <img
                  class="tcar__avatar"
                  src="{{ block.settings.avatar | image_url: width: 160 }}"
                  alt="{{ block.settings.name | escape }}"
                  width="{{ section.settings.avatar_size }}"
                  height="{{ section.settings.avatar_size }}"
                  loading="lazy"
                >
              {% endif %}
              <div class="tcar__author-info">
                {% if block.settings.name != blank %}
                  <span class="tcar__name">{{ block.settings.name }}</span>
                {% endif %}
                {% if block.settings.subtitle != blank %}
                  <span class="tcar__subtitle">{{ block.settings.subtitle }}</span>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    {%- comment -%} ── Navigation ── {%- endcomment -%}
    {% if section.settings.show_navigation %}
      <div class="tcar__nav">
        <button class="tcar__btn tcar__btn--prev" aria-label="Previous">
          <svg viewBox="0 0 24 24" fill="none"><path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        {% if section.settings.show_dots %}
          <div class="tcar__dots" id="tcar-dots-{{ section.id }}"></div>
        {% endif %}
        <button class="tcar__btn tcar__btn--next" aria-label="Next">
          <svg viewBox="0 0 24 24" fill="none"><path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    {% endif %}
  </div>
</section>

<script>
(function(){
  var wrap  = document.getElementById('tcar-{{ section.id }}');
  if(!wrap) return;
  var track = document.getElementById('tcar-track-{{ section.id }}');
  var cards = track.children;
  if(!cards.length) return;

  var dotsC = document.getElementById('tcar-dots-{{ section.id }}');
  var prev  = wrap.querySelector('.tcar__btn--prev');
  var next  = wrap.querySelector('.tcar__btn--next');
  var current = 0;

  function perView(){
    return parseInt(getComputedStyle(wrap).getPropertyValue('--tcar-per-view')) || 1;
  }
  function gapPx(){
    return parseInt(getComputedStyle(wrap).getPropertyValue('--tcar-gap')) || 0;
  }
  function maxIndex(){
    return Math.max(0, cards.length - perView());
  }

  function buildDots(){
    if(!dotsC) return;
    dotsC.innerHTML = '';
    for(var i = 0; i <= maxIndex(); i++){
      var d = document.createElement('button');
      d.className = 'tcar__dot' + (i===0?' active':'');
      d.dataset.index = i;
      d.setAttribute('aria-label','Page '+(i+1));
      d.addEventListener('click', function(){ goTo(parseInt(this.dataset.index)); });
      dotsC.appendChild(d);
    }
  }

  function goTo(i){
    current = Math.max(0, Math.min(i, maxIndex()));
    var cardW = cards[0].offsetWidth + gapPx();
    track.style.transform = 'translateX(-' + (current * cardW) + 'px)';
    if(dotsC){
      var dots = dotsC.querySelectorAll('.tcar__dot');
      dots.forEach(function(d,idx){ d.classList.toggle('active', idx===current); });
    }
  }

  if(prev) prev.addEventListener('click', function(){ goTo(current <= 0 ? maxIndex() : current - 1); });
  if(next) next.addEventListener('click', function(){ goTo(current >= maxIndex() ? 0 : current + 1); });
  buildDots();

  {% if section.settings.autoplay %}
  var iv = setInterval(function(){ goTo(current >= maxIndex() ? 0 : current + 1); }, {{ section.settings.autoplay_speed }}000);
  wrap.addEventListener('mouseenter', function(){ clearInterval(iv); });
  wrap.addEventListener('mouseleave', function(){ iv = setInterval(function(){ goTo(current >= maxIndex() ? 0 : current + 1); }, {{ section.settings.autoplay_speed }}000); });
  {% endif %}

  var ro;
  function onResize(){ buildDots(); goTo(Math.min(current, maxIndex())); }
  if(window.ResizeObserver){ ro = new ResizeObserver(onResize); ro.observe(wrap); }
  else { window.addEventListener('resize', onResize); }
})();
</script>

{% schema %}
{
  "name": "SIQ - Testimonial Slider",
  "tag": "section",
  "class": "section-testimonial-carousel",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Testimonials"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max Container Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "cards_per_view",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Cards per View (Desktop)",
      "default": 1
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Gap between Cards",
      "default": 24
    },
    {
      "type": "select",
      "id": "card_alignment",
      "label": "Card Content Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 12,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Card Padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "card_border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Card Border Width",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Section Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Section Padding Bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Eyebrow Font Size",
      "default": 14

{% comment %}
  SectionHub – Story Cards Slider  (ssc-)
  Instagram-story inspired horizontal card slider
{% endcomment %}

{%- assign sid = section.id -%}
{%- assign heading_font = section.settings.heading_font -%}
{%- assign body_font    = section.settings.body_font -%}

<style>
  {{ heading_font | font_face }}
  {{ body_font | font_face }}

  #ssc-{{ sid }} {
    --ssc-bg: {{ section.settings.bg_color }};
    --ssc-accent: {{ section.settings.accent_color }};
    --ssc-heading-color: {{ section.settings.heading_color }};
    --ssc-text-color: {{ section.settings.text_color }};
    --ssc-heading-ff: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --ssc-heading-fw: {{ heading_font.weight }};
    --ssc-heading-fs: {{ heading_font.style }};
    --ssc-body-ff: {{ body_font.family }}, {{ body_font.fallback_families }};
    --ssc-body-fw: {{ body_font.weight }};
    --ssc-card-w: {{ section.settings.card_width }}px;
    --ssc-card-h: {{ section.settings.card_height }}px;
    --ssc-card-gap: {{ section.settings.card_gap }}px;
    --ssc-radius: {{ section.settings.card_radius }}px;
    --ssc-grad-from: {{ section.settings.gradient_from }};
    --ssc-grad-to: {{ section.settings.gradient_to }};
    --ssc-py: {{ section.settings.padding_y }}px;
    --ssc-px: {{ section.settings.padding_x }}px;
  }
</style>

<section id="ssc-{{ sid }}" class="ssc-wrap" data-ssc-reveal>
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subtext != blank -%}
    <div class="ssc-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="ssc-header__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ssc-header__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="ssc-header__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="ssc-viewport" data-ssc-viewport>
    <div class="ssc-track" data-ssc-track>
      {%- for block in section.blocks -%}
        <article class="ssc-card" data-ssc-card="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <div class="ssc-card__media">
            {%- if block.settings.image != blank -%}
              <img
                class="ssc-card__img"
                src="{{ block.settings.image | image_url: width: 600 }}"
                srcset="{{ block.settings.image | image_url: width: 400 }} 400w,
                        {{ block.settings.image | image_url: width: 600 }} 600w,
                        {{ block.settings.image | image_url: width: 800 }} 800w"
                sizes="(max-width:480px) 240px, (max-width:768px) 340px, {{ section.settings.card_width }}px"
                alt="{{ block.settings.image.alt | escape }}"
                loading="lazy"
              >
            {%- else -%}
              <div class="ssc-card__placeholder">
                <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
              </div>
            {%- endif -%}
            <div class="ssc-card__gradient"></div>
          </div>

          <div class="ssc-card__content">
            {%- if block.settings.tag != blank -%}
              <span class="ssc-card__tag">{{ block.settings.tag }}</span>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h3 class="ssc-card__heading">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="ssc-card__text">{{ block.settings.text }}</p>
            {%- endif -%}
            {%- if block.settings.btn_text != blank -%}
              <a class="ssc-card__btn" href="{{ block.settings.btn_link }}">
                {{ block.settings.btn_text }}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            {%- endif -%}
          </div>

          {%- if section.settings.show_progress -%}
            <div class="ssc-card__ring" data-ssc-ring>
              <svg class="ssc-ring-svg" viewBox="0 0 36 36">
                <circle class="ssc-ring-bg" cx="18" cy="18" r="16" fill="none" stroke="rgba(255,255,255,0.15)" stroke-width="2"/>
                <circle class="ssc-ring-fill" cx="18" cy="18" r="16" fill="none" stroke="var(--ssc-accent)" stroke-width="2" stroke-linecap="round"
                  stroke-dasharray="100.53" stroke-dashoffset="100.53" transform="rotate(-90 18 18)"/>
              </svg>
              <span class="ssc-ring-num" data-ssc-ring-num>{{ forloop.index }}</span>
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>

  {%- if section.settings.show_arrows -%}
    <div class="ssc-arrows">
      <button class="ssc-arrow ssc-arrow--prev" data-ssc-prev aria-label="Previous">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </button>
      <button class="ssc-arrow ssc-arrow--next" data-ssc-next aria-label="Next">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
    </div>
  {%- endif -%}

  {%- if section.settings.show_counter -%}
    <div class="ssc-counter">
      <span class="ssc-counter__cur" data-ssc-cur>01</span>
      <span class="ssc-counter__sep">/</span>
      <span class="ssc-counter__tot" data-ssc-tot>{{ section.blocks.size | prepend: '0' | slice: -2, 2 }}</span>
    </div>
  {%- endif -%}
</section>

<script>
  (function(){
    const wrap = document.getElementById('ssc-{{ sid }}');
    if(!wrap) return;

    const viewport = wrap.querySelector('[data-ssc-track]');
    const cards    = Array.from(wrap.querySelectorAll('[data-ssc-card]'));
    const prevBtn  = wrap.querySelector('[data-ssc-prev]');
    const nextBtn  = wrap.querySelector('[data-ssc-next]');
    const curEl    = wrap.querySelector('[data-ssc-cur]');
    const rings    = Array.from(wrap.querySelectorAll('[data-ssc-ring] .ssc-ring-fill'));

    const count    = cards.length;
    if(count === 0) return;

    let active     = 0;
    let autoTimer  = null;
    let ringTimer  = null;
    const auto     = {{ section.settings.autoplay | json }};
    const speed    = {{ section.settings.autoplay_speed }} * 1000;
    const circum   = 2 * Math.PI * 16; /* r=16 */

    /* --- scroll to card --- */
    function goTo(idx){
      active = ((idx % count) + count) % count;
      const card = cards[active];
      const vp   = wrap.querySelector('[data-ssc-viewport]');

      vp.scrollTo({
        left: card.offsetLeft - (vp.offsetWidth - card.offsetWidth) / 2,
        behavior: 'smooth'
      });

      cards.forEach(function(c, i){
        c.classList.toggle('ssc-card--active', i === active);
      });

      if(curEl){
        var num = active + 1;
        curEl.textContent = num < 10 ? '0' + num : '' + num;
      }

      startRing();
    }

    /* --- progress ring --- */
    function startRing(){
      clearInterval(ringTimer);
      rings.forEach(function(r){ r.style.strokeDashoffset = circum; });
      if(!auto) return;

      var elapsed = 0;
      var interval = 30;
      ringTimer = setInterval(function(){
        elapsed += interval;
        var pct = Math.min(elapsed / speed, 1);
        if(rings[active]){
          rings[active].style.strokeDashoffset = circum * (1 - pct);
        }
        if(pct >= 1){
          clearInterval(ringTimer);
        }
      }, interval);
    }

    /* --- autoplay --- */
    function startAuto(){
      stopAuto();
      if(!auto) return;
      autoTimer = setInterval(function(){ goTo(active + 1); }, speed);
    }
    function stopAuto(){ clearInterval(autoTimer); clearInterval(ringTimer); }

    /* --- arrows --- */
    if(prevBtn) prevBtn.addEventListener('click', function(){ goTo(active - 1); startAuto(); });
    if(nextBtn) nextBtn.addEventListener('click', function(){ goTo(active + 1); startAuto(); });

    /* --- click card --- */
    cards.forEach(function(c, i){
      c.addEventListener('click', function(){ if(i !== active){ goTo(i); startAuto(); } });
    });

    /* --- touch swipe --- */
    var tx = 0;
    viewport.addEventListener('touchstart', function(e){ tx = e.touches[0].clientX; }, {passive:true});
    viewport.addEventListener('touchend', function(e){
      var dx = e.changedTouches[0].clientX - tx;
      if(Math.abs(dx) > 40){
        if(dx < 0) goTo(active + 1); else goTo(active - 1);
        startAuto();
      }
    }, {passive:true});

    /* --- keyboard --- */
    wrap.setAttribute('tabindex', '0');
    wrap.addEventListener('keydown', function(e){
      if(e.key === 'ArrowLeft'){ goTo(active - 1); startAuto(); }
      if(e.key === 'ArrowRight'){ goTo(active + 1); startAuto(); }
    });

    /* --- snap observer (sync active from scroll) --- */
    var scrollTimeout;
    var vpEl = wrap.querySelector('[data-ssc-viewport]');
    vpEl.addEventListener('scroll', function(){
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(function(){
        var center = vpEl.scrollLeft + vpEl.offsetWidth / 2;
        var closest = 0;
        var minDist = Infinity;
        cards.forEach(function(c, i){
          var mid = c.offsetLeft + c.offsetWidth / 2;
          var d = Math.abs(mid - center);
          if(d < minDist){ minDist = d; closest = i; }
        });
        if(closest !== active){
          active = closest;
          cards.forEach(function(c, i){ c.classList.toggle('ssc-card--active', i === active); });
          if(curEl){
            var num = active + 1;
            curEl.textContent = num < 10 ? '0' + num : '' + num;
          }
          startRing();
          startAuto();
        }
      }, 80);
    }, {passive: true});

    /* --- scroll reveal --- */
    if('IntersectionObserver' in window){
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(en){
          if(en.isIntersecting){
            en.target.classList.add('ssc-visible');
            goTo(0);
            startAuto();
            io.unobserve(en.target);
          }
        });
      }, {threshold: 0.15});
      io.observe(wrap);
    } else {
      wrap.classList.add('ssc-visible');
      goTo(0);
      startAuto();
    }
  })();
</script>

{% schema %}
{
  "name": "SIQ - Story Cards Slider",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Featured Stories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore our latest"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Swipe through curated stories that inspire and captivate your audience."
    },
    {
      "type": "header",
      "content": "Card Dimensions"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card Width (px)",
      "min": 220,
      "max": 400,
      "step": 10,
      "default": 300,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Card Height (px)",
      "min": 360,
      "max": 640,
      "step": 10,
      "default": 500,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card Gap (px)",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card Radius (px)",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Behaviour"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay Speed (s)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5,
      "unit": "s"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_counter",
      "label": "Show Counter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_progress",
      "label": "Show Progress Ring",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#111118"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#a78bfa"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#f0eef6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#9994b8"
    },
    {
      "type": "color",
      "id": "gradient_from",
      "label": "Card Gradient (from)",
      "default": "#111118"
    },
    {
      "type": "color",
      "id": "gradient_to",
      "label": "Card Gradient (to)",
      "default": "#00000000"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading Font",
      "default": "playfair_display_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body Font",
      "default": "inter_n4"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding (px)",
      "min": 20,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Horizontal Padding (px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 24,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Story Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag / Category"
        },

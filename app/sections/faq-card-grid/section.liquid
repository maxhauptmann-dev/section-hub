{{ 'section-faq-card-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id
  assign bg = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign accent = section.settings.accent_color
  assign card_bg = section.settings.card_bg
  assign card_border = section.settings.card_border
  assign answer_color = section.settings.answer_color
  assign badge_bg = section.settings.badge_bg
  assign badge_text = section.settings.badge_text
  assign max_w = section.settings.max_width
  assign pad_y = section.settings.padding_y
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom
  assign q_size = section.settings.question_size
  assign a_size = section.settings.answer_size
  assign radius = section.settings.border_radius
  assign columns = section.settings.columns
  assign gap = section.settings.gap
  assign card_style = section.settings.card_style
  assign show_badge = section.settings.show_badge
  assign show_icon = section.settings.show_icon
  assign open_style = section.settings.open_style
  assign card_shadow = section.settings.card_shadow
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign heading_align = section.settings.heading_align
  assign icon_style = section.settings.icon_style
  assign hover_lift = section.settings.hover_lift
-%}

<div
  id="faq-cg-{{ sid }}"
  class="faq-cg"
  style="
    --faq-cg-bg: {{ bg }};
    --faq-cg-text: {{ text_color }};
    --faq-cg-accent: {{ accent }};
    --faq-cg-card-bg: {{ card_bg }};
    --faq-cg-card-border: {{ card_border }};
    --faq-cg-answer: {{ answer_color }};
    --faq-cg-badge-bg: {{ badge_bg }};
    --faq-cg-badge-text: {{ badge_text }};
    --faq-cg-max-w: {{ max_w }}px;
    --faq-cg-pad-y: {{ pad_y }}px;
    --faq-cg-mt: {{ mt }}px;
    --faq-cg-mb: {{ mb }}px;
    --faq-cg-q-size: {{ q_size }}px;
    --faq-cg-a-size: {{ a_size }}px;
    --faq-cg-radius: {{ radius }}px;
    --faq-cg-cols: {{ columns }};
    --faq-cg-gap: {{ gap }}px;
  "
>
  <div class="faq-cg__inner">
    {%- if heading != blank or subheading != blank -%}
      <div class="faq-cg__header" style="text-align:{{ heading_align }}">
        {%- if heading != blank -%}
          <h2 class="faq-cg__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="faq-cg__subheading">{{ subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="faq-cg__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign q = block.settings.question
          assign a = block.settings.answer
          assign badge_label = block.settings.badge
          assign icon = block.settings.icon
          assign card_accent = block.settings.card_accent
        -%}
        <div
          class="faq-cg__card{% if card_style == 'bordered' %} faq-cg__card--bordered{% endif %}{% if card_style == 'glass' %} faq-cg__card--glass{% endif %}{% if card_shadow %} faq-cg__card--shadow{% endif %}{% if hover_lift %} faq-cg__card--lift{% endif %}"
          data-faq-card="{{ sid }}"
          {% if card_accent != blank %}style="--faq-cg-card-accent: {{ card_accent }}"{% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if card_accent != blank -%}
            <div class="faq-cg__card-accent"></div>
          {%- endif -%}

          <button
            class="faq-cg__question"
            aria-expanded="false"
            data-faq-cg-toggle="{{ sid }}"
          >
            <div class="faq-cg__q-top">
              {%- if show_icon and icon != blank -%}
                <span class="faq-cg__icon{% if icon_style == 'circle' %} faq-cg__icon--circle{% endif %}{% if icon_style == 'square' %} faq-cg__icon--square{% endif %}">{{ icon }}</span>
              {%- endif -%}
              {%- if show_badge and badge_label != blank -%}
                <span class="faq-cg__badge">{{ badge_label }}</span>
              {%- endif -%}
            </div>
            <span class="faq-cg__q-text">{{ q }}</span>
            <span class="faq-cg__expand-hint" aria-hidden="true">
              {%- if open_style == 'arrow' -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              {%- else -%}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              {%- endif -%}
            </span>
          </button>

          <div class="faq-cg__answer">
            <div class="faq-cg__answer-inner">{{ a }}</div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
(function(){
  const sid = '{{ sid }}';
  const root = document.getElementById('faq-cg-' + sid);
  if (!root) return;

  root.addEventListener('click', function(e) {
    const btn = e.target.closest('[data-faq-cg-toggle="' + sid + '"]');
    if (!btn) return;
    const card = btn.closest('.faq-cg__card');
    const answer = card.querySelector('.faq-cg__answer');
    const isOpen = card.classList.contains('faq-cg__card--open');

    if (isOpen) {
      card.classList.remove('faq-cg__card--open');
      btn.setAttribute('aria-expanded', 'false');
      answer.style.maxHeight = '0';
    } else {
      card.classList.add('faq-cg__card--open');
      btn.setAttribute('aria-expanded', 'true');
      answer.style.maxHeight = answer.scrollHeight + 'px';
    }
  });
})();
</script>


{% comment %}
  Section Hub – Collage Minimal v1.0
  Asymmetric masonry collage with light theme,
  mixed sizes, hover overlays, editorial design.
  Prefix: icm-
{% endcomment %}

{%- liquid
  assign hf = section.settings.heading_font
  assign bf = section.settings.body_font
  assign gap = section.settings.grid_gap
  assign radius = section.settings.card_radius
  assign show_overlay = section.settings.show_overlay
  assign py = section.settings.section_py
  assign px = section.settings.section_px
-%}

<style>
  {{ hf | font_face: font_display: 'swap' }}
  {{ bf | font_face: font_display: 'swap' }}

  .icm-wrap--{{ section.id }} {
    --icm-bg: {{ section.settings.bg_color }};
    --icm-heading-ff: {{ hf.family }}, {{ hf.fallback_families }};
    --icm-heading-fw: {{ hf.weight }};
    --icm-heading-fs: {{ hf.style }};
    --icm-body-ff: {{ bf.family }}, {{ bf.fallback_families }};
    --icm-body-fw: {{ bf.weight }};
    --icm-body-fs: {{ bf.style }};
    --icm-heading-color: {{ section.settings.heading_color }};
    --icm-text-color: {{ section.settings.text_color }};
    --icm-accent: {{ section.settings.accent_color }};
    --icm-border-color: {{ section.settings.border_color }};
    --icm-card-radius: {{ radius }}px;
    --icm-gap: {{ gap }}px;
    --icm-py: {{ py }}px;
    --icm-px: {{ px }}px;
  }
</style>

<section class="icm-wrap icm-wrap--{{ section.id }}" data-section-id="{{ section.id }}">

  <div class="icm-container">

    {%- comment -%} Header {%- endcomment -%}
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subtext != blank -%}
      <div class="icm-header" data-icm-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <span class="icm-header__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="icm-header__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="icm-header__subtext">{{ section.settings.subtext }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Grid {%- endcomment -%}
    <div class="icm-grid" data-icm-grid>
      {%- for block in section.blocks -%}
        {%- liquid
          assign size = block.settings.size
          assign span_col = 1
          assign span_row = 1
          if size == 'double-width'
            assign span_col = 2
          elsif size == 'double-height'
            assign span_row = 2
          elsif size == 'double'
            assign span_col = 2
            assign span_row = 2
          endif
        -%}
        <div class="icm-card{% if size != 'normal' %} icm-card--{{ size }}{% endif %}"
             style="grid-column: span min({{ span_col }}, 2); grid-row: span {{ span_row }};"
             data-icm-reveal
             {{ block.shopify_attributes }}>

          <div class="icm-card__media">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 1000 }}"
                srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 700 }} 700w, {{ block.settings.image | image_url: width: 1000 }} 1000w"
                sizes="(max-width: 749px) 100vw, 50vw"
                alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                loading="lazy"
                class="icm-card__img"
              >
            {%- else -%}
              <div class="icm-card__placeholder">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              </div>
            {%- endif -%}

            {%- comment -%} Overlay {%- endcomment -%}
            {%- if show_overlay or block.settings.title != blank or block.settings.subtitle != blank -%}
              <div class="icm-card__overlay">
                <div class="icm-card__content">
                  {%- if block.settings.badge != blank -%}
                    <span class="icm-card__badge">{{ block.settings.badge }}</span>
                  {%- endif -%}
                  {%- if block.settings.title != blank -%}
                    <h3 class="icm-card__title">{{ block.settings.title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.subtitle != blank -%}
                    <p class="icm-card__subtitle">{{ block.settings.subtitle }}</p>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </div>

          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="icm-card__link" aria-label="{{ block.settings.title | default: 'View' | escape }}"></a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

  </div>

</section>

<script>
  (function(){
    const sid = '{{ section.id }}';
    const wrap = document.querySelector('.icm-wrap--' + sid);
    if (!wrap) return;

    const revealEls = wrap.querySelectorAll('[data-icm-reveal]');
    if (revealEls.length) {
      const rio = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
          if (e.isIntersecting) {
            e.target.classList.add('icm-visible');
            rio.unobserve(e.target);
          }
        });
      }, { threshold: 0.1 });
      revealEls.forEach(function(el) { rio.observe(el); });
    }
  })();
</script>

{% schema %}
{
  "name": "SS - Collage Minimal",
  "tag": "section",
  "class": "icm-section",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Visual Collage"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Mix and match images of different sizes for dynamic editorial layouts."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 8,
      "max": 32,
      "step": 4,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "default": 4,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show hover overlay",
      "default": true
    },
    {
      "type": "header",
      "content": "Section size"
    },
    {
      "type": "range",
      "id": "section_py",
      "label": "Vertical padding",
      "min": 20,
      "max": 120,
      "step": 10,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_px",
      "label": "Horizontal padding",
      "min": 16,
      "max": 60,
      "step": 4,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#d4745e"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e0e0e0"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "playfair_display_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "inter_n4"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            { "value": "normal", "label": "Normal (1x1)" },
            { "value": "double-width", "label": "Wide (2x1)" },
            { "value": "double-height", "label": "Tall (1x2)" },
            { "value": "double", "label": "Large (2x2)" }
          ],
          "default": "normal"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Image Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SS - Collage Minimal",
      "settings": {
        "eyebrow": "Collection",
        "heading": "Visual Collage",
        "subtext": "Mix and match images of different sizes for dynamic editorial layouts.",
        "grid_gap": 16,
        "card_radius": 4,
        "show_overlay": true,
        "bg_color": "#f8f8f8",
        "heading_color": "#000000"
      },
      "blocks": [
        {
          "type": "image",
          "settings": {
            "size": "normal",
            "title": "Frame One",
            "subtitle": "Photography",
            "badge": "New"
          }
        },
        {
          "type": "image",
          "settings": {
            "size": "double-width",
            "title": "Landscape",
            "subtitle": "Editorial shoot"
          }
        },
        {
          "type": "image",
          "settings": {
            "size": "normal",
            "title": "Frame Two",
            "subtitle": "Studio"
          }
        },
        {
          "type": "image",
          "settings": {
            "size": "double-height",
            "title": "Vertical",
            "subtitle": "Portrait series"
          }
        },
        {
          "type": "image",
          "settings": {
            "size": "normal",
            "title": "Frame Three",
            "subtitle": "Details"
          }
        },
        {
          "type": "image",
          "settings": {
            "size": "normal",
            "title": "Frame Four",
            "subtitle": "Motion"
          }
        },
        {
          "type": "image",
          "settings": {
            "size": "double",
            "title": "Feature",
            "subtitle": "Campaign hero"
          }
        },
        {
          "type": "image",
          "settings": {
            "size": "normal",
            "title": "Frame Five",
            "subtitle": "Lifestyle"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% comment %} SIQ - Top Info Bar {% endcomment %}

{%- liquid
  assign tib_id    = 'tib-' | append: section.id
  assign tib_h     = section.settings.bar_height | append: 'px'
  assign tib_px    = section.settings.side_padding | append: 'px'
  assign tib_font  = section.settings.font_size | append: 'px'
  assign tib_isize = section.settings.icon_size | append: 'px'
  assign tib_gap   = section.settings.social_gap | append: 'px'
  assign tib_speed = section.settings.autoplay_speed | times: 1000

  assign tib_fw = 400
  if section.settings.font_weight == 'medium'
    assign tib_fw = 500
  elsif section.settings.font_weight == 'semibold'
    assign tib_fw = 600
  elsif section.settings.font_weight == 'bold'
    assign tib_fw = 700
  endif

  assign tib_border = 'none'
  if section.settings.show_border
    assign tib_border = '1px solid rgba(255,255,255,0.08)'
  endif

  assign tib_msg_count = 0
  for block in section.blocks
    if block.type == 'message'
      assign tib_msg_count = tib_msg_count | plus: 1
    endif
  endfor
-%}

<style>
  #{{ tib_id }} {
    --tib-bg: {{ section.settings.bg_color }};
    --tib-border: {{ tib_border }};
    --tib-h: {{ tib_h }};
    --tib-px: {{ tib_px }};
    --tib-max-w: {{ section.settings.max_width }}px;
    --tib-text-color: {{ section.settings.text_color }};
    --tib-icon-color: {{ section.settings.icon_color }};
    --tib-font-size: {{ tib_font }};
    --tib-font-weight: {{ tib_fw }};
    --tib-icon-size: {{ tib_isize }};
    --tib-social-gap: {{ tib_gap }};
  }
</style>

<div id="{{ tib_id }}" class="tib{% if section.settings.hide_locale_mobile %} tib--hide-locale-mobile{% endif %}">
  <div class="tib__inner">

    {%- comment %} ═══ LEFT — Social Icons ═══ {%- endcomment %}
    <div class="tib__left">
      {%- if section.settings.show_facebook and section.settings.facebook_url != blank %}

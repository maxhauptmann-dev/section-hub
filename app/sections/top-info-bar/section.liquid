        <a class="tib__social-link" href="{{ section.settings.snapchat_url }}" target="_blank" rel="noopener" aria-label="Snapchat"><svg viewBox="0 0 24 24"><path d="M12.065.001C8.786.001 5.951 1.459 4.228 4.066c-1.003 1.535-1.229 3.106-1.165 4.562-.305.163-.637.249-.977.251-.404 0-.797-.118-1.048-.318-.11-.088-.228-.131-.341-.131-.228 0-.44.171-.494.409-.065.283.116.554.52.73.038.017.085.034.138.052.476.166 1.428.498 1.624 1.165.01.035.015.072.015.11 0 .046-.009.092-.028.135-.274.628-.952 1.1-1.574 1.547-.554.397-.967.709-1.021 1.009-.073.406.147.769.647 1.015.252.126.601.214.989.257.254.028.427.079.498.124-.001.025-.005.049-.005.074 0 .351.109.698.196.881.116.245.351.387.624.387.132 0 .27-.028.427-.084.272-.098.57-.147.883-.147.289 0 .581.046.864.136.559.18 1.072.547 1.574 1.127.913 1.056 1.742 1.578 2.527 1.578.248 0 .493-.051.729-.152.213-.091.437-.138.671-.142.237.004.462.051.675.142.237.101.481.153.729.153.785 0 1.614-.522 2.528-1.578.502-.58 1.014-.948 1.572-1.128.284-.091.577-.137.866-.137.313 0 .611.049.883.147.157.057.295.084.427.084.273 0 .508-.142.624-.387.087-.183.196-.53.196-.881 0-.025-.004-.049-.005-.074.071-.045.244-.096.498-.124.389-.043.738-.131.989-.257.5-.247.72-.609.647-1.015-.054-.3-.467-.612-1.021-1.009-.622-.448-1.3-.919-1.574-1.547-.019-.043-.028-.089-.028-.135 0-.038.005-.075.015-.11.196-.667 1.148-1 1.624-1.165.053-.018.1-.035.138-.052.404-.176.585-.447.52-.73-.054-.238-.266-.409-.494-.409-.113 0-.231.043-.341.131-.251.2-.644.318-1.048.318-.338-.002-.669-.088-.973-.25.064-1.457-.163-3.028-1.166-4.564C18.037 1.46 15.289.002 12.065.001z"/></svg></a>
      {%- endif %}
    </div>

    {%- comment %} ═══ CENTER — Messages ═══ {%- endcomment %}
    <div class="tib__center">
      {%- if tib_msg_count == 0 %}
        <div class="tib__single">
          <span class="tib__text">{{ section.settings.fallback_text | default: 'Free shipping on orders over €50' }}</span>
        </div>
      {%- elsif tib_msg_count == 1 %}
        {%- for block in section.blocks %}
          {%- if block.type == 'message' %}
            <div class="tib__single" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank %}<span>{{ block.settings.icon }}</span>{%- endif %}
              <span class="tib__text">{{ block.settings.text }}</span>
              {%- if block.settings.link_label != blank and block.settings.link_url != blank %}
                <span class="tib__sep">·</span>
                <a class="tib__link" href="{{ block.settings.link_url }}">{{ block.settings.link_label }}</a>
              {%- endif %}
            </div>
          {%- endif %}
        {%- endfor %}
      {%- else %}
        <div class="tib__slide-wrap" id="{{ tib_id }}-slides">
          {%- assign tib_idx = 0 %}
          {%- for block in section.blocks %}
            {%- if block.type == 'message' %}
              <div class="tib__slide{% if tib_idx == 0 %} is-active{% endif %}" data-tib-i="{{ tib_idx }}" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank %}<span>{{ block.settings.icon }}</span>{%- endif %}
                <span class="tib__text">{{ block.settings.text }}</span>
                {%- if block.settings.link_label != blank and block.settings.link_url != blank %}
                  <span class="tib__sep">·</span>
                  <a class="tib__link" href="{{ block.settings.link_url }}">{{ block.settings.link_label }}</a>
                {%- endif %}
              </div>
              {%- assign tib_idx = tib_idx | plus: 1 %}
            {%- endif %}
          {%- endfor %}
        </div>
      {%- endif %}
    </div>

    {%- comment %} ═══ RIGHT — Locale ═══ {%- endcomment %}
    <div class="tib__right">
      {%- if section.settings.show_language %}
        {%- if localization.available_languages.size > 1 %}
          <div class="tib__locale-wrap">
            {%- form 'localization' %}
              <select class="tib__locale-select" name="locale_code" onchange="this.form.submit()" aria-label="Language">
                {%- for lang in localization.available_languages %}
                  <option value="{{ lang.iso_code }}"{% if lang.iso_code == localization.language.iso_code %} selected{% endif %}>{{ lang.endonym_name | capitalize }}</option>
                {%- endfor %}
              </select>
              <svg class="tib__chevron" viewBox="0 0 10 6"><polyline points="1 1 5 5 9 1"/></svg>
            {%- endform %}
          </div>
        {%- else %}
          <span class="tib__locale-static">{{ localization.language.iso_code | upcase }}</span>
        {%- endif %}
      {%- endif %}

      {%- if section.settings.show_language and section.settings.show_currency %}
        <div class="tib__locale-divider"></div>
      {%- endif %}

      {%- if section.settings.show_currency %}
        {%- if localization.available_countries.size > 1 %}
          <div class="tib__locale-wrap">
            {%- form 'localization' %}
              <select class="tib__locale-select" name="country_code" onchange="this.form.submit()" aria-label="Currency">
                {%- for country in localization.available_countries %}
                  <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.currency.symbol }} {{ country.currency.iso_code }}</option>
                {%- endfor %}
              </select>
              <svg class="tib__chevron" viewBox="0 0 10 6"><polyline points="1 1 5 5 9 1"/></svg>
            {%- endform %}
          </div>
        {%- else %}
          <span class="tib__locale-static">{{ localization.country.currency.symbol }} {{ localization.country.currency.iso_code }}</span>
        {%- endif %}
      {%- endif %}
    </div>

  </div>
</div>

{%- if tib_msg_count > 1 and section.settings.enable_autoplay %}
<script>
(function(){
  var wrap = document.getElementById('{{ tib_id }}-slides');
  if(!wrap) return;
  var slides = wrap.querySelectorAll('.tib__slide');
  var n = slides.length;
  if(n < 2) return;
  var cur = 0;
  setInterval(function(){
    var prev = cur;
    cur = (cur + 1) % n;
    slides[prev].classList.remove('is-active');
    slides[prev].classList.add('is-exit');
    slides[cur].classList.add('is-active');
    setTimeout(function(){ slides[prev].classList.remove('is-exit'); }, 380);
  }, {{ tib_speed }});
})();
</script>
{%- endif %}

{% schema %}
{
  "name": "Top Info Bar",
  "tag": "section",
  "class": "tib-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "bar_height",
      "min": 30,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Bar height",
      "default": 40
    },
    {
      "type": "range",
      "id": "side_padding",
      "min": 8,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Side padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 960,
      "max": 1920,
      "step": 40,
      "unit": "px",
      "label": "Max content width",
      "default": 1440
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show bottom border",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#18181b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 13
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        { "value": "normal", "label": "Normal" },
        { "value": "medium", "label": "Medium" },
        { "value": "semibold", "label": "Semi-bold" },
        { "value": "bold", "label": "Bold" }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Center text"
    },
    {
      "type": "text",
      "id": "fallback_text",
      "label": "Fallback text (if no blocks)",
      "default": "Free shipping on orders over €50"
    },
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "Rotate messages",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Rotation interval",
      "default": 4
    },
    {
      "type": "header",
      "content": "Social Icons"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Icon size",
      "default": 16
    },
    {
      "type": "range",
      "id": "social_gap",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Gap between icons",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "show_facebook",
      "label": "Facebook",
      "default": true
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "checkbox",
      "id": "show_instagram",
      "label": "Instagram",
      "default": true
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "checkbox",
      "id": "show_youtube",
      "label": "YouTube",
      "default": true
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "checkbox",
      "id": "show_tiktok",
      "label": "TikTok",
      "default": true
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "checkbox",
      "id": "show_x",
      "label": "X (Twitter)",
      "default": true
    },
    {
      "type": "url",
      "id": "x_url",
      "label": "X URL"
    },
    {
      "type": "checkbox",
      "id": "show_pinterest",
      "label": "Pinterest",
      "default": false
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest URL"
    },
    {
      "type": "checkbox",
      "id": "show_linkedin",
      "label": "LinkedIn",
      "default": false
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn URL"
    },
    {
      "type": "checkbox",
      "id": "show_snapchat",
      "label": "Snapchat",
      "default": false
    },
    {
      "type": "url",
      "id": "snapchat_url",
      "label": "Snapchat URL"
    },
    {
      "type": "header",
      "content": "Language & Currency"
    },
    {
      "type": "checkbox",
      "id": "show_language",
      "label": "Show language selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_currency",
      "label": "Show currency selector",
      "default": true
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "checkbox",
      "id": "hide_locale_mobile",
      "label": "Hide locale on mobile",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Center Message",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon / Emoji",
          "placeholder": "🎉"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Message text",
          "default": "Free shipping on all orders over €50!"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "placeholder": "Shop Now"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Top Info Bar",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "icon": "",
            "text": "Winters sale - Receive 20% off on orders over 50$",
            "link_label": "",
            "link_url": ""
          }
        },
        {
          "type": "message",
          "settings": {
            "icon": "",
            "text": "Free shipping on all orders over €50",
            "link_label": "",
            "link_url": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% comment %}
  Section Hub – Category Scroll
  Horizontal scrolling category cards with large images
  and bold labels. Supports drag-scroll on desktop.
{% endcomment %}

{%- liquid
  assign section_title = section.settings.section_title
  assign section_sub   = section.settings.section_subtitle

  assign card_w        = section.settings.card_width
  assign card_h        = section.settings.card_height
  assign card_wm       = section.settings.card_width_mobile
  assign card_hm       = section.settings.card_height_mobile
  assign card_round    = section.settings.card_roundness
  assign card_gap      = section.settings.card_gap
  assign card_gap_m    = section.settings.card_gap_mobile
  assign overlay_bot   = section.settings.overlay_bottom

  assign label_fs      = section.settings.label_font_size
  assign label_fsm     = section.settings.label_font_size_mobile
  assign label_fw      = section.settings.label_font_weight
  assign label_ls      = section.settings.label_letter_spacing
  assign label_tt      = section.settings.label_text_transform
  assign label_c       = section.settings.label_color
  assign label_pad     = section.settings.label_padding

  assign sublabel_fs   = section.settings.sublabel_font_size
  assign sublabel_c    = section.settings.sublabel_color

  assign title_fs      = section.settings.title_font_size
  assign title_fsm     = section.settings.title_font_size_mobile
  assign title_fw      = section.settings.title_font_weight
  assign title_ls      = section.settings.title_letter_spacing
  assign title_tt      = section.settings.title_text_transform
  assign title_c       = section.settings.title_color
  assign title_sub_fs  = section.settings.title_sub_font_size
  assign title_sub_c   = section.settings.title_sub_color
  assign header_gap    = section.settings.header_gap

  assign bg_color      = section.settings.bg_color
  assign pad_top       = section.settings.padding_top
  assign pad_bottom    = section.settings.padding_bottom
  assign pad_sides     = section.settings.padding_sides
  assign pad_sides_m   = section.settings.padding_sides_mobile
  assign margin_top    = section.settings.margin_top
  assign margin_bottom = section.settings.margin_bottom
  assign sec_width     = section.settings.section_width
  assign lazy          = section.settings.lazy_load

  assign custom_css    = section.settings.custom_css
-%}

<style>
  #cs-{{ section.id }} {
    --cs-card-w: {{ card_w }}px;
    --cs-card-h: {{ card_h }}px;
    --cs-card-wm: {{ card_wm }}px;
    --cs-card-hm: {{ card_hm }}px;
    --cs-card-r: {{ card_round }}px;
    --cs-gap: {{ card_gap }}px;
    --cs-gap-m: {{ card_gap_m }}px;
    --cs-overlay-bottom: {{ overlay_bot | divided_by: 100.0 }};

    --cs-label-fs: {{ label_fs }}px;
    --cs-label-fsm: {{ label_fsm }}px;
    --cs-label-fw: {{ label_fw }};
    --cs-label-ls: {{ label_ls | divided_by: 100.0 }}em;
    --cs-label-tt: {{ label_tt }};
    --cs-label-c: {{ label_c }};
    --cs-label-pad: {{ label_pad }}px;

    --cs-sublabel-fs: {{ sublabel_fs }}px;
    --cs-sublabel-c: {{ sublabel_c }};

    --cs-title-fs: {{ title_fs }}px;
    --cs-title-fsm: {{ title_fsm }}px;
    --cs-title-fw: {{ title_fw }};
    --cs-title-ls: {{ title_ls | divided_by: 100.0 }}em;
    --cs-title-tt: {{ title_tt }};
    --cs-title-c: {{ title_c }};
    --cs-title-sub-fs: {{ title_sub_fs }}px;
    --cs-title-sub-c: {{ title_sub_c }};
    --cs-header-gap: {{ header_gap }}px;

    --cs-bg: {{ bg_color }};
    --cs-pt: {{ pad_top }}px;
    --cs-pb: {{ pad_bottom }}px;
    --cs-ps: {{ pad_sides }}rem;
    --cs-ps-m: {{ pad_sides_m }}rem;
    --cs-mt: {{ margin_top }}px;
    --cs-mb: {{ margin_bottom }}px;

    {% if sec_width == 'page' %}
      --cs-max-w: 1200px;
    {% elsif sec_width == 'custom' %}
      --cs-max-w: {{ section.settings.section_custom_width }}px;
    {% else %}
      --cs-max-w: 100%;
    {% endif %}
  }
  {% if custom_css != blank %}{{ custom_css }}{% endif %}
</style>

<section id="cs-{{ section.id }}" class="cs-wrap">

  {%- if section_title != blank or section_sub != blank -%}
    <div class="cs-header">
      {%- if section_title != blank -%}
        <h2 class="cs-header__title">{{ section_title }}</h2>
      {%- endif -%}
      {%- if section_sub != blank -%}
        <p class="cs-header__sub">{{ section_sub }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="cs-track" data-cs-drag>
    {%- for block in section.blocks -%}
      {%- if block.type == 'category' -%}
        {%- liquid
          assign col = block.settings.collection
          if block.settings.link != blank
            assign card_url = block.settings.link
          elsif col != blank
            assign card_url = col.url
          else
            assign card_url = '#'
          endif

          if block.settings.image != blank
            assign card_img = block.settings.image
          elsif col != blank and col.image != blank
            assign card_img = col.image
          elsif col != blank and col.products.first != blank and col.products.first.featured_image != blank
            assign card_img = col.products.first.featured_image
          else
            assign card_img = blank
          endif

          if block.settings.label != blank
            assign card_label = block.settings.label
          elsif col != blank
            assign card_label = col.title
          else
            assign card_label = ''
          endif
        -%}

        <a href="{{ card_url }}"
           class="cs-card"
           style="{% if block.settings.image_position != blank %}--cs-img-pos: {{ block.settings.image_position }};{% endif %}"
           {{ block.shopify_attributes }}>

          {%- if card_img != blank -%}
            <img
              src="{{ card_img | image_url: width: 800 }}"
              alt="{{ card_img.alt | default: card_label | default: 'Category' }}"
              class="cs-card__img"
              {% if lazy %}loading="lazy"{% else %}loading="eager"{% endif %}
            >
          {%- else -%}
            <div class="cs-card__placeholder">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
            </div>
          {%- endif -%}

          <div class="cs-card__overlay"></div>

          <div class="cs-card__content">
            {%- if card_label != blank -%}
              <span class="cs-card__label">{{ card_label }}</span>
            {%- endif -%}
            {%- if block.settings.sublabel != blank -%}
              <span class="cs-card__sublabel">{{ block.settings.sublabel }}</span>
            {%- endif -%}
          </div>

        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>

</section>

<script>
(function(){
  /* Drag-to-scroll on desktop */
  var track = document.querySelector('#cs-{{ section.id }} .cs-track');
  if(!track) return;

  var isDown = false, startX = 0, scrollLeft = 0;

  track.addEventListener('mousedown', function(e){
    isDown = true;
    track.style.scrollSnapType = 'none';
    startX = e.pageX - track.offsetLeft;
    scrollLeft = track.scrollLeft;
  });

  track.addEventListener('mouseleave', function(){
    isDown = false;
    track.style.scrollSnapType = '';
  });

  track.addEventListener('mouseup', function(){
    isDown = false;
    track.style.scrollSnapType = '';
  });

  track.addEventListener('mousemove', function(e){
    if(!isDown) return;
    e.preventDefault();
    var x = e.pageX - track.offsetLeft;
    var walk = (x - startX) * 1.5;
    track.scrollLeft = scrollLeft - walk;
  });

  /* Prevent click when dragged */
  var moved = false;
  track.addEventListener('mousedown', function(){ moved = false; });
  track.addEventListener('mousemove', function(){ if(isDown) moved = true; });
  track.addEventListener('click', function(e){
    if(moved){ e.preventDefault(); moved = false; }
  }, true);
})();
</script>


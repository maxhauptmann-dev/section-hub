{% comment %}
  Section Hub – Image with Text
  Flexible side-by-side layout with image and text. Reversible, responsive,
  multiple image ratios, buttons, and full color controls.
{% endcomment %}

{{ 'section-image-with-text.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign reversed = section.settings.reverse_layout
  assign img = section.settings.image
-%}

<section
  class="sh-iwt{% if reversed %} sh-iwt--reversed{% endif %}"
  style="
    --sh-iwt-bg: {{ section.settings.background_color }};
    --sh-iwt-text: {{ section.settings.text_color }};
    --sh-iwt-accent: {{ section.settings.accent_color }};
    --sh-iwt-pad-y: {{ section.settings.padding_y }}px;
    --sh-iwt-pad-x: {{ section.settings.padding_x }}px;
    --sh-iwt-gap: {{ section.settings.gap }}px;
    --sh-iwt-img-radius: {{ section.settings.image_roundness }}px;
    --sh-iwt-img-ratio: {{ section.settings.image_ratio }};
    --sh-iwt-heading-size: {{ section.settings.heading_size }}px;
    --sh-iwt-heading-size-m: {{ section.settings.heading_size_mobile }}px;
    --sh-iwt-body-size: {{ section.settings.body_size }}px;
    --sh-iwt-btn-radius: {{ section.settings.button_roundness }}px;
    --sh-iwt-split: {{ section.settings.image_width }}%;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  "
>
  <div class="sh-iwt__container">
    <div class="sh-iwt__media">
      {%- if img != blank -%}
        <img
          src="{{ img | image_url: width: 1200 }}"
          alt="{{ img.alt | escape }}"
          width="{{ img.width }}"
          height="{{ img.height }}"
          loading="lazy"
          class="sh-iwt__img"
        >
      {%- else -%}
        <div class="sh-iwt__placeholder">
          {{ 'image' | placeholder_svg_tag: 'sh-iwt__placeholder-svg' }}
        </div>
      {%- endif -%}
    </div>

    <div class="sh-iwt__content" style="text-align: {{ section.settings.text_align }};">
      {%- if section.settings.eyebrow != blank -%}
        <span class="sh-iwt__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <{{ section.settings.heading_tag }} class="sh-iwt__heading">
          {{ section.settings.heading }}
        </{{ section.settings.heading_tag }}>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="sh-iwt__body">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.button_text != blank or section.settings.button2_text != blank -%}
        <div class="sh-iwt__buttons" style="justify-content: {{ section.settings.text_align }};">
          {%- if section.settings.button_text != blank -%}
            <a
              href="{{ section.settings.button_link }}"
              class="sh-iwt__btn sh-iwt__btn--{{ section.settings.button_style }}"
            >
              {{ section.settings.button_text }}
            </a>
          {%- endif -%}
          {%- if section.settings.button2_text != blank -%}
            <a
              href="{{ section.settings.button2_link }}"
              class="sh-iwt__btn sh-iwt__btn--{{ section.settings.button2_style }}"
            >
              {{ section.settings.button2_text }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SIQ - Image with Text",
  "tag": "section",
  "class": "sh-iwt-root",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "options": [
        { "value": "auto", "label": "Original" },
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "4/3", "label": "Landscape (4:3)" },
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "16/9", "label": "Wide (16:9)" }
      ],
      "default": "auto"
    },
    {
      "type": "range",
      "id": "image_roundness",
      "label": "Image Roundness",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image Width",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "About Us"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading Tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Story"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Tell your brand story here. Share what makes your products unique and why customers love them.</p>"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button Style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" },
        { "value": "ghost", "label": "Ghost" }
      ],
      "default": "solid"
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "button2_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "button2_style",
      "label": "Button Style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" },
        { "value": "ghost", "label": "Ghost" }
      ],
      "default": "outline"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Reverse Layout (Text First)",
      "default": false
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between Image and Text",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Horizontal Padding",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading Size – Mobile",
      "min": 18,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body Font Size",
      "min": 14,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "button_roundness",
      "label": "Button Roundness",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#6366f1"
    }
  ],
  "presets": [
    {
      "name": "SIQ - Image with Text"
    }
  ]
}
{% endschema %}

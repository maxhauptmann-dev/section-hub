      "label": "CTA link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 20,
      "max": 140,
      "step": 4,
      "default": 80,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Absolutely stunning quality. The attention to detail exceeded every expectation."
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Author name",
          "default": "Sarah M."
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role / location",
          "default": "Verified Buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SIQ - Marquee Wall",
      "blocks": [
        { "type": "review", "settings": { "stars": 5, "quote": "Absolutely stunning quality. This exceeded every expectation I had. Will definitely order again!", "name": "Sarah M.", "role": "Verified Buyer" } },
        { "type": "review", "settings": { "stars": 5, "quote": "The best investment I've made for my store this year. My customers love the new look and feel.", "name": "James K.", "role": "Store Owner" } },

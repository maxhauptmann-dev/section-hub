<style>
  {% render 'styles.css' %}
</style>

<section class="tc-section" style="
  --tc-py: {{ section.settings.padding_y | divided_by: 100.0 }}em;
  --tc-px: {{ section.settings.padding_x | divided_by: 100.0 }}em;
  --tc-gap: {{ section.settings.card_gap | divided_by: 100.0 }}em;
  --tc-avatar-size: {{ section.settings.avatar_size }}px;
  --tc-card-bg: {{ section.settings.card_bg }};
  --tc-card-radius: {{ section.settings.card_radius }}px;
  --tc-star-size: {{ section.settings.star_size }}px;
  --tc-header-size: {{ section.settings.header_font_size | divided_by: 100.0 }}em;
  --tc-name-size: {{ section.settings.name_font_size | divided_by: 100.0 }}em;
  --tc-text-size: {{ section.settings.text_font_size | divided_by: 100.0 }}em;
  --tc-rating-size: {{ section.settings.rating_font_size | divided_by: 100.0 }}em;
">
  <div class="tc-container">
    <!-- Header mit Gesamtbewertung -->
    {%- if section.settings.show_header -%}
      <div class="tc-header">
        <h2 class="tc-header-title">{{ section.settings.header_text }}</h2>
        <div class="tc-overall-rating">
          <div class="tc-stars">
            {%- assign full_stars = section.settings.overall_rating | floor -%}
            {%- assign has_half = section.settings.overall_rating | modulo: 1 -%}
            {%- assign next_star = full_stars | plus: 1 -%}
            {%- for i in (1..5) -%}
              {%- if i <= full_stars -%}
                <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {%- elsif i == next_star and has_half > 0 -%}
                <svg viewBox="0 0 24 24"><defs><linearGradient id="tc-half"><stop offset="50%" stop-color="currentColor"/><stop offset="50%" stop-color="transparent"/></linearGradient></defs><path fill="url(#tc-half)" stroke="currentColor" stroke-width="1" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <span class="tc-rating-value">{{ section.settings.overall_rating }}</span>
          <span class="tc-rating-count">{{ section.settings.rating_count_text }}</span>
        </div>
      </div>
    {%- endif -%}

    <!-- Carousel -->
    <div class="tc-carousel-wrapper">
      <div class="tc-carousel" id="tcCarousel">
        {%- for block in section.blocks -%}
          <div class="tc-card" {{ block.shopify_attributes }}>
            <!-- Customer Info mit Avatar -->
            <div class="tc-customer">
              {%- if block.settings.avatar != blank -%}
                <img src="{{ block.settings.avatar | image_url: width: 120 }}" alt="{{ block.settings.name }}" class="tc-avatar" loading="lazy">
              {%- else -%}
                <div class="tc-avatar" style="background-color: #e0e0e0; display: flex; align-items: center; justify-content: center; color: #999; font-size: 24px;">👤</div>
              {%- endif -%}
              <div class="tc-customer-info">
                <div class="tc-customer-name">{{ block.settings.name }}</div>
                {%- if block.settings.show_verified -%}
                  <div class="tc-verified-badge">
                    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                    {{ block.settings.verified_text }}
                  </div>
                {%- endif -%}
              </div>
            </div>

            <!-- Star Rating -->
            <div class="tc-rating">
              {%- assign full_stars = block.settings.rating | floor -%}
              {%- assign has_half = block.settings.rating | modulo: 1 -%}
              {%- assign next_star = full_stars | plus: 1 -%}
              {%- for i in (1..5) -%}
                {%- if i <= full_stars -%}
                  <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                {%- elsif i == next_star and has_half > 0 -%}
                  <svg viewBox="0 0 24 24"><defs><linearGradient id="tc-half-{{ block.id }}"><stop offset="50%" stop-color="currentColor"/><stop offset="50%" stop-color="transparent"/></linearGradient></defs><path fill="url(#tc-half-{{ block.id }})" stroke="currentColor" stroke-width="1" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                {%- endif -%}
              {%- endfor -%}
            </div>

            <!-- Testimonial Text -->
            <p class="tc-text">{{ block.settings.text }}</p>

            <!-- Datum -->
            {%- if block.settings.date != blank -%}
              <div class="tc-date">{{ block.settings.date }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      <!-- Navigation Buttons -->
      {%- if section.settings.show_nav_buttons -%}
        <button class="tc-nav-button tc-prev" aria-label="Previous testimonial" onclick="tcScroll(-340)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button class="tc-nav-button tc-next" aria-label="Next testimonial" onclick="tcScroll(340)">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      {%- endif -%}

      <!-- Pause/Play Button (für Autoplay) -->
      {%- if section.settings.autoplay -%}
        <button class="tc-pause-btn" id="tcPauseBtn" onclick="tcToggleAutoplay()">
          <svg viewBox="0 0 24 24" fill="currentColor" id="tcPauseIcon"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
          <span id="tcPauseText">{{ section.settings.pause_text }}</span>
        </button>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  const tcCarouselEl = document.getElementById('tcCarousel');
  let tcAutoplayInterval = null;
  let tcIsAutoplayEnabled = {{ section.settings.autoplay | json }};

  function tcScroll(distance) {
    if (tcCarouselEl) {
      tcCarouselEl.scrollBy({
        left: distance,
        behavior: 'smooth'
      });
    }
  }

  function tcToggleAutoplay() {
    tcIsAutoplayEnabled = !tcIsAutoplayEnabled;
    const pauseBtn = document.getElementById('tcPauseBtn');
    const pauseIcon = document.getElementById('tcPauseIcon');
    const pauseText = document.getElementById('tcPauseText');

    if (tcIsAutoplayEnabled) {
      pauseIcon.innerHTML = '<rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>';
      pauseText.textContent = '{{ section.settings.pause_text }}';
      tcStartAutoplay();
    } else {
      pauseIcon.innerHTML = '<polygon points="5 3 19 12 5 21 5 3"/>';
      pauseText.textContent = '{{ section.settings.play_text }}';
      clearInterval(tcAutoplayInterval);
    }
  }

  function tcStartAutoplay() {
    const speed = {{ section.settings.autoplay_speed | default: 5000 }};
    clearInterval(tcAutoplayInterval);
    tcAutoplayInterval = setInterval(() => {
      if (tcIsAutoplayEnabled && tcCarouselEl) {
        tcScroll(340);
      }
    }, speed);
  }

  // Start autoplay on page load
  if (tcIsAutoplayEnabled) {
    document.addEventListener('DOMContentLoaded', tcStartAutoplay);
  }

  // Pause autoplay on scroll interaction
  if (tcCarouselEl) {
    tcCarouselEl.addEventListener('mouseenter', () => {
      if (tcAutoplayInterval) clearInterval(tcAutoplayInterval);
    });
    tcCarouselEl.addEventListener('mouseleave', () => {
      if (tcIsAutoplayEnabled) tcStartAutoplay();
    });
  }
</script>


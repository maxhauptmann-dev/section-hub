  ],
  "presets": [
    {
      "name": "SS - Upsell Bar",
      "settings": {
        "eyebrow": "Recommended",
        "heading": "Complete Your Look",
        "subtext": "Handpicked to complement your purchase.",
        "layout_direction": "left",
        "show_vendor": true,
        "show_price": true,
        "show_badge": true,
        "show_trust": true,
        "btn_text": "Add to Cart",
        "urgency_text": "Selling fast — limited stock"
      },
      "blocks": [
        {
          "type": "product_card",
          "settings": {
            "label_text": "Pairs perfectly with your order",
            "description": "Add this bestseller to your cart and save."
          }
        }
      ]
    }
  ]
}
{% endschema %}

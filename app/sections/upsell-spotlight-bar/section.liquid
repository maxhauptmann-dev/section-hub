        {
          "type": "text",
          "id": "label_text",
          "label": "Label above title",
          "default": "Pairs perfectly with your order"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short description",
          "default": "Add this bestseller to your cart and save."
        }
      ]

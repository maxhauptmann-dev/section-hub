{% comment %}
  SectionHub – Upsell Spotlight Bar  (usb-)
  Elegant horizontal upsell bar with single product focus
{% endcomment %}

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font    = section.settings.body_font
  assign layout_dir   = section.settings.layout_direction
-%}

<style>
  {{ heading_font | font_face }}
  {{ body_font | font_face }}

  #usb-{{ section.id }} {
    --usb-bg: {{ section.settings.bg_color }};
    --usb-heading-c: {{ section.settings.heading_color }};
    --usb-text-c: {{ section.settings.text_color }};
    --usb-accent: {{ section.settings.accent_color }};
    --usb-card-bg: {{ section.settings.card_bg }};
    --usb-badge-bg: {{ section.settings.badge_color }};
    --usb-btn-bg: {{ section.settings.btn_bg }};
    --usb-btn-c: {{ section.settings.btn_color }};
    --usb-heading-ff: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --usb-heading-fw: {{ heading_font.weight }};
    --usb-heading-fs: {{ heading_font.style }};
    --usb-body-ff: {{ body_font.family }}, {{ body_font.fallback_families }};
    --usb-body-fw: {{ body_font.weight }};
    --usb-radius: {{ section.settings.card_radius }}px;
    --usb-py: {{ section.settings.padding_top }}px;
    --usb-pb: {{ section.settings.padding_bottom }}px;
    --usb-px: {{ section.settings.padding_sides }}px;
    --usb-max-w: {{ section.settings.max_width }}px;
    --usb-img-ratio: {{ section.settings.image_ratio }};
  }
</style>

<section id="usb-{{ section.id }}" class="usb-wrap">

  {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
    <div class="usb-header" data-usb-el>
      {%- if section.settings.eyebrow != blank -%}
        <span class="usb-header__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="usb-header__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="usb-header__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- if block.type == 'product_card' -%}
      {%- assign p = block.settings.product -%}

      <div class="usb-bar usb-bar--{{ layout_dir }}" data-usb-el {{ block.shopify_attributes }}>
        {%- comment -%} Image side {%- endcomment -%}
        <div class="usb-bar__media">
          {%- if block.settings.custom_image != blank -%}
            <img
              src="{{ block.settings.custom_image | image_url: width: 700 }}"
              alt="{{ p.title | default: 'Upsell product' | escape }}"
              loading="lazy"
              class="usb-bar__img"
            >
          {%- elsif p != blank and p.featured_image -%}
            <img
              src="{{ p.featured_image | image_url: width: 700 }}"
              alt="{{ p.featured_image.alt | default: p.title | escape }}"
              loading="lazy"
              class="usb-bar__img"
            >
          {%- else -%}
            <div class="usb-bar__placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'usb-bar__svg' }}
            </div>
          {%- endif -%}

          {%- if p != blank and p.compare_at_price > p.price and section.settings.show_badge -%}
            {%- assign save_pct = p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price -%}
            <span class="usb-badge" data-usb-badge>Save {{ save_pct }}%</span>
          {%- endif -%}
        </div>

        {%- comment -%} Info side {%- endcomment -%}
        <div class="usb-bar__info">
          {%- if block.settings.label_text != blank -%}
            <span class="usb-bar__label">{{ block.settings.label_text }}</span>
          {%- endif -%}

          {%- if p != blank -%}
            {%- if section.settings.show_vendor and p.vendor != blank -%}
              <span class="usb-bar__vendor">{{ p.vendor }}</span>
            {%- endif -%}
            <h3 class="usb-bar__title">
              <a href="{{ p.url }}">{{ p.title }}</a>
            </h3>

            {%- if section.settings.show_price -%}
              <div class="usb-bar__price">
                {%- if p.compare_at_price > p.price -%}
                  <span class="usb-bar__price-old">{{ p.compare_at_price | money }}</span>
                {%- endif -%}
                <span class="usb-bar__price-now">{{ p.price | money }}</span>
              </div>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <p class="usb-bar__desc">{{ block.settings.description }}</p>
            {%- endif -%}

            {%- if section.settings.urgency_text != blank -%}
              <div class="usb-bar__urgency">
                <span class="usb-bar__urgency-dot"></span>
                {{ section.settings.urgency_text }}
              </div>
            {%- endif -%}

            <a href="{{ p.url }}" class="usb-bar__btn">
              {{ section.settings.btn_text }}
              <span class="usb-bar__btn-arrow">→</span>
            </a>

            {%- if section.settings.show_trust -%}
              <div class="usb-bar__trust">
                <span class="usb-bar__trust-item">✓ Free Shipping</span>
                <span class="usb-bar__trust-item">✓ Easy Returns</span>
              </div>
            {%- endif -%}
          {%- else -%}
            <p class="usb-bar__empty">Select a product in the block settings.</p>
          {%- endif -%}
        </div>
      </div>

    {%- endif -%}
  {%- endfor -%}

</section>

<script>
(function(){
  var w = document.getElementById('usb-{{ section.id }}');
  if (!w) return;
  var obs = new IntersectionObserver(function(es){
    es.forEach(function(e){
      if (e.isIntersecting){ e.target.classList.add('usb-visible'); obs.unobserve(e.target); }
    });
  }, { threshold: 0.12 });
  w.querySelectorAll('[data-usb-el]').forEach(function(el){ obs.observe(el); });
})();
</script>

{% schema %}
{
  "name": "Upsell Spotlight Bar",
  "tag": "section",
  "class": "usb-section",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Recommended"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complete Your Look"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Handpicked to complement your purchase."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_direction",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Image Left" },
        { "value": "right", "label": "Image Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1 / 1", "label": "Square 1:1" },
        { "value": "4 / 5", "label": "Portrait 4:5" },
        { "value": "3 / 4", "label": "Portrait 3:4" },
        { "value": "4 / 3", "label": "Landscape 4:3" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 800,
      "max": 1400,
      "step": 20,
      "default": 1060,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Product Details"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show savings badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust",
      "label": "Show trust indicators",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button text",
      "default": "Add to Cart"
    },
    {
      "type": "text",
      "id": "urgency_text",
      "label": "Urgency text",
      "default": "Selling fast — limited stock"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "playfair_display_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "inter_n4"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#fdfaf6"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#b8864e"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge background",
      "default": "#d4453b"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button background",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 20,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_sides",
      "label": "Side padding",
      "min": 16,
      "max": 80,
      "step": 4,
      "default": 28,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Upsell Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom image (optional)"

{{ 'section-testimonial-orbit-carousel.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id
  assign bg = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign accent = section.settings.accent_color
  assign accent2 = section.settings.accent_color_2
  assign card_bg = section.settings.card_bg
  assign card_border = section.settings.card_border
  assign quote_color = section.settings.quote_color
  assign name_color = section.settings.name_color
  assign role_color = section.settings.role_color
  assign star_color = section.settings.star_color
  assign dot_color = section.settings.dot_color
  assign max_w = section.settings.max_width
  assign pad_y = section.settings.padding_y
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom
  assign q_size = section.settings.quote_size
  assign radius = section.settings.border_radius
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign heading_align = section.settings.heading_align
  assign show_stars = section.settings.show_stars
  assign show_role = section.settings.show_role
  assign show_photo = section.settings.show_photo
  assign autoplay = section.settings.autoplay
  assign speed = section.settings.autoplay_speed
  assign show_glow = section.settings.show_glow
  assign total = section.blocks.size
-%}

<div
  id="to-orbit-{{ sid }}"
  class="to-orbit"
  data-autoplay="{{ autoplay }}"
  data-speed="{{ speed }}"
  data-total="{{ total }}"
  style="
    --to-bg:{{ bg }};
    --to-text:{{ text_color }};
    --to-accent:{{ accent }};
    --to-accent2:{{ accent2 }};
    --to-card-bg:{{ card_bg }};
    --to-card-border:{{ card_border }};
    --to-quote:{{ quote_color }};
    --to-name:{{ name_color }};
    --to-role:{{ role_color }};
    --to-star:{{ star_color }};
    --to-dot:{{ dot_color }};
    --to-max-w:{{ max_w }}px;
    --to-pad-y:{{ pad_y }}px;
    --to-mt:{{ mt }}px;
    --to-mb:{{ mb }}px;
    --to-q-size:{{ q_size }}px;
    --to-radius:{{ radius }}px;
    --to-total:{{ total }};
  "
>
  <div class="to-orbit__inner">
    {%- if heading != blank or subheading != blank -%}
      <div class="to-orbit__header" style="text-align:{{ heading_align }}">
        {%- if heading != blank -%}
          <h2 class="to-orbit__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="to-orbit__sub">{{ subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="to-orbit__stage">
      {%- if show_glow -%}
        <div class="to-orbit__glow"></div>
      {%- endif -%}

      <div class="to-orbit__track">
        {%- for block in section.blocks -%}
          {%- liquid
            assign rating = block.settings.rating
            assign name = block.settings.name
            assign role = block.settings.role
            assign quote = block.settings.quote
            assign photo = block.settings.photo
          -%}
          <div
            class="to-orbit__card{% if forloop.index0 == 0 %} to-orbit__card--active{% endif %}"
            data-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >
            <div class="to-orbit__card-inner">
              {%- if show_stars -%}
                <div class="to-orbit__stars" aria-label="{{ rating }} out of 5 stars">
                  {%- for i in (1..5) -%}
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="{% if i <= rating %}var(--to-star){% else %}none{% endif %}" stroke="var(--to-star)" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  {%- endfor -%}
                </div>
              {%- endif -%}

              <blockquote class="to-orbit__quote">{{ quote }}</blockquote>

              <div class="to-orbit__author">
                {%- if show_photo -%}
                  {%- if photo != blank -%}
                    <img class="to-orbit__avatar" src="{{ photo | image_url: width: 96 }}" alt="{{ name | escape }}" width="48" height="48" loading="lazy">
                  {%- else -%}
                    <span class="to-orbit__avatar-ph">{{ name | slice: 0, 1 }}</span>
                  {%- endif -%}
                {%- endif -%}
                <div>
                  <span class="to-orbit__name">{{ name }}</span>
                  {%- if show_role and role != blank -%}
                    <span class="to-orbit__role">{{ role }}</span>
                  {%- endif -%}
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <!-- Navigation -->
      <button class="to-orbit__arrow to-orbit__arrow--prev" aria-label="Previous testimonial" type="button">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button class="to-orbit__arrow to-orbit__arrow--next" aria-label="Next testimonial" type="button">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>

    <!-- Dots -->
    <div class="to-orbit__dots">
      {%- for block in section.blocks -%}
        <button class="to-orbit__dot{% if forloop.index0 == 0 %} to-orbit__dot--active{% endif %}" data-goto="{{ forloop.index0 }}" aria-label="Go to review {{ forloop.index }}" type="button"></button>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
(function(){
  const el = document.getElementById('to-orbit-{{ sid }}');
  if(!el) return;
  const total = parseInt(el.dataset.total) || 0;
  if(total < 1) return;
  let cur = 0;
  let timer = null;
  const cards = el.querySelectorAll('.to-orbit__card');
  const dots  = el.querySelectorAll('.to-orbit__dot');
  const autoplay = el.dataset.autoplay === 'true';
  const speed = (parseInt(el.dataset.speed) || 5) * 1000;

  function goTo(n){
    cur = ((n % total) + total) % total;
    cards.forEach(function(c, i){
      c.classList.toggle('to-orbit__card--active', i === cur);
      c.classList.toggle('to-orbit__card--prev', i === ((cur - 1 + total) % total));
      c.classList.toggle('to-orbit__card--next', i === ((cur + 1) % total));
      if(i !== cur && i !== ((cur - 1 + total) % total) && i !== ((cur + 1) % total)){
        c.classList.add('to-orbit__card--hidden');
      } else {
        c.classList.remove('to-orbit__card--hidden');
      }
    });
    dots.forEach(function(d, i){ d.classList.toggle('to-orbit__dot--active', i === cur); });
  }

  function next(){ goTo(cur + 1); }
  function prev(){ goTo(cur - 1); }

  function startAP(){ if(autoplay){ timer = setInterval(next, speed); } }
  function stopAP(){ clearInterval(timer); }

  el.querySelector('.to-orbit__arrow--next').addEventListener('click', function(){ stopAP(); next(); startAP(); });
  el.querySelector('.to-orbit__arrow--prev').addEventListener('click', function(){ stopAP(); prev(); startAP(); });
  dots.forEach(function(d){
    d.addEventListener('click', function(){ stopAP(); goTo(parseInt(d.dataset.goto)); startAP(); });
  });

  el.addEventListener('mouseenter', stopAP);
  el.addEventListener('mouseleave', startAP);

  goTo(0);
  startAP();
})();
</script>


{{ 'section-faq-search-timeline.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id
  assign bg = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign accent = section.settings.accent_color
  assign accent2 = section.settings.accent_end
  assign line_color = section.settings.line_color
  assign card_bg = section.settings.card_bg
  assign card_border = section.settings.card_border
  assign answer_color = section.settings.answer_color
  assign search_bg = section.settings.search_bg
  assign search_text = section.settings.search_text
  assign num_bg = section.settings.number_bg
  assign num_text = section.settings.number_text
  assign max_w = section.settings.max_width
  assign pad_y = section.settings.padding_y
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom
  assign q_size = section.settings.question_size
  assign a_size = section.settings.answer_size
  assign radius = section.settings.border_radius
  assign show_search = section.settings.show_search
  assign show_numbers = section.settings.show_numbers
  assign show_line = section.settings.show_timeline_line
  assign open_first = section.settings.open_first
  assign show_icon = section.settings.show_toggle_icon
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign search_placeholder = section.settings.search_placeholder
  assign line_style = section.settings.line_style
  assign card_shadow = section.settings.card_shadow
  assign heading_align = section.settings.heading_align
-%}

<div
  id="faq-st-{{ sid }}"
  class="faq-st"
  style="
    --faq-st-bg: {{ bg }};
    --faq-st-text: {{ text_color }};
    --faq-st-accent: {{ accent }};
    --faq-st-accent2: {{ accent2 }};
    --faq-st-line: {{ line_color }};
    --faq-st-card-bg: {{ card_bg }};
    --faq-st-card-border: {{ card_border }};
    --faq-st-answer: {{ answer_color }};
    --faq-st-search-bg: {{ search_bg }};
    --faq-st-search-text: {{ search_text }};
    --faq-st-num-bg: {{ num_bg }};
    --faq-st-num-text: {{ num_text }};
    --faq-st-max-w: {{ max_w }}px;
    --faq-st-pad-y: {{ pad_y }}px;
    --faq-st-mt: {{ mt }}px;
    --faq-st-mb: {{ mb }}px;
    --faq-st-q-size: {{ q_size }}px;
    --faq-st-a-size: {{ a_size }}px;
    --faq-st-radius: {{ radius }}px;
  "
>
  <div class="faq-st__inner">
    {%- if heading != blank or subheading != blank -%}
      <div class="faq-st__header" style="text-align:{{ heading_align }}">
        {%- if heading != blank -%}
          <h2 class="faq-st__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="faq-st__subheading">{{ subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if show_search -%}
      <div class="faq-st__search-wrap">
        <div class="faq-st__search-box">
          <svg class="faq-st__search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input
            type="text"
            class="faq-st__search-input"
            placeholder="{{ search_placeholder }}"
            aria-label="{{ search_placeholder }}"
            data-faq-search="{{ sid }}"
          >
          <button class="faq-st__search-clear" data-faq-clear="{{ sid }}" aria-label="Clear search" style="display:none">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
        <p class="faq-st__no-results" data-faq-noresults="{{ sid }}" style="display:none">No matching questions found.</p>
      </div>
    {%- endif -%}

    <div class="faq-st__timeline{% if show_line %} faq-st__timeline--line{% endif %}{% if line_style == 'dashed' %} faq-st__timeline--dashed{% endif %}{% if line_style == 'dotted' %} faq-st__timeline--dotted{% endif %}">
      {%- assign idx = 0 -%}
      {%- for block in section.blocks -%}
        {%- assign idx = idx | plus: 1 -%}
        {%- liquid
          assign q = block.settings.question
          assign a = block.settings.answer
          assign is_open = false
          if open_first and idx == 1
            assign is_open = true
          endif
        -%}
        <div
          class="faq-st__item{% if card_shadow %} faq-st__item--shadow{% endif %}"
          data-faq-item="{{ sid }}"
          data-question="{{ q | downcase | escape }}"
          data-answer="{{ a | downcase | strip_html | escape }}"
          {{ block.shopify_attributes }}
        >
          {%- if show_numbers -%}
            <div class="faq-st__number">
              <span class="faq-st__num-circle">{{ idx }}</span>
            </div>
          {%- endif -%}
          <div class="faq-st__card">
            <button
              class="faq-st__question{% if is_open %} faq-st__question--open{% endif %}"
              aria-expanded="{{ is_open }}"
              data-faq-toggle="{{ sid }}"
            >
              <span class="faq-st__q-text">{{ q }}</span>
              {%- if show_icon -%}
                <span class="faq-st__toggle-icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                </span>
              {%- endif -%}
            </button>
            <div class="faq-st__answer" {% if is_open %}style="display:block"{% endif %}>
              <div class="faq-st__answer-inner">{{ a }}</div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
(function(){
  const sid = '{{ sid }}';
  const root = document.getElementById('faq-st-' + sid);
  if (!root) return;

  /* Accordion toggle */
  root.addEventListener('click', function(e) {
    const btn = e.target.closest('[data-faq-toggle="' + sid + '"]');
    if (!btn) return;
    const item = btn.closest('.faq-st__item');
    const answer = item.querySelector('.faq-st__answer');
    const isOpen = btn.classList.contains('faq-st__question--open');

    /* Close all others */
    root.querySelectorAll('[data-faq-toggle="' + sid + '"].faq-st__question--open').forEach(function(ob) {
      if (ob !== btn) {
        ob.classList.remove('faq-st__question--open');
        ob.setAttribute('aria-expanded', 'false');
        ob.closest('.faq-st__item').querySelector('.faq-st__answer').style.display = 'none';
      }
    });

    if (isOpen) {
      btn.classList.remove('faq-st__question--open');
      btn.setAttribute('aria-expanded', 'false');
      answer.style.display = 'none';
    } else {
      btn.classList.add('faq-st__question--open');
      btn.setAttribute('aria-expanded', 'true');
      answer.style.display = 'block';
    }
  });

  /* Search */
  const input = root.querySelector('[data-faq-search="' + sid + '"]');
  const clearBtn = root.querySelector('[data-faq-clear="' + sid + '"]');
  const noResults = root.querySelector('[data-faq-noresults="' + sid + '"]');
  if (input) {
    input.addEventListener('input', function() {
      const val = this.value.toLowerCase().trim();
      clearBtn.style.display = val ? 'flex' : 'none';
      const items = root.querySelectorAll('[data-faq-item="' + sid + '"]');
      let visible = 0;
      items.forEach(function(item) {
        const q = item.getAttribute('data-question') || '';
        const a = item.getAttribute('data-answer') || '';
        if (!val || q.indexOf(val) !== -1 || a.indexOf(val) !== -1) {
          item.style.display = '';
          visible++;
        } else {
          item.style.display = 'none';
        }
      });
      if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';
    });
    if (clearBtn) {
      clearBtn.addEventListener('click', function() {
        input.value = '';
        input.dispatchEvent(new Event('input'));
        input.focus();
      });
    }
  }
})();
</script>


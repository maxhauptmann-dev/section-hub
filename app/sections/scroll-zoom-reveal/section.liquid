{% comment %}
  Section Hub – Scroll Zoom Reveal v1.0
  Scroll-driven image zoom that starts tiny and explodes to fullscreen.
  Text layers reveal at different scroll depths.
  Prefix: szr-
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign bg = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign accent = section.settings.accent_color
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign btn_text = section.settings.btn_text
  assign btn_link = section.settings.btn_link
  assign btn_style = section.settings.btn_style
  assign image = section.settings.image
  assign overlay_color = section.settings.overlay_color
  assign overlay_op = section.settings.overlay_opacity
  assign start_scale = section.settings.start_scale
  assign start_radius = section.settings.start_radius
  assign scroll_distance = section.settings.scroll_distance
  assign show_eyebrow = section.settings.eyebrow
  assign heading_size = section.settings.heading_size
  assign show_particles = section.settings.show_particles
  assign particle_color = section.settings.particle_color
  assign show_progress = section.settings.show_progress
  assign progress_color = section.settings.progress_color
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom
-%}

{%- assign ov_r = overlay_color | color_extract: 'red' -%}
{%- assign ov_g = overlay_color | color_extract: 'green' -%}
{%- assign ov_b = overlay_color | color_extract: 'blue' -%}
{%- assign ov_a = overlay_op | divided_by: 100.0 -%}

<style>
  .szr-wrap--{{ sid }}{
    --szr-bg:{{ bg }};
    --szr-text:{{ text_color }};
    --szr-accent:{{ accent }};
    --szr-overlay:rgba({{ ov_r }},{{ ov_g }},{{ ov_b }},{{ ov_a }});
    --szr-start-scale:{{ start_scale | divided_by: 100.0 }};
    --szr-start-radius:{{ start_radius }}px;
    --szr-heading-fs:clamp(2rem,{{ heading_size }}vw,{{ heading_size | times: 2 }}rem);
    --szr-mt:{{ mt }}px;
    --szr-mb:{{ mb }}px;
    --szr-particle:{{ particle_color }};
    --szr-progress:{{ progress_color }};
  }
</style>

<section class="szr-wrap szr-wrap--{{ sid }}" data-szr data-szr-distance="{{ scroll_distance }}">
  <div class="szr-scroll" style="height:{{ scroll_distance }}vh;">
    <div class="szr-sticky">

      {%- comment -%} Image container {%- endcomment -%}
      <div class="szr-image-wrap" data-szr-image>
        {%- if image != blank -%}
          <img
            src="{{ image | image_url: width: 1920 }}"
            srcset="{{ image | image_url: width: 800 }} 800w,{{ image | image_url: width: 1200 }} 1200w,{{ image | image_url: width: 1920 }} 1920w"
            sizes="100vw"
            alt="{{ image.alt | escape }}"
            loading="eager"
            class="szr-img"
          >
        {%- else -%}
          <div class="szr-placeholder">
            <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
          </div>
        {%- endif -%}
        <div class="szr-overlay"></div>
      </div>

      {%- comment -%} Content layers {%- endcomment -%}
      <div class="szr-content" data-szr-content>
        {%- if show_eyebrow != blank -%}
          <div class="szr-eyebrow" data-szr-layer="0.3">
            <span class="szr-eyebrow-line"></span>
            {{ show_eyebrow }}
          </div>
        {%- endif -%}

        {%- if heading != blank -%}
          <h2 class="szr-heading" data-szr-layer="0.5">{{ heading }}</h2>
        {%- endif -%}

        {%- if subheading != blank -%}
          <p class="szr-sub" data-szr-layer="0.65">{{ subheading }}</p>
        {%- endif -%}

        {%- if btn_text != blank -%}
          <a href="{{ btn_link | default: '#' }}" class="szr-btn szr-btn--{{ btn_style }}" data-szr-layer="0.8">
            {{ btn_text }}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        {%- endif -%}
      </div>

      {%- comment -%} Floating particles {%- endcomment -%}
      {%- if show_particles -%}
        <div class="szr-particles" data-szr-particles>
          {%- for i in (1..15) -%}
            {%- assign px = i | times: 17 | modulo: 90 | plus: 5 -%}
            {%- assign py = i | times: 23 | modulo: 80 | plus: 10 -%}
            {%- assign sz = i | modulo: 3 | plus: 2 -%}
            {%- assign del = i | times: 400 -%}
            <span class="szr-particle" style="left:{{ px }}%;top:{{ py }}%;width:{{ sz }}px;height:{{ sz }}px;animation-delay:{{ del }}ms;"></span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} Progress ring {%- endcomment -%}
      {%- if show_progress -%}
        <div class="szr-progress-ring" data-szr-progress-ring>
          <svg viewBox="0 0 48 48">
            <circle cx="24" cy="24" r="20" fill="none" stroke="currentColor" stroke-width="2" opacity=".15"/>
            <circle cx="24" cy="24" r="20" fill="none" stroke="var(--szr-progress)" stroke-width="2.5" stroke-dasharray="125.6" stroke-dashoffset="125.6" stroke-linecap="round" data-szr-progress-circle/>
          </svg>
          <span class="szr-progress-pct" data-szr-progress-text>0%</span>
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

<script>
(function(){
  var wrap = document.querySelector('.szr-wrap--{{ sid }}');
  if(!wrap) return;

  var scrollEl = wrap.querySelector('.szr-scroll');
  var imgWrap = wrap.querySelector('[data-szr-image]');
  var content = wrap.querySelector('[data-szr-content]');
  var layers = wrap.querySelectorAll('[data-szr-layer]');
  var particles = wrap.querySelector('[data-szr-particles]');
  var progressCircle = wrap.querySelector('[data-szr-progress-circle]');
  var progressText = wrap.querySelector('[data-szr-progress-text]');

  var startScale = parseFloat(getComputedStyle(wrap).getPropertyValue('--szr-start-scale')) || 0.15;
  var startRadius = parseInt(getComputedStyle(wrap).getPropertyValue('--szr-start-radius')) || 40;

  /* On mobile, start larger so image is visible early */
  if(window.innerWidth < 600){
    startScale = Math.max(startScale, 0.3);
    startRadius = Math.min(startRadius, 24);
  }

  function update(){
    var rect = scrollEl.getBoundingClientRect();
    var total = scrollEl.offsetHeight - window.innerHeight;
    if(total <= 0) return;

    var scrolled = Math.max(0, -rect.top);
    var progress = Math.min(scrolled / total, 1);

    /* Image: scale from startScale to 1, radius from startRadius to 0 */
    var scale = startScale + (1 - startScale) * progress;
    var radius = startRadius * (1 - progress);
    imgWrap.style.transform = 'translate(-50%,-50%) scale(' + scale + ')';
    imgWrap.style.borderRadius = radius + 'px';

    /* Overlay fades in after 60% */
    var overlayEl = imgWrap.querySelector('.szr-overlay');
    if(overlayEl){
      var overlayProgress = Math.max(0, (progress - 0.6) / 0.4);
      overlayEl.style.opacity = overlayProgress;
    }

    /* Content layers: each appears at its threshold */
    layers.forEach(function(layer){
      var threshold = parseFloat(layer.dataset.szrLayer) || 0.5;
      var layerProgress = Math.max(0, Math.min(1, (progress - threshold) / 0.2));
      layer.style.opacity = layerProgress;
      layer.style.transform = 'translateY(' + (30 * (1 - layerProgress)) + 'px)';
    });

    /* Particles spread out */
    if(particles){
      particles.style.opacity = Math.min(progress * 2, 1) * 0.6;
      particles.style.transform = 'scale(' + (0.5 + progress * 0.8) + ')';
    }

    /* Progress ring */
    if(progressCircle){
      var dashOffset = 125.6 * (1 - progress);
      progressCircle.style.strokeDashoffset = dashOffset;
    }
    if(progressText){
      progressText.textContent = Math.round(progress * 100) + '%';
    }
  }

  window.addEventListener('scroll', function(){ requestAnimationFrame(update); }, {passive:true});
  update();
})();
</script>

{% schema %}
{
  "name": "SIQ - Zoom Reveal",
  "tag": "section",
  "class": "section-scroll-zoom-reveal",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 45,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Zoom Effect"
    },
    {
      "type": "range",
      "id": "start_scale",
      "label": "Start size",
      "min": 5,
      "max": 50,
      "step": 5,
      "default": 15,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "start_radius",
      "label": "Start corner radius",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "scroll_distance",
      "label": "Scroll distance",
      "min": 200,
      "max": 500,
      "step": 25,
      "default": 350,
      "unit": "vh"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New Collection 2026"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover the Extraordinary"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (vw)",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 5,
      "unit": "vw"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Where craftsmanship meets innovation. Every detail, every stitch, every moment — designed to leave a lasting impression."
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button text",
      "default": "Explore Now"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "btn_style",
      "label": "Button style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "solid"
    },
    {
      "type": "header",
      "content": "Effects"
    },
    {
      "type": "checkbox",
      "id": "show_particles",
      "label": "Floating particles",
      "default": true
    },
    {
      "type": "color",
      "id": "particle_color",
      "label": "Particle color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_progress",
      "label": "Progress ring",
      "default": true
    },
    {
      "type": "color",
      "id": "progress_color",
      "label": "Progress ring color",
      "default": "#6366f1"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#6366f1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "SIQ - Zoom Reveal"
    }
  ]
}
{% endschema %}

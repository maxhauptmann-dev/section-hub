{% comment %}
  Section Hub – Header Aurora v1.0
  Stunning header with animated aurora gradient border, full-screen overlay navigation,
  gradient mesh background, and scroll-reactive effects.
{% endcomment %}

{%- liquid
  assign logo            = section.settings.logo
  assign logo_mobile     = section.settings.logo_mobile
  assign logo_width      = section.settings.logo_width
  assign logo_width_m    = section.settings.logo_width_mobile
  assign layout_mode     = section.settings.layout_mode
  assign shop_font       = section.settings.shop_name_font
  assign shop_size       = section.settings.shop_name_size
  assign shop_size_m     = section.settings.shop_name_size_mobile
  assign shop_line_h     = section.settings.shop_name_line_height
  assign shop_transform  = section.settings.shop_name_transform

  assign menu_mode       = section.settings.menu_mode
  assign mobile_menu     = section.settings.mobile_menu
  assign mega_col_gap    = section.settings.mega_column_gap
  assign mega_list_gap   = section.settings.mega_list_gap
  assign mega_list_mt    = section.settings.mega_list_margin_top
  assign mega_round      = section.settings.mega_roundness

  assign menu_font       = section.settings.menu_font
  assign menu_font_size  = section.settings.menu_font_size
  assign menu_line_h     = section.settings.menu_line_height
  assign menu_transform  = section.settings.menu_text_transform
  assign menu_spacing    = section.settings.menu_letter_spacing

  assign overlay_font_size = section.settings.overlay_font_size
  assign overlay_font_size_m = section.settings.overlay_font_size_mobile

  assign burger_size     = section.settings.burger_size
  assign mobile_heading  = section.settings.mobile_menu_heading

  assign right_gap       = section.settings.right_gap
  assign right_gap_m     = section.settings.right_gap_mobile
  assign right_icon_size = section.settings.right_icon_size
  assign right_icon_size_m = section.settings.right_icon_size_mobile

  assign show_search     = section.settings.use_search
  assign search_text     = section.settings.search_text
  assign search_icon_desk = section.settings.search_icon_desktop
  assign search_to_burger = section.settings.search_to_burger

  assign show_account    = section.settings.use_account
  assign account_text    = section.settings.account_text
  assign account_icon_desk = section.settings.account_icon_desktop
  assign account_to_burger = section.settings.account_to_burger

  assign show_cart       = section.settings.use_cart
  assign cart_text       = section.settings.cart_text
  assign cart_icon_desk  = section.settings.cart_icon_desktop

  assign show_btn        = section.settings.use_button
  assign btn_text        = section.settings.button_label
  assign btn_link        = section.settings.button_link
  assign btn_new_tab     = section.settings.button_new_tab
  assign btn_style       = section.settings.button_style
  assign btn_full_mobile = section.settings.button_full_mobile
  assign btn_font_size   = section.settings.button_font_size
  assign btn_font_size_m = section.settings.button_font_size_mobile
  assign btn_round       = section.settings.button_roundness
  assign btn_border_w    = section.settings.button_border_thickness
  assign btn_glow        = section.settings.button_glow

  assign use_aurora      = section.settings.use_aurora_border
  assign aurora_c1       = section.settings.aurora_color_1
  assign aurora_c2       = section.settings.aurora_color_2
  assign aurora_c3       = section.settings.aurora_color_3
  assign aurora_c4       = section.settings.aurora_color_4
  assign aurora_speed    = section.settings.aurora_speed
  assign aurora_size     = section.settings.aurora_border_size
  assign aurora_intensity = section.settings.aurora_intensity

  assign use_mesh        = section.settings.use_mesh_bg
  assign mesh_c1         = section.settings.mesh_color_1
  assign mesh_c2         = section.settings.mesh_color_2
  assign mesh_c3         = section.settings.mesh_color_3
  assign mesh_opacity    = section.settings.mesh_opacity

  assign scroll_blur     = section.settings.scroll_blur

  assign link_color      = section.settings.link_color
  assign link_hover      = section.settings.link_hover_color
  assign submenu_link    = section.settings.submenu_link_color
  assign submenu_hover   = section.settings.submenu_link_hover
  assign submenu_bg      = section.settings.submenu_bg
  assign submenu_heading_c = section.settings.submenu_heading_color
  assign mobile_h_color  = section.settings.mobile_heading_color
  assign mobile_divider  = section.settings.mobile_divider_color
  assign overlay_bg      = section.settings.overlay_bg
  assign overlay_link    = section.settings.overlay_link_color
  assign overlay_hover   = section.settings.overlay_link_hover

  assign shop_color      = section.settings.shop_name_color
  assign shop_hover      = section.settings.shop_name_hover

  assign right_link_color = section.settings.right_link_color
  assign right_link_hover = section.settings.right_link_hover

  assign btn_text_color  = section.settings.button_text_color
  assign btn_text_hover  = section.settings.button_text_hover
  assign btn_bg          = section.settings.button_bg
  assign btn_bg_hover    = section.settings.button_bg_hover
  assign btn_border      = section.settings.button_border_color
  assign btn_border_hover = section.settings.button_border_hover
  assign btn_glow_color  = section.settings.button_glow_color

  assign badge_bg        = section.settings.cart_badge_bg
  assign badge_color     = section.settings.cart_badge_color

  assign bg_color        = section.settings.section_bg
  assign border_color    = section.settings.section_border

  assign margin_top      = section.settings.margin_top
  assign margin_sides    = section.settings.margin_sides
  assign margin_sides_m  = section.settings.margin_sides_mobile
  assign padding_top     = section.settings.padding_top
  assign padding_bottom  = section.settings.padding_bottom
  assign padding_sides   = section.settings.padding_sides
  assign padding_sides_m = section.settings.padding_sides_mobile

  assign section_width   = section.settings.section_width
  assign custom_width    = section.settings.custom_width
  assign border_thick    = section.settings.border_thickness
  assign section_round   = section.settings.section_roundness

  assign scroll_mode     = section.settings.reveal_menu
  assign transparent_mode = section.settings.transparent_mode
  assign custom_css      = section.settings.custom_css
-%}

<style>
  #shau-{{ section.id }} {
    --shau-logo-w: {{ logo_width }}px;
    --shau-logo-w-m: {{ logo_width_m }}px;
    --shau-shop-size: {{ shop_size }}px;
    --shau-shop-size-m: {{ shop_size_m }}px;
    --shau-shop-line-h: {{ shop_line_h }};
    --shau-shop-weight: {{ shop_font.weight }};
    --shau-shop-color: {{ shop_color }};
    --shau-shop-hover: {{ shop_hover }};

    --shau-mega-col-gap: {{ mega_col_gap }}px;
    --shau-mega-list-gap: {{ mega_list_gap }}px;
    --shau-mega-list-mt: {{ mega_list_mt }}px;
    --shau-mega-round: {{ mega_round }}px;

    --shau-menu-size: {{ menu_font_size }}px;
    --shau-menu-weight: {{ menu_font.weight }};
    --shau-menu-line-h: {{ menu_line_h }};
    --shau-menu-spacing: {{ menu_spacing }}em;

    --shau-overlay-size: {{ overlay_font_size }}px;
    --shau-overlay-size-m: {{ overlay_font_size_m }}px;

    --shau-burger-size: {{ burger_size }}px;

    --shau-right-gap: {{ right_gap }}px;
    --shau-right-gap-m: {{ right_gap_m }}px;
    --shau-right-icon: {{ right_icon_size }}px;
    --shau-right-icon-m: {{ right_icon_size_m }}px;

    --shau-btn-size: {{ btn_font_size }}px;
    --shau-btn-size-m: {{ btn_font_size_m }}px;
    --shau-btn-round: {{ btn_round }}px;
    --shau-btn-border-w: {{ btn_border_w }}px;

    --shau-aurora-c1: {{ aurora_c1 }};
    --shau-aurora-c2: {{ aurora_c2 }};
    --shau-aurora-c3: {{ aurora_c3 }};
    --shau-aurora-c4: {{ aurora_c4 }};
    --shau-aurora-speed: {{ aurora_speed }}s;
    --shau-aurora-size: {{ aurora_size }}px;
    --shau-aurora-intensity: {{ aurora_intensity | divided_by: 100.0 }};

    --shau-mesh-c1: {{ mesh_c1 }};
    --shau-mesh-c2: {{ mesh_c2 }};
    --shau-mesh-c3: {{ mesh_c3 }};
    --shau-mesh-opacity: {{ mesh_opacity | divided_by: 100.0 }};

    --shau-link-color: {{ link_color }};
    --shau-link-hover: {{ link_hover }};
    --shau-submenu-link: {{ submenu_link }};
    --shau-submenu-hover: {{ submenu_hover }};
    --shau-submenu-bg: {{ submenu_bg }};
    --shau-submenu-heading: {{ submenu_heading_c }};
    --shau-mobile-h-color: {{ mobile_h_color }};
    --shau-mobile-divider: {{ mobile_divider }};
    --shau-overlay-bg: {{ overlay_bg }};
    --shau-overlay-link: {{ overlay_link }};
    --shau-overlay-hover: {{ overlay_hover }};

    --shau-right-link: {{ right_link_color }};
    --shau-right-hover: {{ right_link_hover }};

    --shau-btn-text: {{ btn_text_color }};
    --shau-btn-text-hover: {{ btn_text_hover }};
    --shau-btn-bg: {{ btn_bg }};
    --shau-btn-bg-hover: {{ btn_bg_hover }};
    --shau-btn-border: {{ btn_border }};
    --shau-btn-border-hover: {{ btn_border_hover }};
    --shau-btn-glow: {{ btn_glow_color }};

    --shau-badge-bg: {{ badge_bg }};
    --shau-badge-color: {{ badge_color }};

    --shau-bg: {{ bg_color }};
    --shau-border: {{ border_color }};
    --shau-border-w: {{ border_thick }}px;
    --shau-round: {{ section_round }}px;

    --shau-mt: {{ margin_top }}px;
    --shau-mx: {{ margin_sides }}px;
    --shau-mx-m: {{ margin_sides_m }}px;
    --shau-pt: {{ padding_top }}px;
    --shau-pb: {{ padding_bottom }}px;
    --shau-px: {{ padding_sides }}px;
    --shau-px-m: {{ padding_sides_m }}px;

    {% case section_width %}
      {% when 'page' %}
        --shau-width: min(1200px, 100%);
      {% when 'full' %}
        --shau-width: 100%;
      {% when 'custom' %}
        --shau-width: {{ custom_width }}px;
    {% endcase %}
  }

  {{ shop_font | font_face: font_display: 'swap' }}
  {{ menu_font | font_face: font_display: 'swap' }}

  #shau-{{ section.id }} .shau-logo__text {
    font-family: {{ shop_font.family }}, {{ shop_font.fallback_families }};
    font-weight: {{ shop_font.weight }};
    font-style: {{ shop_font.style }};
  }

  #shau-{{ section.id }} .shau-nav__link,
  #shau-{{ section.id }} .shau-overlay__link,
  #shau-{{ section.id }} .shau-drawer__link,
  #shau-{{ section.id }} .shau-drawer__toggle {
    font-family: {{ menu_font.family }}, {{ menu_font.fallback_families }};
    font-weight: {{ menu_font.weight }};
    font-style: {{ menu_font.style }};
  }

  {% if custom_css != blank %}{{ custom_css }}{% endif %}
</style>

{%- comment -%} Main Header {%- endcomment -%}
<header id="shau-{{ section.id }}" class="shau-header shau-header--{{ layout_mode }}{% if transparent_mode %} shau-header--transparent{% endif %}{% if use_aurora %} shau-header--aurora{% endif %}" data-shau-scroll="{{ scroll_mode }}" data-shau-blur="{{ scroll_blur }}">

  {%- if use_aurora -%}
    <div class="shau-aurora" aria-hidden="true">
      <div class="shau-aurora__glow shau-aurora__glow--1"></div>
      <div class="shau-aurora__glow shau-aurora__glow--2"></div>
      <div class="shau-aurora__glow shau-aurora__glow--3"></div>
    </div>
  {%- endif -%}

  {%- if use_mesh -%}
    <div class="shau-mesh" aria-hidden="true">
      <div class="shau-mesh__blob shau-mesh__blob--1"></div>
      <div class="shau-mesh__blob shau-mesh__blob--2"></div>
      <div class="shau-mesh__blob shau-mesh__blob--3"></div>
    </div>
  {%- endif -%}

  <div class="shau-inner">
    {%- comment -%} Logo / Shop Name {%- endcomment -%}
    <a href="/" class="shau-logo">
      {%- if logo != blank -%}
        <img
          src="{{ logo | image_url: width: 400 }}"
          alt="{{ shop.name }}"
          class="shau-logo__img shau-logo__img--desk"
          width="{{ logo_width }}"
          height="{{ logo_width | divided_by: logo.aspect_ratio }}"
          loading="eager"
        >
        {%- if logo_mobile != blank -%}
          <img
            src="{{ logo_mobile | image_url: width: 300 }}"
            alt="{{ shop.name }}"
            class="shau-logo__img shau-logo__img--mobile"
            width="{{ logo_width_m }}"
            height="{{ logo_width_m | divided_by: logo_mobile.aspect_ratio }}"
            loading="eager"
          >
        {%- endif -%}
      {%- else -%}
        <span class="shau-logo__text" style="text-transform:{{ shop_transform }}">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    {%- comment -%} Desktop Navigation (dropdown mode) {%- endcomment -%}
    {%- if menu_mode == 'dropdown' -%}
      <nav class="shau-nav">
        {%- for block in section.blocks -%}
          {%- if block.type == 'mega_menu' -%}
            {%- assign mega_text = block.settings.text -%}
            {%- assign mega_link = block.settings.link -%}
            {%- assign mega_submenu = block.settings.submenu -%}
            {%- assign mega_image = block.settings.featured_image -%}
            {%- assign mega_promo = block.settings.promo_text -%}
            <div class="shau-nav__item{% if mega_submenu != blank %} shau-nav__item--mega{% endif %}" {{ block.shopify_attributes }}>
              <a href="{{ mega_link }}" class="shau-nav__link" style="text-transform:{{ menu_transform }}">
                {{ mega_text }}
                {%- if mega_submenu != blank -%}
                  <svg class="shau-nav__chevron" width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- endif -%}
              </a>
              {%- if mega_submenu != blank -%}
                <div class="shau-mega">
                  <div class="shau-mega__inner">
                    {%- for link in linklists[mega_submenu].links -%}
                      <div class="shau-mega__col">
                        {%- if link.links.size > 0 -%}
                          <span class="shau-mega__heading">{{ link.title }}</span>
                          <ul class="shau-mega__list">
                            {%- for child in link.links -%}
                              <li><a href="{{ child.url }}" class="shau-mega__link">{{ child.title }}</a></li>
                            {%- endfor -%}
                          </ul>
                        {%- else -%}
                          <a href="{{ link.url }}" class="shau-mega__link shau-mega__link--flat">{{ link.title }}</a>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                    {%- if mega_image != blank or mega_promo != blank -%}
                      <div class="shau-mega__promo">
                        {%- if mega_image != blank -%}
                          <img src="{{ mega_image | image_url: width: 600 }}" alt="" class="shau-mega__promo-img" loading="lazy">
                        {%- endif -%}
                        {%- if mega_promo != blank -%}
                          <p class="shau-mega__promo-text">{{ mega_promo }}</p>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- comment -%} Overlay Menu Toggle (overlay mode) {%- endcomment -%}
    {%- if menu_mode == 'overlay' -%}
      <button class="shau-menu-toggle" data-shau-overlay-toggle aria-label="Menu">
        <span class="shau-menu-toggle__text" style="text-transform:{{ menu_transform }}">Menu</span>
        <span class="shau-menu-toggle__icon">
          <span></span><span></span>
        </span>
      </button>
    {%- endif -%}

    {%- comment -%} Right Actions {%- endcomment -%}
    <div class="shau-actions">
      {%- if show_search and search_icon_desk -%}
        <a href="/search" class="shau-actions__icon" aria-label="{{ search_text }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </a>
      {%- elsif show_search -%}
        <a href="/search" class="shau-actions__text-link">{{ search_text }}</a>
      {%- endif -%}

      {%- if show_account and account_icon_desk -%}
        <a href="/account" class="shau-actions__icon" aria-label="{{ account_text }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </a>
      {%- elsif show_account -%}
        <a href="/account" class="shau-actions__text-link">{{ account_text }}</a>
      {%- endif -%}

      {%- if show_cart and cart_icon_desk -%}
        <a href="/cart" class="shau-actions__icon shau-actions__cart" aria-label="{{ cart_text }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          <span class="shau-cart__badge">{{ cart.item_count }}</span>
        </a>
      {%- elsif show_cart -%}
        <a href="/cart" class="shau-actions__text-link">{{ cart_text }} ({{ cart.item_count }})</a>
      {%- endif -%}

      {%- if show_btn -%}
        <a href="{{ btn_link }}"{% if btn_new_tab %} target="_blank" rel="noopener"{% endif %} class="shau-btn shau-btn--{{ btn_style }}{% if btn_glow %} shau-btn--glow{% endif %}">
          <span>{{ btn_text }}</span>
          {%- if btn_style contains 'arrow' -%}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          {%- endif -%}
        </a>
      {%- endif -%}

      {%- comment -%} Burger (dropdown mode mobile) {%- endcomment -%}
      {%- if menu_mode == 'dropdown' -%}
        <button class="shau-burger" data-shau-burger aria-label="Menu">
          <span></span><span></span><span></span>
        </button>
      {%- endif -%}
    </div>
  </div>
</header>

{%- comment -%} Full-Screen Overlay Menu (overlay mode) {%- endcomment -%}
{%- if menu_mode == 'overlay' -%}
  <div id="shau-overlay-{{ section.id }}" class="shau-overlay">
    <div class="shau-overlay__bg" aria-hidden="true"></div>
    <div class="shau-overlay__content">
      <nav class="shau-overlay__nav">
        {%- for block in section.blocks -%}
          {%- if block.type == 'mega_menu' -%}
            {%- assign mega_text = block.settings.text -%}
            {%- assign mega_link = block.settings.link -%}
            {%- assign mega_submenu = block.settings.submenu -%}
            <div class="shau-overlay__item" {{ block.shopify_attributes }}>
              {%- if mega_submenu != blank -%}
                <button class="shau-overlay__link shau-overlay__link--has-sub" data-shau-overlay-sub>
                  {{ mega_text }}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </button>
                <div class="shau-overlay__sub">
                  <button class="shau-overlay__back" data-shau-overlay-back>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                    Back
                  </button>
                  {%- for link in linklists[mega_submenu].links -%}
                    <div class="shau-overlay__sub-group">
                      <span class="shau-overlay__sub-heading">{{ link.title }}</span>
                      {%- if link.links.size > 0 -%}
                        {%- for child in link.links -%}
                          <a href="{{ child.url }}" class="shau-overlay__sub-link">{{ child.title }}</a>
                        {%- endfor -%}
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
              {%- else -%}
                <a href="{{ mega_link }}" class="shau-overlay__link">{{ mega_text }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </nav>

      <div class="shau-overlay__footer">
        {%- if show_search -%}
          <a href="/search" class="shau-overlay__footer-link">{{ search_text }}</a>
        {%- endif -%}
        {%- if show_account -%}
          <a href="/account" class="shau-overlay__footer-link">{{ account_text }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{%- comment -%} Mobile Drawer (dropdown mode) {%- endcomment -%}
{%- if menu_mode == 'dropdown' -%}
  <div id="shau-drawer-{{ section.id }}" class="shau-drawer">
    <div class="shau-drawer__overlay" data-shau-drawer-close></div>
    <div class="shau-drawer__panel">
      <button class="shau-drawer__close" data-shau-drawer-close aria-label="Close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>

      <nav class="shau-drawer__nav">
        {%- if mobile_heading != blank -%}
          <span class="shau-drawer__heading">{{ mobile_heading }}</span>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'mega_menu' -%}
            {%- assign mega_text = block.settings.text -%}
            {%- assign mega_link = block.settings.link -%}
            {%- assign mega_submenu = block.settings.submenu -%}
            {%- if mega_submenu != blank -%}
              <div class="shau-drawer__group">
                <button class="shau-drawer__toggle" data-shau-toggle>
                  {{ mega_text }}
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                </button>
                <div class="shau-drawer__sub">
                  {%- for link in linklists[mega_submenu].links -%}
                    <a href="{{ link.url }}" class="shau-drawer__link shau-drawer__link--parent">{{ link.title }}</a>
                    {%- for child in link.links -%}
                      <a href="{{ child.url }}" class="shau-drawer__link shau-drawer__link--child">{{ child.title }}</a>
                    {%- endfor -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- else -%}
              <a href="{{ mega_link }}" class="shau-drawer__link">{{ mega_text }}</a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if mobile_menu != blank -%}
          {%- for link in linklists[mobile_menu].links -%}
            <a href="{{ link.url }}" class="shau-drawer__link">{{ link.title }}</a>
          {%- endfor -%}
        {%- endif -%}
      </nav>

      <div class="shau-drawer__footer">
        {%- if show_search and search_to_burger -%}
          <a href="/search" class="shau-drawer__flink">{{ search_text }}</a>
        {%- endif -%}
        {%- if show_account and account_to_burger -%}
          <a href="/account" class="shau-drawer__flink">{{ account_text }}</a>
        {%- endif -%}
        {%- if show_btn and btn_full_mobile -%}
          <a href="{{ btn_link }}" class="shau-btn shau-btn--{{ btn_style }} shau-btn--full">
            <span>{{ btn_text }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

<script>
(function(){
  var header = document.getElementById('shau-{{ section.id }}');
  if(!header) return;
  var mode = header.getAttribute('data-shau-scroll');
  var blurOnScroll = header.getAttribute('data-shau-blur') === 'true';

  /* ── Overlay Menu (full-screen) ── */
  var overlayEl = document.getElementById('shau-overlay-{{ section.id }}');
  var overlayToggle = header.querySelector('[data-shau-overlay-toggle]');
  if(overlayEl && overlayToggle){
    overlayToggle.addEventListener('click', function(){
      var isOpen = overlayEl.classList.toggle('shau-overlay--open');
      overlayToggle.classList.toggle('shau-menu-toggle--active', isOpen);
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });

    /* Sub menu navigation */
    var subBtns = overlayEl.querySelectorAll('[data-shau-overlay-sub]');
    var backBtns = overlayEl.querySelectorAll('[data-shau-overlay-back]');
    subBtns.forEach(function(btn){
      btn.addEventListener('click', function(){
        var sub = btn.nextElementSibling;
        if(sub) sub.classList.add('shau-overlay__sub--open');
      });
    });
    backBtns.forEach(function(btn){
      btn.addEventListener('click', function(){
        var sub = btn.closest('.shau-overlay__sub');
        if(sub) sub.classList.remove('shau-overlay__sub--open');
      });
    });
  }

  /* ── Desktop Mega Menu: click toggle (works in editor + touch) ── */
  var navItems = header.querySelectorAll('.shau-nav__item--mega');
  navItems.forEach(function(item) {
    var link = item.querySelector('.shau-nav__link');
    if (!link) return;
    link.addEventListener('click', function(e) {
      var mega = item.querySelector('.shau-mega');
      if (!mega) return;
      var isOpen = item.classList.contains('shau-nav__item--open');
      navItems.forEach(function(other) { other.classList.remove('shau-nav__item--open'); });
      if (!isOpen) {
        e.preventDefault();
        item.classList.add('shau-nav__item--open');
      }
    });
  });
  document.addEventListener('click', function(e) {
    if (!header.contains(e.target)) {
      navItems.forEach(function(item) { item.classList.remove('shau-nav__item--open'); });
    }
  });

  /* ── Drawer (dropdown mode mobile) ── */
  var burger = header.querySelector('[data-shau-burger]');
  var drawer = document.getElementById('shau-drawer-{{ section.id }}');
  if(drawer){
    var closers = drawer.querySelectorAll('[data-shau-drawer-close]');
    var toggles = drawer.querySelectorAll('[data-shau-toggle]');
    if(burger) burger.addEventListener('click', function(){
      drawer.classList.add('shau-drawer--open');
      document.body.style.overflow = 'hidden';
    });
    closers.forEach(function(c){
      c.addEventListener('click', function(){
        drawer.classList.remove('shau-drawer--open');
        document.body.style.overflow = '';
      });
    });
    toggles.forEach(function(t){
      t.addEventListener('click', function(){
        var sub = t.nextElementSibling;
        var open = sub.classList.toggle('shau-drawer__sub--open');
        t.classList.toggle('shau-drawer__toggle--open', open);
      });
    });
  }

  /* ── Scroll behavior ── */
  if(mode === 'default' || !mode){
    if(blurOnScroll) attachBlur();
    return;
  }

  function applySticky(){
    if(mode === 'always-sticky'){
      header.style.position = 'fixed';
      header.style.top = '0';
      header.style.left = '0';
      header.style.width = '100%';
      header.style.zIndex = '1000';
    }
    if(mode === 'scroll-up'){
      header.style.position = 'fixed';
      header.style.top = '0';
      header.style.left = '0';
      header.style.width = '100%';
      header.style.zIndex = '1000';
      header.style.transition = 'transform 0.3s ease';
      var lastY = 0;
      window.addEventListener('scroll', function(){
        var y = window.scrollY;
        header.style.transform = (y > lastY && y > 80) ? 'translateY(-100%)' : 'translateY(0)';
        lastY = y;
      }, { passive: true });
    }
  }

  function attachBlur(){
    window.addEventListener('scroll', function(){
      var y = window.scrollY;
      var blur = Math.min(y / 10, 20);
      var opacity = Math.min(0.6 + y / 500, 0.95);
      header.style.backdropFilter = 'blur(' + blur + 'px)';
      header.style.webkitBackdropFilter = 'blur(' + blur + 'px)';
      header.style.backgroundColor = 'rgba(255,255,255,' + opacity + ')';
    }, { passive: true });
  }

  if(blurOnScroll) attachBlur();
  requestAnimationFrame(function(){ requestAnimationFrame(applySticky); });
  document.addEventListener('DOMContentLoaded', applySticky);
  window.addEventListener('load', applySticky);
})();
</script>


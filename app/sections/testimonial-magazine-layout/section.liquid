{{ 'section-testimonial-magazine-layout.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id
  assign bg = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign accent = section.settings.accent_color
  assign rule_color = section.settings.rule_color
  assign quote_color = section.settings.quote_color
  assign name_color = section.settings.name_color
  assign role_color = section.settings.role_color
  assign dropcap_color = section.settings.dropcap_color
  assign star_color = section.settings.star_color
  assign sidebar_bg = section.settings.sidebar_bg
  assign sidebar_text = section.settings.sidebar_text
  assign max_w = section.settings.max_width
  assign pad_y = section.settings.padding_y
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom
  assign q_size = section.settings.quote_size
  assign hero_q_size = section.settings.hero_quote_size
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign heading_align = section.settings.heading_align
  assign show_stars = section.settings.show_stars
  assign show_dropcap = section.settings.show_dropcap
  assign show_dividers = section.settings.show_dividers
  assign serif_font = section.settings.serif_font
  assign blocks_size = section.blocks.size
-%}

<div
  id="tm-mag-{{ sid }}"
  class="tm-mag{% if serif_font %} tm-mag--serif{% endif %}"
  style="
    --tm-bg:{{ bg }};
    --tm-text:{{ text_color }};
    --tm-accent:{{ accent }};
    --tm-rule:{{ rule_color }};
    --tm-quote:{{ quote_color }};
    --tm-name:{{ name_color }};
    --tm-role:{{ role_color }};
    --tm-dropcap:{{ dropcap_color }};
    --tm-star:{{ star_color }};
    --tm-sidebar-bg:{{ sidebar_bg }};
    --tm-sidebar-text:{{ sidebar_text }};
    --tm-max-w:{{ max_w }}px;
    --tm-pad-y:{{ pad_y }}px;
    --tm-mt:{{ mt }}px;
    --tm-mb:{{ mb }}px;
    --tm-q-size:{{ q_size }}px;
    --tm-hero-q:{{ hero_q_size }}px;
  "
>
  <div class="tm-mag__inner">
    {%- if heading != blank or subheading != blank -%}
      <div class="tm-mag__header" style="text-align:{{ heading_align }}">
        {%- if show_dividers -%}<hr class="tm-mag__rule">{%- endif -%}
        {%- if subheading != blank -%}
          <span class="tm-mag__kicker">{{ subheading }}</span>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 class="tm-mag__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if show_dividers -%}<hr class="tm-mag__rule">{%- endif -%}
      </div>
    {%- endif -%}

    {%- if blocks_size > 0 -%}
      {%- comment -%} First block = Hero featured quote {%- endcomment -%}
      {%- assign hero = section.blocks[0] -%}
      <div class="tm-mag__hero" {{ hero.shopify_attributes }}>
        <div class="tm-mag__hero-content">
          {%- if show_dropcap -%}
            <span class="tm-mag__dropcap" aria-hidden="true">"</span>
          {%- endif -%}
          <blockquote class="tm-mag__hero-quote">{{ hero.settings.quote }}</blockquote>
          <div class="tm-mag__hero-meta">
            {%- if hero.settings.photo != blank -%}
              <img class="tm-mag__hero-avatar" src="{{ hero.settings.photo | image_url: width: 120 }}" alt="{{ hero.settings.name | escape }}" width="60" height="60" loading="lazy">
            {%- endif -%}
            <div>
              {%- if show_stars -%}
                <div class="tm-mag__stars">
                  {%- for i in (1..5) -%}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="{% if i <= hero.settings.rating %}var(--tm-star){% else %}none{% endif %}" stroke="var(--tm-star)" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  {%- endfor -%}
                </div>
              {%- endif -%}
              <span class="tm-mag__hero-name">{{ hero.settings.name }}</span>
              {%- if hero.settings.role != blank -%}
                <span class="tm-mag__hero-role">{{ hero.settings.role }}</span>
              {%- endif -%}
            </div>
          </div>
        </div>
        {%- if hero.settings.photo != blank -%}
          <div class="tm-mag__hero-photo">
            <img src="{{ hero.settings.photo | image_url: width: 480 }}" alt="{{ hero.settings.name | escape }}" width="240" loading="lazy">
          </div>
        {%- endif -%}
      </div>

      {%- if show_dividers -%}<hr class="tm-mag__rule tm-mag__rule--wide">{%- endif -%}

      {%- comment -%} Remaining blocks = Column grid {%- endcomment -%}
      {%- if blocks_size > 1 -%}
        <div class="tm-mag__grid">
          {%- for block in section.blocks -%}
            {%- if forloop.index0 == 0 -%}{%- continue -%}{%- endif -%}
            <article class="tm-mag__item" {{ block.shopify_attributes }}>
              {%- if show_dividers and forloop.index0 > 1 -%}
                <hr class="tm-mag__rule tm-mag__rule--thin">
              {%- endif -%}
              {%- if show_stars -%}
                <div class="tm-mag__stars">
                  {%- for i in (1..5) -%}
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="{% if i <= block.settings.rating %}var(--tm-star){% else %}none{% endif %}" stroke="var(--tm-star)" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  {%- endfor -%}
                </div>
              {%- endif -%}
              <blockquote class="tm-mag__item-quote">
                {%- if show_dropcap -%}
                  <span class="tm-mag__mini-dropcap" aria-hidden="true">"</span>
                {%- endif -%}
                {{ block.settings.quote }}
              </blockquote>
              <footer class="tm-mag__item-footer">
                {%- if block.settings.photo != blank -%}
                  <img class="tm-mag__item-avatar" src="{{ block.settings.photo | image_url: width: 64 }}" alt="{{ block.settings.name | escape }}" width="32" height="32" loading="lazy">
                {%- endif -%}
                <div>
                  <span class="tm-mag__item-name">{{ block.settings.name }}</span>
                  {%- if block.settings.role != blank -%}
                    <span class="tm-mag__item-role">{{ block.settings.role }}</span>
                  {%- endif -%}
                </div>
              </footer>
            </article>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SIQ - Magazine Reviews",
  "tag": "section",
  "class": "section-testimonial-magazine-layout",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What They Say"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Kicker / Subheading",
      "default": "Customer Stories"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "checkbox",
      "id": "serif_font",
      "label": "Use serif typography",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "Show star ratings",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dropcap",
      "label": "Show decorative quotes",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "label": "Show editorial dividers",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#faf8f4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading text",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#8b5e3c"
    },
    {
      "type": "color",
      "id": "rule_color",
      "label": "Divider color",
      "default": "#d4c5b0"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote text",
      "default": "#2d2d2d"
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Name color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "role_color",
      "label": "Role color",
      "default": "#8b8b8b"
    },
    {
      "type": "color",
      "id": "dropcap_color",
      "label": "Drop cap color",
      "default": "#8b5e3c"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#d4a853"
    },
    {
      "type": "color",
      "id": "sidebar_bg",
      "label": "Sidebar pull-quote bg",
      "default": "#f0ebe3"
    },
    {
      "type": "color",
      "id": "sidebar_text",
      "label": "Sidebar pull-quote text",
      "default": "#5a4a3a"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max width",
      "min": 600,
      "max": 1200,
      "step": 20,
      "default": 960,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 40,
      "max": 140,
      "step": 4,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "hero_quote_size",
      "label": "Hero quote size",
      "min": 22,
      "max": 42,
      "step": 2,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "quote_size",
      "label": "Grid quote size",
      "min": 13,
      "max": 20,
      "step": 1,
      "default": 15,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Exceptional quality and attention to detail."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Customer"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role / Title",
          "default": "Verified Buyer"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Profile photo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SIQ - Magazine Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "quote": "In a world of mass production, this brand stands apart. Every piece feels carefully considered — from the weight of the materials to the precision of each stitch. It is the kind of quality that makes you pause, hold it in your hands, and think: someone truly cared about making this perfect. That is rare, and I treasure it.",
            "name": "Victoria Ashford",
            "role": "Design Editor, Atelier Monthly",
            "rating": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "The craftsmanship speaks for itself. You can feel the difference the moment you open the packaging. This is what true luxury looks like — no logos screaming for attention, just impeccable quality.",
            "name": "Daniel Hartmann",
            "role": "Creative Director",
            "rating": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "Understated elegance at its finest. I have recommended this brand to every single person who has asked about my taste. It never fails to impress.",
            "name": "Isabelle Moreau",
            "role": "Fashion Buyer",
            "rating": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "There is an honesty to this brand that I deeply respect. No gimmicks, no over-promising. Just a beautifully made product that exceeds expectations. I am a customer for life.",
            "name": "Sebastian Clarke",
            "role": "Loyal Customer",
            "rating": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "Purchased as a gift and my mother could not stop talking about it. The presentation, the quality, the little personal touches — everything was absolutely perfect.",
            "name": "Amara Okafor",
            "role": "Verified Buyer",
            "rating": 5
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "After years of trying different brands, I have finally found my home. The consistency is remarkable — every single order matches the very first experience I had. That kind of reliability builds real trust.",
            "name": "Henrik Johansson",
            "role": "Premium Member",
            "rating": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}

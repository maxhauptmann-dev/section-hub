{{ 'section-faq-chat-bubbles.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id
  assign bg = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign chat_bg = section.settings.chat_bg
  assign chat_border = section.settings.chat_border
  assign q_bubble_bg = section.settings.q_bubble_bg
  assign q_bubble_text = section.settings.q_bubble_text
  assign a_bubble_bg = section.settings.a_bubble_bg
  assign a_bubble_text = section.settings.a_bubble_text
  assign avatar_bg = section.settings.avatar_bg
  assign avatar_text = section.settings.avatar_text
  assign time_color = section.settings.time_color
  assign typing_color = section.settings.typing_color
  assign max_w = section.settings.max_width
  assign pad_y = section.settings.padding_y
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom
  assign q_size = section.settings.question_size
  assign a_size = section.settings.answer_size
  assign radius = section.settings.border_radius
  assign bubble_radius = section.settings.bubble_radius
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign heading_align = section.settings.heading_align
  assign show_avatar = section.settings.show_avatar
  assign show_time = section.settings.show_time
  assign show_typing = section.settings.show_typing
  assign user_label = section.settings.user_label
  assign bot_label = section.settings.bot_label
  assign bot_icon = section.settings.bot_icon
  assign user_icon = section.settings.user_icon
  assign chat_shadow = section.settings.chat_shadow
  assign show_header_bar = section.settings.show_header_bar
  assign header_bg = section.settings.header_bg
  assign header_text = section.settings.header_text
-%}

<div
  id="faq-cb-{{ sid }}"
  class="faq-cb"
  style="
    --faq-cb-bg:{{ bg }};
    --faq-cb-text:{{ text_color }};
    --faq-cb-chat-bg:{{ chat_bg }};
    --faq-cb-chat-border:{{ chat_border }};
    --faq-cb-q-bg:{{ q_bubble_bg }};
    --faq-cb-q-text:{{ q_bubble_text }};
    --faq-cb-a-bg:{{ a_bubble_bg }};
    --faq-cb-a-text:{{ a_bubble_text }};
    --faq-cb-avatar-bg:{{ avatar_bg }};
    --faq-cb-avatar-text:{{ avatar_text }};
    --faq-cb-time:{{ time_color }};
    --faq-cb-typing:{{ typing_color }};
    --faq-cb-max-w:{{ max_w }}px;
    --faq-cb-pad-y:{{ pad_y }}px;
    --faq-cb-mt:{{ mt }}px;
    --faq-cb-mb:{{ mb }}px;
    --faq-cb-q-size:{{ q_size }}px;
    --faq-cb-a-size:{{ a_size }}px;
    --faq-cb-radius:{{ radius }}px;
    --faq-cb-bubble-r:{{ bubble_radius }}px;
    --faq-cb-header-bg:{{ header_bg }};
    --faq-cb-header-text:{{ header_text }};
  "
>
  <div class="faq-cb__inner">
    {%- if heading != blank or subheading != blank -%}
      <div class="faq-cb__header" style="text-align:{{ heading_align }}">
        {%- if heading != blank -%}
          <h2 class="faq-cb__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="faq-cb__sub">{{ subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="faq-cb__chat{% if chat_shadow %} faq-cb__chat--shadow{% endif %}">
      {%- if show_header_bar -%}
        <div class="faq-cb__chat-header">
          <span class="faq-cb__chat-header-icon">{{ bot_icon }}</span>
          <div class="faq-cb__chat-header-info">
            <span class="faq-cb__chat-header-name">{{ bot_label }}</span>
            <span class="faq-cb__chat-header-status">Online</span>
          </div>
          <span class="faq-cb__chat-header-dot"></span>
        </div>
      {%- endif -%}

      <div class="faq-cb__messages">
        {%- for block in section.blocks -%}
          {%- liquid
            assign q = block.settings.question
            assign a = block.settings.answer
            assign time_q = block.settings.time_question
            assign time_a = block.settings.time_answer
          -%}

          <!-- Question bubble (user - right) -->
          <div class="faq-cb__row faq-cb__row--user" data-faq-cb-row="{{ sid }}" {{ block.shopify_attributes }}>
            <div class="faq-cb__bubble-wrap faq-cb__bubble-wrap--user">
              <div class="faq-cb__bubble faq-cb__bubble--q">
                <p class="faq-cb__bubble-text">{{ q }}</p>
              </div>
              {%- if show_time and time_q != blank -%}
                <span class="faq-cb__time faq-cb__time--right">{{ time_q }}</span>
              {%- endif -%}
            </div>
            {%- if show_avatar -%}
              <span class="faq-cb__avatar faq-cb__avatar--user">{{ user_icon }}</span>
            {%- endif -%}
          </div>

          <!-- Answer bubble (bot - left) -->
          <div class="faq-cb__row faq-cb__row--bot" data-faq-cb-ans="{{ sid }}">
            {%- if show_avatar -%}
              <span class="faq-cb__avatar faq-cb__avatar--bot">{{ bot_icon }}</span>
            {%- endif -%}
            <div class="faq-cb__bubble-wrap faq-cb__bubble-wrap--bot">
              {%- if show_typing -%}
                <div class="faq-cb__typing" data-faq-cb-typing="{{ sid }}">
                  <span class="faq-cb__typing-dot"></span>
                  <span class="faq-cb__typing-dot"></span>
                  <span class="faq-cb__typing-dot"></span>
                </div>
              {%- endif -%}
              <div class="faq-cb__bubble faq-cb__bubble--a"{% if show_typing %} style="display:none" data-faq-cb-abubble="{{ sid }}"{% endif %}>
                <div class="faq-cb__bubble-text">{{ a }}</div>
              </div>
              {%- if show_time and time_a != blank -%}
                <span class="faq-cb__time faq-cb__time--left"{% if show_typing %} style="display:none" data-faq-cb-atime="{{ sid }}"{% endif %}>{{ time_a }}</span>
              {%- endif -%}
            </div>
          </div>

        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  var sid='{{ sid }}';
  var root=document.getElementById('faq-cb-'+sid);
  if(!root)return;
  var typings=root.querySelectorAll('[data-faq-cb-typing="'+sid+'"]');
  if(!typings.length)return;
  /* Show typing for 1.2s then reveal answer */
  var observer=new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(!entry.isIntersecting)return;
      var row=entry.target;
      observer.unobserve(row);
      var typing=row.querySelector('[data-faq-cb-typing="'+sid+'"]');
      var bubble=row.querySelector('[data-faq-cb-abubble="'+sid+'"]');
      var time=row.querySelector('[data-faq-cb-atime="'+sid+'"]');
      if(!typing||!bubble)return;
      typing.style.display='flex';
      setTimeout(function(){
        typing.style.display='none';
        bubble.style.display='block';
        if(time)time.style.display='block';
      },1200);
    });
  },{threshold:0.3});
  root.querySelectorAll('[data-faq-cb-ans="'+sid+'"]').forEach(function(r){
    observer.observe(r);
  });
})();
</script>


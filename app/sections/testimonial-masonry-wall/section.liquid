{{ 'section-testimonial-masonry-wall.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id
  assign bg = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign accent = section.settings.accent_color
  assign card_bg = section.settings.card_bg
  assign card_border = section.settings.card_border
  assign quote_color = section.settings.quote_color
  assign name_color = section.settings.name_color
  assign role_color = section.settings.role_color
  assign star_color = section.settings.star_color
  assign badge_bg = section.settings.badge_bg
  assign badge_text = section.settings.badge_text
  assign quote_mark_color = section.settings.quote_mark_color
  assign max_w = section.settings.max_width
  assign pad_y = section.settings.padding_y
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom
  assign q_size = section.settings.quote_size
  assign name_size = section.settings.name_size
  assign radius = section.settings.border_radius
  assign columns = section.settings.columns
  assign gap = section.settings.gap
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign heading_align = section.settings.heading_align
  assign show_stars = section.settings.show_stars
  assign show_quote_mark = section.settings.show_quote_mark
  assign show_verified = section.settings.show_verified
  assign card_shadow = section.settings.card_shadow
  assign hover_lift = section.settings.hover_lift
-%}

<div
  id="tm-wall-{{ sid }}"
  class="tm-wall"
  style="
    --tm-bg:{{ bg }};
    --tm-text:{{ text_color }};
    --tm-accent:{{ accent }};
    --tm-card-bg:{{ card_bg }};
    --tm-card-border:{{ card_border }};
    --tm-quote:{{ quote_color }};
    --tm-name:{{ name_color }};
    --tm-role:{{ role_color }};
    --tm-star:{{ star_color }};
    --tm-badge-bg:{{ badge_bg }};
    --tm-badge-text:{{ badge_text }};
    --tm-qmark:{{ quote_mark_color }};
    --tm-max-w:{{ max_w }}px;
    --tm-pad-y:{{ pad_y }}px;
    --tm-mt:{{ mt }}px;
    --tm-mb:{{ mb }}px;
    --tm-q-size:{{ q_size }}px;
    --tm-name-size:{{ name_size }}px;
    --tm-radius:{{ radius }}px;
    --tm-cols:{{ columns }};
    --tm-gap:{{ gap }}px;
  "
>
  <div class="tm-wall__inner">
    {%- if heading != blank or subheading != blank -%}
      <div class="tm-wall__header" style="text-align:{{ heading_align }}">
        {%- if heading != blank -%}
          <h2 class="tm-wall__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="tm-wall__sub">{{ subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="tm-wall__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign quote = block.settings.quote
          assign name = block.settings.name
          assign role = block.settings.role
          assign rating = block.settings.rating
          assign verified = block.settings.verified
          assign photo = block.settings.photo
          assign highlight = block.settings.highlight
        -%}
        <div
          class="tm-wall__card{% if card_shadow %} tm-wall__card--shadow{% endif %}{% if hover_lift %} tm-wall__card--lift{% endif %}{% if highlight %} tm-wall__card--highlight{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if show_quote_mark -%}
            <span class="tm-wall__qmark" aria-hidden="true">"</span>
          {%- endif -%}

          {%- if show_stars -%}
            <div class="tm-wall__stars">
              {%- for i in (1..5) -%}
                {%- if i <= rating -%}
                  <svg class="tm-wall__star" viewBox="0 0 24 24" fill="var(--tm-star)" width="18" height="18"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
                {%- else -%}
                  <svg class="tm-wall__star" viewBox="0 0 24 24" fill="none" stroke="var(--tm-star)" stroke-width="1.5" width="18" height="18"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          <p class="tm-wall__quote">{{ quote }}</p>

          <div class="tm-wall__author">
            {%- if photo != blank -%}
              <img
                class="tm-wall__avatar"
                src="{{ photo | image_url: width: 80 }}"
                alt="{{ name | escape }}"
                width="40"
                height="40"
                loading="lazy"
              >
            {%- else -%}
              <span class="tm-wall__avatar-placeholder">{{ name | slice: 0, 1 }}</span>
            {%- endif -%}
            <div class="tm-wall__author-info">
              <span class="tm-wall__name">{{ name }}</span>
              {%- if role != blank -%}
                <span class="tm-wall__role">{{ role }}</span>
              {%- endif -%}
            </div>
            {%- if show_verified and verified -%}
              <span class="tm-wall__badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                Verified
              </span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SIQ - Masonry Reviews",
  "tag": "section",
  "class": "section-testimonial-masonry-wall",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "textarea",
      "id": "subheading",

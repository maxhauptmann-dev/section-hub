{% comment %}
  Section Hub – Testimonial Video Slider
  Video testimonials with star ratings, overlay text and carousel navigation.
{% endcomment %}

{{ 'section-testimonial-video-slider.css' | asset_url | stylesheet_tag }}

<section class="tv-slider" id="tv-slider-{{ section.id }}" style="
  --tv-bg: {{ section.settings.background_color }};
  --tv-text: {{ section.settings.text_color }};
  --tv-accent: {{ section.settings.accent_color }};
  --tv-card-bg: {{ section.settings.card_background }};
  --tv-card-radius: {{ section.settings.card_radius }}px;
  --tv-star-size: {{ section.settings.star_size }}px;
  --tv-video-height: {{ section.settings.video_height }}px;
  --tv-cards-per-view: {{ section.settings.cards_per_row }};
  --tv-padding-top: {{ section.settings.padding_top }}px;
  --tv-padding-bottom: {{ section.settings.padding_bottom }}px;
">
  <div class="tv-slider__container">
    {% if section.settings.heading != blank %}
      <div class="tv-slider__header">
        {% if section.settings.subheading != blank %}
          <span class="tv-slider__subheading">{{ section.settings.subheading }}</span>
        {% endif %}
        <h2 class="tv-slider__heading">{{ section.settings.heading }}</h2>

        {% if section.settings.show_overall_rating %}
          <div class="tv-slider__overall">
            <span class="tv-slider__overall-label">{{ section.settings.overall_label }}</span>
            <div class="tv-slider__overall-stars">
              {% assign full = section.settings.overall_stars | floor %}
              {% for i in (1..5) %}
                {% if i <= full %}
                  <svg class="tv-star" viewBox="0 0 24 24" fill="var(--tv-accent)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
                {% else %}
                  <svg class="tv-star" viewBox="0 0 24 24" fill="none" stroke="var(--tv-accent)" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
                {% endif %}
              {% endfor %}
            </div>
            {% if section.settings.review_count != blank %}
              <span class="tv-slider__review-count">{{ section.settings.review_count }}</span>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="tv-slider__viewport">
      <div class="tv-slider__track" id="tv-track-{{ section.id }}" data-autoplay="{{ section.settings.autoplay_videos }}">
        {% for block in section.blocks %}
          <div class="tv-slider__card" {{ block.shopify_attributes }}>
            <div class="tv-slider__video-wrap">
              {% if block.settings.media_type == 'video' %}
                {%- comment -%} Video media: Shopify hosted, YouTube, Vimeo or external URL {%- endcomment -%}
                {% if block.settings.shopify_video != blank %}
                  {%- comment -%} Shopify hosted video — show thumbnail overlay, load video on click {%- endcomment -%}
                  {% assign sv = block.settings.shopify_video %}
                  {% if block.settings.poster != blank %}
                    {% assign thumb_url = block.settings.poster | image_url: width: 800 %}
                  {% elsif sv.preview_image != blank %}
                    {% assign thumb_url = sv.preview_image | image_url: width: 800 %}
                  {% else %}
                    {% assign thumb_url = '' %}
                  {% endif %}
                  {% if thumb_url != '' %}
                    <div class="tv-slider__thumb" data-video-type="shopify">
                      <img class="tv-slider__thumb-img" src="{{ thumb_url }}" alt="{{ block.settings.name | escape }}" loading="lazy">
                      <button class="tv-slider__play" aria-label="Play">
                        <svg width="56" height="56" viewBox="0 0 56 56" fill="none"><circle cx="28" cy="28" r="27" fill="rgba(0,0,0,0.5)" stroke="#fff" stroke-width="2"/><path d="M22 18L38 28L22 38V18Z" fill="#fff"/></svg>
                      </button>
                    </div>
                    <div class="tv-slider__video-container" style="display:none;">
                      {% if section.settings.autoplay_videos %}
                        {{ sv | video_tag: class: 'tv-slider__video', playsinline: true, muted: true, loop: true, autoplay: true, controls: true, preload: 'auto' }}
                      {% else %}
                        {{ sv | video_tag: class: 'tv-slider__video', playsinline: true, muted: false, loop: true, controls: true, preload: 'metadata' }}
                      {% endif %}
                    </div>
                  {% else %}
                    {%- comment -%} No thumbnail available — just show video directly {%- endcomment -%}
                    {% if section.settings.autoplay_videos %}
                      {{ sv | video_tag: class: 'tv-slider__video', playsinline: true, muted: true, loop: true, autoplay: true, controls: true, preload: 'auto' }}
                    {% else %}
                      {{ sv | video_tag: class: 'tv-slider__video', playsinline: true, muted: false, loop: true, controls: true, preload: 'metadata' }}
                      <button class="tv-slider__play" aria-label="Play">
                        <svg width="56" height="56" viewBox="0 0 56 56" fill="none"><circle cx="28" cy="28" r="27" fill="rgba(0,0,0,0.5)" stroke="#fff" stroke-width="2"/><path d="M22 18L38 28L22 38V18Z" fill="#fff"/></svg>
                      </button>
                    {% endif %}
                  {% endif %}
                {% elsif block.settings.video_url != blank %}
                  {%- comment -%} YouTube / Vimeo — show thumbnail, load iframe on click {%- endcomment -%}
                  {% if block.settings.video_url.type == 'youtube' %}
                    {% assign yt_id = block.settings.video_url.id %}
                    {% if block.settings.poster != blank %}
                      {% assign yt_thumb = block.settings.poster | image_url: width: 800 %}
                    {% else %}
                      {% assign yt_thumb = 'https://img.youtube.com/vi/' | append: yt_id | append: '/maxresdefault.jpg' %}
                    {% endif %}
                    <div class="tv-slider__thumb" data-video-type="youtube" data-video-id="{{ yt_id }}" data-autoplay="{{ section.settings.autoplay_videos }}">
                      <img class="tv-slider__thumb-img" src="{{ yt_thumb }}" alt="{{ block.settings.name | escape }}" loading="lazy">
                      <button class="tv-slider__play" aria-label="Play">
                        <svg width="56" height="56" viewBox="0 0 56 56" fill="none"><circle cx="28" cy="28" r="27" fill="rgba(0,0,0,0.5)" stroke="#fff" stroke-width="2"/><path d="M22 18L38 28L22 38V18Z" fill="#fff"/></svg>
                      </button>
                    </div>
                  {% elsif block.settings.video_url.type == 'vimeo' %}
                    {% assign vm_id = block.settings.video_url.id %}
                    {% if block.settings.poster != blank %}
                      {% assign vm_thumb = block.settings.poster | image_url: width: 800 %}
                    {% else %}
                      {% assign vm_thumb = '' %}
                    {% endif %}
                    <div class="tv-slider__thumb" data-video-type="vimeo" data-video-id="{{ vm_id }}" data-autoplay="{{ section.settings.autoplay_videos }}"{% if vm_thumb != '' %} data-thumb="{{ vm_thumb }}"{% endif %}>
                      {% if vm_thumb != '' %}
                        <img class="tv-slider__thumb-img" src="{{ vm_thumb }}" alt="{{ block.settings.name | escape }}" loading="lazy">
                      {% else %}
                        <div class="tv-slider__thumb-placeholder"></div>
                      {% endif %}
                      <button class="tv-slider__play" aria-label="Play">
                        <svg width="56" height="56" viewBox="0 0 56 56" fill="none"><circle cx="28" cy="28" r="27" fill="rgba(0,0,0,0.5)" stroke="#fff" stroke-width="2"/><path d="M22 18L38 28L22 38V18Z" fill="#fff"/></svg>
                      </button>
                    </div>
                  {% endif %}
                {% else %}
                  <div class="tv-slider__placeholder">
                    <svg width="48" height="48" viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="23" stroke="rgba(255,255,255,0.3)" stroke-width="2"/><path d="M19 15L34 24L19 33V15Z" fill="rgba(255,255,255,0.3)"/></svg>
                  </div>
                {% endif %}
              {% else %}
                {%- comment -%} Image media {%- endcomment -%}
                {% if block.settings.image != blank %}
                  <img
                    class="tv-slider__video tv-slider__image"
                    src="{{ block.settings.image | image_url: width: 600 }}"
                    alt="{{ block.settings.name }}"
                    loading="lazy"
                  >
                {% elsif block.settings.poster != blank %}
                  <img
                    class="tv-slider__video tv-slider__image"
                    src="{{ block.settings.poster | image_url: width: 600 }}"
                    alt="{{ block.settings.name }}"
                    loading="lazy"
                  >
                {% else %}
                  <div class="tv-slider__placeholder">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.3)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                  </div>
                {% endif %}
              {% endif %}

              {%- comment -%} Overlay info {%- endcomment -%}
              <div class="tv-slider__overlay">
                <div class="tv-slider__overlay-stars">
                  {% for i in (1..5) %}
                    {% if i <= block.settings.rating %}
                      <svg class="tv-star-sm" viewBox="0 0 24 24" fill="var(--tv-accent)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
                    {% else %}
                      <svg class="tv-star-sm" viewBox="0 0 24 24" fill="none" stroke="var(--tv-accent)" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
                    {% endif %}
                  {% endfor %}
                </div>
                <span class="tv-slider__overlay-name">{{ block.settings.name }}</span>
              </div>
            </div>

            {% if block.settings.quote != blank %}
              <div class="tv-slider__caption">
                <p class="tv-slider__quote">{{ block.settings.quote }}</p>
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="tv-slider__nav">
      <button class="tv-slider__btn tv-slider__btn--prev" aria-label="Previous">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="tv-slider__dots" id="tv-dots-{{ section.id }}"></div>
      <button class="tv-slider__btn tv-slider__btn--next" aria-label="Next">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </div>
</section>

<script>
(function(){
  var wrap  = document.getElementById('tv-slider-{{ section.id }}');
  var track = document.getElementById('tv-track-{{ section.id }}');
  var dotsC = document.getElementById('tv-dots-{{ section.id }}');
  var prev  = wrap.querySelector('.tv-slider__btn--prev');
  var next  = wrap.querySelector('.tv-slider__btn--next');
  var cards = track.children;
  var perView = parseInt(getComputedStyle(wrap).getPropertyValue('--tv-cards-per-view')) || 3;
  var gap = 20;
  var current = 0;
  var maxIdx = Math.max(0, cards.length - perView);

  function buildDots(){
    dotsC.innerHTML='';
    for(var i=0;i<=maxIdx;i++){
      var d=document.createElement('button');
      d.className='tv-slider__dot'+(i===0?' active':'');
      d.dataset.index=i;
      d.addEventListener('click',function(){goTo(parseInt(this.dataset.index));});
      dotsC.appendChild(d);
    }
  }

  function goTo(i){
    current=Math.max(0,Math.min(i,maxIdx));
    var w=cards[0].offsetWidth+gap;
    track.style.transform='translateX(-'+(current*w)+'px)';
    dotsC.querySelectorAll('.tv-slider__dot').forEach(function(d,idx){d.classList.toggle('active',idx===current);});
  }

  prev.addEventListener('click',function(){goTo(current-1);});
  next.addEventListener('click',function(){goTo(current+1);});
  buildDots();

  /* ── Thumbnail → Video on click ── */
  wrap.querySelectorAll('.tv-slider__thumb').forEach(function(thumb){
    var btn = thumb.querySelector('.tv-slider__play');
    if(!btn) return;
    btn.addEventListener('click', function(){
      var type = thumb.dataset.videoType;

      if(type === 'shopify'){
        /* Shopify hosted: reveal hidden video container */
        var container = thumb.nextElementSibling;
        if(container && container.classList.contains('tv-slider__video-container')){
          thumb.style.display = 'none';
          container.style.display = 'block';
          var vid = container.querySelector('video');
          if(vid){ vid.play(); }
        }
      } else if(type === 'youtube'){
        var id = thumb.dataset.videoId;
        var autoplay = thumb.dataset.autoplay === 'true' ? 1 : 1; /* always autoplay after click */
        var iframe = document.createElement('iframe');
        iframe.className = 'tv-slider__video';
        iframe.src = 'https://www.youtube.com/embed/' + id + '?controls=1&modestbranding=1&rel=0&autoplay=1';
        iframe.setAttribute('frameborder','0');
        iframe.setAttribute('allow','accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
        iframe.setAttribute('allowfullscreen','');
        thumb.parentElement.appendChild(iframe);
        thumb.style.display = 'none';
      } else if(type === 'vimeo'){
        var id = thumb.dataset.videoId;
        var iframe = document.createElement('iframe');
        iframe.className = 'tv-slider__video';
        iframe.src = 'https://player.vimeo.com/video/' + id + '?autoplay=1';
        iframe.setAttribute('frameborder','0');
        iframe.setAttribute('allow','autoplay; fullscreen; picture-in-picture');
        iframe.setAttribute('allowfullscreen','');
        thumb.parentElement.appendChild(iframe);
        thumb.style.display = 'none';
      }
    });
  });

  /* Legacy play buttons (direct video, no thumbnail) */
  wrap.querySelectorAll('.tv-slider__play').forEach(function(btn){
    if(btn.closest('.tv-slider__thumb')) return; /* already handled above */
    btn.addEventListener('click', function(){
      var vid = this.parentElement.querySelector('video');
      if(vid){ vid.paused ? vid.play() : vid.pause(); this.style.opacity = vid.paused ? '1' : '0'; }
    });
  });

  window.addEventListener('resize',function(){
    perView=parseInt(getComputedStyle(wrap).getPropertyValue('--tv-cards-per-view'))||3;
    maxIdx=Math.max(0,cards.length-perView);
    buildDots();goTo(Math.min(current,maxIdx));
  });
})();
</script>

{% schema %}
{
  "name": "SIQ - Video Testimonials",
  "tag": "section",
  "class": "section-testimonial-video-slider",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Customers, Real Results"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "VIDEO TESTIMONIALS"
    },
    {
      "type": "header",
      "content": "Overall Rating"
    },
    {
      "type": "checkbox",
      "id": "show_overall_rating",
      "label": "Show Overall Rating",
      "default": true
    },
    {
      "type": "text",
      "id": "overall_label",
      "label": "Label",
      "default": "Excellent 4.8 / 5"
    },
    {
      "type": "range",
      "id": "overall_stars",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Stars",
      "default": 5
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review Count",
      "default": "based on 1.067 reviews"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "cards_per_row",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Videos per Row (Desktop)",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "autoplay_videos",
      "label": "Autoplay Videos",
      "info": "Videos start automatically when visible (muted). If disabled, visitors must click to play.",
      "default": false
    },
    {
      "type": "range",
      "id": "video_height",
      "min": 250,
      "max": 600,
      "step": 10,
      "unit": "px",
      "label": "Video Height",
      "default": 420
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Border Radius",
      "default": 16
    },
    {
      "type": "range",
      "id": "star_size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Star Size",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f9f6f2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Stars)",
      "default": "#00b67a"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card Background",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "video_testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "select",
          "id": "media_type",
          "label": "Type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "video"
        },
        {
          "type": "header",
          "content": "Image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "header",
          "content": "Video"
        },
        {
          "type": "video",
          "id": "shopify_video",
          "label": "Video",
          "info": "Upload or select a video from your Shopify media library"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "accept": ["youtube", "vimeo"],
          "label": "Or paste a YouTube / Vimeo URL",
          "info": "Used when no Shopify video is selected"
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Poster / Thumbnail (optional)"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating",
          "default": 5
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Sarah"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Short Text (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Testimonials",
      "blocks": [
        {
          "type": "video_testimonial",
          "settings": { "media_type": "video", "rating": 5, "name": "Sarah, 6 days ago", "quote": "Feels like a cloud on your eyes" }
        },
        {
          "type": "video_testimonial",
          "settings": { "media_type": "video", "rating": 5, "name": "Alex, 2 days ago", "quote": "Soft and perfect for rest" }
        },
        {
          "type": "video_testimonial",
          "settings": { "media_type": "image", "rating": 5, "name": "James, yesterday", "quote": "Very comfortable and high quality" }
        }
      ]
    }
  ]
}
{% endschema %}

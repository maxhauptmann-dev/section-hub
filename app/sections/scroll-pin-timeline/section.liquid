{% comment %}
  Section Hub – Scroll Pin Timeline v1.0
  Scroll-driven vertical timeline. Items animate in left/right
  alternating as the user scrolls. IntersectionObserver driven.
  Prefix: spt-
{% endcomment %}

{%- liquid
  assign heading_font  = section.settings.heading_font
  assign body_font     = section.settings.body_font
  assign bg_color      = section.settings.bg_color
  assign accent        = section.settings.accent_color
  assign accent_2      = section.settings.accent_color_2
  assign heading_color = section.settings.heading_color
  assign text_color    = section.settings.text_color
  assign card_bg       = section.settings.card_bg
  assign card_radius   = section.settings.card_radius
  assign card_px       = section.settings.card_padding
  assign line_color    = section.settings.line_color
  assign line_w        = section.settings.line_width
  assign dot_size      = section.settings.dot_size
  assign dot_color     = section.settings.dot_color
  assign btn_radius    = section.settings.btn_radius
  assign max_w         = section.settings.content_max_width
  assign item_gap      = section.settings.item_gap
  assign pt            = section.settings.padding_top
  assign pb            = section.settings.padding_bottom
  assign show_eyebrow  = section.settings.show_header
  assign section_eyebrow = section.settings.eyebrow
  assign section_heading = section.settings.heading
  assign section_sub   = section.settings.subheading
  assign shadow_color  = section.settings.shadow_color
-%}

<style>
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}

  .spt-wrap--{{ section.id }} {
    --spt-bg: {{ bg_color }};
    --spt-accent: {{ accent }};
    --spt-accent-2: {{ accent_2 }};
    --spt-accent-glow: {{ accent | color_modify: 'alpha', 0.15 }};
    --spt-heading-color: {{ heading_color }};
    --spt-text-color: {{ text_color }};
    --spt-card-bg: {{ card_bg }};
    --spt-card-radius: {{ card_radius }}px;
    --spt-card-px: {{ card_px }}px;
    --spt-line-color: {{ line_color }};
    --spt-line-w: {{ line_w }}px;
    --spt-dot-size: {{ dot_size }}px;
    --spt-dot-color: {{ card_bg }};
    --spt-btn-radius: {{ btn_radius }}px;
    --spt-max-w: {{ max_w }}px;
    --spt-item-gap: {{ item_gap }}px;
    --spt-pt: {{ pt }}px;
    --spt-pb: {{ pb }}px;
    --spt-pt-mobile: {{ pt | divided_by: 2 | at_least: 40 }}px;
    --spt-pb-mobile: {{ pb | divided_by: 2 | at_least: 40 }}px;
    --spt-shadow-color: {{ shadow_color | color_modify: 'alpha', 0.08 }};
    --spt-heading-ff: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --spt-heading-fw: {{ heading_font.weight }};
    --spt-heading-fs: {{ heading_font.style }};
    --spt-body-ff: {{ body_font.family }}, {{ body_font.fallback_families }};
  }
</style>

<section class="spt-wrap spt-wrap--{{ section.id }}" data-section-id="{{ section.id }}">

  {%- if show_eyebrow -%}
    <div class="spt-header">
      {%- if section_eyebrow != blank -%}
        <div class="spt-header__eyebrow">{{ section_eyebrow }}</div>
      {%- endif -%}
      {%- if section_heading != blank -%}
        <h2 class="spt-header__heading">{{ section_heading }}</h2>
      {%- endif -%}
      {%- if section_sub != blank -%}
        <p class="spt-header__sub">{{ section_sub }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="spt-timeline" data-spt-timeline>

    {%- comment -%} Animated axis line {%- endcomment -%}
    <div class="spt-axis" data-spt-axis>
      <div class="spt-axis__fill" data-spt-axis-fill></div>
    </div>

    {%- for block in section.blocks -%}
      {%- liquid
        assign is_right = forloop.index0 | modulo: 2
        if is_right == 0
          assign side = 'left'
        else
          assign side = 'right'
        endif
        assign btn_text = block.settings.btn_text
        assign btn_link = block.settings.btn_link
        assign btn_style = block.settings.btn_style
      -%}

      <div class="spt-item spt-item--{{ side }}" data-spt-item {{ block.shopify_attributes }}>

        {%- comment -%} Left slot {%- endcomment -%}
        <div class="spt-item__left">
          {%- if side == 'left' -%}
            <div class="spt-card" data-spt-card>
              {%- if block.settings.image != blank -%}
                <div class="spt-card__img">
                  <img
                    src="{{ block.settings.image | image_url: width: 900 }}"
                    srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 900 }} 900w"
                    sizes="(max-width:749px) 100vw, 440px"
                    alt="{{ block.settings.image.alt | escape }}"
                    loading="lazy"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                  >
                </div>
              {%- elsif block.settings.show_image_placeholder -%}
                <div class="spt-card__img">
                  <div class="spt-card__img-placeholder">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                  </div>
                </div>
              {%- endif -%}
              <div class="spt-card__body">
                {%- if block.settings.year != blank -%}
                  <div class="spt-card__year">{{ block.settings.year }}</div>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="spt-card__heading">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="spt-card__text">{{ block.settings.text }}</p>
                {%- endif -%}
                {%- if btn_text != blank -%}
                  <a href="{{ btn_link | default: '#' }}" class="spt-card__btn spt-card__btn--{{ btn_style }}">
                    {{ btn_text }}
                    {%- if btn_style != 'ghost' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                    {%- endif -%}
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} Center dot {%- endcomment -%}
        <div class="spt-item__dot-col">
          <div class="spt-dot" data-spt-dot></div>
        </div>

        {%- comment -%} Right slot {%- endcomment -%}
        <div class="spt-item__right">
          {%- if side == 'right' -%}
            <div class="spt-card" data-spt-card>
              {%- if block.settings.image != blank -%}
                <div class="spt-card__img">
                  <img
                    src="{{ block.settings.image | image_url: width: 900 }}"
                    srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 900 }} 900w"
                    sizes="(max-width:749px) 100vw, 440px"
                    alt="{{ block.settings.image.alt | escape }}"
                    loading="lazy"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                  >
                </div>
              {%- elsif block.settings.show_image_placeholder -%}
                <div class="spt-card__img">
                  <div class="spt-card__img-placeholder">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                  </div>
                </div>
              {%- endif -%}
              <div class="spt-card__body">
                {%- if block.settings.year != blank -%}
                  <div class="spt-card__year">{{ block.settings.year }}</div>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="spt-card__heading">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="spt-card__text">{{ block.settings.text }}</p>
                {%- endif -%}
                {%- if btn_text != blank -%}
                  <a href="{{ btn_link | default: '#' }}" class="spt-card__btn spt-card__btn--{{ btn_style }}">
                    {{ btn_text }}
                    {%- if btn_style != 'ghost' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                    {%- endif -%}
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>

      </div>
    {%- endfor -%}

  </div>

</section>

<script>
(function(){
  var section = document.querySelector('.spt-wrap--{{ section.id }}');
  if (!section) return;

  var items = section.querySelectorAll('[data-spt-item]');
  var dots  = section.querySelectorAll('[data-spt-dot]');
  var axisEl = section.querySelector('[data-spt-axis]');
  var axisFill = section.querySelector('[data-spt-axis-fill]');

  if (!items.length) return;

  /* IntersectionObserver: animate cards in when they hit viewport */
  var io = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (!entry.isIntersecting) return;
      var card = entry.target.querySelector('[data-spt-card]');
      var dot  = entry.target.querySelector('[data-spt-dot]');
      if (card) card.classList.add('spt-card--visible');
      if (dot)  dot.classList.add('spt-dot--active');
      io.unobserve(entry.target);
    });
  }, { threshold: 0.2, rootMargin: '0px 0px -60px 0px' });

  items.forEach(function(item) { io.observe(item); });

  /* Scroll-driven axis fill */
  if (axisEl && axisFill) {
    function updateAxis() {
      var axisRect = axisEl.getBoundingClientRect();
      var axisTop  = axisRect.top + window.scrollY;
      var axisH    = axisEl.offsetHeight;
      var scrolled = window.scrollY + window.innerHeight * 0.6;
      var progress = Math.max(0, Math.min(1, (scrolled - axisTop) / axisH));
      axisFill.style.height = (progress * 100) + '%';
    }

    window.addEventListener('scroll', function(){ requestAnimationFrame(updateAxis); }, { passive: true });
    updateAxis();
  }
})();
</script>


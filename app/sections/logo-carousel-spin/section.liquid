{{ 'section-logo-carousel-spin.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id
  assign bg = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign border_color = section.settings.border_color
  assign logo_height = section.settings.logo_height
  assign speed = section.settings.speed
  assign gap = section.settings.gap
  assign pad_y = section.settings.padding_y
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom
  assign heading = section.settings.heading
  assign heading_align = section.settings.heading_align
  assign direction = section.settings.direction
  assign pause = section.settings.pause_hover
  assign grayscale = section.settings.grayscale
  assign show_border = section.settings.show_border
  assign animate = section.settings.enable_animation
  assign total = section.blocks.size

  assign fallback_names = "Brand,Brand,Brand,Brand,Brand,Brand,Brand" | split: ","
-%}

<div
  id="lcs-{{ sid }}"
  class="lcs{% if pause and animate %} lcs--pause{% endif %}{% unless animate %} lcs--static{% endunless %}"
  style="
    --lcs-bg:{{ bg }};
    --lcs-text:{{ text_color }};
    --lcs-border:{{ border_color }};
    --lcs-logo-h:{{ logo_height }}px;
    --lcs-speed:{{ speed }}s;
    --lcs-gap:{{ gap }}px;
    --lcs-pad-y:{{ pad_y }}px;
    --lcs-mt:{{ mt }}px;
    --lcs-mb:{{ mb }}px;
  "
>
  {%- if heading != blank -%}
    <p class="lcs__heading" style="text-align:{{ heading_align }}">{{ heading }}</p>
  {%- endif -%}

  {%- if show_border -%}<hr class="lcs__rule">{%- endif -%}

  <div class="lcs__track" aria-label="Partner logos">
    {%- if animate -%}
      <div class="lcs__ribbon lcs__ribbon--{{ direction }}">
        {%- comment -%}Duplicate blocks for seamless loop{%- endcomment -%}
        {%- for i in (1..2) -%}
          {%- if total > 0 -%}
            {%- for block in section.blocks -%}
              <div class="lcs__item{% if grayscale %} lcs__item--gray{% endif %}" {{ block.shopify_attributes }}>
                {%- if block.settings.logo != blank -%}
                  <img
                    src="{{ block.settings.logo | image_url: height: logo_height | times: 2 }}"
                    alt="{{ block.settings.alt | default: block.settings.name | escape }}"
                    height="{{ logo_height }}"
                    loading="lazy"
                    class="lcs__logo"
                  >
                {%- elsif block.settings.name != blank -%}
                  <span class="lcs__name">{{ block.settings.name }}</span>
                {%- else -%}
                  <span class="lcs__name">Brand</span>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for name in fallback_names -%}
              <div class="lcs__item lcs__item--gray">
                <span class="lcs__name">{{ name }}</span>
              </div>
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="lcs__ribbon lcs__ribbon--grid">
        {%- if total > 0 -%}
          {%- for block in section.blocks -%}
            <div class="lcs__item{% if grayscale %} lcs__item--gray{% endif %}" {{ block.shopify_attributes }}>
              {%- if block.settings.logo != blank -%}
                <img
                  src="{{ block.settings.logo | image_url: height: logo_height | times: 2 }}"
                  alt="{{ block.settings.alt | default: block.settings.name | escape }}"
                  height="{{ logo_height }}"
                  loading="lazy"
                  class="lcs__logo"
                >
              {%- elsif block.settings.name != blank -%}
                <span class="lcs__name">{{ block.settings.name }}</span>
              {%- else -%}
                <span class="lcs__name">Brand</span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for name in fallback_names -%}
            <div class="lcs__item lcs__item--gray">
              <span class="lcs__name">{{ name }}</span>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if show_border -%}<hr class="lcs__rule">{%- endif -%}
</div>

{% schema %}
{
  "name": "SIQ - Logo Spin",
  "tag": "section",
  "class": "section-logo-carousel-spin",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted by leading brands"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "Enable scrolling animation",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed",
      "min": 10,
      "max": 80,
      "step": 2,
      "default": 30,
      "unit": "s",
      "info": "Seconds per full loop"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Grayscale logos (color on hover)",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 20,
      "max": 80,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between logos",
      "min": 20,
      "max": 100,
      "step": 4,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show top/bottom border",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#64748b"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e2e8f0"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 12,
      "max": 80,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Brand name (fallback)",
          "default": "Brand"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SIQ - Logo Spin",
      "blocks": [
        { "type": "logo", "settings": { "name": "Google" } },
        { "type": "logo", "settings": { "name": "Apple" } },
        { "type": "logo", "settings": { "name": "Microsoft" } },
        { "type": "logo", "settings": { "name": "Amazon" } },
        { "type": "logo", "settings": { "name": "Spotify" } },
        { "type": "logo", "settings": { "name": "Netflix" } },
        { "type": "logo", "settings": { "name": "Tesla" } },
        { "type": "logo", "settings": { "name": "Nike" } }
      ]
    }
  ]
}
{% endschema %}

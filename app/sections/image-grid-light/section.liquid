{% comment %}
  Section Hub – Image Grid Light v1.0
  Clean grid gallery with light theme, hover effects,
  optional overlays, and maximum customization.
  Prefix: igl-
{% endcomment %}

{%- liquid
  assign hf = section.settings.heading_font
  assign bf = section.settings.body_font
  assign cols = section.settings.columns
  assign cols_m = section.settings.columns_mobile
  assign hover_effect = section.settings.hover_effect
  assign show_overlay = section.settings.show_overlay
  assign overlay_opacity = section.settings.overlay_opacity
  assign aspect_ratio = section.settings.aspect_ratio
  assign gap = section.settings.grid_gap
  assign radius = section.settings.card_radius
  assign py = section.settings.section_py
  assign px = section.settings.section_px
-%}

<style>
  {{ hf | font_face: font_display: 'swap' }}
  {{ bf | font_face: font_display: 'swap' }}

  .igl-wrap--{{ section.id }} {
    --igl-bg: {{ section.settings.bg_color }};
    --igl-heading-ff: {{ hf.family }}, {{ hf.fallback_families }};
    --igl-heading-fw: {{ hf.weight }};
    --igl-heading-fs: {{ hf.style }};
    --igl-body-ff: {{ bf.family }}, {{ bf.fallback_families }};
    --igl-body-fw: {{ bf.weight }};
    --igl-body-fs: {{ bf.style }};
    --igl-heading-color: {{ section.settings.heading_color }};
    --igl-text-color: {{ section.settings.text_color }};
    --igl-overlay-bg: {{ section.settings.overlay_bg }};
    --igl-overlay-opacity: {{ overlay_opacity | divided_by: 100.0 }};
    --igl-accent: {{ section.settings.accent_color }};
    --igl-card-radius: {{ radius }}px;
    --igl-gap: {{ gap }}px;
    --igl-cols: {{ cols }};
    --igl-cols-m: {{ cols_m }};
    --igl-aspect: {{ aspect_ratio }};
    --igl-py: {{ py }}px;
    --igl-px: {{ px }}px;
  }
</style>

<section class="igl-wrap igl-wrap--{{ section.id }}" data-section-id="{{ section.id }}">

  <div class="igl-container">

    {%- comment -%} Header {%- endcomment -%}
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subtext != blank -%}
      <div class="igl-header" data-igl-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <span class="igl-header__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="igl-header__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="igl-header__subtext">{{ section.settings.subtext }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Grid {%- endcomment -%}
    <div class="igl-grid igl-grid--{{ cols }}" data-igl-grid>
      {%- for block in section.blocks -%}
        <div class="igl-card" data-igl-reveal {{ block.shopify_attributes }}>
          <div class="igl-card__media">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1000 }} 1000w"
                sizes="(max-width: 749px) 100vw, 50vw"
                alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                loading="lazy"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                class="igl-card__img"
              >
            {%- else -%}
              <div class="igl-card__placeholder">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              </div>
            {%- endif -%}

            {%- comment -%} Hover overlay {%- endcomment -%}
            {%- if show_overlay or block.settings.title != blank or block.settings.subtitle != blank -%}
              <div class="igl-card__overlay">
                <div class="igl-card__content">
                  {%- if block.settings.badge != blank -%}
                    <span class="igl-card__badge">{{ block.settings.badge }}</span>
                  {%- endif -%}
                  {%- if block.settings.title != blank -%}
                    <h3 class="igl-card__title">{{ block.settings.title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.subtitle != blank -%}
                    <p class="igl-card__subtitle">{{ block.settings.subtitle }}</p>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </div>

          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="igl-card__link" aria-label="{{ block.settings.title | default: 'View' | escape }}"></a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

  </div>

</section>

<script>
  (function(){
    const sid = '{{ section.id }}';
    const wrap = document.querySelector('.igl-wrap--' + sid);
    if (!wrap) return;

    const revealEls = wrap.querySelectorAll('[data-igl-reveal]');
    if (revealEls.length) {
      const rio = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
          if (e.isIntersecting) {
            e.target.classList.add('igl-visible');
            rio.unobserve(e.target);
          }
        });
      }, { threshold: 0.12 });
      revealEls.forEach(function(el) { rio.observe(el); });
    }
  })();
</script>

{% schema %}
{
  "name": "SS - Image Grid Light",
  "tag": "section",
  "class": "igl-section",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Gallery"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Image Grid"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "A clean, responsive image gallery perfect for showcasing your work."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (desktop)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "auto", "label": "Auto (natural)" },
        { "value": "1/1", "label": "Square 1:1" },
        { "value": "4/3", "label": "Landscape 4:3" },
        { "value": "3/4", "label": "Portrait 3:4" },
        { "value": "16/9", "label": "Wide 16:9" }
      ],
      "default": "4/3"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 8,
      "max": 32,
      "step": 4,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Border radius",
      "min": 0,
      "max": 24,
      "step": 4,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Hover effects"
    },
    {
      "type": "select",
      "id": "hover_effect",
      "label": "Hover animation",
      "options": [
        { "value": "zoom", "label": "Zoom in" },
        { "value": "lift", "label": "Lift up" },
        { "value": "fade", "label": "Fade" },
        { "value": "none", "label": "None" }
      ],
      "default": "zoom"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show hover overlay",
      "default": true
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 50,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Section size"
    },
    {
      "type": "range",
      "id": "section_py",
      "label": "Vertical padding",
      "min": 20,
      "max": 120,
      "step": 10,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_px",
      "label": "Horizontal padding",
      "min": 16,
      "max": 60,
      "step": 4,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "overlay_bg",
      "label": "Overlay background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#4a90e2"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "playfair_display_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "inter_n4"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Image Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SS - Image Grid Light",
      "settings": {
        "eyebrow": "Gallery",
        "heading": "Image Grid",
        "subtext": "A clean, responsive image gallery perfect for showcasing your work.",
        "columns": "3",
        "columns_mobile": "1",
        "aspect_ratio": "4/3",
        "grid_gap": 16,
        "card_radius": 8,
        "hover_effect": "zoom",
        "show_overlay": true,
        "overlay_opacity": 50,
        "bg_color": "#ffffff",
        "heading_color": "#000000"
      },
      "blocks": [
        {
          "type": "image",
          "settings": {
            "title": "Project One",
            "subtitle": "Photography",
            "badge": "Featured"
          }
        },
        {
          "type": "image",
          "settings": {
            "title": "Project Two",
            "subtitle": "Editorial"
          }
        },
        {
          "type": "image",
          "settings": {
            "title": "Project Three",
            "subtitle": "Design"
          }
        },
        {
          "type": "image",
          "settings": {
            "title": "Project Four",
            "subtitle": "Motion"
          }
        },
        {
          "type": "image",
          "settings": {
            "title": "Project Five",
            "subtitle": "Branding"
          }
        },
        {
          "type": "image",
          "settings": {
            "title": "Project Six",
            "subtitle": "Web Design"
          }
        }
      ]
    }
  ]
}
{% endschema %}

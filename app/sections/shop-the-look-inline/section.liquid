{% comment %}
  Section Hub – Shop the Look – Inline Labels v1.0
  Hero-ready lifestyle image with floating product label cards directly on the photo.
  Each label shows: small product image + category + product name.
  Click → goes to product page.
  Fully positionable per block (x/y %). Works as hero (full viewport height) or inline section.
{% endcomment %}

{%- liquid
  assign heading         = section.settings.heading
  assign subheading      = section.settings.subheading
  assign show_text_overlay = section.settings.show_text_overlay
  assign overlay_pos     = section.settings.overlay_position

  assign use_custom_font = section.settings.use_custom_font
  assign heading_font    = section.settings.heading_font_family
  assign heading_size    = section.settings.heading_size
  assign heading_size_m  = section.settings.heading_size_mobile
  assign heading_lh      = section.settings.heading_line_height
  assign heading_color   = section.settings.heading_color
  assign heading_align   = section.settings.heading_text_align
  assign sub_size        = section.settings.subheading_size
  assign sub_color       = section.settings.subheading_color

  assign img             = section.settings.image
  assign img_mobile      = section.settings.image_mobile
  assign img_round       = section.settings.image_roundness
  assign img_border      = section.settings.image_border_thickness
  assign img_border_c    = section.settings.image_border_color
  assign img_fit         = section.settings.image_fit
  assign img_height      = section.settings.image_height
  assign img_height_m    = section.settings.image_height_mobile
  assign img_overlay     = section.settings.image_overlay_opacity
  assign img_overlay_c   = section.settings.image_overlay_color

  assign label_bg        = section.settings.label_bg
  assign label_bg_blur   = section.settings.label_bg_blur
  assign label_round     = section.settings.label_roundness
  assign label_shadow    = section.settings.label_shadow
  assign label_img_size  = section.settings.label_image_size
  assign label_img_round = section.settings.label_image_roundness
  assign label_img_fit   = section.settings.label_image_fit
  assign label_gap       = section.settings.label_gap

  assign use_label_font  = section.settings.use_custom_font_label
  assign label_font      = section.settings.label_font_family
  assign cat_size        = section.settings.category_size
  assign cat_color       = section.settings.category_color
  assign cat_uppercase   = section.settings.category_uppercase
  assign name_size       = section.settings.name_size
  assign name_color      = section.settings.name_color
  assign name_weight     = section.settings.name_weight

  assign show_price      = section.settings.show_price
  assign price_size      = section.settings.price_size
  assign price_color     = section.settings.price_color

  assign connector_show  = section.settings.show_connector
  assign connector_color = section.settings.connector_color
  assign connector_w     = section.settings.connector_width

  assign show_dot        = section.settings.show_dot
  assign dot_size        = section.settings.dot_size
  assign dot_bg          = section.settings.dot_bg
  assign dot_pulse       = section.settings.dot_pulse

  assign bg_color        = section.settings.section_bg
  assign bg_gradient     = section.settings.section_bg_gradient
  assign content_width   = section.settings.content_width
  assign full_width      = section.settings.full_width
  assign hero_mode       = section.settings.hero_mode
  assign sec_round       = section.settings.section_roundness
  assign lazy            = section.settings.lazy_load
  assign margin_top      = section.settings.margin_top
  assign margin_bottom   = section.settings.margin_bottom
  assign padding_top     = section.settings.padding_top
  assign padding_bottom  = section.settings.padding_bottom
  assign padding_sides   = section.settings.padding_sides
  assign padding_sides_m = section.settings.padding_sides_mobile
  assign custom_css      = section.settings.custom_css
-%}

{%- if use_custom_font -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family={{ heading_font | replace: ' ', '+' }}:wght@400;700&display=swap" rel="stylesheet">
{%- endif -%}
{%- if use_label_font -%}
  <link href="https://fonts.googleapis.com/css2?family={{ label_font | replace: ' ', '+' }}:wght@400;600&display=swap" rel="stylesheet">
{%- endif -%}

<style>
  #stli-{{ section.id }} {
    --stli-heading-font: {% if use_custom_font %}'{{ heading_font }}', serif{% else %}inherit{% endif %};
    --stli-heading-size: {{ heading_size }}px;
    --stli-heading-size-m: {{ heading_size_m }}px;
    --stli-heading-lh: {{ heading_lh }};
    --stli-heading-color: {{ heading_color }};
    --stli-heading-align: {{ heading_align }};
    --stli-sub-size: {{ sub_size }}px;
    --stli-sub-color: {{ sub_color }};

    --stli-img-round: {{ img_round }}px;
    --stli-img-border: {{ img_border }}px;
    --stli-img-border-c: {{ img_border_c }};
    --stli-img-fit: {{ img_fit }};
    --stli-img-h: {{ img_height }}px;
    --stli-img-h-m: {{ img_height_m }}px;
    --stli-overlay-c: {{ img_overlay_c }};
    --stli-overlay-op: {{ img_overlay | divided_by: 100.0 }};

    --stli-label-bg: {{ label_bg }};
    --stli-label-blur: {{ label_bg_blur }}px;
    --stli-label-round: {{ label_round }}px;
    --stli-label-img-size: {{ label_img_size }}px;
    --stli-label-img-round: {{ label_img_round }}px;
    --stli-label-img-fit: {{ label_img_fit }};
    --stli-label-gap: {{ label_gap }}px;

    --stli-label-font: {% if use_label_font %}'{{ label_font }}', sans-serif{% else %}inherit{% endif %};
    --stli-cat-size: {{ cat_size }}px;
    --stli-cat-color: {{ cat_color }};
    --stli-name-size: {{ name_size }}px;
    --stli-name-color: {{ name_color }};
    --stli-name-weight: {{ name_weight }};
    --stli-price-size: {{ price_size }}px;
    --stli-price-color: {{ price_color }};

    --stli-connector-c: {{ connector_color }};
    --stli-connector-w: {{ connector_w }}px;

    --stli-dot-size: {{ dot_size }}px;
    --stli-dot-bg: {{ dot_bg }};

    --stli-bg: {% if bg_gradient != blank %}{{ bg_gradient }}{% else %}{{ bg_color }}{% endif %};
    --stli-content-w: {{ content_width }}px;
    --stli-sec-round: {{ sec_round }}px;
    --stli-mt: {{ margin_top }}px;
    --stli-mb: {{ margin_bottom }}px;
    --stli-pt: {{ padding_top }}px;
    --stli-pb: {{ padding_bottom }}px;
    --stli-ps: {{ padding_sides }}px;
    --stli-ps-m: {{ padding_sides_m }}px;
  }
  {% if custom_css != blank %}{{ custom_css }}{% endif %}
</style>

<section id="stli-{{ section.id }}" class="stli-section{% if full_width %} stli-full-width{% endif %}{% if hero_mode %} stli-hero{% endif %}">
  <div class="stli-wrapper">

    <div class="stli-canvas">

      {%- comment -%} Background image {%- endcomment -%}
      <div class="stli-image-wrap">
        {%- if img != blank -%}
          <picture>
            {%- if img_mobile != blank -%}
              <source media="(max-width: 749px)" srcset="{{ img_mobile | image_url: width: 900 }}">
            {%- endif -%}
            <img
              src="{{ img | image_url: width: 2000 }}"
              alt="{{ img.alt | default: heading | escape }}"
              class="stli-image"
              {% if lazy %}loading="lazy"{% else %}loading="eager"{% endif %}
            >
          </picture>
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'stli-image stli-placeholder' }}
        {%- endif -%}
      </div>

      {%- comment -%} Dark overlay {%- endcomment -%}
      {%- if img_overlay > 0 -%}
        <div class="stli-overlay" aria-hidden="true"></div>
      {%- endif -%}

      {%- comment -%} Inline label blocks {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'product_label' -%}
          {%- assign p = block.settings.product -%}
          {%- assign lx = block.settings.label_x -%}
          {%- assign ly = block.settings.label_y -%}
          {%- assign side = block.settings.label_side -%}

          <div
            class="stli-label stli-label--{{ side }}"
            {{ block.shopify_attributes }}
            style="left:{{ lx }}%;top:{{ ly }}%;"
          >
            {%- comment -%} Dot anchor {%- endcomment -%}
            {%- if show_dot -%}
              <div class="stli-dot{% if dot_pulse %} stli-dot--pulse{% endif %}" aria-hidden="true">
                <span class="stli-dot__inner"></span>
                {%- if dot_pulse -%}<span class="stli-dot__ping"></span>{%- endif -%}
              </div>
            {%- endif -%}

            {%- comment -%} Connector line {%- endcomment -%}
            {%- if connector_show -%}
              <div class="stli-connector"></div>
            {%- endif -%}

            {%- comment -%} Label card {%- endcomment -%}
            <a
              href="{% if p != blank %}{{ p.url }}{% else %}#{% endif %}"
              class="stli-label__card{% if label_shadow %} stli-label__card--shadow{% endif %}{% if label_bg_blur > 0 %} stli-label__card--blur{% endif %}"
              aria-label="{% if p != blank %}{{ p.title | escape }}{% else %}View product{% endif %}"
            >
              {%- comment -%} Product image {%- endcomment -%}
              <div class="stli-label__img-wrap">
                {%- if block.settings.custom_image != blank -%}
                  <img
                    src="{{ block.settings.custom_image | image_url: width: 200 }}"
                    alt=""
                    class="stli-label__img"
                    {% if lazy %}loading="lazy"{% endif %}
                  >
                {%- elsif p != blank and p.featured_image != blank -%}
                  <img
                    src="{{ p.featured_image | image_url: width: 200 }}"
                    alt="{{ p.featured_image.alt | escape }}"
                    class="stli-label__img"
                    {% if lazy %}loading="lazy"{% endif %}
                  >
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'stli-label__img stli-placeholder' }}
                {%- endif -%}
              </div>

              {%- comment -%} Text info {%- endcomment -%}
              <div class="stli-label__info">
                {%- if block.settings.category_label != blank -%}
                  <p class="stli-label__cat{% if cat_uppercase %} stli-label__cat--upper{% endif %}">
                    {{- block.settings.category_label -}}
                  </p>
                {%- elsif p != blank and p.product_type != blank -%}
                  <p class="stli-label__cat{% if cat_uppercase %} stli-label__cat--upper{% endif %}">
                    {{- p.product_type -}}
                  </p>
                {%- endif -%}

                <p class="stli-label__name">
                  {%- if block.settings.label_name != blank -%}
                    "{{ block.settings.label_name }}"
                  {%- elsif p != blank -%}
                    {{ p.title | truncate: 40 }}
                  {%- else -%}
                    Product Name
                  {%- endif -%}
                </p>

                {%- if show_price and p != blank -%}
                  <p class="stli-label__price">{{ p.price | money }}</p>
                {%- endif -%}
              </div>
            </a>
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} Optional text overlay (heading/subheading on image) {%- endcomment -%}
      {%- if show_text_overlay and heading != blank -%}
        <div class="stli-text-overlay stli-text-overlay--{{ overlay_pos }}">
          <h2 class="stli-heading">{{ heading }}</h2>
          {%- if subheading != blank -%}
            <p class="stli-subheading">{{ subheading }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>{%- comment -%} /stli-canvas {%- endcomment -%}

    {%- comment -%} Heading below image (when not overlay mode) {%- endcomment -%}
    {%- unless show_text_overlay -%}
      {%- if heading != blank -%}
        <div class="stli-below-heading">
          <h2 class="stli-heading">{{ heading }}</h2>
          {%- if subheading != blank -%}
            <p class="stli-subheading">{{ subheading }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endunless -%}

    {%- comment -%} Mobile product bar {%- endcomment -%}
    <div class="stli-mobile-bar">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product_label' -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank -%}
            <a href="{{ p.url }}" class="stli-mobile-card">
              <div class="stli-mobile-card__img-wrap">
                {%- if block.settings.custom_image != blank -%}
                  <img src="{{ block.settings.custom_image | image_url: width: 120 }}" alt="" class="stli-mobile-card__img" loading="lazy">
                {%- elsif p.featured_image != blank -%}
                  <img src="{{ p.featured_image | image_url: width: 120 }}" alt="{{ p.featured_image.alt | escape }}" class="stli-mobile-card__img" loading="lazy">
                {%- endif -%}
              </div>
              <div class="stli-mobile-card__info">
                {%- if block.settings.category_label != blank -%}
                  <p class="stli-mobile-card__cat">{{ block.settings.category_label }}</p>
                {%- endif -%}
                <p class="stli-mobile-card__name">{{ block.settings.label_name | default: p.title | truncate: 28 }}</p>
                {%- if show_price -%}
                  <p class="stli-mobile-card__price">{{ p.price | money }}</p>
                {%- endif -%}
              </div>
            </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "SIQ - Inline Labels",
  "tag": "section",
  "class": "stli-root",
  "settings": [
    {
      "type": "header",
      "content": "Heading & Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the Look"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "checkbox",
      "id": "show_text_overlay",
      "label": "Show Heading on Image (Overlay)",
      "default": false,
      "info": "Places heading/subheading directly on top of the image."
    },
    {
      "type": "select",
      "id": "overlay_position",
      "label": "Overlay Text Position",
      "options": [
        { "value": "top-left", "label": "Top Left" },
        { "value": "top-center", "label": "Top Center" },
        { "value": "top-right", "label": "Top Right" },
        { "value": "center", "label": "Center" },
        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "bottom-center", "label": "Bottom Center" },
        { "value": "bottom-right", "label": "Bottom Right" }
      ],
      "default": "bottom-left"
    },
    {
      "type": "checkbox",
      "id": "use_custom_font",
      "label": "Use Custom Heading Font",
      "default": false
    },
    {
      "type": "text",
      "id": "heading_font_family",
      "label": "Heading Font Family",
      "default": "Playfair Display"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 18,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading Size – Mobile",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Heading Line Height",
      "min": 0.8,
      "max": 2.0,
      "step": 0.1,
      "default": 1.2
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "heading_text_align",
      "label": "Heading Align",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Subheading Size",
      "min": 10,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#ffffffcc"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image (optional)"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image Height – Desktop",
      "min": 300,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 700,
      "info": "In Hero Mode: 100vh override is used instead."
    },
    {
      "type": "range",
      "id": "image_height_mobile",
      "label": "Image Height – Mobile",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 500
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image Fit",
      "options": [
        { "value": "cover", "label": "Cover (füllen)" },
        { "value": "contain", "label": "Contain (ganzes Bild)" }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "image_roundness",
      "label": "Image Roundness",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_border_thickness",
      "label": "Image Border",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "image_border_color",
      "label": "Image Border Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "label": "Dark Overlay Opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 20,
      "info": "Adds a dark layer over the image for better text/label readability."
    },
    {
      "type": "color",
      "id": "image_overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Label Cards"
    },
    {
      "type": "color",
      "id": "label_bg",
      "label": "Label Background",
      "default": "#ffffffdd"
    },
    {
      "type": "range",
      "id": "label_bg_blur",
      "label": "Background Blur (Glassmorphism)",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 8,
      "info": "0 = kein Blur. Höher = stärkerer Frost-Glas-Effekt."
    },
    {
      "type": "range",
      "id": "label_roundness",
      "label": "Label Roundness",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 40,
      "info": "0 = eckig, 40 = Pill-Form."
    },
    {
      "type": "checkbox",
      "id": "label_shadow",
      "label": "Label Shadow",
      "default": true
    },
    {
      "type": "range",
      "id": "label_gap",
      "label": "Gap between Image & Text",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Label – Product Image"
    },
    {
      "type": "range",
      "id": "label_image_size",
      "label": "Image Size",
      "min": 32,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "label_image_roundness",
      "label": "Image Roundness",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 50,
      "info": "50+ = rund."
    },
    {
      "type": "select",
      "id": "label_image_fit",
      "label": "Image Fit",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ],
      "default": "cover"
    },
    {
      "type": "header",
      "content": "Label – Text"
    },
    {
      "type": "checkbox",
      "id": "use_custom_font_label",
      "label": "Use Custom Label Font",
      "default": false
    },
    {
      "type": "text",
      "id": "label_font_family",
      "label": "Label Font Family",
      "default": "Inter"
    },
    {
      "type": "range",
      "id": "category_size",
      "label": "Category Size",
      "min": 8,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "color",
      "id": "category_color",
      "label": "Category Color",
      "default": "#888888"
    },
    {
      "type": "checkbox",
      "id": "category_uppercase",
      "label": "Category Uppercase",
      "default": true
    },
    {
      "type": "range",
      "id": "name_size",
      "label": "Product Name Size",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Product Name Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "name_weight",
      "label": "Product Name Weight",
      "min": 400,
      "max": 700,
      "step": 100,
      "default": 600
    },
    {
      "type": "header",
      "content": "Price"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show Price",
      "default": false
    },
    {
      "type": "range",
      "id": "price_size",
      "label": "Price Size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Dot & Connector"
    },
    {
      "type": "checkbox",
      "id": "show_dot",
      "label": "Show Dot Anchor",
      "default": true
    },
    {
      "type": "range",
      "id": "dot_size",
      "label": "Dot Size",
      "min": 6,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "color",
      "id": "dot_bg",
      "label": "Dot Color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "dot_pulse",
      "label": "Dot Pulse Animation",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_connector",
      "label": "Show Connector Line",
      "default": false,
      "info": "Verbindungslinie zwischen Dot und Label."
    },

{% comment %}
  Section Hub – Scroll Storyteller v1.0
  Immersive sticky scroll-through panels with cinematic transitions.
  Each block = one story panel with image, heading, text, button.
  Prefix: shst-
{% endcomment %}

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font    = section.settings.body_font
  assign bg_color     = section.settings.bg_color
  assign accent       = section.settings.accent_color
  assign transition    = section.settings.transition_style
  assign speed        = section.settings.transition_speed
  assign scroll_per   = section.settings.scroll_per_panel
  assign show_numbers = section.settings.show_panel_numbers
  assign number_color = section.settings.number_color
  assign heading_color = section.settings.heading_color
  assign eyebrow_color = section.settings.eyebrow_color
  assign text_color    = section.settings.text_color
  assign btn_style     = section.settings.btn_style
  assign btn_bg        = section.settings.btn_bg
  assign btn_text_c    = section.settings.btn_text_color
  assign btn_radius    = section.settings.btn_radius
  assign btn_arrow     = section.settings.btn_show_arrow
  assign overlay_color = section.settings.image_overlay_color
  assign overlay_op    = section.settings.image_overlay_opacity
  assign dot_pos       = section.settings.dot_position
  assign dot_active    = section.settings.dot_active_color
  assign dot_inactive  = section.settings.dot_inactive_color
  assign show_counter  = section.settings.show_counter
  assign counter_color = section.settings.counter_color
  assign side_text     = section.settings.side_label
  assign side_color    = section.settings.side_label_color
  assign show_progress = section.settings.show_progress
  assign progress_h    = section.settings.progress_height
  assign content_px    = section.settings.content_padding

  assign panel_count   = section.blocks.size
  assign total_scroll  = panel_count | times: scroll_per
-%}

{%- assign ov_r = overlay_color | color_extract: 'red' -%}
{%- assign ov_g = overlay_color | color_extract: 'green' -%}
{%- assign ov_b = overlay_color | color_extract: 'blue' -%}
{%- assign ov_a = overlay_op | divided_by: 100.0 -%}

<style>
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}

  .shst-wrap--{{ section.id }} {
    --shst-bg: {{ bg_color }};
    --shst-accent: {{ accent }};
    --shst-transition-speed: {{ speed }}s;
    --shst-content-px: {{ content_px }}px;

    --shst-heading-ff: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --shst-heading-fw: {{ heading_font.weight }};
    --shst-heading-fs: {{ heading_font.style }};
    --shst-heading-color: {{ heading_color }};
    --shst-eyebrow-color: {{ eyebrow_color }};
    --shst-text-color: {{ text_color }};
    --shst-number-color: {{ number_color }};

    --shst-btn-bg: {{ btn_bg }};
    --shst-btn-text: {{ btn_text_c }};
    --shst-btn-radius: {{ btn_radius }}px;

    --shst-dot-active: {{ dot_active }};
    --shst-dot-inactive: {{ dot_inactive }};
    --shst-counter-color: {{ counter_color }};
    --shst-side-color: {{ side_color }};
    --shst-progress-h: {{ progress_h }}px;
  }
</style>

<section class="shst-wrap shst-wrap--{{ section.id }}" data-section-id="{{ section.id }}">

  <div class="shst-scroll" style="height: {{ total_scroll }}vh;" data-shst-scroll data-shst-panels="{{ panel_count }}" data-shst-scroll-per="{{ scroll_per }}">

    <div class="shst-sticky">

      {%- comment -%} Progress bar {%- endcomment -%}
      {%- if show_progress -%}
        <div class="shst-progress" data-shst-progress></div>
      {%- endif -%}

      {%- comment -%} Panels (one per block) {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- assign layout = block.settings.layout -%}
        <div
          class="shst-panel shst-panel--{{ layout }}{% if transition != 'fade' %} shst-panel--{{ transition }}{% endif %}{% if forloop.first %} shst-panel--active{% endif %}"
          data-shst-panel="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >

          {%- comment -%} Image side {%- endcomment -%}
          <div class="shst-panel__image">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 1600 }}"
                srcset="{{ block.settings.image | image_url: width: 600 }} 600w,
                        {{ block.settings.image | image_url: width: 1000 }} 1000w,
                        {{ block.settings.image | image_url: width: 1600 }} 1600w"
                sizes="{% if layout == 'full-image' %}100vw{% else %}50vw{% endif %}"
                alt="{{ block.settings.image.alt | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
              >
            {%- else -%}
              {{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag }}
            {%- endif -%}
            <div class="shst-panel__image-overlay" style="background: rgba({{ ov_r }},{{ ov_g }},{{ ov_b }},{{ ov_a }});"></div>
          </div>

          {%- comment -%} Content side {%- endcomment -%}
          <div class="shst-panel__content" style="{% if layout == 'full-image' %}padding: {{ content_px }}px; text-align: center; align-items: center;{% endif %}">

            {%- if show_numbers -%}
              <div class="shst-panel__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
            {%- endif -%}

            {%- if block.settings.eyebrow != blank -%}
              <div class="shst-panel__eyebrow">
                <span class="shst-panel__eyebrow-line"></span>
                {{ block.settings.eyebrow }}
              </div>
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
              <h3 class="shst-panel__heading">{{ block.settings.heading }}</h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <p class="shst-panel__text">{{ block.settings.text }}</p>
            {%- endif -%}

            {%- if block.settings.btn_text != blank -%}
              <a href="{{ block.settings.btn_link | default: '#' }}" class="shst-panel__btn shst-panel__btn--{{ btn_style }}">
                {{ block.settings.btn_text }}
                {%- if btn_arrow -%}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                {%- endif -%}
              </a>
            {%- endif -%}

          </div>
        </div>
      {%- endfor -%}

      {%- comment -%} Progress dots {%- endcomment -%}
      {%- if dot_pos != 'none' -%}
        <div class="shst-dots shst-dots--{{ dot_pos }}">
          {%- for block in section.blocks -%}
            <button class="shst-dot{% if forloop.first %} shst-dot--active{% endif %}" data-shst-dot="{{ forloop.index0 }}" aria-label="Go to panel {{ forloop.index }}"></button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} Panel counter {%- endcomment -%}
      {%- if show_counter -%}
        <div class="shst-counter">
          <span class="shst-counter__current" data-shst-counter-current>01</span>
          <span> / {{ panel_count | prepend: '0' | slice: -2, 2 }}</span>
        </div>
      {%- endif -%}

      {%- comment -%} Side label {%- endcomment -%}
      {%- if side_text != blank -%}
        <div class="shst-side-label">{{ side_text }}</div>
      {%- endif -%}

    </div>
  </div>

</section>

<script>
  (function() {
    var section = document.querySelector('.shst-wrap--{{ section.id }}');
    if (!section) return;

    var scrollEl = section.querySelector('[data-shst-scroll]');
    var panels = section.querySelectorAll('[data-shst-panel]');
    var dots = section.querySelectorAll('[data-shst-dot]');
    var counter = section.querySelector('[data-shst-counter-current]');
    var progress = section.querySelector('[data-shst-progress]');

    if (!scrollEl || panels.length === 0) return;

    var panelCount = parseInt(scrollEl.dataset.shstPanels) || panels.length;
    var scrollPer = parseInt(scrollEl.dataset.shstScrollPer) || 150;
    var currentIndex = 0;

    function updatePanels(index) {
      if (index === currentIndex) return;
      currentIndex = index;

      panels.forEach(function(p, i) {
        p.classList.toggle('shst-panel--active', i === index);
      });

      dots.forEach(function(d, i) {
        d.classList.toggle('shst-dot--active', i === index);
      });

      if (counter) {
        counter.textContent = String(index + 1).padStart(2, '0');
      }
    }

    function onScroll() {
      var rect = scrollEl.getBoundingClientRect();
      var scrolled = Math.max(0, -rect.top);
      var totalHeight = scrollEl.offsetHeight - window.innerHeight;

      if (totalHeight <= 0) return;

      var rawProgress = scrolled / totalHeight;
      var index = Math.min(Math.floor(rawProgress * panelCount), panelCount - 1);
      index = Math.max(0, index);

      updatePanels(index);

      if (progress) {
        progress.style.width = (Math.min(rawProgress, 1) * 100) + '%';
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    dots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        var target = parseInt(dot.dataset.shstDot);
        var totalHeight = scrollEl.offsetHeight - window.innerHeight;
        var scrollTarget = scrollEl.offsetTop + (target / panelCount) * totalHeight;
        window.scrollTo({ top: scrollTarget, behavior: 'smooth' });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "SS - Scroll Storyteller",
  "tag": "section",
  "class": "shst-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#c9a96e"
    },
    {
      "type": "range",
      "id": "scroll_per_panel",
      "label": "Scroll distance per panel",
      "min": 80,
      "max": 250,
      "step": 10,
      "default": 150,
      "unit": "vh",
      "info": "How far the user scrolls before the next panel. Total scroll = panels x this value."
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Content padding",
      "min": 20,
      "max": 100,
      "step": 10,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Transition"
    },
    {
      "type": "select",
      "id": "transition_style",
      "label": "Panel transition",
      "options": [
        { "value": "fade", "label": "Fade" },
        { "value": "slide", "label": "Slide" },
        { "value": "zoom", "label": "Zoom" }
      ],
      "default": "fade"
    },
    {
      "type": "range",
      "id": "transition_speed",
      "label": "Transition speed",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6,
      "unit": "ds",
      "info": "In deciseconds (6 = 0.6s)."
    },
    {
      "type": "header",
      "content": "Panel numbers"
    },
    {
      "type": "checkbox",
      "id": "show_panel_numbers",
      "label": "Show large panel numbers",
      "default": true
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Number stroke color",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#888888"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text color",
      "default": "#aaaaaa"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "playfair_display_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "inter_n4"
    },
    {
      "type": "header",
      "content": "Image overlay"
    },
    {
      "type": "color",
      "id": "image_overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 70,
      "step": 5,
      "default": 15,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "select",
      "id": "btn_style",
      "label": "Button style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" },
        { "value": "accent", "label": "Accent" },
        { "value": "underline", "label": "Underline" }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button text color",
      "default": "#0a0a0a"
    },
    {
      "type": "range",
      "id": "btn_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "btn_show_arrow",
      "label": "Show arrow icon on buttons",
      "default": true
    },
    {
      "type": "header",
      "content": "Progress dots"
    },
    {
      "type": "select",
      "id": "dot_position",
      "label": "Dot position",
      "options": [
        { "value": "right", "label": "Right side" },
        { "value": "bottom", "label": "Bottom center" },
        { "value": "none", "label": "Hidden" }
      ],
      "default": "right"
    },
    {
      "type": "color",
      "id": "dot_active_color",
      "label": "Dot active color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "dot_inactive_color",
      "label": "Dot inactive color",
      "default": "#444444"
    },
    {
      "type": "header",
      "content": "Panel counter"
    },
    {
      "type": "checkbox",
      "id": "show_counter",
      "label": "Show panel counter",
      "default": true
    },
    {
      "type": "color",
      "id": "counter_color",
      "label": "Counter color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Side label"
    },
    {
      "type": "text",
      "id": "side_label",
      "label": "Side label text",
      "default": "Our Story"
    },
    {
      "type": "color",
      "id": "side_label_color",
      "label": "Side label color",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Progress bar"
    },
    {
      "type": "checkbox",
      "id": "show_progress",
      "label": "Show top progress bar",
      "default": true
    },
    {
      "type": "range",
      "id": "progress_height",
      "label": "Progress bar height",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Story Panel",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Panel image"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Layout",
          "options": [
            { "value": "image-left", "label": "Image left, text right" },
            { "value": "image-right", "label": "Image right, text left" },
            { "value": "full-image", "label": "Full image with text overlay" }
          ],
          "default": "image-left"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow text",
          "default": "Chapter One"
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Heading",
          "default": "Where It All Began"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Body text",
          "default": "Every great journey starts with a single step. Ours began with a vision to create something truly exceptional."
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button text",
          "default": "Read More"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SS - Scroll Storyteller",
      "blocks": [
        {
          "type": "panel",
          "settings": {
            "layout": "image-left",
            "eyebrow": "Chapter One",
            "heading": "Where It All Began",
            "text": "Every great journey starts with a single step. Ours began with a vision to create something truly exceptional — blending timeless craftsmanship with modern sensibility.",
            "btn_text": "Our Origins"
          }
        },
        {
          "type": "panel",
          "settings": {
            "layout": "image-right",
            "eyebrow": "Chapter Two",
            "heading": "The Craft Behind the Vision",
            "text": "We source only the finest materials and work with artisans who share our obsession with detail. Every stitch, every texture tells a story.",
            "btn_text": "Our Process"
          }
        },
        {
          "type": "panel",
          "settings": {
            "layout": "full-image",
            "eyebrow": "Chapter Three",
            "heading": "Designed for Tomorrow",
            "text": "Sustainability isn't an afterthought — it's woven into everything we do. From responsible sourcing to carbon-neutral shipping.",
            "btn_text": "Our Commitment"
          }
        },
        {
          "type": "panel",
          "settings": {
            "layout": "image-left",
            "eyebrow": "Chapter Four",
            "heading": "Join the Movement",
            "text": "More than a brand, we're a community of people who believe in quality, authenticity, and living intentionally.",
            "btn_text": "Shop Collection"
          }
        }
      ]
    }
  ]
}
{% endschema %}

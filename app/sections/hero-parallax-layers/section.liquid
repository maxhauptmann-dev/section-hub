      "default": "#0a0a0a"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section height (vh)",
      "min": 50,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "vh"
    },
    {
      "type": "range",
      "id": "section_height_mobile",

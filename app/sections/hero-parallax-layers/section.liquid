{% comment %}
  SS - Hero Parallax Layers
  Multi-layer parallax hero with floating shapes, duotone filter,
  animated gradient border, progress bar & staggered text reveals.
  Prefix: shpl-
{% endcomment %}

{%- assign shpl_bg = section.settings.bg_color -%}
{%- assign shpl_height = section.settings.section_height -%}
{%- assign shpl_height_mob = section.settings.section_height_mobile -%}
{%- assign shpl_align = section.settings.text_align -%}
{%- assign shpl_max_w = section.settings.content_max_width -%}

{%- assign shpl_img1 = section.settings.layer1_image -%}
{%- assign shpl_img2 = section.settings.layer2_image -%}
{%- assign shpl_img3 = section.settings.layer3_image -%}
{%- assign shpl_speed1 = section.settings.layer1_speed -%}
{%- assign shpl_speed2 = section.settings.layer2_speed -%}
{%- assign shpl_speed3 = section.settings.layer3_speed -%}

{%- assign shpl_duotone = section.settings.enable_duotone -%}
{%- assign shpl_duo_c1 = section.settings.duotone_color1 -%}
{%- assign shpl_duo_c2 = section.settings.duotone_color2 -%}
{%- assign shpl_duo_opacity = section.settings.duotone_opacity -%}

{%- assign shpl_shapes = section.settings.enable_shapes -%}
{%- assign shpl_shape1_c = section.settings.shape1_color -%}
{%- assign shpl_shape2_c = section.settings.shape2_color -%}
{%- assign shpl_shape3_c = section.settings.shape3_color -%}
{%- assign shpl_shape_blur = section.settings.shape_blur -%}
{%- assign shpl_shape_opacity = section.settings.shape_opacity -%}
{%- assign shpl_shape_speed = section.settings.shape_animation_speed -%}

{%- assign shpl_grain = section.settings.enable_grain -%}
{%- assign shpl_grain_opacity = section.settings.grain_opacity -%}

{%- assign shpl_overlay_style = section.settings.overlay_style -%}

{%- assign shpl_border = section.settings.enable_border_frame -%}
{%- assign shpl_border_inset = section.settings.border_inset -%}
{%- assign shpl_border_w = section.settings.border_width -%}
{%- assign shpl_border_rad = section.settings.border_radius -%}
{%- assign shpl_border_c1 = section.settings.border_color1 -%}
{%- assign shpl_border_c2 = section.settings.border_color2 -%}
{%- assign shpl_border_c3 = section.settings.border_color3 -%}

{%- assign shpl_badge_show = section.settings.show_badge -%}
{%- assign shpl_badge_text = section.settings.badge_text -%}
{%- assign shpl_badge_bg = section.settings.badge_bg -%}
{%- assign shpl_badge_color = section.settings.badge_text_color -%}
{%- assign shpl_badge_dot = section.settings.badge_dot_color -%}
{%- assign shpl_badge_border = section.settings.badge_border_color -%}

{%- assign shpl_subtitle = section.settings.subtitle -%}
{%- assign shpl_subtitle_color = section.settings.subtitle_color -%}

{%- assign shpl_heading = section.settings.heading -%}
{%- assign shpl_heading_color = section.settings.heading_color -%}
{%- assign shpl_heading_gradient = section.settings.heading_gradient -%}
{%- assign shpl_heading_g1 = section.settings.heading_gradient_c1 -%}
{%- assign shpl_heading_g2 = section.settings.heading_gradient_c2 -%}
{%- assign shpl_heading_g3 = section.settings.heading_gradient_c3 -%}
{%- assign shpl_heading_font = section.settings.heading_font -%}

{%- assign shpl_desc = section.settings.description -%}
{%- assign shpl_desc_color = section.settings.description_color -%}

{%- assign shpl_btn1_text = section.settings.btn1_text -%}
{%- assign shpl_btn1_link = section.settings.btn1_link -%}
{%- assign shpl_btn1_style = section.settings.btn1_style -%}
{%- assign shpl_btn1_bg = section.settings.btn1_bg -%}
{%- assign shpl_btn1_color = section.settings.btn1_color -%}
{%- assign shpl_btn1_arrow = section.settings.btn1_show_arrow -%}
{%- assign shpl_btn_radius = section.settings.btn_radius -%}

{%- assign shpl_btn2_text = section.settings.btn2_text -%}
{%- assign shpl_btn2_link = section.settings.btn2_link -%}
{%- assign shpl_btn2_style = section.settings.btn2_style -%}
{%- assign shpl_btn2_color = section.settings.btn2_text_color -%}
{%- assign shpl_btn2_border = section.settings.btn2_border_color -%}
{%- assign shpl_btn2_arrow = section.settings.btn2_show_arrow -%}

{%- assign shpl_progress = section.settings.enable_progress -%}
{%- assign shpl_progress_h = section.settings.progress_height -%}

{%- assign shpl_scroll = section.settings.show_scroll_indicator -%}
{%- assign shpl_scroll_text = section.settings.scroll_text -%}
{%- assign shpl_scroll_color = section.settings.scroll_color -%}

{%- assign shpl_reveal_style = section.settings.reveal_animation -%}

<style>
  {{ shpl_heading_font | font_face: font_display: 'swap' }}

  .shpl-wrap--{{ section.id }} {
    --shpl-bg: {{ shpl_bg }};
    --shpl-height: {{ shpl_height }}vh;
    --shpl-align: {{ shpl_align }};
    --shpl-max-width: {{ shpl_max_w }}px;

    --shpl-duo-opacity: {{ shpl_duo_opacity | divided_by: 100.0 }};
    --shpl-duo-color1: {{ shpl_duo_c1 }};
    --shpl-duo-color2: {{ shpl_duo_c2 }};

    --shpl-shape1-color: {{ shpl_shape1_c }};
    --shpl-shape2-color: {{ shpl_shape2_c }};
    --shpl-shape3-color: {{ shpl_shape3_c }};
    --shpl-shape-blur: {{ shpl_shape_blur }}px;
    --shpl-shape-opacity: {{ shpl_shape_opacity | divided_by: 100.0 }};
    --shpl-shape-speed: {{ shpl_shape_speed }}s;

    --shpl-grain-opacity: {{ shpl_grain_opacity | divided_by: 100.0 }};

    --shpl-border-inset: {{ shpl_border_inset }}px;
    --shpl-border-width: {{ shpl_border_w }}px;
    --shpl-border-radius: {{ shpl_border_rad }}px;
    --shpl-border-c1: {{ shpl_border_c1 }};
    --shpl-border-c2: {{ shpl_border_c2 }};
    --shpl-border-c3: {{ shpl_border_c3 }};

    --shpl-badge-bg: {{ shpl_badge_bg }};
    --shpl-badge-color: {{ shpl_badge_color }};
    --shpl-badge-dot: {{ shpl_badge_dot }};
    --shpl-badge-border: {{ shpl_badge_border }};

    --shpl-subtitle-color: {{ shpl_subtitle_color }};

    --shpl-heading-color: {{ shpl_heading_color }};
    --shpl-heading-ff: {{ shpl_heading_font.family }}, {{ shpl_heading_font.fallback_families }};
    --shpl-heading-fw: {{ shpl_heading_font.weight }};
    --shpl-heading-fs: {{ shpl_heading_font.style }};
    --shpl-heading-g1: {{ shpl_heading_g1 }};
    --shpl-heading-g2: {{ shpl_heading_g2 }};
    --shpl-heading-g3: {{ shpl_heading_g3 }};

    --shpl-desc-color: {{ shpl_desc_color }};

    --shpl-btn1-bg: {{ shpl_btn1_bg }};
    --shpl-btn1-text: {{ shpl_btn1_color }};
    --shpl-btn2-text: {{ shpl_btn2_color }};
    --shpl-btn2-border: {{ shpl_btn2_border }};
    --shpl-btn-radius: {{ shpl_btn_radius }}px;

    --shpl-progress-h: {{ shpl_progress_h }}px;
    --shpl-scroll-color: {{ shpl_scroll_color }};
  }

  @media (max-width: 749px) {
    .shpl-wrap--{{ section.id }} {
      --shpl-height: {{ shpl_height_mob }}vh;
    }
  }
</style>

<section class="shpl-wrap shpl-wrap--{{ section.id }}" data-section-id="{{ section.id }}">

  {%- comment -%} Parallax layers {%- endcomment -%}
  <div class="shpl-layers">
    {%- if shpl_img1 != blank -%}
      <div class="shpl-layer shpl-layer--bg" data-shpl-speed="{{ shpl_speed1 }}">
        <img
          src="{{ shpl_img1 | image_url: width: 2400 }}"
          srcset="{{ shpl_img1 | image_url: width: 800 }} 800w,
                  {{ shpl_img1 | image_url: width: 1200 }} 1200w,
                  {{ shpl_img1 | image_url: width: 1800 }} 1800w,
                  {{ shpl_img1 | image_url: width: 2400 }} 2400w"
          sizes="100vw"
          alt="{{ shpl_img1.alt | escape }}"
          loading="eager"
          fetchpriority="high"
          width="{{ shpl_img1.width }}"
          height="{{ shpl_img1.height }}"
        >
      </div>
    {%- endif -%}

    {%- if shpl_img2 != blank -%}
      <div class="shpl-layer shpl-layer--mid" data-shpl-speed="{{ shpl_speed2 }}">
        <img
          src="{{ shpl_img2 | image_url: width: 1200 }}"
          srcset="{{ shpl_img2 | image_url: width: 600 }} 600w,
                  {{ shpl_img2 | image_url: width: 900 }} 900w,
                  {{ shpl_img2 | image_url: width: 1200 }} 1200w"
          sizes="40vw"
          alt="{{ shpl_img2.alt | escape }}"
          loading="eager"
          width="{{ shpl_img2.width }}"
          height="{{ shpl_img2.height }}"
        >
      </div>
    {%- endif -%}

    {%- if shpl_img3 != blank -%}
      <div class="shpl-layer shpl-layer--front" data-shpl-speed="{{ shpl_speed3 }}">
        <img
          src="{{ shpl_img3 | image_url: width: 1200 }}"
          srcset="{{ shpl_img3 | image_url: width: 600 }} 600w,
                  {{ shpl_img3 | image_url: width: 900 }} 900w,
                  {{ shpl_img3 | image_url: width: 1200 }} 1200w"
          sizes="35vw"
          alt="{{ shpl_img3.alt | escape }}"
          loading="eager"
          width="{{ shpl_img3.width }}"
          height="{{ shpl_img3.height }}"
        >
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} Duotone filter {%- endcomment -%}
  {%- if shpl_duotone -%}
    <div class="shpl-duotone"></div>
  {%- endif -%}

  {%- comment -%} Floating shapes {%- endcomment -%}
  {%- if shpl_shapes -%}
    <div class="shpl-shapes">
      <div class="shpl-shape shpl-shape--1"></div>
      <div class="shpl-shape shpl-shape--2"></div>
      <div class="shpl-shape shpl-shape--3"></div>
    </div>
  {%- endif -%}

  {%- comment -%} Grain overlay {%- endcomment -%}
  {%- if shpl_grain -%}
    <div class="shpl-grain"></div>
  {%- endif -%}

  {%- comment -%} Gradient overlay {%- endcomment -%}
  {%- if shpl_overlay_style != 'none' -%}
    <div class="shpl-gradient-overlay shpl-gradient-overlay--{{ shpl_overlay_style }}"></div>
  {%- endif -%}

  {%- comment -%} Animated border frame {%- endcomment -%}
  {%- if shpl_border -%}
    <div class="shpl-border-frame"></div>
  {%- endif -%}

  {%- comment -%} Content {%- endcomment -%}
  <div class="shpl-content" style="--shpl-align: {{ shpl_align }}; max-width: {{ shpl_max_w }}px;">

    {%- if shpl_badge_show and shpl_badge_text != blank -%}
      <div class="shpl-badge shpl-reveal shpl-reveal--d1">
        <span class="shpl-badge__dot"></span>
        {{ shpl_badge_text }}
      </div>
    {%- endif -%}

    {%- if shpl_subtitle != blank -%}
      <p class="shpl-subtitle shpl-reveal shpl-reveal--d2">{{ shpl_subtitle }}</p>
    {%- endif -%}

    {%- if shpl_heading != blank -%}
      <h2 class="shpl-heading{% if shpl_heading_gradient %} shpl-heading--gradient{% endif %} shpl-reveal{% if shpl_reveal_style == 'blur' %}-blur{% elsif shpl_reveal_style == 'scale' %}-scale{% endif %} shpl-reveal--d3">
        {{ shpl_heading }}
      </h2>
    {%- endif -%}

    {%- if shpl_desc != blank -%}
      <p class="shpl-description shpl-reveal shpl-reveal--d4">{{ shpl_desc }}</p>
    {%- endif -%}

    {%- if shpl_btn1_text != blank or shpl_btn2_text != blank -%}
      <div class="shpl-buttons shpl-reveal shpl-reveal--d5">
        {%- if shpl_btn1_text != blank -%}
          <a href="{{ shpl_btn1_link | default: '#' }}" class="shpl-btn shpl-btn--{{ shpl_btn1_style }}">
            {{ shpl_btn1_text }}
            {%- if shpl_btn1_arrow -%}
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            {%- endif -%}
          </a>
        {%- endif -%}

        {%- if shpl_btn2_text != blank -%}
          <a href="{{ shpl_btn2_link | default: '#' }}" class="shpl-btn shpl-btn--{{ shpl_btn2_style }}">
            {{ shpl_btn2_text }}
            {%- if shpl_btn2_arrow -%}
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            {%- endif -%}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>

  {%- comment -%} Progress bar {%- endcomment -%}
  {%- if shpl_progress -%}
    <div class="shpl-progress" data-shpl-progress></div>
  {%- endif -%}

  {%- comment -%} Scroll indicator {%- endcomment -%}
  {%- if shpl_scroll -%}
    <div class="shpl-scroll-indicator shpl-reveal shpl-reveal--d5">
      <div class="shpl-scroll-indicator__mouse"></div>
      {%- if shpl_scroll_text != blank -%}
        <span>{{ shpl_scroll_text }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}

</section>

<script>
  (function() {
    var section = document.querySelector('.shpl-wrap--{{ section.id }}');
    if (!section) return;

    var layers = section.querySelectorAll('.shpl-layer');
    var progressBar = section.querySelector('[data-shpl-progress]');

    if (layers.length === 0) return;

    var ticking = false;

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function() {
        /* Simple: use raw scroll position (window.scrollY) */
        var scrollY = window.pageYOffset || document.documentElement.scrollTop;

        layers.forEach(function(layer) {
          var speed = parseFloat(layer.dataset.shplSpeed) || 0;
          /* Direct pixel offset: speed 1 → 1px per 10px scrolled
             speed 5 → 5px per 10px scrolled */
          var yOffset = scrollY * speed * -0.15;

          if (layer.classList.contains('shpl-layer--bg')) {
            layer.style.transform = 'translate3d(0,' + yOffset + 'px,0) scale(1.1)';
          } else {
            layer.style.transform = 'translate3d(0,' + yOffset + 'px,0)';
          }
        });

        if (progressBar) {
          var rect = section.getBoundingClientRect();
          var sectionH = section.offsetHeight;
          var winH = window.innerHeight;
          var maxScroll = sectionH - winH;
          var p = maxScroll > 0 ? Math.min(Math.max(-rect.top / maxScroll, 0), 1) : 0;
          progressBar.style.width = (p * 100) + '%';
        }

        ticking = false;
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    onScroll();
  })();
</script>

{% schema %}
{
  "name": "SIQ - Hero Parallax",
  "tag": "section",
  "class": "shpl-section",
  "settings": [
    {
      "type": "header",

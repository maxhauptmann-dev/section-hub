{% comment %}
  Section Hub – Shop the Look – Slider v1.0
  Large lifestyle image on one side, product slider carousel on the other.
  Swipeable on mobile, arrow + dot navigation.
{% endcomment %}

{%- liquid
  assign heading         = section.settings.heading
  assign use_custom_font = section.settings.use_custom_font
  assign heading_font    = section.settings.heading_font_family
  assign heading_size    = section.settings.heading_size
  assign heading_size_m  = section.settings.heading_size_mobile
  assign heading_lh      = section.settings.heading_line_height
  assign heading_align   = section.settings.heading_text_align
  assign heading_align_m = section.settings.heading_text_align_mobile
  assign heading_color   = section.settings.heading_color
  assign heading_mb      = section.settings.heading_margin_bottom
  assign heading_mb_m    = section.settings.heading_margin_bottom_mobile

  assign img             = section.settings.image
  assign img_mobile      = section.settings.image_mobile
  assign img_position    = section.settings.image_position
  assign img_round       = section.settings.image_roundness
  assign img_border      = section.settings.image_border_thickness
  assign img_border_c    = section.settings.image_border_color
  assign img_aspect      = section.settings.image_aspect_ratio
  assign img_fit         = section.settings.image_fit

  assign slider_mt       = section.settings.slider_margin_top
  assign slider_mt_m     = section.settings.slider_margin_top_mobile
  assign slide_round     = section.settings.slide_image_roundness
  assign slide_border    = section.settings.slide_image_border_thickness
  assign slide_border_c  = section.settings.slide_image_border_color
  assign slide_aspect    = section.settings.slide_image_aspect_ratio
  assign slide_fit       = section.settings.slide_image_fit

  assign slide_align     = section.settings.slide_content_align
  assign use_title_font  = section.settings.use_custom_font_title
  assign title_font      = section.settings.slide_title_font_family
  assign title_size      = section.settings.slide_title_size
  assign title_color     = section.settings.slide_title_color
  assign price_size      = section.settings.slide_price_size
  assign price_color     = section.settings.slide_price_color
  assign price_compare_c = section.settings.slide_price_compare_color
  assign price_mt        = section.settings.slide_price_margin_top

  assign arrow_size      = section.settings.arrow_size
  assign arrow_color     = section.settings.arrow_color
  assign arrow_bg        = section.settings.arrow_bg
  assign arrow_round     = section.settings.arrow_roundness
  assign show_arrows_m   = section.settings.show_arrows_mobile
  assign dot_size        = section.settings.dot_size
  assign dot_color       = section.settings.dot_color
  assign dot_active_c    = section.settings.dot_active_color
  assign show_dots_m     = section.settings.show_dots_mobile

  assign bg_color        = section.settings.section_bg
  assign bg_gradient     = section.settings.section_bg_gradient
  assign content_width   = section.settings.content_width
  assign full_width      = section.settings.full_width
  assign sec_round       = section.settings.section_roundness
  assign lazy            = section.settings.lazy_load

  assign margin_top      = section.settings.margin_top
  assign margin_bottom   = section.settings.margin_bottom
  assign padding_top     = section.settings.padding_top
  assign padding_bottom  = section.settings.padding_bottom
  assign padding_sides   = section.settings.padding_sides
  assign padding_sides_m = section.settings.padding_sides_mobile
  assign custom_css      = section.settings.custom_css
-%}

{%- liquid
  case img_aspect
    when 'square'
      assign iar = '1/1'
    when 'portrait'
      assign iar = '3/4'
    when 'landscape'
      assign iar = '4/3'
    when 'tall'
      assign iar = '2/3'
    else
      assign iar = 'auto'
  endcase
  case slide_aspect
    when 'square'
      assign sar = '1/1'
    when 'portrait'
      assign sar = '3/4'
    when 'landscape'
      assign sar = '4/3'
    else
      assign sar = 'auto'
  endcase
-%}

{%- if use_custom_font -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family={{ heading_font | replace: ' ', '+' }}:wght@400;700&display=swap" rel="stylesheet">
{%- endif -%}
{%- if use_title_font -%}
  <link href="https://fonts.googleapis.com/css2?family={{ title_font | replace: ' ', '+' }}:wght@400;600&display=swap" rel="stylesheet">
{%- endif -%}

<style>
  #stls-{{ section.id }} {
    --stls-heading-font: {% if use_custom_font %}'{{ heading_font }}', serif{% else %}inherit{% endif %};
    --stls-heading-size: {{ heading_size }}px;
    --stls-heading-size-m: {{ heading_size_m }}px;
    --stls-heading-lh: {{ heading_lh }};
    --stls-heading-color: {{ heading_color }};
    --stls-heading-align: {{ heading_align }};
    --stls-heading-align-m: {{ heading_align_m }};
    --stls-heading-mb: {{ heading_mb }}px;
    --stls-heading-mb-m: {{ heading_mb_m }}px;

    --stls-img-round: {{ img_round }}px;
    --stls-img-border: {{ img_border }}px;
    --stls-img-border-c: {{ img_border_c }};
    --stls-img-ar: {{ iar }};
    --stls-img-fit: {{ img_fit }};

    --stls-slider-mt: {{ slider_mt }}px;
    --stls-slider-mt-m: {{ slider_mt_m }}px;
    --stls-slide-round: {{ slide_round }}px;
    --stls-slide-border: {{ slide_border }}px;
    --stls-slide-border-c: {{ slide_border_c }};
    --stls-slide-ar: {{ sar }};
    --stls-slide-fit: {{ slide_fit }};

    --stls-slide-align: {{ slide_align }};
    --stls-title-font: {% if use_title_font %}'{{ title_font }}', sans-serif{% else %}inherit{% endif %};
    --stls-title-size: {{ title_size }}px;
    --stls-title-color: {{ title_color }};
    --stls-price-size: {{ price_size }}px;
    --stls-price-color: {{ price_color }};
    --stls-price-compare-c: {{ price_compare_c }};
    --stls-price-mt: {{ price_mt }}px;

    --stls-arrow-size: {{ arrow_size }}px;
    --stls-arrow-color: {{ arrow_color }};
    --stls-arrow-bg: {{ arrow_bg }};
    --stls-arrow-round: {{ arrow_round }}px;
    --stls-dot-size: {{ dot_size }}px;
    --stls-dot-color: {{ dot_color }};
    --stls-dot-active: {{ dot_active_c }};

    --stls-bg: {% if bg_gradient != blank %}{{ bg_gradient }}{% else %}{{ bg_color }}{% endif %};
    --stls-content-w: {{ content_width }}px;
    --stls-sec-round: {{ sec_round }}px;

    --stls-mt: {{ margin_top }}px;
    --stls-mb: {{ margin_bottom }}px;
    --stls-pt: {{ padding_top }}px;
    --stls-pb: {{ padding_bottom }}px;
    --stls-ps: {{ padding_sides }}px;
    --stls-ps-m: {{ padding_sides_m }}px;
  }
  {% if custom_css != blank %}{{ custom_css }}{% endif %}
</style>

<section id="stls-{{ section.id }}" class="stls-section{% if full_width %} stls-full-width{% endif %}">
  <div class="stls-wrapper">
    {%- if heading != blank -%}
      <h2 class="stls-heading">{{ heading }}</h2>
    {%- endif -%}

    <div class="stls-layout{% if img_position == 'right' %} stls-layout--reversed{% endif %}">
      {%- comment -%} Lifestyle image {%- endcomment -%}
      <div class="stls-image-col">
        <div class="stls-image-wrap">
          {%- if img != blank -%}
            <picture>
              {%- if img_mobile != blank -%}
                <source media="(max-width: 749px)" srcset="{{ img_mobile | image_url: width: 800 }}">
              {%- endif -%}
              <img
                src="{{ img | image_url: width: 1000 }}"
                alt="{{ img.alt | default: heading | escape }}"
                width="1000"
                height="{{ 1000 | divided_by: img.aspect_ratio | round }}"
                class="stls-image"
                {% if lazy %}loading="lazy"{% endif %}
              >
            </picture>
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'stls-image stls-placeholder' }}
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Product slider {%- endcomment -%}
      <div class="stls-slider-col">
        <div class="stls-slider" data-stls-slider="{{ section.id }}">
          <div class="stls-slider__track">
            {%- for block in section.blocks -%}
              {%- if block.type == 'slide' -%}
                {%- assign p = block.settings.product -%}
                <div class="stls-slide{% if forloop.first %} stls-slide--active{% endif %}" data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                  <a href="{% if p != blank %}{{ p.url }}{% else %}#{% endif %}" class="stls-slide__link">
                    <div class="stls-slide__img-wrap">
                      {%- if block.settings.custom_image != blank -%}
                        <img
                          src="{{ block.settings.custom_image | image_url: width: 600 }}"
                          alt="{{ block.settings.custom_image.alt | escape }}"
                          class="stls-slide__img"
                          {% if lazy %}loading="lazy"{% endif %}
                        >
                      {%- elsif p != blank and p.featured_image != blank -%}
                        <img
                          src="{{ p.featured_image | image_url: width: 600 }}"
                          alt="{{ p.featured_image.alt | escape }}"
                          class="stls-slide__img"
                          {% if lazy %}loading="lazy"{% endif %}
                        >
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'stls-slide__img stls-placeholder' }}
                      {%- endif -%}
                    </div>
                    <div class="stls-slide__info">
                      <p class="stls-slide__title">
                        {%- if p != blank -%}{{ p.title }}{%- else -%}Product Title{%- endif -%}
                      </p>
                      <p class="stls-slide__price">
                        {%- if p != blank -%}
                          {%- if p.compare_at_price > p.price -%}
                            <span class="stls-slide__price-sale">{{ p.price | money }}</span>
                            <s class="stls-slide__price-compare">{{ p.compare_at_price | money }}</s>
                          {%- else -%}
                            {{ p.price | money }}
                          {%- endif -%}
                        {%- else -%}
                          $0.00
                        {%- endif -%}
                      </p>
                    </div>
                  </a>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- comment -%} Arrow navigation {%- endcomment -%}
          <button class="stls-arrow stls-arrow--prev{% unless show_arrows_m %} stls-hide-mobile{% endunless %}" aria-label="Previous" data-stls-prev>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button class="stls-arrow stls-arrow--next{% unless show_arrows_m %} stls-hide-mobile{% endunless %}" aria-label="Next" data-stls-next>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
          </button>

          {%- comment -%} Dot navigation {%- endcomment -%}
          <div class="stls-dots{% unless show_dots_m %} stls-hide-mobile{% endunless %}">
            {%- assign slide_count = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'slide' -%}
                <button class="stls-dot{% if slide_count == 0 %} stls-dot--active{% endif %}" data-stls-dot="{{ slide_count }}" aria-label="Go to slide {{ slide_count | plus: 1 }}"></button>
                {%- assign slide_count = slide_count | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('stls-{{ section.id }}');
    if (!root) return;
    var slider = root.querySelector('[data-stls-slider]');
    if (!slider) return;
    var slides = slider.querySelectorAll('.stls-slide');
    var dots = slider.querySelectorAll('.stls-dot');
    var idx = 0;

    function go(i) {
      if (i < 0) i = slides.length - 1;
      if (i >= slides.length) i = 0;
      slides.forEach(function (s, n) {
        s.classList.toggle('stls-slide--active', n === i);
        s.style.display = n === i ? '' : 'none';
      });
      dots.forEach(function (d, n) {
        d.classList.toggle('stls-dot--active', n === i);
      });
      idx = i;
    }

    slider.querySelector('[data-stls-prev]').addEventListener('click', function () { go(idx - 1); });
    slider.querySelector('[data-stls-next]').addEventListener('click', function () { go(idx + 1); });
    dots.forEach(function (d) {
      d.addEventListener('click', function () { go(parseInt(d.dataset.stlsDot, 10)); });
    });

    /* touch swipe */
    var sx = 0;
    slider.addEventListener('touchstart', function (e) { sx = e.touches[0].clientX; }, { passive: true });
    slider.addEventListener('touchend', function (e) {
      var diff = sx - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) go(diff > 0 ? idx + 1 : idx - 1);
    });

    /* init: hide non-active */
    go(0);
  })();
</script>

{% schema %}
{
  "name": "Shop the Look – Slider",
  "tag": "section",
  "class": "stls-root",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the Look"
    },
    {
      "type": "checkbox",
      "id": "use_custom_font",
      "label": "Use Custom Heading Font",
      "default": false
    },
    {
      "type": "text",
      "id": "heading_font_family",
      "label": "Heading Font Family",
      "default": "Playfair Display"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 18,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading Size – Mobile",
      "min": 16,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Heading Line Height",
      "min": 0.8,
      "max": 2.0,
      "step": 0.1,
      "default": 1.2
    },
    {
      "type": "select",
      "id": "heading_text_align",
      "label": "Heading Align",

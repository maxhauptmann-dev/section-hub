          "min": 0,
          "max": 3,
          "step": 1,
          "default": 1,
          "info": "0 = static, 1 = normal, 2 = fast, 3 = dramatic."
        },
        {
          "type": "header",
          "content": "Card size"
        },
        {
          "type": "select",
          "id": "card_height",
          "label": "Card height",
          "options": [
            { "value": "auto", "label": "Auto (layout default)" },
            { "value": "small", "label": "Small" },
            { "value": "medium", "label": "Medium" },
            { "value": "large", "label": "Large" },
            { "value": "xl", "label": "Extra Large" }
          ],
          "default": "auto",
          "info": "Overrides the height for this card individually."
        },
        {
          "type": "select",

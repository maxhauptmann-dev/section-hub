      "id": "stagger_delay",
      "label": "Stagger delay between cards",
      "min": 0,
      "max": 300,
      "step": 50,
      "default": 100,
      "unit": "ms"
    },
    {
      "type": "range",
      "id": "parallax_depth",
      "label": "Parallax depth",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 25,

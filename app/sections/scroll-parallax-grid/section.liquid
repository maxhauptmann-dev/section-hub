          "options": [
            { "value": "auto", "label": "Auto (1 column)" },
            { "value": "wide", "label": "Wide (2 columns)" },
            { "value": "full", "label": "Full row" }
          ],
          "default": "auto",
          "info": "Span multiple columns. Only applies in Masonry & Equal layouts."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SIQ - Parallax Grid",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "label": "Midnight Architecture",
            "description": "Bold lines and shadows in urban landscapes.",
            "category_tag": "Architecture",
            "parallax_speed": 2
          }
        },
        {
          "type": "card",
          "settings": {
            "label": "Golden Hour Portraits",
            "description": "Authentic warmth captured in natural light.",
            "category_tag": "Photography",
            "parallax_speed": 1
          }
        },
        {
          "type": "card",
          "settings": {
            "label": "Textile Craft",
            "description": "Hand-woven artistry meets modern design.",
            "category_tag": "Craft",
            "parallax_speed": 3
          }
        },
        {
          "type": "card",
          "settings": {
            "label": "Brand Identity System",
            "description": "Complete visual language for a luxury brand.",
            "category_tag": "Branding",
            "parallax_speed": 1
          }
        },
        {
          "type": "card",
          "settings": {
            "label": "Nature in Detail",
            "description": "Macro photography revealing hidden textures.",
            "category_tag": "Nature",
            "parallax_speed": 2
          }
        },
        {
          "type": "card",
          "settings": {
            "label": "Minimalist Interior",
            "description": "Less is more in contemporary living spaces.",
            "category_tag": "Interior",
            "parallax_speed": 1
          }
        }
      ]
    }
  ]
}
{% endschema %}

      "info": "How much cards move relative to scroll. 0 = disabled."
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button text",
      "default": "View All Projects"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "CTA style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" },
        { "value": "glass", "label": "Glass / Frosted" }
      ],
      "default": "glass"
    },
    {
      "type": "range",
      "id": "cta_radius",
      "label": "CTA border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "default": 8,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Gallery Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Title",
          "default": "Project Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "A brief description of this project or visual."
        },

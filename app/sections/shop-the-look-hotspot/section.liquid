{% comment %}
  Section Hub – Shop the Look – Hotspot v1.0
  Interactive dots on a lifestyle image that open product popup cards.
  Click a dot → product card appears next to it with image, title, price & CTA.
{% endcomment %}

{%- liquid
  assign heading         = section.settings.heading
  assign use_custom_font = section.settings.use_custom_font
  assign heading_font    = section.settings.heading_font_family
  assign heading_size    = section.settings.heading_size
  assign heading_size_m  = section.settings.heading_size_mobile
  assign heading_lh      = section.settings.heading_line_height
  assign heading_color   = section.settings.heading_color
  assign heading_align   = section.settings.heading_text_align
  assign heading_mb      = section.settings.heading_margin_bottom
  assign heading_mb_m    = section.settings.heading_margin_bottom_mobile

  assign img             = section.settings.image
  assign img_mobile      = section.settings.image_mobile
  assign img_round       = section.settings.image_roundness
  assign img_border      = section.settings.image_border_thickness
  assign img_border_c    = section.settings.image_border_color
  assign img_aspect      = section.settings.image_aspect_ratio
  assign img_aspect_m    = section.settings.image_aspect_ratio_mobile
  assign img_fit         = section.settings.image_fit
  assign img_max_h       = section.settings.image_max_height
  assign img_max_h_m     = section.settings.image_max_height_mobile

  assign dot_size        = section.settings.dot_size
  assign dot_bg          = section.settings.dot_bg
  assign dot_border_c    = section.settings.dot_border_color
  assign dot_border_w    = section.settings.dot_border_width
  assign dot_pulse       = section.settings.dot_pulse
  assign dot_pulse_c     = section.settings.dot_pulse_color

  assign popup_bg        = section.settings.popup_bg
  assign popup_round     = section.settings.popup_roundness
  assign popup_w         = section.settings.popup_width
  assign popup_shadow    = section.settings.popup_shadow
  assign popup_img_ratio = section.settings.popup_image_ratio
  assign popup_img_round = section.settings.popup_image_roundness

  assign use_title_font  = section.settings.use_custom_font_title
  assign title_font      = section.settings.popup_title_font_family
  assign title_size      = section.settings.popup_title_size
  assign title_color     = section.settings.popup_title_color
  assign price_size      = section.settings.popup_price_size
  assign price_color     = section.settings.popup_price_color
  assign price_compare_c = section.settings.popup_price_compare_color

  assign btn_label       = section.settings.button_label
  assign btn_bg          = section.settings.button_bg
  assign btn_color       = section.settings.button_color
  assign btn_round       = section.settings.button_roundness

  assign image_layout    = section.settings.image_layout
  assign sidebar_width   = section.settings.sidebar_width
  assign sidebar_bg      = section.settings.sidebar_bg

  assign bg_color        = section.settings.section_bg
  assign bg_gradient     = section.settings.section_bg_gradient
  assign content_width   = section.settings.content_width
  assign full_width      = section.settings.full_width
  assign sec_round       = section.settings.section_roundness
  assign lazy            = section.settings.lazy_load
  assign margin_top      = section.settings.margin_top
  assign margin_bottom   = section.settings.margin_bottom
  assign padding_top     = section.settings.padding_top
  assign padding_bottom  = section.settings.padding_bottom
  assign padding_sides   = section.settings.padding_sides
  assign padding_sides_m = section.settings.padding_sides_mobile
  assign custom_css      = section.settings.custom_css
-%}

{%- liquid
  case img_aspect
    when 'square'
      assign iar = '1/1'
    when 'portrait'
      assign iar = '3/4'
    when 'landscape'
      assign iar = '4/3'
    when 'wide'
      assign iar = '16/9'
    else
      assign iar = 'auto'
  endcase
  case img_aspect_m
    when 'square'
      assign iar_m = '1/1'
    when 'portrait'
      assign iar_m = '3/4'
    when 'landscape'
      assign iar_m = '4/3'
    else
      assign iar_m = 'auto'
  endcase
  case popup_img_ratio
    when 'square'
      assign pir = '1/1'
    when 'portrait'
      assign pir = '3/4'
    when 'landscape'
      assign pir = '4/3'
    else
      assign pir = '1/1'
  endcase
-%}

{%- if use_custom_font -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family={{ heading_font | replace: ' ', '+' }}:wght@400;700&display=swap" rel="stylesheet">
{%- endif -%}
{%- if use_title_font -%}
  <link href="https://fonts.googleapis.com/css2?family={{ title_font | replace: ' ', '+' }}:wght@400;600&display=swap" rel="stylesheet">
{%- endif -%}

<style>
  #stlh-{{ section.id }} {
    --stlh-heading-font: {% if use_custom_font %}'{{ heading_font }}', serif{% else %}inherit{% endif %};
    --stlh-heading-size: {{ heading_size }}px;
    --stlh-heading-size-m: {{ heading_size_m }}px;
    --stlh-heading-lh: {{ heading_lh }};
    --stlh-heading-color: {{ heading_color }};
    --stlh-heading-align: {{ heading_align }};
    --stlh-heading-mb: {{ heading_mb }}px;
    --stlh-heading-mb-m: {{ heading_mb_m }}px;

    --stlh-img-round: {{ img_round }}px;
    --stlh-img-border: {{ img_border }}px;
    --stlh-img-border-c: {{ img_border_c }};
    --stlh-img-ar: {{ iar }};
    --stlh-img-ar-m: {{ iar_m }};
    --stlh-img-fit: {{ img_fit }};
    --stlh-img-max-h: {% if img_max_h > 0 %}{{ img_max_h }}px{% else %}none{% endif %};
    --stlh-img-max-h-m: {% if img_max_h_m > 0 %}{{ img_max_h_m }}px{% else %}none{% endif %};

    --stlh-dot-size: {{ dot_size }}px;
    --stlh-dot-bg: {{ dot_bg }};
    --stlh-dot-border-c: {{ dot_border_c }};
    --stlh-dot-border-w: {{ dot_border_w }}px;
    --stlh-dot-pulse-c: {{ dot_pulse_c }};

    --stlh-popup-bg: {{ popup_bg }};
    --stlh-popup-round: {{ popup_round }}px;
    --stlh-popup-w: {{ popup_w }}px;
    --stlh-popup-img-ar: {{ pir }};
    --stlh-popup-img-round: {{ popup_img_round }}px;

    --stlh-title-font: {% if use_title_font %}'{{ title_font }}', sans-serif{% else %}inherit{% endif %};
    --stlh-title-size: {{ title_size }}px;
    --stlh-title-color: {{ title_color }};
    --stlh-price-size: {{ price_size }}px;
    --stlh-price-color: {{ price_color }};
    --stlh-price-compare-c: {{ price_compare_c }};

    --stlh-btn-bg: {{ btn_bg }};
    --stlh-btn-color: {{ btn_color }};
    --stlh-btn-round: {{ btn_round }}px;

    --stlh-bg: {% if bg_gradient != blank %}{{ bg_gradient }}{% else %}{{ bg_color }}{% endif %};
    --stlh-content-w: {{ content_width }}px;
    --stlh-sec-round: {{ sec_round }}px;
    --stlh-sidebar-w: {{ sidebar_width }}%;
    --stlh-sidebar-bg: {{ sidebar_bg }};
    --stlh-mt: {{ margin_top }}px;
    --stlh-mb: {{ margin_bottom }}px;
    --stlh-pt: {{ padding_top }}px;
    --stlh-pb: {{ padding_bottom }}px;
    --stlh-ps: {{ padding_sides }}px;
    --stlh-ps-m: {{ padding_sides_m }}px;
  }
  {% if custom_css != blank %}{{ custom_css }}{% endif %}
</style>

<section id="stlh-{{ section.id }}" class="stlh-section{% if full_width %} stlh-full-width{% endif %}">
  <div class="stlh-wrapper">
    {%- if heading != blank -%}
      <h2 class="stlh-heading">{{ heading }}</h2>
    {%- endif -%}

    <div class="stlh-layout stlh-layout--{{ image_layout }}">

      <div class="stlh-canvas" data-stlh-canvas="{{ section.id }}">
      {%- comment -%} Background image {%- endcomment -%}
      <div class="stlh-image-wrap">
        {%- if img != blank -%}
          <picture>
            {%- if img_mobile != blank -%}
              <source media="(max-width: 749px)" srcset="{{ img_mobile | image_url: width: 800 }}">
            {%- endif -%}
            <img src="{{ img | image_url: width: 1400 }}" alt="{{ img.alt | default: heading | escape }}" class="stlh-image" {% if lazy %}loading="lazy"{% endif %}>
          </picture>
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'stlh-image stlh-placeholder' }}
        {%- endif -%}
      </div>

      {%- comment -%} Hotspot dots + popup cards {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'hotspot_product' -%}
          {%- assign p = block.settings.product -%}
          <div class="stlh-spot" {{ block.shopify_attributes }}
               style="left:{{ block.settings.dot_x }}%;top:{{ block.settings.dot_y }}%;"
               data-stlh-spot>
            <button class="stlh-dot{% if dot_pulse %} stlh-dot--pulse{% endif %}" aria-label="{% if p != blank %}{{ p.title | escape }}{% else %}View product{% endif %}" data-stlh-toggle>
              <span class="stlh-dot__inner"></span>
              {%- if dot_pulse -%}<span class="stlh-dot__ping"></span>{%- endif -%}
            </button>

            {%- comment -%} Popup card {%- endcomment -%}
            <div class="stlh-popup" data-stlh-popup>
              <button class="stlh-popup__close" aria-label="Close" data-stlh-close>✕</button>
              {%- if p != blank -%}
                <a href="{{ p.url }}" class="stlh-popup__link">
                  <div class="stlh-popup__img-wrap">
                    {%- if block.settings.custom_image != blank -%}
                      <img src="{{ block.settings.custom_image | image_url: width: 400 }}" alt="" class="stlh-popup__img" {% if lazy %}loading="lazy"{% endif %}>
                    {%- elsif p.featured_image != blank -%}
                      <img src="{{ p.featured_image | image_url: width: 400 }}" alt="{{ p.featured_image.alt | escape }}" class="stlh-popup__img" {% if lazy %}loading="lazy"{% endif %}>
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'stlh-popup__img stlh-placeholder' }}
                    {%- endif -%}
                  </div>
                  <div class="stlh-popup__info">
                    <p class="stlh-popup__title">{{ p.title }}</p>
                    <p class="stlh-popup__price">
                      {%- if p.compare_at_price > p.price -%}
                        <span class="stlh-popup__price-sale">{{ p.price | money }}</span>
                        <s class="stlh-popup__price-compare">{{ p.compare_at_price | money }}</s>
                      {%- else -%}
                        {{ p.price | money }}
                      {%- endif -%}
                    </p>
                    <span class="stlh-popup__btn">{{ btn_label }}</span>
                  </div>
                </a>
              {%- else -%}
                <div class="stlh-popup__empty">Select a product</div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>{%- comment -%} /stlh-canvas {%- endcomment -%}

    {%- comment -%} Desktop sidebar – only visible in left/right layout {%- endcomment -%}
    <div class="stlh-sidebar">
      {%- for block in section.blocks -%}
        {%- if block.type == 'hotspot_product' -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank -%}
            <a href="{{ p.url }}" class="stlh-sidebar-card" {{ block.shopify_attributes }}>
              <div class="stlh-sidebar-card__img-wrap">
                {%- if block.settings.custom_image != blank -%}
                  <img src="{{ block.settings.custom_image | image_url: width: 200 }}" alt="" class="stlh-sidebar-card__img" {% if lazy %}loading="lazy"{% endif %}>
                {%- elsif p.featured_image != blank -%}
                  <img src="{{ p.featured_image | image_url: width: 200 }}" alt="{{ p.featured_image.alt | escape }}" class="stlh-sidebar-card__img" {% if lazy %}loading="lazy"{% endif %}>
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'stlh-sidebar-card__img stlh-placeholder' }}
                {%- endif -%}
              </div>
              <div class="stlh-sidebar-card__info">
                <p class="stlh-sidebar-card__title">{{ p.title }}</p>
                <p class="stlh-sidebar-card__price">
                  {%- if p.compare_at_price > p.price -%}
                    <span class="stlh-sidebar-card__price-sale">{{ p.price | money }}</span>
                    <s class="stlh-sidebar-card__price-compare">{{ p.compare_at_price | money }}</s>
                  {%- else -%}
                    {{ p.price | money }}
                  {%- endif -%}
                </p>
                <span class="stlh-sidebar-card__btn">{{ btn_label }}</span>
              </div>
            </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    </div>{%- comment -%} /stlh-layout {%- endcomment -%}

    {%- comment -%} Mobile bottom-bar with products {%- endcomment -%}
    <div class="stlh-mobile-bar" data-stlh-bar>
      {%- for block in section.blocks -%}
        {%- if block.type == 'hotspot_product' -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank -%}
            <a href="{{ p.url }}" class="stlh-mobile-card">
              <div class="stlh-mobile-card__img-wrap">
                {%- if p.featured_image != blank -%}
                  <img src="{{ p.featured_image | image_url: width: 120 }}" alt="{{ p.featured_image.alt | escape }}" class="stlh-mobile-card__img" loading="lazy">
                {%- endif -%}
              </div>
              <div class="stlh-mobile-card__info">
                <p class="stlh-mobile-card__title">{{ p.title | truncate: 30 }}</p>
                <p class="stlh-mobile-card__price">{{ p.price | money }}</p>
              </div>
            </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('stlh-{{ section.id }}');
    if (!root) return;
    var spots = root.querySelectorAll('[data-stlh-spot]');

    function closeAll() {
      spots.forEach(function (s) { s.querySelector('[data-stlh-popup]').classList.remove('stlh-popup--open'); });
    }

    spots.forEach(function (spot) {
      var toggle = spot.querySelector('[data-stlh-toggle]');
      var popup = spot.querySelector('[data-stlh-popup]');
      var close = spot.querySelector('[data-stlh-close]');

      toggle.addEventListener('click', function (e) {
        e.stopPropagation();
        var isOpen = popup.classList.contains('stlh-popup--open');
        closeAll();
        if (!isOpen) popup.classList.add('stlh-popup--open');
      });

      if (close) close.addEventListener('click', function (e) { e.stopPropagation(); popup.classList.remove('stlh-popup--open'); });
    });

    document.addEventListener('click', closeAll);
    root.querySelector('.stlh-canvas').addEventListener('click', function (e) { e.stopPropagation(); closeAll(); });
  })();
</script>

{% schema %}
{
  "name": "Shop the Look – Hotspot",
  "tag": "section",
  "class": "stlh-root",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the look"
    },
    {
      "type": "checkbox",
      "id": "use_custom_font",
      "label": "Use Custom Heading Font",
      "default": false
    },
    {
      "type": "text",
      "id": "heading_font_family",
      "label": "Heading Font Family",
      "default": "Playfair Display"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 18,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading Size – Mobile",
      "min": 16,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Heading Line Height",
      "min": 0.8,
      "max": 2.0,
      "step": 0.1,
      "default": 1.2
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "select",
      "id": "heading_text_align",
      "label": "Heading Align",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "label": "Heading Margin Bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "heading_margin_bottom_mobile",
      "label": "Heading Margin Bottom – Mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image (optional)"
    },
    {
      "type": "range",
      "id": "image_roundness",
      "label": "Image Roundness",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "image_border_thickness",
      "label": "Image Border",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "image_border_color",
      "label": "Image Border Color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "square", "label": "1:1" },
        { "value": "portrait", "label": "3:4" },
        { "value": "landscape", "label": "4:3" },
        { "value": "wide", "label": "16:9" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio_mobile",
      "label": "Image Aspect Ratio – Mobile",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "square", "label": "1:1" },
        { "value": "portrait", "label": "3:4" },
        { "value": "landscape", "label": "4:3" }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image Fit",
      "info": "Cover füllt den Bereich (Bild wird ggf. beschnitten). Contain zeigt das gesamte Bild.",
      "options": [
        { "value": "cover", "label": "Cover (füllen)" },
        { "value": "contain", "label": "Contain (ganzes Bild)" }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "image_max_height",

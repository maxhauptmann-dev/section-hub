      "content": "Popup Card"
    },
    {
      "type": "color",
      "id": "popup_bg",
      "label": "Popup Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "popup_roundness",
      "label": "Popup Roundness",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "popup_width",
      "label": "Popup Width",
      "min": 160,
      "max": 360,
      "step": 10,
      "unit": "px",
      "default": 240
    },
    {
      "type": "checkbox",
      "id": "popup_shadow",
      "label": "Popup Shadow",
      "default": true
    },
    {
      "type": "select",
      "id": "popup_image_ratio",
      "label": "Popup Image Ratio",
      "options": [
        { "value": "square", "label": "1:1" },
        { "value": "portrait", "label": "3:4" },
        { "value": "landscape", "label": "4:3" }
      ],
      "default": "square"
    },
    {
      "type": "range",

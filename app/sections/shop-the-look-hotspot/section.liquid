    {
      "type": "header",
      "content": "Hotspot Dots"
    },
    {
      "type": "range",
      "id": "dot_size",
      "label": "Dot Size",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "dot_bg",
      "label": "Dot Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "dot_border_color",
      "label": "Dot Border Color",
      "default": "#00000033"
    },
    {
      "type": "range",
      "id": "dot_border_width",
      "label": "Dot Border Width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "dot_pulse",
      "label": "Pulse Animation",
      "default": true

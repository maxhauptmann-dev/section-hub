{% comment %}
  Section Hub – Lookbook Scroll Gallery v1.0
  Cinematic horizontal-scroll lookbook with full-bleed slides,
  Ken Burns zoom, autoplay, dots/arrows navigation, editorial captions.
  Prefix: ils-
{% endcomment %}

{%- liquid
  assign hf = section.settings.heading_font
  assign bf = section.settings.body_font
  assign autoplay = section.settings.autoplay
  assign auto_speed = section.settings.autoplay_speed
  assign transition_style = section.settings.transition_style
  assign slide_height = section.settings.slide_height
  assign caption_pos = section.settings.caption_position
  assign caption_style = section.settings.caption_style
  assign show_arrows = section.settings.show_arrows
  assign show_dots = section.settings.show_dots
  assign show_progress = section.settings.show_progress
  assign show_counter = section.settings.show_counter
  assign kenburns = section.settings.kenburns
  assign overlay_opacity = section.settings.overlay_opacity
-%}

<style>
  {{ hf | font_face: font_display: 'swap' }}
  {{ bf | font_face: font_display: 'swap' }}

  .ils-wrap--{{ section.id }} {
    --ils-bg: {{ section.settings.bg_color }};
    --ils-accent: {{ section.settings.accent_color }};
    --ils-heading-ff: {{ hf.family }}, {{ hf.fallback_families }};
    --ils-heading-fw: {{ hf.weight }};
    --ils-heading-fs: {{ hf.style }};
    --ils-body-ff: {{ bf.family }}, {{ bf.fallback_families }};
    --ils-body-fw: {{ bf.weight }};
    --ils-body-fs: {{ bf.style }};
    --ils-heading-color: {{ section.settings.heading_color }};
    --ils-text-color: {{ section.settings.text_color }};
    --ils-caption-bg: {{ section.settings.caption_bg }};
    --ils-slide-h: {{ slide_height }}vh;
    --ils-overlay-opacity: {{ overlay_opacity | divided_by: 100.0 }};
  }
</style>

<section class="ils-wrap ils-wrap--{{ section.id }}"
         data-section-id="{{ section.id }}"
         data-ils-autoplay="{{ autoplay }}"
         data-ils-speed="{{ auto_speed }}"
         data-ils-transition="{{ transition_style }}">

  {%- comment -%} Slides {%- endcomment -%}
  <div class="ils-viewport">
    <div class="ils-track" data-ils-track>
      {%- for block in section.blocks -%}
        <div class="ils-slide{% if forloop.first %} ils-slide--active{% endif %}{% if kenburns %} ils-slide--kenburns{% endif %}"
             data-ils-slide="{{ forloop.index0 }}"
             {{ block.shopify_attributes }}>

          {%- comment -%} Image {%- endcomment -%}
          <div class="ils-slide__media">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 2000 }}"
                srcset="{{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1200 }} 1200w, {{ block.settings.image | image_url: width: 1600 }} 1600w, {{ block.settings.image | image_url: width: 2000 }} 2000w"
                sizes="100vw"
                alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                class="ils-slide__img"
              >
            {%- else -%}
              <div class="ils-slide__placeholder">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              </div>
            {%- endif -%}
            <div class="ils-slide__overlay"></div>
          </div>

          {%- comment -%} Caption {%- endcomment -%}
          {%- if block.settings.heading != blank or block.settings.subtitle != blank or block.settings.btn_text != blank -%}
            <div class="ils-slide__caption ils-slide__caption--{{ caption_pos }} ils-slide__caption--{{ caption_style }}">
              {%- if block.settings.badge != blank -%}
                <span class="ils-slide__badge">{{ block.settings.badge }}</span>
              {%- endif -%}
              {%- if block.settings.eyebrow != blank -%}
                <span class="ils-slide__eyebrow">{{ block.settings.eyebrow }}</span>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="ils-slide__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.subtitle != blank -%}
                <p class="ils-slide__subtitle">{{ block.settings.subtitle }}</p>
              {%- endif -%}
              {%- if block.settings.btn_text != blank -%}
                <a href="{{ block.settings.btn_link | default: '#' }}" class="ils-slide__btn">
                  {{ block.settings.btn_text }}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%} Arrows {%- endcomment -%}
    {%- if show_arrows -%}
      <button class="ils-arrow ils-arrow--prev" data-ils-prev aria-label="Previous slide">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button class="ils-arrow ils-arrow--next" data-ils-next aria-label="Next slide">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 6 15 12 9 18"/></svg>
      </button>
    {%- endif -%}

    {%- comment -%} Counter {%- endcomment -%}
    {%- if show_counter -%}
      <div class="ils-counter" data-ils-counter>
        <span class="ils-counter__current">01</span>
        <span class="ils-counter__sep">/</span>
        <span class="ils-counter__total">{{ section.blocks.size | prepend: '00' | slice: -2, 2 }}</span>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} Dots + progress {%- endcomment -%}
  <div class="ils-controls">
    {%- if show_dots -%}
      <div class="ils-dots" data-ils-dots>
        {%- for block in section.blocks -%}
          <button class="ils-dot{% if forloop.first %} ils-dot--active{% endif %}" data-ils-dot="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
    {%- if show_progress and autoplay -%}
      <div class="ils-progress">
        <div class="ils-progress__bar" data-ils-progress style="--ils-auto-speed: {{ auto_speed }}ms;"></div>
      </div>
    {%- endif -%}
  </div>

</section>

<script>
  (function(){
    var sid = '{{ section.id }}';
    var wrap = document.querySelector('.ils-wrap--' + sid);
    if (!wrap) return;

    var slides = wrap.querySelectorAll('[data-ils-slide]');
    var total = slides.length;
    if (total < 1) return;

    var currentIdx = 0;
    var autoplayOn = wrap.getAttribute('data-ils-autoplay') === 'true';
    var speed = (parseInt(wrap.getAttribute('data-ils-speed')) || 5) * 1000; // Convert seconds to ms
    var transStyle = wrap.getAttribute('data-ils-transition') || 'fade';
    var timer = null;

    var dots = wrap.querySelectorAll('[data-ils-dot]');
    var counterCur = wrap.querySelector('.ils-counter__current');
    var progressBar = wrap.querySelector('[data-ils-progress]');
    var prevBtn = wrap.querySelector('[data-ils-prev]');
    var nextBtn = wrap.querySelector('[data-ils-next]');

    function goTo(idx) {
      if (idx < 0) idx = total - 1;
      if (idx >= total) idx = 0;

      slides.forEach(function(s, i) {
        s.classList.remove('ils-slide--active', 'ils-slide--exit');
        if (i === currentIdx) s.classList.add('ils-slide--exit');
      });

      currentIdx = idx;
      slides[currentIdx].classList.add('ils-slide--active');

      /* Update dots */
      dots.forEach(function(d) { d.classList.remove('ils-dot--active'); });
      if (dots[currentIdx]) dots[currentIdx].classList.add('ils-dot--active');

      /* Counter */
      if (counterCur) {
        var num = currentIdx + 1;
        counterCur.textContent = num < 10 ? '0' + num : '' + num;
      }

      /* Progress bar */
      restartProgress();
    }

    function restartProgress() {
      if (!progressBar) return;
      progressBar.style.transition = 'none';
      progressBar.style.transform = 'scaleX(0)';
      void progressBar.offsetWidth;
      if (autoplayOn) {
        progressBar.style.transition = 'transform ' + speed + 'ms linear';
        progressBar.style.transform = 'scaleX(1)';
      }
    }

    function startAutoplay() {
      if (!autoplayOn) return;
      stopAutoplay();
      timer = setInterval(function() { goTo(currentIdx + 1); }, speed);
      restartProgress();
    }

    function stopAutoplay() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    /* Arrows */
    if (prevBtn) prevBtn.addEventListener('click', function() { goTo(currentIdx - 1); stopAutoplay(); startAutoplay(); });
    if (nextBtn) nextBtn.addEventListener('click', function() { goTo(currentIdx + 1); stopAutoplay(); startAutoplay(); });

    /* Dots */
    dots.forEach(function(d) {
      d.addEventListener('click', function() {
        goTo(parseInt(d.getAttribute('data-ils-dot')));
        stopAutoplay();
        startAutoplay();
      });
    });

    /* Keyboard */
    document.addEventListener('keydown', function(e) {
      var rect = wrap.getBoundingClientRect();
      if (rect.top > window.innerHeight || rect.bottom < 0) return;
      if (e.key === 'ArrowLeft') { goTo(currentIdx - 1); stopAutoplay(); startAutoplay(); }
      if (e.key === 'ArrowRight') { goTo(currentIdx + 1); stopAutoplay(); startAutoplay(); }
    });

    /* Touch swipe */
    var touchX = 0;
    wrap.addEventListener('touchstart', function(e) { touchX = e.changedTouches[0].screenX; }, { passive: true });
    wrap.addEventListener('touchend', function(e) {
      var dx = e.changedTouches[0].screenX - touchX;
      if (Math.abs(dx) > 50) {
        if (dx < 0) goTo(currentIdx + 1);
        else goTo(currentIdx - 1);
        stopAutoplay();
        startAutoplay();
      }
    }, { passive: true });

    /* Pause on hover */
    wrap.addEventListener('mouseenter', stopAutoplay);
    wrap.addEventListener('mouseleave', startAutoplay);

    /* Init */
    startAutoplay();
  })();
</script>

{% schema %}
{
  "name": "SS - Lookbook Scroll",
  "tag": "section",
  "class": "ils-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "slide_height",
      "label": "Slide height",
      "min": 50,
      "max": 100,
      "step": 5,
      "default": 90,
      "unit": "vh"
    },
    {
      "type": "select",
      "id": "transition_style",
      "label": "Transition style",
      "options": [
        { "value": "fade", "label": "Fade" },
        { "value": "slide", "label": "Slide" },
        { "value": "zoom", "label": "Zoom" }
      ],
      "default": "fade"
    },
    {
      "type": "select",
      "id": "caption_position",
      "label": "Caption position",
      "options": [
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "center", "label": "Center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "bottom-left"
    },
    {
      "type": "select",
      "id": "caption_style",
      "label": "Caption style",
      "options": [
        { "value": "glass", "label": "Glass" },
        { "value": "solid", "label": "Solid" },
        { "value": "text-only", "label": "Text only" }
      ],
      "default": "glass"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 25,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_counter",
      "label": "Show counter (01 / 05)",
      "default": true
    },
    {

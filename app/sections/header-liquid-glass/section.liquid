{% comment %}
  Section Hub – Header Liquid Glass v1.0
  Premium frosted glass header with mega menu, customizable colors, reveal on scroll.
  Features: Liquid glass effect, mega menu blocks, custom fonts, mobile drawer.
{% endcomment %}

{%- liquid
  assign logo            = section.settings.logo
  assign logo_mobile     = section.settings.logo_mobile
  assign logo_width      = section.settings.logo_width
  assign logo_width_m    = section.settings.logo_width_mobile
  assign use_custom_font = section.settings.use_custom_font
  assign shop_font       = section.settings.shop_name_font
  assign shop_size       = section.settings.shop_name_size
  assign shop_size_m     = section.settings.shop_name_size_mobile
  assign shop_line_h     = section.settings.shop_name_line_height

  assign mobile_menu     = section.settings.mobile_menu
  assign mega_col_gap    = section.settings.mega_column_gap
  assign mega_list_gap   = section.settings.mega_list_gap
  assign mega_list_mt    = section.settings.mega_list_margin_top
  assign mega_round      = section.settings.mega_roundness

  assign menu_custom_font = section.settings.menu_use_custom_font
  assign menu_font_size   = section.settings.menu_font_size
  assign menu_font_size_m = section.settings.menu_font_size_mobile
  assign menu_line_h      = section.settings.menu_line_height
  assign show_underline   = section.settings.show_underline_hover

  assign burger_size      = section.settings.burger_size
  assign mobile_heading   = section.settings.mobile_menu_heading
  assign mobile_h_custom  = section.settings.mobile_heading_custom_font
  assign mobile_h_size    = section.settings.mobile_heading_font_size
  assign mobile_h_line_h  = section.settings.mobile_heading_line_height

  assign right_gap        = section.settings.right_gap
  assign right_gap_m      = section.settings.right_gap_mobile
  assign right_custom_f   = section.settings.right_use_custom_font
  assign right_font_size  = section.settings.right_font_size
  assign right_line_h     = section.settings.right_line_height
  assign right_icon_size  = section.settings.right_icon_size
  assign right_icon_size_m = section.settings.right_icon_size_mobile

  assign show_search     = section.settings.use_search
  assign search_text     = section.settings.search_text
  assign search_icon_desk = section.settings.search_icon_desktop
  assign search_to_burger = section.settings.search_to_burger

  assign show_account    = section.settings.use_account
  assign account_text    = section.settings.account_text
  assign account_icon_desk = section.settings.account_icon_desktop
  assign account_to_burger = section.settings.account_to_burger

  assign show_cart       = section.settings.use_cart
  assign cart_text       = section.settings.cart_text
  assign cart_icon_desk  = section.settings.cart_icon_desktop

  assign show_btn        = section.settings.use_button
  assign btn_text        = section.settings.button_label
  assign btn_link        = section.settings.button_link
  assign btn_new_tab     = section.settings.button_new_tab
  assign btn_style       = section.settings.button_style
  assign btn_custom_style = section.settings.button_custom_styling
  assign btn_full_mobile = section.settings.button_full_mobile
  assign btn_custom_font = section.settings.button_custom_font
  assign btn_font_size   = section.settings.button_font_size
  assign btn_font_size_m = section.settings.button_font_size_mobile
  assign btn_round       = section.settings.button_roundness
  assign btn_border_w    = section.settings.button_border_thickness

  assign use_glass       = section.settings.use_liquid_glass
  assign glass_opacity   = section.settings.glass_opacity
  assign glass_blur      = section.settings.glass_blur
  assign glass_border_op = section.settings.glass_border_opacity

  assign submenu_glass   = section.settings.submenu_use_glass
  assign submenu_bg      = section.settings.submenu_bg

  assign link_color      = section.settings.link_color
  assign link_hover      = section.settings.link_hover_color
  assign link_hover_grad = section.settings.link_hover_gradient
  assign submenu_link    = section.settings.submenu_link_color
  assign submenu_hover   = section.settings.submenu_link_hover
  assign mobile_h_color  = section.settings.mobile_heading_color
  assign mobile_divider  = section.settings.mobile_divider_color

  assign shop_color      = section.settings.shop_name_color
  assign shop_hover      = section.settings.shop_name_hover

  assign right_link_color = section.settings.right_link_color
  assign right_link_hover = section.settings.right_link_hover

  assign btn_text_color  = section.settings.button_text_color
  assign btn_text_hover  = section.settings.button_text_hover
  assign btn_bg          = section.settings.button_bg
  assign btn_bg_hover    = section.settings.button_bg_hover
  assign btn_border      = section.settings.button_border_color
  assign btn_border_hover = section.settings.button_border_hover
  assign btn_shadow      = section.settings.button_shadow

  assign bg_color        = section.settings.section_bg
  assign border_color    = section.settings.section_border

  assign margin_top      = section.settings.margin_top
  assign margin_sides    = section.settings.margin_sides
  assign margin_sides_m  = section.settings.margin_sides_mobile
  assign padding_top     = section.settings.padding_top
  assign padding_bottom  = section.settings.padding_bottom
  assign padding_sides   = section.settings.padding_sides
  assign padding_sides_m = section.settings.padding_sides_mobile

  assign section_width   = section.settings.section_width
  assign custom_width    = section.settings.custom_width
  assign border_thick    = section.settings.border_thickness
  assign section_round   = section.settings.section_roundness

  assign scroll_mode     = section.settings.reveal_menu
  assign custom_css      = section.settings.custom_css
-%}

<style>
  #shlg-{{ section.id }} {
    --shlg-logo-w: {{ logo_width }}px;
    --shlg-logo-w-m: {{ logo_width_m }}px;
    --shlg-shop-size: {{ shop_size }}px;
    --shlg-shop-size-m: {{ shop_size_m }}px;
    --shlg-shop-line-h: {{ shop_line_h }};
    --shlg-shop-color: {{ shop_color }};
    --shlg-shop-hover: {{ shop_hover }};

    --shlg-mega-col-gap: {{ mega_col_gap }}px;
    --shlg-mega-list-gap: {{ mega_list_gap }}px;
    --shlg-mega-list-mt: {{ mega_list_mt }}px;
    --shlg-mega-round: {{ mega_round }}px;

    --shlg-menu-size: {{ menu_font_size }}px;
    --shlg-menu-size-m: {{ menu_font_size_m }}px;
    --shlg-menu-line-h: {{ menu_line_h }};

    --shlg-burger-size: {{ burger_size }}px;
    --shlg-mobile-h-size: {{ mobile_h_size }}px;
    --shlg-mobile-h-line-h: {{ mobile_h_line_h }};

    --shlg-right-gap: {{ right_gap }}px;
    --shlg-right-gap-m: {{ right_gap_m }}px;
    --shlg-right-size: {{ right_font_size }}px;
    --shlg-right-line-h: {{ right_line_h }};
    --shlg-right-icon: {{ right_icon_size }}px;
    --shlg-right-icon-m: {{ right_icon_size_m }}px;

    --shlg-btn-size: {{ btn_font_size }}px;
    --shlg-btn-size-m: {{ btn_font_size_m }}px;
    --shlg-btn-round: {{ btn_round }}px;
    --shlg-btn-border-w: {{ btn_border_w }}px;

    --shlg-glass-op: {{ glass_opacity | divided_by: 100.0 }};
    --shlg-glass-blur: {{ glass_blur }}px;
    --shlg-glass-border-op: {{ glass_border_op | divided_by: 100.0 }};

    --shlg-link-color: {{ link_color }};
    --shlg-link-hover: {{ link_hover }};
    --shlg-submenu-link: {{ submenu_link }};
    --shlg-submenu-hover: {{ submenu_hover }};
    --shlg-submenu-bg: {{ submenu_bg }};
    --shlg-mobile-h-color: {{ mobile_h_color }};
    --shlg-mobile-divider: {{ mobile_divider }};

    --shlg-right-link: {{ right_link_color }};
    --shlg-right-hover: {{ right_link_hover }};

    --shlg-btn-text: {{ btn_text_color }};
    --shlg-btn-text-hover: {{ btn_text_hover }};
    --shlg-btn-bg: {{ btn_bg }};
    --shlg-btn-bg-hover: {{ btn_bg_hover }};
    --shlg-btn-border: {{ btn_border }};
    --shlg-btn-border-hover: {{ btn_border_hover }};
    --shlg-btn-shadow: {{ btn_shadow }};

    --shlg-bg: {{ bg_color }};
    --shlg-border: {{ border_color }};
    --shlg-border-w: {{ border_thick }}px;
    --shlg-round: {{ section_round }}px;

    --shlg-mt: {{ margin_top }}px;
    --shlg-mx: {{ margin_sides }}px;
    --shlg-mx-m: {{ margin_sides_m }}px;
    --shlg-pt: {{ padding_top }}px;
    --shlg-pb: {{ padding_bottom }}px;
    --shlg-px: {{ padding_sides }}px;
    --shlg-px-m: {{ padding_sides_m }}px;

    {% case section_width %}
      {% when 'page' %}
        --shlg-width: min(1200px, 100%);
      {% when 'full' %}
        --shlg-width: 100%;
      {% when 'custom' %}
        --shlg-width: {{ custom_width }}px;
    {% endcase %}
  }
  {% if use_custom_font and shop_font != blank %}
    @import url('https://fonts.googleapis.com/css2?family={{ shop_font | replace: ' ', '+' }}:wght@400;500;600;700&display=swap');
    #shlg-{{ section.id }} .shlg-logo__text { font-family: '{{ shop_font }}', sans-serif; }
  {% endif %}
  {% if link_hover_grad != blank %}
    #shlg-{{ section.id }} .shlg-nav__link:hover {
      background: {{ link_hover_grad }};
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
  {% endif %}
  {% if custom_css != blank %}{{ custom_css }}{% endif %}
</style>

<header id="shlg-{{ section.id }}" class="shlg-header{% if use_glass %} shlg-header--glass{% endif %}" data-shlg-scroll="{{ scroll_mode }}">
  <div class="shlg-inner">
    {%- comment -%} Logo / Shop Name {%- endcomment -%}
    <a href="/" class="shlg-logo">
      {%- if logo != blank -%}
        <img
          src="{{ logo | image_url: width: 400 }}"
          alt="{{ shop.name }}"
          class="shlg-logo__img shlg-logo__img--desk"
          width="{{ logo_width }}"
          height="{{ logo_width | divided_by: logo.aspect_ratio }}"
          loading="eager"
        >
        {%- if logo_mobile != blank -%}
          <img
            src="{{ logo_mobile | image_url: width: 300 }}"
            alt="{{ shop.name }}"
            class="shlg-logo__img shlg-logo__img--mobile"
            width="{{ logo_width_m }}"
            height="{{ logo_width_m | divided_by: logo_mobile.aspect_ratio }}"
            loading="eager"
          >
        {%- endif -%}
      {%- else -%}
        <span class="shlg-logo__text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    {%- comment -%} Desktop Navigation {%- endcomment -%}
    <nav class="shlg-nav">
      {%- for block in section.blocks -%}
        {%- if block.type == 'mega_menu' -%}
          {%- assign mega_text = block.settings.text -%}
          {%- assign mega_link = block.settings.link -%}
          {%- assign mega_submenu = block.settings.submenu -%}
          <div class="shlg-nav__item shlg-nav__item--mega" {{ block.shopify_attributes }}>
            <a href="{{ mega_link }}" class="shlg-nav__link{% if show_underline %} shlg-nav__link--underline{% endif %}">
              {{ mega_text }}
              {%- if mega_submenu != blank -%}
                <svg class="shlg-nav__chevron" width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {%- endif -%}
            </a>
            {%- if mega_submenu != blank -%}
              <div class="shlg-mega{% if submenu_glass %} shlg-mega--glass{% endif %}">
                <div class="shlg-mega__inner">
                  {%- for link in linklists[mega_submenu].links -%}
                    <div class="shlg-mega__col">
                      <span class="shlg-mega__heading">{{ link.title }}</span>
                      {%- if link.links.size > 0 -%}
                        <ul class="shlg-mega__list">
                          {%- for child in link.links -%}
                            <li><a href="{{ child.url }}" class="shlg-mega__link">{{ child.title }}</a></li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    {%- comment -%} Right Side {%- endcomment -%}
    <div class="shlg-right">
      {%- if show_search and search_icon_desk -%}
        <a href="/search" class="shlg-right__icon" aria-label="{{ search_text }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        </a>
      {%- elsif show_search -%}
        <a href="/search" class="shlg-right__link">{{ search_text }}</a>
      {%- endif -%}

      {%- if show_account and account_icon_desk -%}
        <a href="/account" class="shlg-right__icon" aria-label="{{ account_text }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </a>
      {%- elsif show_account -%}
        <a href="/account" class="shlg-right__link">{{ account_text }}</a>
      {%- endif -%}

      {%- if show_cart and cart_icon_desk -%}
        <a href="/cart" class="shlg-right__icon shlg-right__cart" aria-label="{{ cart_text }}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          <span class="shlg-cart__count">{{ cart.item_count }}</span>
        </a>
      {%- elsif show_cart -%}
        <a href="/cart" class="shlg-right__link shlg-right__cart">{{ cart_text }} ({{ cart.item_count }})</a>
      {%- endif -%}

      {%- if show_btn -%}
        <a href="{{ btn_link }}"{% if btn_new_tab %} target="_blank" rel="noopener"{% endif %} class="shlg-btn shlg-btn--{{ btn_style }}">
          <span>{{ btn_text }}</span>
          {%- if btn_style contains 'arrow' -%}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          {%- endif -%}
        </a>
      {%- endif -%}

      {%- comment -%} Mobile Burger {%- endcomment -%}
      <button class="shlg-burger" data-shlg-burger aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

{%- comment -%} Mobile Drawer {%- endcomment -%}
<div id="shlg-drawer-{{ section.id }}" class="shlg-drawer">
  <div class="shlg-drawer__overlay" data-shlg-drawer-close></div>
  <div class="shlg-drawer__panel">
    <button class="shlg-drawer__close" data-shlg-drawer-close aria-label="Close">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>

    <nav class="shlg-drawer__nav">
      {%- if mobile_heading != blank -%}
        <span class="shlg-drawer__heading">{{ mobile_heading }}</span>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'mega_menu' -%}
          {%- assign mega_text = block.settings.text -%}
          {%- assign mega_link = block.settings.link -%}
          {%- assign mega_submenu = block.settings.submenu -%}
          {%- if mega_submenu != blank -%}
            <div class="shlg-drawer__group">
              <button class="shlg-drawer__toggle" data-shlg-toggle>
                {{ mega_text }}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
              </button>
              <div class="shlg-drawer__sub">
                {%- for link in linklists[mega_submenu].links -%}
                  <a href="{{ link.url }}" class="shlg-drawer__link">{{ link.title }}</a>
                  {%- for child in link.links -%}
                    <a href="{{ child.url }}" class="shlg-drawer__link shlg-drawer__link--child">{{ child.title }}</a>
                  {%- endfor -%}
                {%- endfor -%}
              </div>
            </div>
          {%- else -%}
            <a href="{{ mega_link }}" class="shlg-drawer__link">{{ mega_text }}</a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      {%- comment -%} Mobile-only links from mobile_menu {%- endcomment -%}
      {%- if mobile_menu != blank -%}
        {%- for link in linklists[mobile_menu].links -%}
          <a href="{{ link.url }}" class="shlg-drawer__link">{{ link.title }}</a>
        {%- endfor -%}
      {%- endif -%}
    </nav>

    <div class="shlg-drawer__footer">
      {%- if show_search and search_to_burger -%}
        <a href="/search" class="shlg-drawer__flink">{{ search_text }}</a>
      {%- endif -%}
      {%- if show_account and account_to_burger -%}
        <a href="/account" class="shlg-drawer__flink">{{ account_text }}</a>
      {%- endif -%}
      {%- if show_btn and btn_full_mobile -%}
        <a href="{{ btn_link }}" class="shlg-btn shlg-btn--{{ btn_style }} shlg-btn--full">
          <span>{{ btn_text }}</span>
          {%- if btn_style contains 'arrow' -%}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          {%- endif -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
(function(){
  var header = document.getElementById('shlg-{{ section.id }}');
  if(!header) return;
  var mode = header.getAttribute('data-shlg-scroll');

  /* ── Drawer ── */
  var burger = header.querySelector('[data-shlg-burger]');
  var drawer = document.getElementById('shlg-drawer-{{ section.id }}');
  if(drawer){
    var closers = drawer.querySelectorAll('[data-shlg-drawer-close]');
    var toggles = drawer.querySelectorAll('[data-shlg-toggle]');
    if(burger) burger.addEventListener('click', function(){ drawer.classList.add('shlg-drawer--open'); document.body.style.overflow='hidden'; });
    closers.forEach(function(c){ c.addEventListener('click', function(){ drawer.classList.remove('shlg-drawer--open'); document.body.style.overflow=''; }); });
    toggles.forEach(function(t){
      t.addEventListener('click', function(){
        var sub = t.nextElementSibling;
        var open = sub.classList.toggle('shlg-drawer__sub--open');
        t.classList.toggle('shlg-drawer__toggle--open', open);
      });
    });
  }

  /* ── Scroll behavior ── */
  if(mode === 'default' || !mode) {
    header.style.position = '';
    header.style.top = '';
    header.style.left = '';
    header.style.width = '';
    header.style.zIndex = '';
    header.style.transform = '';
    header.style.transition = '';
    return;
  }

  function applySticky(){
    if(mode === 'sticky' || mode === 'always-sticky'){
      header.style.position = 'fixed';
      header.style.top      = '0';
      header.style.left     = '0';
      header.style.width    = '100%';
      header.style.zIndex   = '1000';
    }
    if(mode === 'scroll-up'){
      header.style.position   = 'fixed';
      header.style.top        = '0';
      header.style.left       = '0';
      header.style.width      = '100%';
      header.style.zIndex     = '1000';
      header.style.transition = 'transform 0.3s ease';
      var lastY = 0;
      window.addEventListener('scroll', function(){
        var y = window.scrollY;
        header.style.transform = (y > lastY && y > 80) ? 'translateY(-100%)' : 'translateY(0)';
        lastY = y;
      }, { passive: true });
    }
  }

  requestAnimationFrame(function(){ requestAnimationFrame(applySticky); });
  document.addEventListener('DOMContentLoaded', applySticky);
  window.addEventListener('load', applySticky);
})();
</script>

{% schema %}
{
  "name": "SIQ - Header Liquid Glass",
  "tag": "section",
  "class": "shlg-root",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "select",
      "id": "reveal_menu",
      "label": "Reveal menu",
      "options": [
        { "value": "default", "label": "Default" },
        { "value": "always-sticky", "label": "Always/sticky" },
        { "value": "scroll-up", "label": "Show on scroll up" }
      ],
      "default": "always-sticky"
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "paragraph",
      "content": "Leave blank to display shop name instead of logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo_mobile",
      "label": "Logo - mobile"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Width",
      "min": 40,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 130
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Width - mobile",
      "min": 30,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 130
    },
    {
      "type": "header",
      "content": "Shop name"
    },
    {
      "type": "checkbox",
      "id": "use_custom_font",
      "label": "Use custom font",
      "default": false
    },
    {
      "type": "text",
      "id": "shop_name_font",
      "label": "Shop Name Font",
      "default": "Playfair Display",
      "info": "Google Fonts name"
    },
    {
      "type": "range",
      "id": "shop_name_size",
      "label": "Font size",
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "shop_name_size_mobile",
      "label": "Font size - mobile",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "shop_name_line_height",
      "label": "Line height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.2
    },
    {
      "type": "header",
      "content": "Menu"
    },
    {
      "type": "paragraph",
      "content": "Use blocks to create mega menu on desktop."
    },
    {
      "type": "link_list",
      "id": "mobile_menu",
      "label": "Mobile menu"
    },
    {
      "type": "header",
      "content": "Desktop mega menu layout"
    },
    {
      "type": "range",
      "id": "mega_column_gap",
      "label": "Column gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "mega_list_gap",
      "label": "List gap",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {

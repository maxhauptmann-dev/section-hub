    {
      "type": "select",
      "id": "layout_style",
      "label": "Image position",
      "options": [
        { "value": "alternate", "label": "Alternating" },
        { "value": "left", "label": "Always left" },
        { "value": "right", "label": "Always right" }
      ],
      "default": "alternate"
    },
    {
      "type": "select",
      "id": "split_ratio",
      "label": "Image-text split",
      "options": [
        { "value": "50", "label": "50 / 50" },
        { "value": "55", "label": "55 / 45" },
        { "value": "60", "label": "60 / 40" }
      ],
      "default": "55"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [

{% comment %}
  Section Hub – Horizon Split v1.0
  Cinematic split-screen editorial gallery with alternating
  image-text layouts, numbered entries, parallax, and scroll-reveal.
  Prefix: ihs-
{% endcomment %}

{%- liquid
  assign hf = section.settings.heading_font
  assign bf = section.settings.body_font
  assign layout = section.settings.layout_style
  assign img_ratio = section.settings.image_ratio
  assign split = section.settings.split_ratio
  assign gap = section.settings.entry_gap
  assign show_numbers = section.settings.show_numbers
  assign show_line = section.settings.show_accent_line
  assign hover_zoom = section.settings.hover_zoom
  assign py = section.settings.section_py
  assign px = section.settings.section_px
-%}

<style>
  {{ hf | font_face: font_display: 'swap' }}
  {{ bf | font_face: font_display: 'swap' }}

  .ihs-wrap--{{ section.id }} {
    --ihs-bg: {{ section.settings.bg_color }};
    --ihs-accent: {{ section.settings.accent_color }};
    --ihs-heading-ff: {{ hf.family }}, {{ hf.fallback_families }};
    --ihs-heading-fw: {{ hf.weight }};
    --ihs-heading-fs: {{ hf.style }};
    --ihs-body-ff: {{ bf.family }}, {{ bf.fallback_families }};
    --ihs-body-fw: {{ bf.weight }};
    --ihs-body-fs: {{ bf.style }};
    --ihs-heading-color: {{ section.settings.heading_color }};
    --ihs-text-color: {{ section.settings.text_color }};
    --ihs-content-bg: {{ section.settings.content_bg }};
    --ihs-divider: {{ section.settings.divider_color }};
    --ihs-gap: {{ gap }}px;
    --ihs-radius: {{ section.settings.card_radius }}px;
    --ihs-py: {{ py }}px;
    --ihs-px: {{ px }}px;
    --ihs-img-ratio: {{ img_ratio }};
    --ihs-split: {{ split }};
  }
</style>

<section class="ihs-wrap ihs-wrap--{{ section.id }}" data-section-id="{{ section.id }}">

  <div class="ihs-container">

    {%- comment -%} Section header {%- endcomment -%}
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subtext != blank -%}
      <div class="ihs-header" data-ihs-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <span class="ihs-header__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="ihs-header__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="ihs-header__subtext">{{ section.settings.subtext }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Entries {%- endcomment -%}
    <div class="ihs-entries">
      {%- for block in section.blocks -%}
        {%- liquid
          assign is_even = false
          assign mod_result = forloop.index0 | modulo: 2
          if mod_result == 1
            assign is_even = true
          endif
          assign flip = false
          if layout == 'alternate'
            if is_even
              assign flip = true
            endif
          elsif layout == 'right'
            assign flip = true
          endif
        -%}
        <div class="ihs-entry{% if flip %} ihs-entry--flipped{% endif %}"
             data-ihs-reveal
             data-ihs-index="{{ forloop.index0 }}"
             {{ block.shopify_attributes }}>

          {%- comment -%} Image side {%- endcomment -%}
          <div class="ihs-entry__media">
            <div class="ihs-entry__img-wrap{% if hover_zoom %} ihs-entry__img-wrap--zoom{% endif %}">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 1200 }}"
                  srcset="{{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1200 }} 1200w"
                  sizes="(max-width: 749px) 100vw, 50vw"
                  alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  class="ihs-entry__img"
                >
              {%- else -%}
                <div class="ihs-entry__placeholder">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                </div>
              {%- endif -%}
            </div>
          </div>

          {%- comment -%} Content side {%- endcomment -%}
          <div class="ihs-entry__content">
            <div class="ihs-entry__inner">
              {%- if show_numbers -%}
                <span class="ihs-entry__number">{{ forloop.index | prepend: '00' | slice: -2, 2 }}</span>
              {%- endif -%}

              {%- if show_line -%}
                <div class="ihs-entry__line"></div>
              {%- endif -%}

              {%- if block.settings.eyebrow != blank -%}
                <span class="ihs-entry__eyebrow">{{ block.settings.eyebrow }}</span>
              {%- endif -%}

              {%- if block.settings.heading != blank -%}
                <h3 class="ihs-entry__heading">{{ block.settings.heading }}</h3>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="ihs-entry__desc">{{ block.settings.description }}</p>
              {%- endif -%}

              {%- if block.settings.detail_1 != blank or block.settings.detail_2 != blank -%}
                <div class="ihs-entry__details">
                  {%- if block.settings.detail_label_1 != blank -%}
                    <div class="ihs-entry__detail">
                      <span class="ihs-entry__detail-label">{{ block.settings.detail_label_1 }}</span>
                      <span class="ihs-entry__detail-value">{{ block.settings.detail_1 }}</span>
                    </div>
                  {%- endif -%}
                  {%- if block.settings.detail_label_2 != blank -%}
                    <div class="ihs-entry__detail">
                      <span class="ihs-entry__detail-label">{{ block.settings.detail_label_2 }}</span>
                      <span class="ihs-entry__detail-value">{{ block.settings.detail_2 }}</span>
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if block.settings.btn_text != blank -%}
                <a href="{{ block.settings.btn_link | default: '#' }}" class="ihs-entry__btn">
                  {{ block.settings.btn_text }}
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
              {%- endif -%}
            </div>
          </div>
        </div>

        {%- comment -%} Divider between entries {%- endcomment -%}
        {%- unless forloop.last -%}
          {%- if section.settings.show_divider -%}
            <div class="ihs-divider" data-ihs-reveal></div>
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
    </div>

    {%- comment -%} CTA {%- endcomment -%}
    {%- if section.settings.cta_text != blank and section.settings.cta_link != blank -%}
      <div class="ihs-cta" data-ihs-reveal>
        <a href="{{ section.settings.cta_link }}" class="ihs-cta__btn ihs-cta__btn--{{ section.settings.cta_style }}">
          {{ section.settings.cta_text }}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

<script>
  (function(){
    var sid = '{{ section.id }}';
    var wrap = document.querySelector('.ihs-wrap--' + sid);
    if (!wrap) return;

    var revealEls = wrap.querySelectorAll('[data-ihs-reveal]');

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('ihs-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      revealEls.forEach(function(el) { observer.observe(el); });
    } else {
      revealEls.forEach(function(el) { el.classList.add('ihs-visible'); });
    }
  })();
</script>

{% schema %}
{
  "name": "SS - Horizon Split",
  "tag": "section",
  "class": "ihs-section",
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Portfolio"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Selected Works"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "A curated selection of our finest projects, presented in cinematic split-screen detail."

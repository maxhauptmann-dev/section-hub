          "label": "Category"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SS - Lens Focus",
      "settings": {
        "eyebrow": "Gallery",
        "heading": "Through the Lens",
        "subtext": "Hover or scroll to bring each image into sharp focus and reveal hidden details.",

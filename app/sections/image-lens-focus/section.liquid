{% comment %}
  Section Hub – Lens Focus v1.0
  Innovative gallery with lens/spotlight focus effect.
  Images start blurred/desaturated and sharpen on hover or scroll.
  Prefix: ilf-
{% endcomment %}

{%- liquid
  assign hf = section.settings.heading_font
  assign bf = section.settings.body_font
  assign focus_mode = section.settings.focus_mode
  assign cols = section.settings.columns
  assign gap = section.settings.card_gap
  assign rad = section.settings.card_radius
  assign blur_amount = section.settings.blur_amount
  assign py = section.settings.section_py
  assign px = section.settings.section_px
  assign show_filter = section.settings.show_filter
  assign show_lightbox = section.settings.show_lightbox
  assign hover_lift = section.settings.hover_lift
  assign spotlight = section.settings.spotlight_effect
-%}

{%- comment -%} Collect unique categories {%- endcomment -%}
{%- liquid
  assign cats_raw = ''
  for block in section.blocks
    if block.settings.category != blank
      assign cat_handle = block.settings.category | handleize
      unless cats_raw contains cat_handle
        if cats_raw != ''
          assign cats_raw = cats_raw | append: '|||'
        endif
        assign cats_raw = cats_raw | append: cat_handle | append: '::' | append: block.settings.category
      endunless
    endif
  endfor
  assign cats_arr = cats_raw | split: '|||'
-%}

<style>
  {{ hf | font_face: font_display: 'swap' }}
  {{ bf | font_face: font_display: 'swap' }}

  .ilf-wrap--{{ section.id }} {
    --ilf-bg: {{ section.settings.bg_color }};
    --ilf-accent: {{ section.settings.accent_color }};
    --ilf-heading-ff: {{ hf.family }}, {{ hf.fallback_families }};
    --ilf-heading-fw: {{ hf.weight }};
    --ilf-heading-fs: {{ hf.style }};
    --ilf-body-ff: {{ bf.family }}, {{ bf.fallback_families }};
    --ilf-body-fw: {{ bf.weight }};
    --ilf-body-fs: {{ bf.style }};
    --ilf-heading-color: {{ section.settings.heading_color }};
    --ilf-text-color: {{ section.settings.text_color }};
    --ilf-card-bg: {{ section.settings.card_bg }};
    --ilf-overlay: {{ section.settings.overlay_color }};
    --ilf-cols: {{ cols }};
    --ilf-gap: {{ gap }}px;
    --ilf-radius: {{ rad }}px;
    --ilf-blur: {{ blur_amount }}px;
    --ilf-img-aspect: {{ section.settings.img_aspect }};
    --ilf-py: {{ py }}px;
    --ilf-px: {{ px }}px;
  }
</style>

<section class="ilf-wrap ilf-wrap--{{ section.id }}"
         data-section-id="{{ section.id }}"
         data-ilf-mode="{{ focus_mode }}"
         data-ilf-spotlight="{{ spotlight }}"
         data-ilf-lightbox="{{ show_lightbox }}">

  <div class="ilf-container">

    {%- comment -%} Header {%- endcomment -%}
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subtext != blank -%}
      <div class="ilf-header" data-ilf-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <span class="ilf-header__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="ilf-header__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="ilf-header__subtext">{{ section.settings.subtext }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Filter tabs {%- endcomment -%}
    {%- if show_filter and cats_arr.size > 0 -%}
      <div class="ilf-filters" data-ilf-reveal>
        <button class="ilf-filter ilf-filter--active" data-ilf-filter="all">All</button>
        {%- for cat in cats_arr -%}
          {%- assign cat_parts = cat | split: '::' -%}
          <button class="ilf-filter" data-ilf-filter="{{ cat_parts[0] }}">{{ cat_parts[1] }}</button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Grid {%- endcomment -%}
    <div class="ilf-grid">
      {%- for block in section.blocks -%}
        {%- assign cat_handle = block.settings.category | handleize -%}
        <div class="ilf-card{% if hover_lift %} ilf-card--lift{% endif %}"
             data-ilf-reveal
             data-ilf-index="{{ forloop.index0 }}"
             data-ilf-cat="{{ cat_handle }}"
             {{ block.shopify_attributes }}>

          <div class="ilf-card__media">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 800 }} 800w"
                sizes="(max-width: 599px) 100vw, (max-width: 999px) 50vw, 33vw"
                alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                loading="lazy"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                class="ilf-card__img"
              >
            {%- else -%}
              <div class="ilf-card__placeholder">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              </div>
            {%- endif -%}

            {%- comment -%} Gradient overlay {%- endcomment -%}
            <div class="ilf-card__overlay"></div>

            {%- comment -%} Spotlight circle (CSS driven) {%- endcomment -%}
            {%- if spotlight -%}
              <div class="ilf-card__spot"></div>
            {%- endif -%}

            {%- comment -%} Lens icon {%- endcomment -%}
            <div class="ilf-card__lens-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </div>
          </div>

          <div class="ilf-card__body">
            {%- if block.settings.category != blank -%}
              <span class="ilf-card__cat">{{ block.settings.category }}</span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="ilf-card__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.caption != blank -%}
              <p class="ilf-card__caption">{{ block.settings.caption }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%} CTA {%- endcomment -%}
    {%- if section.settings.cta_text != blank and section.settings.cta_link != blank -%}
      <div class="ilf-cta" data-ilf-reveal>
        <a href="{{ section.settings.cta_link }}" class="ilf-cta__btn ilf-cta__btn--{{ section.settings.cta_style }}">
          {{ section.settings.cta_text }}
        </a>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} Lightbox {%- endcomment -%}
  {%- if show_lightbox -%}
    <div class="ilf-lightbox" data-ilf-lb>
      <div class="ilf-lightbox__backdrop"></div>
      <button class="ilf-lightbox__close" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <button class="ilf-lightbox__arrow ilf-lightbox__arrow--prev" aria-label="Previous">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button class="ilf-lightbox__arrow ilf-lightbox__arrow--next" aria-label="Next">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
      </button>
      <div class="ilf-lightbox__content">
        <img src="" alt="" class="ilf-lightbox__img">
      </div>
      <div class="ilf-lightbox__counter"></div>
    </div>
  {%- endif -%}
</section>

<script>
  (function(){
    var sid = '{{ section.id }}';
    var wrap = document.querySelector('.ilf-wrap--' + sid);
    if (!wrap) return;
    var mode = wrap.dataset.ilfMode;
    var hasLightbox = wrap.dataset.ilfLightbox === 'true';
    var hasSpotlight = wrap.dataset.ilfSpotlight === 'true';
    var cards = wrap.querySelectorAll('.ilf-card');

    /* --- Reveal --- */
    var revealEls = wrap.querySelectorAll('[data-ilf-reveal]');
    if ('IntersectionObserver' in window) {
      var revealObs = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('ilf-visible');
            revealObs.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });
      revealEls.forEach(function(el) { revealObs.observe(el); });
    } else {
      revealEls.forEach(function(el) { el.classList.add('ilf-visible'); });
    }

    /* --- Scroll focus (only needed for scroll mode) --- */
    /* hover mode = pure CSS :hover, always mode = pure CSS via data-attr */
    if (mode === 'scroll' && 'IntersectionObserver' in window) {
      var scrollObs = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('ilf-focused');
            scrollObs.unobserve(entry.target);
          }
        });
      }, { threshold: 0.3, rootMargin: '0px 0px -60px 0px' });
      cards.forEach(function(c) { scrollObs.observe(c); });
    }

    /* --- Spotlight mouse-follow (rAF throttled) --- */
    if (hasSpotlight) {
      var ticking = false;
      cards.forEach(function(card) {
        var spot = card.querySelector('.ilf-card__spot');
        if (!spot) return;
        card.addEventListener('mousemove', function(e) {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function() {
            var rect = card.getBoundingClientRect();
            var x = e.clientX - rect.left;
            var y = e.clientY - rect.top;
            spot.style.setProperty('--spot-x', x + 'px');
            spot.style.setProperty('--spot-y', y + 'px');
            ticking = false;
          });
        });
      });
    }

    /* --- Filter --- */
    var filters = wrap.querySelectorAll('[data-ilf-filter]');
    filters.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var val = btn.dataset.ilfFilter;
        filters.forEach(function(b) { b.classList.remove('ilf-filter--active'); });
        btn.classList.add('ilf-filter--active');
        cards.forEach(function(card) {
          var match = val === 'all' || card.dataset.ilfCat === val;
          card.style.display = match ? '' : 'none';
        });
      });
    });

    /* --- Lightbox --- */
    if (hasLightbox) {
      var lb = wrap.querySelector('[data-ilf-lb]');
      var lbImg = lb.querySelector('.ilf-lightbox__img');
      var lbCounter = lb.querySelector('.ilf-lightbox__counter');
      var imgCards = [];
      cards.forEach(function(c) {
        var img = c.querySelector('.ilf-card__img');
        if (img) imgCards.push({ el: c, src: img.src.replace(/width=\d+/, 'width=1600'), alt: img.alt });
      });
      var current = 0;

      function openLb(idx) {
        current = idx;
        lbImg.src = imgCards[idx].src;
        lbImg.alt = imgCards[idx].alt;
        lbCounter.textContent = (idx + 1) + ' / ' + imgCards.length;
        lb.classList.add('ilf-lightbox--open');
        document.body.style.overflow = 'hidden';
      }

      function closeLb() {
        lb.classList.remove('ilf-lightbox--open');
        document.body.style.overflow = '';
      }

      function navLb(dir) {
        var next = (current + dir + imgCards.length) % imgCards.length;
        openLb(next);
      }

      imgCards.forEach(function(item, i) {
        item.el.addEventListener('click', function() { openLb(i); });
        item.el.style.cursor = 'pointer';
      });

      lb.querySelector('.ilf-lightbox__close').addEventListener('click', closeLb);
      lb.querySelector('.ilf-lightbox__backdrop').addEventListener('click', closeLb);
      lb.querySelector('.ilf-lightbox__arrow--prev').addEventListener('click', function() { navLb(-1); });
      lb.querySelector('.ilf-lightbox__arrow--next').addEventListener('click', function() { navLb(1); });

      document.addEventListener('keydown', function(e) {
        if (!lb.classList.contains('ilf-lightbox--open')) return;
        if (e.key === 'Escape') closeLb();
        if (e.key === 'ArrowLeft') navLb(-1);
        if (e.key === 'ArrowRight') navLb(1);
      });
    }
  })();
</script>

{% schema %}
{
  "name": "SS - Lens Focus",
  "tag": "section",
  "class": "ilf-section",
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Gallery"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Through the Lens"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Hover or scroll to bring each image into sharp focus and reveal hidden details."
    },
    {
      "type": "header",
      "content": "Focus effect"
    },
    {
      "type": "select",
      "id": "focus_mode",
      "label": "Focus trigger",
      "options": [
        { "value": "hover", "label": "On hover" },
        { "value": "scroll", "label": "On scroll" },
        { "value": "always", "label": "Always focused" }
      ],
      "default": "hover",
      "info": "When unfocused, images appear blurred and desaturated."
    },
    {
      "type": "range",
      "id": "blur_amount",
      "label": "Blur intensity",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4,
      "unit": "px",
      "info": "How blurry unfocused images appear"
    },
    {
      "type": "checkbox",
      "id": "spotlight_effect",
      "label": "Spotlight reveal",
      "default": true,
      "info": "A radial light follows the mouse"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards",
      "min": 8,
      "max": 40,
      "step": 4,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 24,
      "step": 4,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "img_aspect",
      "label": "Image aspect ratio",
      "options": [
        { "value": "auto", "label": "Auto (natural)" },
        { "value": "4/3", "label": "4:3 Landscape" },
        { "value": "3/4", "label": "3:4 Portrait" },
        { "value": "1/1", "label": "1:1 Square" },
        { "value": "16/9", "label": "16:9 Wide" }
      ],
      "default": "3/4"
    },
    {
      "type": "header",
      "content": "Features"
    },
    {
      "type": "checkbox",
      "id": "show_filter",
      "label": "Show category filters",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_lightbox",
      "label": "Enable lightbox",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hover_lift",
      "label": "Lift card on hover",
      "default": true
    },
    {

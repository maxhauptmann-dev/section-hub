{%- comment -%}
  Section Hub — Before / After Morph Cards v1
  Grid of cards with circular ripple / slide / fade reveal animations.
{%- endcomment -%}

{%- assign sid           = section.id -%}
{%- assign reveal_mode   = section.settings.reveal_mode -%}
{%- assign show_toggle   = section.settings.show_toggle -%}
{%- assign show_tap_hint = section.settings.show_tap_hint -%}
{%- assign heading_font  = section.settings.heading_font -%}
{%- assign body_font     = section.settings.body_font -%}
{{ heading_font | font_face: font_display: 'swap' }}
{{ body_font    | font_face: font_display: 'swap' }}

<style>
#bam-{{ sid }}.bam-section {
  --bam-bg:                 {{ section.settings.bg_color }};
  --bam-text:               {{ section.settings.text_color }};
  --bam-muted:              {{ section.settings.muted_color }};
  --bam-accent:             {{ section.settings.accent_color }};
  --bam-card-bg:            {{ section.settings.card_bg_color }};
  --bam-mw:                 {{ section.settings.max_width }}px;
  --bam-pt:                 {{ section.settings.padding_top }}px;
  --bam-pb:                 {{ section.settings.padding_bottom }}px;
  --bam-pt-m:               {{ section.settings.padding_top_mobile }}px;
  --bam-pb-m:               {{ section.settings.padding_bottom_mobile }}px;
  --bam-header-gap:         {{ section.settings.header_gap }}px;
  --bam-header-gap-m:       {{ section.settings.header_gap_mobile }}px;
  --bam-header-align:       {{ section.settings.header_align }};
  --bam-cols:               {{ section.settings.columns_desktop }};
  --bam-cols-s:             {{ section.settings.columns_tablet }};
  --bam-cols-m:             {{ section.settings.columns_mobile }};
  --bam-gap:                {{ section.settings.grid_gap }}px;
  --bam-gap-m:              {{ section.settings.grid_gap_mobile }}px;
  --bam-card-radius:        {{ section.settings.card_radius }}px;
  --bam-card-h:             {{ section.settings.card_height }}px;
  --bam-card-h-m:           {{ section.settings.card_height_mobile }}px;
  --bam-card-p:             {{ section.settings.card_padding }}px;
  --bam-card-p-m:           {{ section.settings.card_padding_mobile }}px;
  --bam-card-shadow:        {% if section.settings.card_shadow %}0 2px 16px rgba(0,0,0,0.08){% else %}none{% endif %};
  --bam-card-shadow-hover:  {% if section.settings.card_shadow %}0 6px 32px rgba(0,0,0,0.15){% else %}none{% endif %};
  --bam-heading-size:       {{ section.settings.heading_size }}px;
  --bam-heading-size-m:     {{ section.settings.heading_size_mobile }}px;
  --bam-heading-weight:     {{ section.settings.heading_weight }};
  --bam-heading-ls:         {{ section.settings.heading_letter_spacing }}em;
  --bam-heading-style:      {{ heading_font.style }};
  --bam-body-size:          {{ section.settings.body_size }}px;
  --bam-body-style:         {{ body_font.style }};
  --bam-eyebrow-size:       {{ section.settings.eyebrow_size }}px;
  --bam-card-title-size:    {{ section.settings.card_title_size }}px;
  --bam-card-title-size-m:  {{ section.settings.card_title_size_mobile }}px;
  --bam-card-desc-size:     {{ section.settings.card_desc_size }}px;
  --bam-font-heading:       {{ heading_font.family }}, {{ heading_font.fallback_families }};
  --bam-font-body:          {{ body_font.family }},    {{ body_font.fallback_families }};
}
</style>

<section id="bam-{{ sid }}" class="bam-section" aria-label="{{ section.settings.heading | default: 'Before & After' }}">
  <div class="bam-wrap">

    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="bam-header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="bam-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="bam-heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="bam-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="bam-grid" id="bam-grid-{{ sid }}">
      {%- for block in section.blocks -%}
        <div
          class="bam-card"
          data-mode="{{ reveal_mode }}"
          data-idx="{{ forloop.index0 }}"
          tabindex="0"
          role="button"
          aria-label="{{ block.settings.title | default: 'Before After Card' }} — Click to reveal after"
          {{ block.shopify_attributes }}
        >
          <div class="bam-card-img-wrap">

            {%- comment -%} After image (bottom) {%- endcomment -%}
            {%- if block.settings.image_after != blank -%}
              {{ block.settings.image_after | image_url: width: 900 | image_tag:
                class: 'bam-img-after',
                loading: 'lazy',
                widths: '400,600,900',
                sizes: '(max-width:559px) 92vw, (max-width:899px) 46vw, 30vw'
              }}
            {%- else -%}
              <div class="bam-placeholder bam-placeholder--after">
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}

            {%- comment -%} Before image (top, will be clipped away) {%- endcomment -%}
            {%- if block.settings.image_before != blank -%}
              {{ block.settings.image_before | image_url: width: 900 | image_tag:
                class: 'bam-img-before',
                loading: 'lazy',
                widths: '400,600,900',
                sizes: '(max-width:559px) 92vw, (max-width:899px) 46vw, 30vw'
              }}
            {%- else -%}
              <div class="bam-placeholder bam-placeholder--before">
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}

            {%- comment -%} State labels {%- endcomment -%}
            {%- if section.settings.show_state_labels -%}
              <span class="bam-state-label bam-state-label--before">{{ block.settings.label_before | default: 'Before' }}</span>
              <span class="bam-state-label bam-state-label--after">{{ block.settings.label_after | default: 'After' }}</span>
            {%- endif -%}

            {%- comment -%} Badge {%- endcomment -%}
            {%- if block.settings.badge != blank -%}
              <span class="bam-badge">{{ block.settings.badge }}</span>
            {%- endif -%}

            {%- comment -%} Tap hint {%- endcomment -%}
            {%- if show_tap_hint -%}
              <div class="bam-tap-hint">
                <div class="bam-tap-hint-inner">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M12 5v14M5 12h14"/>
                  </svg>
                  Tap to reveal
                </div>
              </div>
            {%- endif -%}

            {%- comment -%} Toggle button {%- endcomment -%}
            {%- if show_toggle -%}
              <div class="bam-toggle-wrap">
                <button class="bam-toggle" data-toggle aria-label="Toggle before/after">
                  <span class="bam-toggle-dot">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                      <path d="M9 6l-4 6 4 6"/><path d="M15 6l4 6-4 6"/>
                    </svg>
                  </span>
                  <span class="bam-toggle-label">After</span>
                </button>
              </div>
            {%- endif -%}

          </div>

          {%- if block.settings.title != blank or block.settings.description != blank or block.settings.button_label != blank -%}
            <div class="bam-card-body">
              {%- if block.settings.title != blank -%}
                <p class="bam-card-title">{{ block.settings.title }}</p>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="bam-card-desc">{{ block.settings.description }}</p>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <a class="bam-card-link" href="{{ block.settings.button_link | default: '#' }}">
                  {{ block.settings.button_label }}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}

        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

<script>
(function(){
  var ROOT = document.getElementById('bam-{{ sid }}');
  if (!ROOT) return;

  function getRelPos(e, el) {
    var r   = el.getBoundingClientRect();
    var src = e.touches ? e.changedTouches[0] : e;
    return {
      x: ((src.clientX - r.left) / r.width  * 100).toFixed(1),
      y: ((src.clientY - r.top)  / r.height * 100).toFixed(1)
    };
  }

  function revealCard(card, e) {
    var mode = card.dataset.mode;
    if (mode === 'ripple' && e) {
      var imgWrap = card.querySelector('.bam-card-img-wrap');
      if (imgWrap) {
        var pos = getRelPos(e, imgWrap);
        card.style.setProperty('--bam-rx', pos.x + '%');
        card.style.setProperty('--bam-ry', pos.y + '%');
      }
    }
    card.classList.add('bam-revealed', 'bam-touched');
    var tl = card.querySelector('.bam-toggle-label');
    if (tl) tl.textContent = 'Before';
  }

  function unrevealCard(card) {
    card.classList.remove('bam-revealed');
    var tl = card.querySelector('.bam-toggle-label');
    if (tl) tl.textContent = 'After';
  }

  ROOT.querySelectorAll('.bam-card').forEach(function(card) {
    /* Click / tap on card image area */
    var imgWrap = card.querySelector('.bam-card-img-wrap');
    if (imgWrap) {
      imgWrap.addEventListener('click', function(e) {
        if (e.target.closest('[data-toggle]')) return;
        if (card.classList.contains('bam-revealed')) {
          unrevealCard(card);
        } else {
          revealCard(card, e);
        }
      });
      imgWrap.addEventListener('touchend', function(e) {
        if (e.target.closest('[data-toggle]')) return;
        e.preventDefault();
        if (card.classList.contains('bam-revealed')) {
          unrevealCard(card);
        } else {
          revealCard(card, e);
        }
      }, { passive: false });
    }

    /* Toggle button */
    var toggleBtn = card.querySelector('[data-toggle]');
    if (toggleBtn) {
      toggleBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (card.classList.contains('bam-revealed')) {
          unrevealCard(card);
        } else {
          revealCard(card, null);
        }
      });
    }

    /* Keyboard */
    card.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if (card.classList.contains('bam-revealed')) {
          unrevealCard(card);
        } else {
          revealCard(card, null);
        }
      }
    });
  });

  /* IntersectionObserver: stagger entrance */
  if (typeof IntersectionObserver !== 'undefined') {
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var idx = +entry.target.dataset.idx;
          entry.target.style.animationDelay = (idx * 0.07) + 's';
          entry.target.style.animation = 'bam-card-in 0.5s ease both';
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });
    ROOT.querySelectorAll('.bam-card').forEach(function(c){ io.observe(c); });
  }
})();
</script>

<style>
@keyframes bam-card-in {
  from { opacity: 0; transform: translateY(22px); }
  to   { opacity: 1; transform: translateY(0); }
}
</style>


    },
    {
      "type": "range",
      "id": "target_hour",
      "label": "Hour",
      "min": 0,
      "max": 23,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "target_minute",
      "label": "Minute",
      "min": 0,
      "max": 59,
      "step": 1,
      "default": 0

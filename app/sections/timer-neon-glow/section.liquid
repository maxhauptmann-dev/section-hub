      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Limited Time"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Flash Sale Ends Soon"
    },
    {

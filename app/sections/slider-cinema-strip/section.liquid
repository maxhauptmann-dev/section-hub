{% comment %}
  SectionHub – Cinema Strip Slider  (scs-)
  Film-strip inspired horizontal slider with sprocket holes
{% endcomment %}

{%- assign sid = section.id -%}
{%- assign heading_font = section.settings.heading_font -%}
{%- assign body_font    = section.settings.body_font -%}

<style>
  {{ heading_font | font_face }}
  {{ body_font | font_face }}

  #scs-{{ sid }} {
    --scs-bg: {{ section.settings.bg_color }};
    --scs-accent: {{ section.settings.accent_color }};
    --scs-strip-bg: {{ section.settings.strip_color }};
    --scs-heading-color: {{ section.settings.heading_color }};
    --scs-text-color: {{ section.settings.text_color }};
    --scs-heading-ff: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --scs-heading-fw: {{ heading_font.weight }};
    --scs-heading-fs: {{ heading_font.style }};
    --scs-body-ff: {{ body_font.family }}, {{ body_font.fallback_families }};
    --scs-body-fw: {{ body_font.weight }};
    --scs-frame-w: {{ section.settings.frame_width }}px;
    --scs-frame-h: {{ section.settings.frame_height }}px;
    --scs-frame-gap: {{ section.settings.frame_gap }}px;
    --scs-radius: {{ section.settings.frame_radius }}px;
    --scs-py: {{ section.settings.padding_y }}px;
    --scs-px: {{ section.settings.padding_x }}px;
  }
</style>

<section id="scs-{{ sid }}" class="scs-wrap" data-scs-reveal>
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subtext != blank -%}
    <div class="scs-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="scs-header__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="scs-header__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="scs-header__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="scs-film">
    {%- if section.settings.show_sprockets -%}
      <div class="scs-sprockets scs-sprockets--top">
        {%- for i in (1..20) -%}
          <span class="scs-sprocket"></span>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="scs-viewport" data-scs-viewport>
      <div class="scs-track" data-scs-track>
        {%- for block in section.blocks -%}
          <div class="scs-frame{% if forloop.first %} scs-frame--active{% endif %}"
               data-scs-frame="{{ forloop.index0 }}"
               {{ block.shopify_attributes }}>

            <div class="scs-frame__media">
              {%- if block.settings.image != blank -%}
                <img
                  class="scs-frame__img"
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  srcset="{{ block.settings.image | image_url: width: 400 }} 400w,
                          {{ block.settings.image | image_url: width: 600 }} 600w,
                          {{ block.settings.image | image_url: width: 800 }} 800w,
                          {{ block.settings.image | image_url: width: 1100 }} 1100w"
                  sizes="(max-width:480px) 260px, (max-width:768px) 340px, {{ section.settings.frame_width }}px"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="lazy"
                >
              {%- else -%}
                <div class="scs-frame__placeholder">
                  <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
                    <rect x="2" y="2" width="20" height="20" rx="2.18"/>
                    <path d="M7 2v20M17 2v20M2 12h20M2 7h5M2 17h5M17 17h5M17 7h5"/>
                  </svg>
                </div>
              {%- endif -%}
            </div>

            <div class="scs-frame__caption">
              <div class="scs-frame__meta">
                {%- if block.settings.tag != blank -%}
                  <span class="scs-frame__tag">{{ block.settings.tag }}</span>
                {%- endif -%}
                <span class="scs-frame__num">Frame {{ forloop.index }}</span>
              </div>
              {%- if block.settings.heading != blank -%}
                <h3 class="scs-frame__heading">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="scs-frame__text">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- if block.settings.btn_text != blank -%}
                <a class="scs-frame__btn" href="{{ block.settings.btn_link }}">
                  {{ block.settings.btn_text }}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.show_sprockets -%}
      <div class="scs-sprockets scs-sprockets--bottom">
        {%- for i in (1..20) -%}
          <span class="scs-sprocket"></span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="scs-controls">
    {%- if section.settings.show_arrows -%}
      <div class="scs-arrows">
        <button class="scs-arrow scs-arrow--prev" data-scs-prev aria-label="Previous frame">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        </button>
        <button class="scs-arrow scs-arrow--next" data-scs-next aria-label="Next frame">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
      </div>
    {%- endif -%}

    {%- if section.settings.show_counter -%}
      <div class="scs-counter">
        <span class="scs-counter__cur" data-scs-cur>01</span>
        <span class="scs-counter__sep">/</span>
        <span class="scs-counter__tot">{{ section.blocks.size | prepend: '0' | slice: -2, 2 }}</span>
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.show_filmstrip -%}
    <div class="scs-filmstrip" data-scs-filmstrip>
      {%- for block in section.blocks -%}
        <button class="scs-thumb{% if forloop.first %} scs-thumb--active{% endif %}" data-scs-thumb="{{ forloop.index0 }}">
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 120 }}" alt="" loading="lazy">
          {%- else -%}
            <span class="scs-thumb__empty">{{ forloop.index }}</span>
          {%- endif -%}
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<script>
  (function(){
    var wrap     = document.getElementById('scs-{{ sid }}');
    if(!wrap) return;

    var viewport = wrap.querySelector('[data-scs-viewport]');
    var frames   = Array.from(wrap.querySelectorAll('[data-scs-frame]'));
    var thumbs   = Array.from(wrap.querySelectorAll('[data-scs-thumb]'));
    var prevBtn  = wrap.querySelector('[data-scs-prev]');
    var nextBtn  = wrap.querySelector('[data-scs-next]');
    var curEl    = wrap.querySelector('[data-scs-cur]');

    var count    = frames.length;
    if(count === 0) return;

    var active    = 0;
    var autoTimer = null;
    var auto      = {{ section.settings.autoplay | json }};
    var speed     = {{ section.settings.autoplay_speed }} * 1000;

    function goTo(idx){
      active = ((idx % count) + count) % count;
      var frame = frames[active];

      viewport.scrollTo({
        left: frame.offsetLeft - (viewport.offsetWidth - frame.offsetWidth) / 2,
        behavior: 'smooth'
      });

      frames.forEach(function(f, i){ f.classList.toggle('scs-frame--active', i === active); });
      thumbs.forEach(function(t, i){ t.classList.toggle('scs-thumb--active', i === active); });

      if(curEl){
        var num = active + 1;
        curEl.textContent = num < 10 ? '0' + num : '' + num;
      }
    }

    /* arrows */
    if(prevBtn) prevBtn.addEventListener('click', function(){ goTo(active - 1); startAuto(); });
    if(nextBtn) nextBtn.addEventListener('click', function(){ goTo(active + 1); startAuto(); });

    /* thumbs */
    thumbs.forEach(function(t, i){
      t.addEventListener('click', function(){ goTo(i); startAuto(); });
    });

    /* frame click */
    frames.forEach(function(f, i){
      f.addEventListener('click', function(){ if(i !== active){ goTo(i); startAuto(); } });
    });

    /* touch */
    var tx = 0;
    viewport.addEventListener('touchstart', function(e){ tx = e.touches[0].clientX; }, {passive:true});
    viewport.addEventListener('touchend', function(e){
      var dx = e.changedTouches[0].clientX - tx;
      if(Math.abs(dx) > 40){
        if(dx < 0) goTo(active + 1); else goTo(active - 1);
        startAuto();
      }
    }, {passive:true});

    /* drag */
    var isDrag = false, startX = 0, scrollL = 0;
    viewport.addEventListener('mousedown', function(e){
      isDrag = true; startX = e.pageX; scrollL = viewport.scrollLeft;
      viewport.style.cursor = 'grabbing';
    });
    window.addEventListener('mousemove', function(e){
      if(!isDrag) return;
      e.preventDefault();
      viewport.scrollLeft = scrollL - (e.pageX - startX);
    });
    window.addEventListener('mouseup', function(){
      if(!isDrag) return;
      isDrag = false;
      viewport.style.cursor = '';
      /* snap to closest */
      var center = viewport.scrollLeft + viewport.offsetWidth / 2;
      var closest = 0, minDist = Infinity;
      frames.forEach(function(f, i){
        var mid = f.offsetLeft + f.offsetWidth / 2;
        if(Math.abs(mid - center) < minDist){ minDist = Math.abs(mid - center); closest = i; }
      });
      goTo(closest);
      startAuto();
    });

    /* keyboard */
    wrap.setAttribute('tabindex', '0');
    wrap.addEventListener('keydown', function(e){
      if(e.key === 'ArrowLeft'){ goTo(active - 1); startAuto(); }
      if(e.key === 'ArrowRight'){ goTo(active + 1); startAuto(); }
    });

    /* snap sync */
    var scrollTimeout;
    viewport.addEventListener('scroll', function(){
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(function(){
        var center = viewport.scrollLeft + viewport.offsetWidth / 2;
        var closest = 0, minDist = Infinity;
        frames.forEach(function(f, i){
          var mid = f.offsetLeft + f.offsetWidth / 2;
          if(Math.abs(mid - center) < minDist){ minDist = Math.abs(mid - center); closest = i; }
        });
        if(closest !== active){
          active = closest;
          frames.forEach(function(f, i){ f.classList.toggle('scs-frame--active', i === active); });
          thumbs.forEach(function(t, i){ t.classList.toggle('scs-thumb--active', i === active); });
          if(curEl){
            var num = active + 1;
            curEl.textContent = num < 10 ? '0' + num : '' + num;
          }
          startAuto();
        }
      }, 80);
    }, {passive: true});

    /* autoplay */
    function startAuto(){
      stopAuto();
      if(!auto) return;
      autoTimer = setInterval(function(){ goTo(active + 1); }, speed);
    }
    function stopAuto(){ clearInterval(autoTimer); }

    /* scroll reveal */
    if('IntersectionObserver' in window){
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(en){
          if(en.isIntersecting){
            en.target.classList.add('scs-visible');
            goTo(0);
            startAuto();
            io.unobserve(en.target);
          }
        });
      }, {threshold: 0.15});
      io.observe(wrap);
    } else {
      wrap.classList.add('scs-visible');
      goTo(0);
      startAuto();
    }
  })();
</script>

{% schema %}
{
  "name": "Cinema Strip Slider",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Visual Reel"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Behind the scenes"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Scroll through our visual reel — each frame tells a story worth exploring."
    },
    {
      "type": "header",
      "content": "Frame Dimensions"
    },
    {
      "type": "range",
      "id": "frame_width",
      "label": "Frame Width (px)",
      "min": 260,
      "max": 520,
      "step": 10,
      "default": 380,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "frame_height",
      "label": "Frame Height (px)",
      "min": 220,
      "max": 460,
      "step": 10,
      "default": 320,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "frame_gap",
      "label": "Frame Gap (px)",
      "min": 8,
      "max": 40,
      "step": 4,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "frame_radius",
      "label": "Frame Radius (px)",
      "min": 0,
      "max": 20,
      "step": 2,
      "default": 4,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Film Style"
    },
    {
      "type": "checkbox",
      "id": "show_sprockets",
      "label": "Show Sprocket Holes",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_filmstrip",
      "label": "Show Filmstrip Thumbs",
      "default": true
    },
    {
      "type": "header",
      "content": "Behaviour"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay Speed (s)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 4,
      "unit": "s"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_counter",
      "label": "Show Counter",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#faf7f2"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#c2634a"
    },
    {
      "type": "color",
      "id": "strip_color",
      "label": "Film Strip Color",
      "default": "#2c2418"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#2c2418"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#7a6e5f"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading Font",
      "default": "playfair_display_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body Font",
      "default": "inter_n4"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding (px)",
      "min": 20,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Horizontal Padding (px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 24,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "frame",
      "name": "Film Frame",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag / Scene"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "btn_text",
          "label": "Button Text"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cinema Strip Slider",
      "category": "Slider",
      "blocks": [
        {
          "type": "frame",
          "settings": {
            "tag": "Scene I",
            "heading": "The Workshop",
            "text": "Raw materials meet skilled hands in our sunlit atelier where every piece begins its journey.",
            "btn_text": "Watch"
          }
        },
        {
          "type": "frame",
          "settings": {
            "tag": "Scene II",
            "heading": "First Light",
            "text": "Dawn breaks over the studio — the golden hour when inspiration meets craftsmanship.",
            "btn_text": "Explore"
          }
        },
        {
          "type": "frame",
          "settings": {
            "tag": "Scene III",
            "heading": "The Details",
            "text": "Macro moments that reveal the precision and care woven into every millimeter.",
            "btn_text": "Zoom In"
          }
        },
        {
          "type": "frame",
          "settings": {
            "tag": "Scene IV",
            "heading": "Final Cut",
            "text": "The finished piece — polished, purposeful, and ready to find its home in the world.",
            "btn_text": "View"
          }
        },
        {
          "type": "frame",
          "settings": {
            "tag": "Scene V",
            "heading": "The Collection",
            "text": "All pieces together — a cohesive narrative of texture, tone, and timeless design.",
            "btn_text": "See All"
          }
        }
      ]
    }
  ]
}
{% endschema %}

          "info": "Leave blank to use collection URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SIQ - Reveal Tiles",
      "settings": {
        "eyebrow": "Collections",
        "heading": "Unveiled For You",
        "subtext": "Each collection reveals itself as you explore."
      },
      "blocks": [
        {
          "type": "tile",
          "settings": { "title": "New Season", "tag": "Spring 2026", "subtitle": "Fresh arrivals for the new season", "tile_height": 420 }
        },
        {
          "type": "tile",
          "settings": { "title": "Essentials", "tag": "Wardrobe", "subtitle": "Timeless everyday pieces", "tile_height": 320 }
        },
        {
          "type": "tile",
          "settings": { "title": "Limited Edition", "tag": "Exclusive", "subtitle": "While stocks last", "tile_height": 380 }
        },
        {

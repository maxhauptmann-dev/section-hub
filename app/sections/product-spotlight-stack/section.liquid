        },
        {
          "type": "text",
          "id": "feature_3",
          "label": "Feature 3",
          "default": "30-day free returns"
        },
        {
          "type": "text",
          "id": "feature_4",
          "label": "Feature 4"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Product link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SIQ - Spotlight Stack",
      "blocks": [
        {
          "type": "product",
          "settings": {
            "title": "Signature Collection",
            "price": "$149.00",
            "price_compare": "$199.00",
            "badge": "New",
            "description": "Crafted for those who demand perfection. Premium materials, timeless design.",
            "feature_1": "Premium quality materials",
            "feature_2": "Free shipping worldwide",
            "feature_3": "30-day free returns"
          }
        },
        {
          "type": "product",
          "settings": {
            "title": "Essential Bundle",
            "price": "$89.00",
            "badge": "Bestseller",
            "description": "Everything you need, nothing you don't. The perfect starter kit for the modern lifestyle.",
            "feature_1": "Curated starter set",
            "feature_2": "Exclusive bundle pricing",
            "feature_3": "Gift-ready packaging"
          }
        },
        {
          "type": "product",
          "settings": {
            "title": "Limited Edition",
            "price": "$219.00",
            "price_compare": "$289.00",
            "badge": "Limited",
            "description": "Only 50 pieces worldwide. Own a piece of history with our most exclusive release.",
            "feature_1": "Numbered certificate included",
            "feature_2": "Handcrafted in Europe",
            "feature_3": "Lifetime warranty"
          }
        },
        {
          "type": "product",
          "settings": {
            "title": "Classic Series",
            "price": "$69.00",
            "badge": "Sale",
            "description": "The icon that started it all. Timeless style meets modern performance.",

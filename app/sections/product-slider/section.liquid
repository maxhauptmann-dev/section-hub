{% comment %}
  Section Hub – Product Slider
  Scrollable product carousel with hover image swap.
  Supports: collection source OR individual product blocks.
{% endcomment %}

{{ 'styles.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign card_width = section.settings.card_width
  assign card_width_mobile = section.settings.card_width_mobile
  assign gap = section.settings.gap
  assign ratio = section.settings.image_ratio
  assign show_vendor = section.settings.show_vendor
  assign show_price = section.settings.show_price
  assign show_badge = section.settings.show_badge
  assign badge_text = section.settings.badge_text
  assign show_quick_add = section.settings.show_quick_add
  assign show_compare = section.settings.show_compare_price
  assign source = section.settings.source
-%}

<div
  class="sh-product-slider"
  style="
    --sh-ps-pt: {{ section.settings.padding_top }}px;
    --sh-ps-pb: {{ section.settings.padding_bottom }}px;
    --sh-ps-mt: {{ section.settings.margin_top }}px;
    --sh-ps-mb: {{ section.settings.margin_bottom }}px;
    --sh-ps-bg: {{ section.settings.bg_color }};
    --sh-ps-side: {{ section.settings.side_padding }}rem;
    --sh-ps-side-mobile: {{ section.settings.side_padding_mobile }}rem;
    --sh-ps-gap: {{ gap }}px;
    --sh-ps-card-width: {{ card_width }}px;
    --sh-ps-card-width-mobile: {{ card_width_mobile }}px;
    --sh-ps-card-radius: {{ section.settings.card_radius }}px;
    --sh-ps-ratio: {% if ratio == 'square' %}1/1{% elsif ratio == 'portrait' %}3/4{% elsif ratio == 'tall' %}2/3{% elsif ratio == 'landscape' %}4/3{% else %}auto{% endif %};
    --sh-ps-heading-size: {{ section.settings.heading_size }}px;
    --sh-ps-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --sh-ps-heading-color: {{ section.settings.heading_color }};
    --sh-ps-title-size: {{ section.settings.title_size }}px;
    --sh-ps-title-color: {{ section.settings.title_color }};
    --sh-ps-price-size: {{ section.settings.price_size }}px;
    --sh-ps-price-color: {{ section.settings.price_color }};
    --sh-ps-compare-color: {{ section.settings.compare_color }};
    --sh-ps-vendor-color: {{ section.settings.vendor_color }};
    --sh-ps-badge-bg: {{ section.settings.badge_bg }};
    --sh-ps-badge-color: {{ section.settings.badge_color }};
    --sh-ps-badge-size: {{ section.settings.badge_size }}px;
    --sh-ps-badge-radius: {{ section.settings.badge_radius }}px;
    --sh-ps-border-color: {{ section.settings.arrow_border_color }};
    --sh-ps-arrow-bg: {{ section.settings.arrow_bg }};
    --sh-ps-arrow-color: {{ section.settings.arrow_color }};
    --sh-ps-arrow-hover-bg: {{ section.settings.arrow_hover_bg }};
    --sh-ps-arrow-hover-color: {{ section.settings.arrow_hover_color }};
    --sh-ps-arrow-size: {{ section.settings.arrow_size }}px;
    --sh-ps-quick-bg: {{ section.settings.quick_add_bg }};
    --sh-ps-quick-color: {{ section.settings.quick_add_color }};
  "
  data-section-id="{{ section.id }}"
>
  {%- if section.settings.heading != blank or section.settings.show_arrows -%}
    <div class="sh-product-slider__header">
      {% if section.settings.heading != blank %}
        <h2 class="sh-product-slider__heading">{{ section.settings.heading }}</h2>
      {% else %}
        <span></span>
      {% endif %}

      {% if section.settings.show_arrows %}
        <div class="sh-product-slider__nav {% if section.settings.hide_arrows_mobile %}sh-product-slider__nav--hide-mobile{% endif %}">
          <button class="sh-product-slider__arrow" data-sh-ps-prev aria-label="Previous">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 18L9 12L15 6"/>
            </svg>
          </button>
          <button class="sh-product-slider__arrow" data-sh-ps-next aria-label="Next">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18L15 12L9 6"/>
            </svg>
          </button>
        </div>
      {% endif %}
    </div>
  {%- endif -%}

  <div class="sh-product-slider__track" data-sh-ps-track>
    {%- if source == 'collection' -%}
      {%- assign col = section.settings.collection -%}
      {%- if col != blank -%}
        {%- for product in collections[col].products limit: section.settings.max_products -%}
          <a class="sh-product-slider__card" href="{{ product.url }}">
            <div class="sh-product-slider__image-wrap">
              {%- if product.featured_image -%}
                <img
                  class="sh-product-slider__img sh-product-slider__img--primary"
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                  width="600"
                  height="800"
                >
                {%- if product.images[1] != blank -%}
                  <img
                    class="sh-product-slider__img sh-product-slider__img--secondary"
                    src="{{ product.images[1] | image_url: width: 600 }}"
                    alt="{{ product.images[1].alt | escape }}"
                    loading="lazy"
                    width="600"
                    height="800"
                  >
                {%- endif -%}
              {%- else -%}
                <div class="sh-product-slider__placeholder">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {%- endif -%}

              {%- if show_badge and badge_text != blank -%}
                <span class="sh-product-slider__badge">{{ badge_text }}</span>
              {%- endif -%}

              {%- if show_quick_add -%}
                <span class="sh-product-slider__quick-add" aria-label="Quick view">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                  </svg>
                </span>
              {%- endif -%}
            </div>

            <div class="sh-product-slider__info">
              {%- if show_vendor -%}
                <div class="sh-product-slider__vendor">{{ product.vendor }}</div>
              {%- endif -%}
              <p class="sh-product-slider__title">{{ product.title }}</p>
              {%- if show_price -%}
                <div class="sh-product-slider__price">
                  {%- if show_compare and product.compare_at_price > product.price -%}
                    <span class="sh-product-slider__compare-price">{{ product.compare_at_price | money }}</span>
                  {%- endif -%}
                  {{ product.price | money }}
                </div>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Placeholder cards when no collection selected {%- endcomment -%}
        {%- for i in (1..6) -%}
          <div class="sh-product-slider__card">
            <div class="sh-product-slider__image-wrap">
              <div class="sh-product-slider__placeholder">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            </div>
            <div class="sh-product-slider__info">
              <p class="sh-product-slider__title">Example Product {{ i }}</p>
              <div class="sh-product-slider__price">€29.95</div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}

    {%- elsif source == 'products' -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'product' and block.settings.product != blank -%}
          {%- assign p = block.settings.product -%}
          {%- assign custom_badge = block.settings.custom_badge -%}
          <a class="sh-product-slider__card" href="{{ p.url }}" {{ block.shopify_attributes }}>
            <div class="sh-product-slider__image-wrap">
              {%- if p.featured_image -%}
                <img
                  class="sh-product-slider__img sh-product-slider__img--primary"
                  src="{{ p.featured_image | image_url: width: 600 }}"
                  alt="{{ p.featured_image.alt | escape }}"
                  loading="lazy"
                  width="600"
                  height="800"
                >
                {%- if p.images[1] != blank -%}
                  <img
                    class="sh-product-slider__img sh-product-slider__img--secondary"
                    src="{{ p.images[1] | image_url: width: 600 }}"
                    alt="{{ p.images[1].alt | escape }}"
                    loading="lazy"
                    width="600"
                    height="800"
                  >
                {%- endif -%}
              {%- else -%}
                <div class="sh-product-slider__placeholder">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {%- endif -%}

              {%- if show_badge and custom_badge != blank -%}
                <span class="sh-product-slider__badge">{{ custom_badge }}</span>
              {%- endif -%}

              {%- if show_quick_add -%}
                <span class="sh-product-slider__quick-add" aria-label="Quick view">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                  </svg>
                </span>
              {%- endif -%}
            </div>

            <div class="sh-product-slider__info">
              {%- if show_vendor -%}
                <div class="sh-product-slider__vendor">{{ p.vendor }}</div>
              {%- endif -%}
              <p class="sh-product-slider__title">{{ p.title }}</p>
              {%- if show_price -%}
                <div class="sh-product-slider__price">
                  {%- if show_compare and p.compare_at_price > p.price -%}
                    <span class="sh-product-slider__compare-price">{{ p.compare_at_price | money }}</span>
                  {%- endif -%}
                  {{ p.price | money }}
                </div>
              {%- endif -%}
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

<script>
(function () {
  var section = document.querySelector('[data-section-id="{{ section.id }}"]');
  if (!section) return;

  var track = section.querySelector('[data-sh-ps-track]');
  var prev = section.querySelector('[data-sh-ps-prev]');
  var next = section.querySelector('[data-sh-ps-next]');
  if (!track) return;

  var scrollAmount = parseInt(getComputedStyle(section).getPropertyValue('--sh-ps-card-width')) + parseInt(getComputedStyle(section).getPropertyValue('--sh-ps-gap'));

  if (prev) {
    prev.addEventListener('click', function () {
      track.scrollBy({ left: -scrollAmount * 2, behavior: 'smooth' });
    });
  }
  if (next) {
    next.addEventListener('click', function () {
      track.scrollBy({ left: scrollAmount * 2, behavior: 'smooth' });
    });
  }
})();
</script>

{% schema %}
{
  "name": "SH – Product Slider",
  "tag": "section",
  "class": "sh-product-slider-section",
  "settings": [
    {
      "type": "header",

{% comment %}
  Section Hub – Scroll Morph Gallery v1.0
  Images morph from small rounded shapes to fullwidth as user scrolls.
  Each image has its own scroll zone with parallax and text overlay.
  Prefix: smg-
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign bg = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign accent = section.settings.accent_color
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign scroll_per = section.settings.scroll_per_image
  assign start_w = section.settings.start_width
  assign start_radius = section.settings.start_radius
  assign gap = section.settings.image_gap
  assign overlay_color = section.settings.overlay_color
  assign overlay_op = section.settings.overlay_opacity
  assign show_counter = section.settings.show_counter
  assign show_captions = section.settings.show_captions
  assign heading_align = section.settings.heading_align
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom

  assign total = section.blocks.size
  assign total_scroll = total | times: scroll_per | plus: 100
-%}

{%- assign ov_r = overlay_color | color_extract: 'red' -%}
{%- assign ov_g = overlay_color | color_extract: 'green' -%}
{%- assign ov_b = overlay_color | color_extract: 'blue' -%}
{%- assign ov_a = overlay_op | divided_by: 100.0 -%}

<style>
  .smg-wrap--{{ sid }}{
    --smg-bg:{{ bg }};
    --smg-text:{{ text_color }};
    --smg-accent:{{ accent }};
    --smg-overlay:rgba({{ ov_r }},{{ ov_g }},{{ ov_b }},{{ ov_a }});
    --smg-start-w:{{ start_w }}%;
    --smg-start-r:{{ start_radius }}px;
    --smg-gap:{{ gap }}px;
    --smg-mt:{{ mt }}px;
    --smg-mb:{{ mb }}px;
  }
</style>

{%- if total > 0 -%}
<section class="smg-wrap smg-wrap--{{ sid }}" data-smg data-smg-panels="{{ total }}" data-smg-scroll-per="{{ scroll_per }}">

  {%- if heading != blank or subheading != blank -%}
    <div class="smg-header" style="text-align:{{ heading_align }}">
      {%- if heading != blank -%}
        <h2 class="smg-heading">{{ heading }}</h2>
      {%- endif -%}
      {%- if subheading != blank -%}
        <p class="smg-sub">{{ subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="smg-scroll" style="height:{{ total_scroll }}vh;">
    <div class="smg-sticky">

      {%- comment -%} Image panels {%- endcomment -%}
      {%- for block in section.blocks -%}
        <div
          class="smg-panel{% if forloop.first %} smg-panel--active{% endif %}"
          data-smg-panel="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          <div class="smg-panel__img-wrap" data-smg-img="{{ forloop.index0 }}">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 1800 }}"
                srcset="{{ block.settings.image | image_url: width: 700 }} 700w,{{ block.settings.image | image_url: width: 1200 }} 1200w,{{ block.settings.image | image_url: width: 1800 }} 1800w"
                sizes="100vw"
                alt="{{ block.settings.image.alt | default: block.settings.caption | escape }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                class="smg-panel__img"
              >
            {%- else -%}
              <div class="smg-panel__ph">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
              </div>
            {%- endif -%}
            <div class="smg-panel__overlay"></div>
          </div>

          {%- if show_captions -%}
            <div class="smg-panel__caption" data-smg-caption="{{ forloop.index0 }}">
              {%- if block.settings.eyebrow != blank -%}
                <span class="smg-panel__eyebrow">{{ block.settings.eyebrow }}</span>
              {%- endif -%}
              {%- if block.settings.caption != blank -%}
                <h3 class="smg-panel__title">{{ block.settings.caption }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="smg-panel__desc">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}

      {%- comment -%} Counter {%- endcomment -%}
      {%- if show_counter -%}
        <div class="smg-counter">
          <span class="smg-counter__num" data-smg-counter>01</span>
          <span class="smg-counter__sep">/</span>
          <span>{{ total | prepend: '0' | slice: -2, 2 }}</span>
        </div>
      {%- endif -%}

      {%- comment -%} Scroll progress bar {%- endcomment -%}
      <div class="smg-progress-bar">
        <div class="smg-progress-fill" data-smg-progress></div>
      </div>

    </div>
  </div>
</section>
{%- endif -%}

<script>
(function(){
  var wrap = document.querySelector('.smg-wrap--{{ sid }}');
  if(!wrap) return;

  var scrollEl = wrap.querySelector('.smg-scroll');
  var panels = wrap.querySelectorAll('[data-smg-panel]');
  var imgWraps = wrap.querySelectorAll('[data-smg-img]');
  var captions = wrap.querySelectorAll('[data-smg-caption]');
  var counterEl = wrap.querySelector('[data-smg-counter]');
  var progressEl = wrap.querySelector('[data-smg-progress]');
  var panelCount = panels.length;
  var scrollPer = parseInt(wrap.dataset.smgScrollPer) || 150;
  var startW = parseFloat(getComputedStyle(wrap).getPropertyValue('--smg-start-w')) || 40;
  var startR = parseInt(getComputedStyle(wrap).getPropertyValue('--smg-start-r')) || 30;

  /* Mobile: use larger start width for better visibility */
  var isMobile = window.innerWidth < 600;
  if(isMobile){
    startW = Math.max(startW, 70);
    startR = Math.min(startR, 16);
  }

  function update(){
    var rect = scrollEl.getBoundingClientRect();
    var total = scrollEl.offsetHeight - window.innerHeight;
    if(total <= 0) return;

    var scrolled = Math.max(0, -rect.top);
    var globalProgress = Math.min(scrolled / total, 1);

    /* Determine active panel */
    var rawIndex = globalProgress * panelCount;
    var activeIndex = Math.min(Math.floor(rawIndex), panelCount - 1);
    var panelProgress = rawIndex - activeIndex;

    panels.forEach(function(p, i){
      var isActive = i === activeIndex;
      p.classList.toggle('smg-panel--active', isActive);

      var iw = imgWraps[i];
      if(!iw) return;

      if(isActive){
        /* Morph: width goes from startW% to 100%, radius from startR to 0 */
        var w = startW + (100 - startW) * panelProgress;
        var r = startR * (1 - panelProgress);
        var scale = 0.85 + 0.15 * panelProgress;
        iw.style.width = w + '%';
        iw.style.borderRadius = r + 'px';
        iw.style.transform = 'scale(' + scale + ')';
        iw.style.opacity = '1';
      } else if(i < activeIndex){
        iw.style.width = '100%';
        iw.style.borderRadius = '0';
        iw.style.transform = 'scale(1)';
        iw.style.opacity = '0';
      } else {
        iw.style.width = startW + '%';
        iw.style.borderRadius = startR + 'px';
        iw.style.transform = 'scale(0.85)';
        iw.style.opacity = '0';
      }
    });

    /* Captions */
    captions.forEach(function(c, i){
      var isActive = i === activeIndex;
      if(isActive){
        var captionProgress = Math.max(0, (panelProgress - 0.3) / 0.4);
        c.style.opacity = Math.min(captionProgress, 1);
        c.style.transform = 'translateY(' + (20 * (1 - Math.min(captionProgress, 1))) + 'px)';
      } else {
        c.style.opacity = '0';
        c.style.transform = 'translateY(20px)';
      }
    });

    /* Counter */
    if(counterEl){
      counterEl.textContent = String(activeIndex + 1).padStart(2, '0');
    }

    /* Progress bar */
    if(progressEl){
      progressEl.style.width = (globalProgress * 100) + '%';
    }
  }

  window.addEventListener('scroll', function(){ requestAnimationFrame(update); }, {passive:true});
  update();
})();
</script>

{% schema %}
{
  "name": "SIQ - Morph Gallery",
  "tag": "section",
  "class": "section-scroll-morph-gallery",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Craftsmanship"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Scroll to explore every detail. Each image tells its own story."
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Morph Effect"
    },
    {
      "type": "range",
      "id": "start_width",
      "label": "Start width",
      "min": 20,
      "max": 60,
      "step": 5,
      "default": 35,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "start_radius",
      "label": "Start radius",
      "min": 0,
      "max": 60,
      "step": 4,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "scroll_per_image",
      "label": "Scroll per image",
      "min": 100,
      "max": 300,
      "step": 25,
      "default": 175,
      "unit": "vh"
    },
    {
      "type": "header",
      "content": "Display"
    },
    {
      "type": "checkbox",
      "id": "show_captions",
      "label": "Show captions",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_counter",
      "label": "Show counter",
      "default": true
    },
    {
      "type": "range",
      "id": "image_gap",
      "label": "Panel gap",
      "min": 0,
      "max": 40,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 30,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#a78bfa"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "image_panel",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Chapter One"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Title",
          "default": "The Beginning"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Every great story starts with a single moment of inspiration."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SIQ - Morph Gallery",
      "blocks": [
        { "type": "image_panel", "settings": { "eyebrow": "Chapter One", "caption": "Raw Materials", "description": "Sourced from the finest origins. Hand-selected for perfection." } },
        { "type": "image_panel", "settings": { "eyebrow": "Chapter Two", "caption": "The Process", "description": "Where tradition meets innovation. Crafted with precision and passion." } },
        { "type": "image_panel", "settings": { "eyebrow": "Chapter Three", "caption": "Attention to Detail", "description": "Every stitch, every cut, every finish — examined under a master's eye." } },
        { "type": "image_panel", "settings": { "eyebrow": "Chapter Four", "caption": "The Final Piece", "description": "A masterwork of design. Ready to become part of your story." } }
      ]
    }
  ]
}
{% endschema %}

          "settings": { "rating": 5, "title": "Love it!", "quote": "Bin total begeistert von der Qualität. Das Material fühlt sich luxuriös an.", "name": "Elena S.", "verified": true }
        },
        {
          "type": "review",
          "settings": { "rating": 5, "title": "Toller Shop", "quote": "Sehr zufrieden mit meiner Bestellung. Die Kommunikation war super und die Lieferung kam schnell.", "name": "Jan W.", "verified": true }
        }
      ]

{{ 'section-hero-particle-float.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id
  assign bg = section.settings.bg_color
  assign bg2 = section.settings.bg_color_2
  assign text_color = section.settings.text_color
  assign accent = section.settings.accent_color
  assign particle1 = section.settings.particle_color_1
  assign particle2 = section.settings.particle_color_2
  assign particle3 = section.settings.particle_color_3
  assign btn_bg = section.settings.btn_bg
  assign btn_text = section.settings.btn_text
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign btn_label = section.settings.btn_label
  assign btn_link = section.settings.btn_link
  assign min_h = section.settings.min_height
  assign pad_y = section.settings.padding_y
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom
  assign h_size = section.settings.heading_size
  assign content_align = section.settings.content_align
  assign particle_count = section.settings.particle_count
  assign particle_size = section.settings.particle_size
  assign particle_speed = section.settings.particle_speed
  assign bg_image = section.settings.bg_image
  assign overlay_opacity = section.settings.overlay_opacity
-%}

<div
  id="hpf-{{ sid }}"
  class="hpf"
  style="
    --hpf-bg:{{ bg }};
    --hpf-bg2:{{ bg2 }};
    --hpf-text:{{ text_color }};
    --hpf-accent:{{ accent }};
    --hpf-p1:{{ particle1 }};
    --hpf-p2:{{ particle2 }};
    --hpf-p3:{{ particle3 }};
    --hpf-btn-bg:{{ btn_bg }};
    --hpf-btn-text:{{ btn_text }};
    --hpf-min-h:{{ min_h }}px;
    --hpf-pad-y:{{ pad_y }}px;
    --hpf-mt:{{ mt }}px;
    --hpf-mb:{{ mb }}px;
    --hpf-h-size:{{ h_size }}px;
    --hpf-p-size:{{ particle_size }}px;
    --hpf-p-speed:{{ particle_speed }}s;
    --hpf-overlay:{{ overlay_opacity | divided_by: 100.0 }};
  "
>
  {%- if bg_image != blank -%}
    <img class="hpf__bg-img" src="{{ bg_image | image_url: width: 1920 }}" alt="" loading="eager" aria-hidden="true">
    <div class="hpf__overlay"></div>
  {%- endif -%}

  <!-- Particles -->
  <div class="hpf__particles" aria-hidden="true">
    {%- for i in (1..20) -%}
      {%- liquid
        if i > particle_count
          break
        endif
        assign mod = i | modulo: 3
      -%}
      <span class="hpf__dot hpf__dot--c{{ mod }}" style="--hpf-dx:{{ i | times: 17 | modulo: 90 | plus: 5 }}%;--hpf-dy:{{ i | times: 23 | modulo: 80 | plus: 10 }}%;--hpf-dd:{{ i | times: 7 | modulo: 8 }}s;--hpf-ds:{{ i | modulo: 3 | times: 4 | plus: 8 }}px;"></span>
    {%- endfor -%}
  </div>

  <!-- Content -->
  <div class="hpf__content" style="text-align:{{ content_align }}">
    {%- if heading != blank -%}
      <h1 class="hpf__heading">{{ heading }}</h1>
    {%- endif -%}
    {%- if subheading != blank -%}
      <p class="hpf__sub">{{ subheading }}</p>
    {%- endif -%}
    {%- if btn_label != blank -%}
      <a href="{{ btn_link | default: '#' }}" class="hpf__btn">{{ btn_label }}</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "SIQ - Particle Hero",
  "tag": "section",
  "class": "section-hero-particle-float",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to the Future"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover products designed for tomorrow, available today."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 60,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Particles"
    },
    {
      "type": "range",
      "id": "particle_count",
      "label": "Particle count",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "particle_size",
      "label": "Max particle size",
      "min": 4,
      "max": 20,
      "step": 2,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "particle_speed",
      "label": "Float speed",
      "min": 6,
      "max": 30,
      "step": 2,
      "default": 14,
      "unit": "s"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background start",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "bg_color_2",
      "label": "Background end",
      "default": "#1e293b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#6366f1"
    },
    {
      "type": "color",
      "id": "particle_color_1",
      "label": "Particle color 1",
      "default": "#a855f7"
    },
    {
      "type": "color",
      "id": "particle_color_2",
      "label": "Particle color 2",
      "default": "#6366f1"
    },
    {
      "type": "color",
      "id": "particle_color_3",
      "label": "Particle color 3",
      "default": "#ec4899"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button background",
      "default": "#6366f1"
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Min height",
      "min": 300,
      "max": 800,
      "step": 20,
      "default": 540,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 40,
      "max": 140,
      "step": 4,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 28,
      "max": 72,
      "step": 2,
      "default": 48,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "SIQ - Particle Hero"
    }
  ]
}
{% endschema %}

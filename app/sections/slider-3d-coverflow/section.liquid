        },
        {
          "type": "card",
          "settings": {
            "heading": "Urban Explorer",
            "subtitle": "Street-ready essentials"
          }
        },
        {
          "type": "card",
          "settings": {
            "heading": "Golden Hour",
            "subtitle": "Sunset-inspired colorways",
            "btn_text": "Shop Now"
          }
        },
        {
          "type": "card",
          "settings": {
            "heading": "Midnight Studio",
            "subtitle": "Dark & refined aesthetics"
          }
        },
        {
          "type": "card",
          "settings": {
            "heading": "Coastal Breeze",
            "subtitle": "Light, airy, effortless",
            "btn_text": "Explore"
          }
        }
      ]
    }
  ]
}
{% endschema %}

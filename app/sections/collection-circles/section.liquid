{% comment %}
  Section Hub – Collection Circles
  Round collection images with labels underneath.
{% endcomment %}

{%- liquid
  assign section_title = section.settings.section_title
  assign section_sub   = section.settings.section_subtitle

  assign circle_size   = section.settings.circle_size
  assign circle_size_m = section.settings.circle_size_mobile
  assign circle_bg     = section.settings.circle_bg
  assign border_w      = section.settings.border_width
  assign border_c      = section.settings.border_color
  assign hover_ring    = section.settings.hover_ring_size
  assign hover_ring_c  = section.settings.hover_ring_color

  assign gap           = section.settings.gap
  assign gap_m         = section.settings.gap_mobile

  assign label_fs      = section.settings.label_font_size
  assign label_fsm     = section.settings.label_font_size_mobile
  assign label_fw      = section.settings.label_font_weight
  assign label_ls      = section.settings.label_letter_spacing
  assign label_tt      = section.settings.label_text_transform
  assign label_c       = section.settings.label_color
  assign label_gap     = section.settings.label_gap

  assign sublabel_fs   = section.settings.sublabel_font_size
  assign sublabel_c    = section.settings.sublabel_color

  assign title_fs      = section.settings.title_font_size
  assign title_fsm     = section.settings.title_font_size_mobile
  assign title_fw      = section.settings.title_font_weight
  assign title_ls      = section.settings.title_letter_spacing
  assign title_tt      = section.settings.title_text_transform
  assign title_c       = section.settings.title_color
  assign title_sub_fs  = section.settings.title_sub_font_size
  assign title_sub_c   = section.settings.title_sub_color
  assign header_gap    = section.settings.header_gap

  assign bg_color      = section.settings.bg_color
  assign pad_top       = section.settings.padding_top
  assign pad_bottom    = section.settings.padding_bottom
  assign pad_sides     = section.settings.padding_sides
  assign pad_sides_m   = section.settings.padding_sides_mobile
  assign margin_top    = section.settings.margin_top
  assign margin_bottom = section.settings.margin_bottom
  assign sec_width     = section.settings.section_width
  assign layout        = section.settings.layout
  assign lazy          = section.settings.lazy_load
  assign custom_css    = section.settings.custom_css
-%}

<style>
  #cc-{{ section.id }} {
    --cc-size: {{ circle_size }}px;
    --cc-size-m: {{ circle_size_m }}px;
    --cc-circle-bg: {{ circle_bg }};
    --cc-border-w: {{ border_w }}px;
    --cc-border-c: {{ border_c }};
    --cc-hover-ring: {{ hover_ring }}px;
    --cc-hover-ring-c: {{ hover_ring_c }};

    --cc-gap: {{ gap }}px;
    --cc-gap-m: {{ gap_m }}px;
    --cc-track-pad: {{ pad_sides }}rem;
    --cc-track-pad-m: {{ pad_sides_m }}rem;

    --cc-label-fs: {{ label_fs }}px;
    --cc-label-fsm: {{ label_fsm }}px;
    --cc-label-fw: {{ label_fw }};
    --cc-label-ls: {{ label_ls | divided_by: 100.0 }}em;
    --cc-label-tt: {{ label_tt }};
    --cc-label-c: {{ label_c }};
    --cc-label-gap: {{ label_gap }}px;

    --cc-sublabel-fs: {{ sublabel_fs }}px;
    --cc-sublabel-c: {{ sublabel_c }};

    --cc-title-fs: {{ title_fs }}px;
    --cc-title-fsm: {{ title_fsm }}px;
    --cc-title-fw: {{ title_fw }};
    --cc-title-ls: {{ title_ls | divided_by: 100.0 }}em;
    --cc-title-tt: {{ title_tt }};
    --cc-title-c: {{ title_c }};
    --cc-title-sub-fs: {{ title_sub_fs }}px;
    --cc-title-sub-c: {{ title_sub_c }};
    --cc-header-gap: {{ header_gap }}px;

    --cc-bg: {{ bg_color }};
    --cc-pt: {{ pad_top }}px;
    --cc-pb: {{ pad_bottom }}px;
    --cc-ps: {{ pad_sides }}rem;
    --cc-ps-m: {{ pad_sides_m }}rem;
    --cc-mt: {{ margin_top }}px;
    --cc-mb: {{ margin_bottom }}px;

    {% if sec_width == 'page' %}
      --cc-max-w: 1200px;
    {% elsif sec_width == 'custom' %}
      --cc-max-w: {{ section.settings.section_custom_width }}px;
    {% else %}
      --cc-max-w: 100%;
    {% endif %}
  }
  {% if custom_css != blank %}{{ custom_css }}{% endif %}
</style>

<section id="cc-{{ section.id }}" class="cc-wrap" {% if layout == 'wrap' %}data-cc-layout="wrap"{% endif %}>
  <div class="cc-inner">

    {%- if section_title != blank or section_sub != blank -%}
      <div class="cc-header">
        {%- if section_title != blank -%}
          <h2 class="cc-header__title">{{ section_title }}</h2>
        {%- endif -%}
        {%- if section_sub != blank -%}
          <p class="cc-header__sub">{{ section_sub }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="cc-track">
      {%- for block in section.blocks -%}
        {%- if block.type == 'circle' -%}
          {%- liquid
            assign col = block.settings.collection

            if block.settings.link != blank
              assign item_url = block.settings.link
            elsif col != blank
              assign item_url = col.url
            else
              assign item_url = '#'
            endif

            if block.settings.image != blank
              assign item_img = block.settings.image
            elsif col != blank and col.image != blank
              assign item_img = col.image
            elsif col != blank and col.products.first != blank and col.products.first.featured_image != blank
              assign item_img = col.products.first.featured_image
            else
              assign item_img = blank
            endif

            if block.settings.label != blank
              assign item_label = block.settings.label
            elsif col != blank
              assign item_label = col.title
            else
              assign item_label = ''
            endif
          -%}

          <a href="{{ item_url }}" class="cc-item" {{ block.shopify_attributes }}>
            <div class="cc-circle">
              {%- if item_img != blank -%}
                <img
                  src="{{ item_img | image_url: width: 600 }}"
                  alt="{{ item_img.alt | default: item_label | default: 'Collection' }}"
                  class="cc-circle__img"
                  style="{% if block.settings.image_position != blank %}object-position: {{ block.settings.image_position }};{% endif %}"
                  {% if lazy %}loading="lazy"{% else %}loading="eager"{% endif %}
                >
              {%- else -%}
                <div class="cc-circle__placeholder">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21 15 16 10 5 21"/>
                  </svg>
                </div>
              {%- endif -%}
            </div>

            {%- if item_label != blank -%}
              <span class="cc-label">{{ item_label }}</span>
            {%- endif -%}
            {%- if block.settings.sublabel != blank -%}
              <span class="cc-sublabel">{{ block.settings.sublabel }}</span>
            {%- endif -%}
          </a>

        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

<script>
(function(){
  var track = document.querySelector('#cc-{{ section.id }} .cc-track');
  if(!track || track.closest('[data-cc-layout="wrap"]')) return;

  var isDown = false, startX = 0, scrollLeft = 0, moved = false;

  track.addEventListener('mousedown', function(e){
    isDown = true; moved = false;
    track.style.scrollSnapType = 'none';
    track.style.cursor = 'grabbing';
    startX = e.pageX - track.offsetLeft;
    scrollLeft = track.scrollLeft;
  });

  track.addEventListener('mouseleave', end);
  track.addEventListener('mouseup', end);

  function end(){
    isDown = false;
    track.style.scrollSnapType = '';
    track.style.cursor = '';
  }

  track.addEventListener('mousemove', function(e){
    if(!isDown) return;
    e.preventDefault();
    moved = true;
    var x = e.pageX - track.offsetLeft;
    track.scrollLeft = scrollLeft - (x - startX) * 1.5;
  });

  track.addEventListener('click', function(e){
    if(moved){ e.preventDefault(); moved = false; }
  }, true);
})();
</script>


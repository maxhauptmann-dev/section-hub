{% comment %}
  Section Hub – Video Split Player v1.0
  Split-layout video section. Video on one side, editorial content
  on the other. Animated play button with progress ring.
  Multiple blocks = multiple video+content pairs with dot navigation.
  Prefix: shvp-
{% endcomment %}

{%- liquid
  assign heading_font  = section.settings.heading_font
  assign body_font     = section.settings.body_font
  assign bg_color      = section.settings.bg_color
  assign accent        = section.settings.accent_color
  assign accent_2      = section.settings.accent_color_2
  assign heading_color = section.settings.heading_color
  assign text_color    = section.settings.text_color
  assign layout        = section.settings.layout
  assign stage_radius  = section.settings.stage_radius
  assign aspect        = section.settings.aspect_ratio
  assign gap           = section.settings.split_gap
  assign show_glow     = section.settings.show_glow
  assign show_corners  = section.settings.show_corners
  assign show_badge    = section.settings.show_badge
  assign show_dots     = section.settings.show_dots
  assign autoplay_vid  = section.settings.autoplay_video
  assign btn_radius    = section.settings.btn_radius
  assign section_py    = section.settings.section_padding_y
  assign section_px    = section.settings.section_padding_x
-%}

<style>
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}

  .shvp-wrap--{{ section.id }} {
    --shvp-bg: {{ bg_color }};
    --shvp-accent: {{ accent }};
    --shvp-accent-2: {{ accent_2 }};
    --shvp-heading-ff: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --shvp-heading-fw: {{ heading_font.weight }};
    --shvp-heading-fs: {{ heading_font.style }};
    --shvp-body-ff: {{ body_font.family }}, {{ body_font.fallback_families }};
    --shvp-body-fw: {{ body_font.weight }};
    --shvp-body-fs: {{ body_font.style }};
    --shvp-heading-color: {{ heading_color }};
    --shvp-text-color: {{ text_color }};
    --shvp-radius: {{ stage_radius }}px;
    --shvp-aspect: {{ aspect }};
    --shvp-gap: {{ gap }}px;
    --shvp-btn-radius: {{ btn_radius }}px;
    --shvp-py: {{ section_py }}px;
    --shvp-px: {{ section_px }}px;
  }
</style>

<section class="shvp-wrap shvp-wrap--{{ section.id }}" data-section-id="{{ section.id }}">

  {%- if show_glow -%}
    <div class="shvp-glow shvp-glow--1"></div>
    <div class="shvp-glow shvp-glow--2"></div>
  {%- endif -%}

  <div class="shvp-container">

    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subtitle != blank -%}
      <div class="shvp-header" data-shvp-reveal>
        {%- if section.settings.eyebrow != blank -%}
          <div class="shvp-header__eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="shvp-header__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="shvp-header__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- assign is_odd = forloop.index0 | modulo: 2 -%}
      <div
        class="shvp-split{% if layout == 'right' %} shvp-split--reversed{% elsif layout == 'stacked' %} shvp-split--stacked{% elsif layout == 'alternate' and is_odd == 1 %} shvp-split--reversed{% endif %}{% if forloop.first %} shvp-split--active{% else %} shvp-split--hidden{% endif %}"
        data-shvp-reveal
        data-shvp-pair="{{ forloop.index0 }}"
        {% unless forloop.first %}style="display:none;"{% endunless %}
        {{ block.shopify_attributes }}
      >
        {%- comment -%} Video side {%- endcomment -%}
        {%- liquid
          assign has_shopify_video = false
          assign has_embed_video = false
          assign has_mp4 = false
          if block.settings.shopify_video != blank
            assign has_shopify_video = true
          endif
          if block.settings.embed_url != blank
            assign has_embed_video = true
          endif
          if block.settings.video_url != blank
            assign has_mp4 = true
          endif
          assign has_any_video = false
          if has_shopify_video or has_embed_video or has_mp4
            assign has_any_video = true
          endif
        -%}
        <div class="shvp-video">
          {%- if show_corners -%}
            <div class="shvp-corner shvp-corner--tl"></div>
            <div class="shvp-corner shvp-corner--br"></div>
          {%- endif -%}

          {%- if has_shopify_video -%}
            {%- comment -%} Shopify hosted video {%- endcomment -%}
            {%- assign sv = block.settings.shopify_video -%}
            {%- assign sv_poster = '' -%}
            {%- if block.settings.poster != blank -%}
              {%- assign sv_poster = block.settings.poster | image_url: width: 1200 -%}
            {%- elsif sv.preview_image != blank -%}
              {%- assign sv_poster = sv.preview_image | image_url: width: 1200 -%}
            {%- endif -%}
            <div class="shvp-video__shopify-wrap" data-shvp-shopify-wrap>
              {%- if sv_poster != '' -%}
                <img class="shvp-video__poster" src="{{ sv_poster }}" alt="{{ block.settings.content_title | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
              {%- endif -%}
              <div class="shvp-video__shopify-player" data-shvp-shopify-player style="{% if sv_poster != '' %}display:none;{% endif %}">
                {{ sv | video_tag: class: 'shvp-video__el', playsinline: true, muted: true, loop: true, controls: false, preload: 'metadata', data-shvp-video: '' }}
              </div>
            </div>

          {%- elsif has_embed_video -%}
            {%- comment -%} YouTube / Vimeo {%- endcomment -%}
            {%- assign ev = block.settings.embed_url -%}
            {%- if ev.type == 'youtube' -%}
              {%- assign yt_thumb = 'https://img.youtube.com/vi/' | append: ev.id | append: '/maxresdefault.jpg' -%}
              {%- if block.settings.poster != blank -%}
                {%- assign yt_thumb = block.settings.poster | image_url: width: 1200 -%}
              {%- endif -%}
              <div class="shvp-video__embed" data-shvp-embed data-video-type="youtube" data-video-id="{{ ev.id }}">
                <img class="shvp-video__poster" src="{{ yt_thumb }}" alt="{{ block.settings.content_title | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
                <div class="shvp-video__iframe-wrap" data-shvp-iframe-wrap style="display:none;"></div>
              </div>
            {%- elsif ev.type == 'vimeo' -%}
              {%- assign vm_poster = '' -%}
              {%- if block.settings.poster != blank -%}
                {%- assign vm_poster = block.settings.poster | image_url: width: 1200 -%}
              {%- endif -%}
              <div class="shvp-video__embed" data-shvp-embed data-video-type="vimeo" data-video-id="{{ ev.id }}">
                {%- if vm_poster != '' -%}
                  <img class="shvp-video__poster" src="{{ vm_poster }}" alt="{{ block.settings.content_title | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
                {%- endif -%}
                <div class="shvp-video__iframe-wrap" data-shvp-iframe-wrap style="display:none;"></div>
              </div>
            {%- endif -%}

          {%- elsif has_mp4 -%}
            {%- comment -%} Direct MP4 URL {%- endcomment -%}
            <video
              data-shvp-video
              playsinline
              muted
              loop
              preload="metadata"
              {% if autoplay_vid %}data-shvp-autoplay{% endif %}
              poster="{% if block.settings.poster != blank %}{{ block.settings.poster | image_url: width: 1200 }}{% endif %}"
            >
              <source src="{{ block.settings.video_url }}" type="video/mp4">
            </video>

          {%- elsif block.settings.poster != blank -%}
            <img
              src="{{ block.settings.poster | image_url: width: 1200 }}"
              alt="{{ block.settings.content_title | escape }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              width="{{ block.settings.poster.width }}"
              height="{{ block.settings.poster.height }}"
            >
          {%- else -%}
            {{ 'lifestyle-' | append: forloop.index | placeholder_svg_tag }}
          {%- endif -%}

          <div class="shvp-video__overlay"></div>

          {%- if has_any_video -%}
            <button class="shvp-play" data-shvp-play="{{ forloop.index0 }}" aria-label="Play video">
              <svg class="shvp-play__ring" viewBox="0 0 84 84">
                <circle class="shvp-play__ring-bg" cx="42" cy="42" r="42"></circle>
                <circle class="shvp-play__ring-progress" cx="42" cy="42" r="42" data-shvp-ring></circle>
              </svg>
              <svg data-shvp-icon-play viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              <svg data-shvp-icon-pause viewBox="0 0 24 24" fill="currentColor" style="display:none;"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
            </button>
          {%- endif -%}

          {%- if show_badge and block.settings.badge_text != blank -%}
            <div class="shvp-video__badge">
              <span class="shvp-video__badge-dot"></span>
              {{ block.settings.badge_text }}
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} Content side {%- endcomment -%}
        <div class="shvp-content">
          {%- if block.settings.content_eyebrow != blank -%}
            <div class="shvp-content__eyebrow">{{ block.settings.content_eyebrow }}</div>
          {%- endif -%}

          {%- if block.settings.content_title != blank -%}
            <h3 class="shvp-content__title">{{ block.settings.content_title }}</h3>
          {%- endif -%}

          {%- if block.settings.content_desc != blank -%}
            <p class="shvp-content__desc">{{ block.settings.content_desc }}</p>
          {%- endif -%}

          {%- comment -%} Feature bullets {%- endcomment -%}
          {%- if block.settings.feature_1 != blank or block.settings.feature_2 != blank or block.settings.feature_3 != blank -%}
            <div class="shvp-features">
              {%- for i in (1..3) -%}
                {%- assign feat_key = 'feature_' | append: i -%}
                {%- assign feat = block.settings[feat_key] -%}
                {%- if feat != blank -%}
                  <div class="shvp-feature">
                    <div class="shvp-feature__icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    </div>
                    <span class="shvp-feature__text">{{ feat }}</span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- comment -%} Actions {%- endcomment -%}
          {%- if block.settings.btn_primary_text != blank or block.settings.btn_secondary_text != blank -%}
            <div class="shvp-actions">
              {%- if block.settings.btn_primary_text != blank -%}
                <a href="{{ block.settings.btn_primary_link | default: '#' }}" class="shvp-btn shvp-btn--primary">
                  {{ block.settings.btn_primary_text }}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </a>
              {%- endif -%}
              {%- if block.settings.btn_secondary_text != blank -%}
                <a href="{{ block.settings.btn_secondary_link | default: '#' }}" class="shvp-btn shvp-btn--{{ section.settings.btn_secondary_style }}">
                  {{ block.settings.btn_secondary_text }}
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}

    {%- comment -%} Navigation dots {%- endcomment -%}
    {%- if show_dots and section.blocks.size > 1 -%}
      <div class="shvp-dots" data-shvp-reveal>
        {%- for block in section.blocks -%}
          <button class="shvp-dot{% if forloop.first %} shvp-dot--active{% endif %}" data-shvp-dot="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

<script>
  (function() {
    var section = document.querySelector('.shvp-wrap--{{ section.id }}');
    if (!section) return;

    var pairs = section.querySelectorAll('[data-shvp-pair]');
    var dots = section.querySelectorAll('[data-shvp-dot]');
    var reveals = section.querySelectorAll('[data-shvp-reveal]');
    var currentIdx = 0;

    /* Scroll reveal */
    var obs = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (!e.isIntersecting) return;
        e.target.classList.add('shvp-visible');
        obs.unobserve(e.target);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -30px 0px' });

    reveals.forEach(function(el) { obs.observe(el); });

    /* Autoplay first video if enabled */
    var firstAutoplay = section.querySelector('[data-shvp-autoplay]');
    if (firstAutoplay) {
      var autoplayObs = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
          if (e.isIntersecting) {
            e.target.play().catch(function() {});
            var pair = e.target.closest('[data-shvp-pair]');
            if (pair) {
              var pp = pair.querySelector('[data-shvp-icon-play]');
              var pa = pair.querySelector('[data-shvp-icon-pause]');
              if (pp) pp.style.display = 'none';
              if (pa) pa.style.display = '';
            }
          } else {
            e.target.pause();
          }
        });
      }, { threshold: 0.3 });
      autoplayObs.observe(firstAutoplay);
    }

    /* Switch between pairs */
    function switchPair(idx) {
      if (idx === currentIdx && pairs.length > 1) return;

      pairs.forEach(function(p) {
        p.style.display = 'none';
        p.classList.remove('shvp-split--active');
        p.classList.add('shvp-split--hidden');
        var v = p.querySelector('[data-shvp-video]') || p.querySelector('[data-shvp-shopify-wrap] video');
        if (v) { v.pause(); }
        var ip = p.querySelector('[data-shvp-icon-play]');
        var ipa = p.querySelector('[data-shvp-icon-pause]');
        if (ip) ip.style.display = '';
        if (ipa) ipa.style.display = 'none';
      });

      dots.forEach(function(d) { d.classList.remove('shvp-dot--active'); });

      var pair = pairs[idx];
      pair.style.display = '';
      pair.classList.remove('shvp-split--hidden');
      pair.classList.add('shvp-split--active');

      /* Re-observe for reveal if needed */
      if (!pair.classList.contains('shvp-visible')) {
        obs.observe(pair);
      }

      if (dots[idx]) dots[idx].classList.add('shvp-dot--active');
      currentIdx = idx;

      /* Autoplay if enabled */
      var autoV = pair.querySelector('[data-shvp-autoplay]');
      if (autoV) {
        autoV.play().catch(function() {});
        var pp2 = pair.querySelector('[data-shvp-icon-play]');
        var pa2 = pair.querySelector('[data-shvp-icon-pause]');
        if (pp2) pp2.style.display = 'none';
        if (pa2) pa2.style.display = '';
      }
    }

    /* Dot clicks */
    dots.forEach(function(dot) {
      dot.addEventListener('click', function() {
        switchPair(parseInt(dot.dataset.shvpDot));
      });
    });

    /* Play/pause — handles mp4, Shopify hosted, and YouTube/Vimeo */
    var playBtns = section.querySelectorAll('[data-shvp-play]');
    playBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var idx = parseInt(btn.dataset.shvpPlay);
        var pair = pairs[idx];
        var iconPlay = btn.querySelector('[data-shvp-icon-play]');
        var iconPause = btn.querySelector('[data-shvp-icon-pause]');

        /* MP4 video */
        var video = pair.querySelector('[data-shvp-video]');
        if (video) {
          if (video.paused) {
            video.play();
            if (iconPlay) iconPlay.style.display = 'none';
            if (iconPause) iconPause.style.display = '';
          } else {
            video.pause();
            if (iconPlay) iconPlay.style.display = '';
            if (iconPause) iconPause.style.display = 'none';
          }
          return;
        }

        /* Shopify hosted video */
        var shopifyWrap = pair.querySelector('[data-shvp-shopify-wrap]');
        if (shopifyWrap) {
          var poster = shopifyWrap.querySelector('.shvp-video__poster');
          var playerWrap = shopifyWrap.querySelector('[data-shvp-shopify-player]');
          var sv = shopifyWrap.querySelector('video');
          if (sv) {
            if (poster && poster.style.display !== 'none') {
              poster.style.display = 'none';
              if (playerWrap) playerWrap.style.display = '';
              sv.play();
              if (iconPlay) iconPlay.style.display = 'none';
              if (iconPause) iconPause.style.display = '';
            } else if (sv.paused) {
              sv.play();
              if (iconPlay) iconPlay.style.display = 'none';
              if (iconPause) iconPause.style.display = '';
            } else {
              sv.pause();
              if (iconPlay) iconPlay.style.display = '';
              if (iconPause) iconPause.style.display = 'none';
            }
          }
          return;
        }

        /* YouTube / Vimeo embed */
        var embedWrap = pair.querySelector('[data-shvp-embed]');
        if (embedWrap) {
          var iframeWrap = embedWrap.querySelector('[data-shvp-iframe-wrap]');
          var posterImg = embedWrap.querySelector('.shvp-video__poster');
          if (iframeWrap && iframeWrap.style.display === 'none') {
            var vType = embedWrap.dataset.videoType;
            var vId = embedWrap.dataset.videoId;
            var iframeSrc = '';
            if (vType === 'youtube') {
              iframeSrc = 'https://www.youtube.com/embed/' + vId + '?autoplay=1&mute=1&loop=1&playlist=' + vId + '&controls=0&modestbranding=1&rel=0';
            } else if (vType === 'vimeo') {
              iframeSrc = 'https://player.vimeo.com/video/' + vId + '?autoplay=1&muted=1&loop=1&background=1';
            }
            if (iframeSrc) {
              iframeWrap.innerHTML = '<iframe src="' + iframeSrc + '" style="position:absolute;inset:0;width:100%;height:100%;border:0;" allow="autoplay;fullscreen" allowfullscreen></iframe>';
              iframeWrap.style.display = '';
              iframeWrap.style.position = 'absolute';
              iframeWrap.style.inset = '0';
              iframeWrap.style.width = '100%';
              iframeWrap.style.height = '100%';
              iframeWrap.style.zIndex = '1';
              if (posterImg) posterImg.style.display = 'none';
              if (iconPlay) iconPlay.style.display = 'none';
              if (iconPause) iconPause.style.display = '';
            }
          }
          return;
        }
      });
    });

    /* Progress ring — works for mp4 and Shopify video */
    function updateRings() {
      pairs.forEach(function(pair) {
        var video = pair.querySelector('[data-shvp-video]') || pair.querySelector('[data-shvp-shopify-wrap] video');
        var ring = pair.querySelector('[data-shvp-ring]');
        if (!video || !ring || video.paused || !video.duration) return;

        var progress = video.currentTime / video.duration;
        var circumference = 2 * Math.PI * 42;
        ring.style.strokeDashoffset = circumference * (1 - progress);
      });
      requestAnimationFrame(updateRings);
    }
    updateRings();

  })();
</script>

{% schema %}
{
  "name": "SS - Video Split",
  "tag": "section",
  "class": "shvp-section",
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Featured Video"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Stories Worth Watching"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Immerse yourself in our brand stories, behind-the-scenes content, and product spotlights."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout style",
      "options": [
        { "value": "left", "label": "Video Left" },
        { "value": "right", "label": "Video Right" },
        { "value": "alternate", "label": "Alternate" },
        { "value": "stacked", "label": "Stacked (centered)" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#0f0f0f"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Video aspect ratio",
      "options": [
        { "value": "16/9", "label": "Widescreen (16:9)" },
        { "value": "4/3", "label": "Classic (4:3)" },
        { "value": "1/1", "label": "Square (1:1)" },
        { "value": "9/16", "label": "Portrait (9:16)" }
      ],
      "default": "16/9"
    },
    {
      "type": "range",
      "id": "stage_radius",
      "label": "Video border radius",
      "min": 0,
      "max": 32,
      "step": 4,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "split_gap",
      "label": "Gap between sides",
      "min": 24,
      "max": 80,
      "step": 8,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_y",
      "label": "Vertical padding",
      "min": 40,
      "max": 160,
      "step": 10,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_x",
      "label": "Horizontal padding",
      "min": 16,
      "max": 80,
      "step": 8,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#6366f1"
    },
    {
      "type": "color",
      "id": "accent_color_2",
      "label": "Accent color 2 (glow)",
      "default": "#ec4899"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#999999"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "space_grotesk_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "inter_n4"
    },
    {
      "type": "header",
      "content": "Video playback"
    },
    {
      "type": "checkbox",
      "id": "autoplay_video",
      "label": "Autoplay when visible",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show video badge",
      "default": true
    },
    {
      "type": "header",
      "content": "Decorations"
    },
    {
      "type": "checkbox",
      "id": "show_glow",
      "label": "Show ambient glow",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_corners",

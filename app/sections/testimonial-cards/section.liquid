{% comment %}
  Section Hub – Testimonial Cards
  Trustpilot-style testimonial cards with overall rating, star badges,
  carousel navigation and fully customisable colours / sizes.
{% endcomment %}

{{ 'section-testimonial-cards.css' | asset_url | stylesheet_tag }}

<section class="tc-cards" id="tc-cards-{{ section.id }}" style="
  --tc-bg: {{ section.settings.background_color }};
  --tc-text: {{ section.settings.text_color }};
  --tc-accent: {{ section.settings.accent_color }};
  --tc-card-bg: {{ section.settings.card_background }};
  --tc-card-radius: {{ section.settings.card_radius }}px;
  --tc-star-size: {{ section.settings.star_size }}px;
  --tc-heading-size: {{ section.settings.heading_size }}px;
  --tc-quote-size: {{ section.settings.quote_font_size }}px;
  --tc-cards-per-view: {{ section.settings.cards_per_row }};
  --tc-card-padding: {{ section.settings.card_padding }}px;
  --tc-section-padding-top: {{ section.settings.padding_top }}px;
  --tc-section-padding-bottom: {{ section.settings.padding_bottom }}px;
">
  <div class="tc-cards__container">
    {%- comment -%} Header with overall rating {%- endcomment -%}
    {% if section.settings.heading != blank %}
      <div class="tc-cards__header">
        <h2 class="tc-cards__heading">{{ section.settings.heading }}</h2>

        {% if section.settings.show_overall_rating %}
          <div class="tc-cards__overall">
            <span class="tc-cards__overall-label">{{ section.settings.overall_label }}</span>
            <span class="tc-cards__overall-score">{{ section.settings.overall_score }}</span>
            <div class="tc-cards__overall-stars">
              {% for i in (1..5) %}
                {% if i <= 4 %}
                  <svg class="tc-star" width="var(--tc-star-size)" height="var(--tc-star-size)" viewBox="0 0 24 24" fill="var(--tc-accent)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
                {% else %}
                  <svg class="tc-star" width="var(--tc-star-size)" height="var(--tc-star-size)" viewBox="0 0 24 24" fill="none" stroke="var(--tc-accent)" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
                {% endif %}
              {% endfor %}
            </div>
            {% if section.settings.review_count != blank %}
              <span class="tc-cards__review-count">{{ section.settings.review_count }}</span>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {%- comment -%} Cards track {%- endcomment -%}
    <div class="tc-cards__viewport">
      <div class="tc-cards__track" id="tc-track-{{ section.id }}">
        {% for block in section.blocks %}
          <div class="tc-cards__card" {{ block.shopify_attributes }}>
            {%- comment -%} Star badge {%- endcomment -%}
            <div class="tc-cards__stars">
              {% for i in (1..5) %}
                {% if i <= block.settings.rating %}
                  <svg class="tc-star" viewBox="0 0 24 24" fill="var(--tc-accent)"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
                {% else %}
                  <svg class="tc-star" viewBox="0 0 24 24" fill="none" stroke="var(--tc-accent)" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
                {% endif %}
              {% endfor %}
            </div>

            {%- comment -%} Optional date tag {%- endcomment -%}
            {% if block.settings.date != blank %}
              <span class="tc-cards__date">{{ block.settings.date }}</span>
            {% endif %}

            {%- comment -%} Title {%- endcomment -%}
            {% if block.settings.title != blank %}
              <h3 class="tc-cards__title">{{ block.settings.title }}</h3>
            {% endif %}

            {%- comment -%} Quote {%- endcomment -%}
            <p class="tc-cards__quote">{{ block.settings.quote }}</p>

            {%- comment -%} Author {%- endcomment -%}
            <div class="tc-cards__author">
              <span class="tc-cards__name">{{ block.settings.name }}</span>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    {%- comment -%} Navigation {%- endcomment -%}
    <div class="tc-cards__nav">
      <button class="tc-cards__btn tc-cards__btn--prev" aria-label="Previous">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="tc-cards__dots" id="tc-dots-{{ section.id }}"></div>
      <button class="tc-cards__btn tc-cards__btn--next" aria-label="Next">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </div>
</section>

<script>
(function(){
  var wrap = document.getElementById('tc-cards-{{ section.id }}');
  var track = document.getElementById('tc-track-{{ section.id }}');
  var dotsC = document.getElementById('tc-dots-{{ section.id }}');
  var prev  = wrap.querySelector('.tc-cards__btn--prev');
  var next  = wrap.querySelector('.tc-cards__btn--next');
  var cards = track.children;
  var perView = parseInt(getComputedStyle(wrap).getPropertyValue('--tc-cards-per-view')) || 3;
  var gap = 24;
  var current = 0;
  var maxIndex = Math.max(0, cards.length - perView);

  function buildDots(){
    dotsC.innerHTML = '';
    for(var i = 0; i <= maxIndex; i++){
      var d = document.createElement('button');
      d.className = 'tc-cards__dot' + (i===0?' active':'');
      d.dataset.index = i;
      d.setAttribute('aria-label','Page '+(i+1));
      d.addEventListener('click', function(){ goTo(parseInt(this.dataset.index)); });
      dotsC.appendChild(d);
    }
  }

  function goTo(i){
    current = Math.max(0, Math.min(i, maxIndex));
    var cardW = cards[0].offsetWidth + gap;
    track.style.transform = 'translateX(-' + (current * cardW) + 'px)';
    var dots = dotsC.querySelectorAll('.tc-cards__dot');
    dots.forEach(function(d,idx){ d.classList.toggle('active', idx===current); });
  }

  prev.addEventListener('click', function(){ goTo(current - 1); });
  next.addEventListener('click', function(){ goTo(current + 1); });
  buildDots();

  {% if section.settings.autoplay %}
  var iv = setInterval(function(){ goTo(current >= maxIndex ? 0 : current + 1); }, {{ section.settings.autoplay_speed }}000);
  wrap.addEventListener('mouseenter', function(){ clearInterval(iv); });
  wrap.addEventListener('mouseleave', function(){ iv = setInterval(function(){ goTo(current >= maxIndex ? 0 : current + 1); }, {{ section.settings.autoplay_speed }}000); });
  {% endif %}

  window.addEventListener('resize', function(){
    perView = parseInt(getComputedStyle(wrap).getPropertyValue('--tc-cards-per-view')) || 3;
    maxIndex = Math.max(0, cards.length - perView);
    buildDots();
    goTo(Math.min(current, maxIndex));
  });
})();
</script>


{{ 'section-image-prism-rotate.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id
  assign bg = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign accent = section.settings.accent_color
  assign border_color = section.settings.border_color
  assign pad_y = section.settings.padding_y
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom
  assign speed = section.settings.speed
  assign prism_w = section.settings.prism_width
  assign prism_h = section.settings.prism_height
  assign radius = section.settings.border_radius
  assign pause = section.settings.pause_hover
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign heading_align = section.settings.heading_align
  assign show_glow = section.settings.show_glow
  assign show_reflection = section.settings.show_reflection
  assign total = section.blocks.size
  assign face_angle = 360.0 | divided_by: total
  assign tz = prism_w | divided_by: 2
-%}

<div
  id="ipr-{{ sid }}"
  class="ipr"
  style="
    --ipr-bg:{{ bg }};
    --ipr-text:{{ text_color }};
    --ipr-accent:{{ accent }};
    --ipr-border:{{ border_color }};
    --ipr-pad-y:{{ pad_y }}px;
    --ipr-mt:{{ mt }}px;
    --ipr-mb:{{ mb }}px;
    --ipr-speed:{{ speed }}s;
    --ipr-w:{{ prism_w }}px;
    --ipr-h:{{ prism_h }}px;
    --ipr-radius:{{ radius }}px;
    --ipr-tz:{{ tz }}px;
  "
>
  <div class="ipr__inner">
    {%- if heading != blank or subheading != blank -%}
      <div class="ipr__header" style="text-align:{{ heading_align }}">
        {%- if heading != blank -%}
          <h2 class="ipr__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="ipr__sub">{{ subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="ipr__stage">
      {%- if show_glow -%}
        <div class="ipr__glow" aria-hidden="true"></div>
      {%- endif -%}

      <div class="ipr__scene">
        <div class="ipr__prism{% if pause %} ipr__prism--pause{% endif %}">
          {%- for block in section.blocks -%}
            {%- liquid
              assign angle = forloop.index0 | times: face_angle
              assign img = block.settings.image
              assign caption = block.settings.caption
            -%}
            <div
              class="ipr__face"
              style="transform: rotateY({{ angle }}deg) translateZ(var(--ipr-tz));"
              {{ block.shopify_attributes }}
            >
              {%- if img != blank -%}
                <img src="{{ img | image_url: width: 800 }}" alt="{{ caption | default: 'Gallery image' | escape }}" class="ipr__img" loading="lazy">
              {%- else -%}
                <div class="ipr__placeholder">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                </div>
              {%- endif -%}
              {%- if caption != blank -%}
                <div class="ipr__caption">{{ caption }}</div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- if show_reflection -%}
        <div class="ipr__reflection" aria-hidden="true">
          <div class="ipr__prism ipr__prism--reflect{% if pause %} ipr__prism--pause{% endif %}">
            {%- for block in section.blocks -%}
              {%- liquid
                assign angle = forloop.index0 | times: face_angle
                assign img = block.settings.image
              -%}
              <div class="ipr__face" style="transform: rotateY({{ angle }}deg) translateZ(var(--ipr-tz));">
                {%- if img != blank -%}
                  <img src="{{ img | image_url: width: 400 }}" alt="" class="ipr__img" loading="lazy" aria-hidden="true">
                {%- else -%}
                  <div class="ipr__placeholder"></div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SIQ - Image Prism",
  "tag": "section",
  "class": "section-image-prism-rotate",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Gallery"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A revolving showcase of our finest moments."
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Prism"
    },
    {
      "type": "range",
      "id": "prism_width",
      "label": "Prism width",
      "min": 200,
      "max": 500,
      "step": 20,
      "default": 340,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "prism_height",
      "label": "Prism height",
      "min": 200,
      "max": 500,
      "step": 20,
      "default": 380,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Rotation speed",
      "min": 8,
      "max": 40,
      "step": 2,
      "default": 18,
      "unit": "s"
    },
    {
      "type": "checkbox",
      "id": "pause_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_glow",
      "label": "Show background glow",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_reflection",
      "label": "Show floor reflection",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / glow",
      "default": "#6366f1"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Face border",
      "default": "#1e293b"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Face radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 40,
      "max": 140,
      "step": 4,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "face",
      "name": "Image Face",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SIQ - Image Prism",
      "blocks": [
        { "type": "face", "settings": { "caption": "Collection One" } },
        { "type": "face", "settings": { "caption": "Best Sellers" } },
        { "type": "face", "settings": { "caption": "New Arrivals" } },
        { "type": "face", "settings": { "caption": "Limited Edition" } }
      ]
    }
  ]
}
{% endschema %}

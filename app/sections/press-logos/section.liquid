{% comment %}
  Section Hub – Press Logos
  Minimal "As seen in" / "Bekannt aus" logo bar.
{% endcomment %}

{%- liquid
  assign heading      = section.settings.heading
  assign heading_fs   = section.settings.heading_font_size
  assign heading_fsm  = section.settings.heading_font_size_mobile
  assign heading_fw   = section.settings.heading_font_weight
  assign heading_ls   = section.settings.heading_letter_spacing
  assign heading_tt   = section.settings.heading_text_transform
  assign heading_c    = section.settings.heading_color
  assign heading_align = section.settings.heading_alignment
  assign heading_gap  = section.settings.heading_gap

  assign logo_h       = section.settings.logo_height
  assign logo_hm      = section.settings.logo_height_mobile
  assign logo_max_w   = section.settings.logo_max_width
  assign logo_opacity = section.settings.logo_opacity
  assign grayscale    = section.settings.grayscale
  assign gap          = section.settings.gap
  assign gap_m        = section.settings.gap_mobile
  assign layout       = section.settings.layout

  assign show_divider = section.settings.show_divider
  assign divider_c    = section.settings.divider_color

  assign bg_color     = section.settings.bg_color
  assign pad_top      = section.settings.padding_top
  assign pad_bottom   = section.settings.padding_bottom
  assign pad_top_m    = section.settings.padding_top_mobile
  assign pad_bottom_m = section.settings.padding_bottom_mobile
  assign pad_sides    = section.settings.padding_sides
  assign pad_sides_m  = section.settings.padding_sides_mobile
  assign margin_top   = section.settings.margin_top
  assign margin_bottom = section.settings.margin_bottom
  assign sec_width    = section.settings.section_width
  assign lazy         = section.settings.lazy_load
  assign custom_css   = section.settings.custom_css
-%}

<style>
  #pl-{{ section.id }} {
    --pl-heading-fs: {{ heading_fs }}px;
    --pl-heading-fsm: {{ heading_fsm }}px;
    --pl-heading-fw: {{ heading_fw }};
    --pl-heading-ls: {{ heading_ls | divided_by: 100.0 }}em;
    --pl-heading-tt: {{ heading_tt }};
    --pl-heading-c: {{ heading_c }};
    --pl-heading-align: {{ heading_align }};
    --pl-heading-gap: {{ heading_gap }}px;

    --pl-logo-h: {{ logo_h }}px;
    --pl-logo-hm: {{ logo_hm }}px;
    --pl-logo-max-w: {{ logo_max_w }}px;
    --pl-logo-opacity: {{ logo_opacity | divided_by: 100.0 }};

    --pl-gap: {{ gap }}px;
    --pl-gap-m: {{ gap_m }}px;

    --pl-divider-c: {{ divider_c }};

    --pl-bg: {{ bg_color }};
    --pl-pt: {{ pad_top }}px;
    --pl-pb: {{ pad_bottom }}px;
    --pl-pt-m: {{ pad_top_m }}px;
    --pl-pb-m: {{ pad_bottom_m }}px;
    --pl-ps: {{ pad_sides }}rem;
    --pl-ps-m: {{ pad_sides_m }}rem;
    --pl-mt: {{ margin_top }}px;
    --pl-mb: {{ margin_bottom }}px;

    {% if sec_width == 'page' %}
      --pl-max-w: 1200px;
    {% elsif sec_width == 'custom' %}
      --pl-max-w: {{ section.settings.section_custom_width }}px;
    {% else %}
      --pl-max-w: 100%;
    {% endif %}
  }
  {% if custom_css != blank %}{{ custom_css }}{% endif %}
</style>

<section
  id="pl-{{ section.id }}"
  class="pl-wrap"
  {% if grayscale %}data-pl-gray{% endif %}
  {% if layout == 'scroll' %}data-pl-scroll{% endif %}
  {% if show_divider %}data-pl-divider{% endif %}
>
  <div class="pl-inner">

    {%- if heading != blank -%}
      <p class="pl-heading">{{ heading }}</p>
    {%- endif -%}

    <div class="pl-row">
      {%- for block in section.blocks -%}
        {%- if block.type == 'logo' -%}
          <div class="pl-item" {{ block.shopify_attributes }} {% if block.settings.scale != 100 %}style="--pl-logo-h: {{ logo_h | times: block.settings.scale | divided_by: 100 }}px; --pl-logo-hm: {{ logo_hm | times: block.settings.scale | divided_by: 100 }}px;"{% endif %}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" target="_blank" rel="noopener">{%- endif -%}

            {%- if block.settings.logo != blank -%}
              <img
                src="{{ block.settings.logo | image_url: width: 400 }}"
                alt="{{ block.settings.logo.alt | default: block.settings.name | default: 'Logo' }}"
                class="pl-logo"
                {% if lazy %}loading="lazy"{% else %}loading="eager"{% endif %}
              >
            {%- else -%}
              <span class="pl-placeholder">{{ block.settings.name | default: 'Logo' }}</span>
            {%- endif -%}

            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Press Logos",
  "tag": "div",
  "class": "pl-root",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bekannt aus:"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Font size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Font size – mobile",
      "min": 11,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Font weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "600", "label": "Semi-bold" }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Letter spacing",
      "min": -2,
      "max": 15,
      "step": 1,
      "unit": "em",
      "default": 1
    },
    {
      "type": "select",
      "id": "heading_text_transform",
      "label": "Text transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "lowercase", "label": "Lowercase" }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#666666"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "Space below heading",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Logos"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Logo height – mobile",
      "min": 14,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "Logo max width",
      "min": 60,
      "max": 250,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "range",
      "id": "logo_opacity",
      "label": "Logo opacity",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Grayscale logos",
      "info": "Show logos in gray, color on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between logos",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Gap – mobile",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout mode",
      "options": [
        { "value": "wrap", "label": "Wrap to rows" },
        { "value": "scroll", "label": "Horizontal scroll" }
      ],
      "default": "wrap"
    },
    {
      "type": "header",
      "content": "Divider"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider line above",
      "default": false
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#e5e5e5"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top – mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom – mobile",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_sides",
      "label": "Padding sides",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "rem",
      "default": 2
    },
    {
      "type": "range",
      "id": "padding_sides_mobile",
      "label": "Padding sides – mobile",
      "min": 0,
      "max": 3,
      "step": 1,
      "unit": "rem",
      "default": 1
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Content width",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "page", "label": "Page width (1200px)" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "section_custom_width",
      "label": "Custom width",
      "min": 800,
      "max": 1800,
      "step": 10,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "header",
      "content": "Advanced"
    },
    {
      "type": "checkbox",
      "id": "lazy_load",
      "label": "Lazy-load images",
      "default": true
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Brand name",
          "info": "Shown as alt-text and as placeholder if no image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "range",
          "id": "scale",
          "label": "Size scale",
          "info": "Adjust individual logo size",
          "min": 50,
          "max": 150,
          "step": 5,
          "unit": "%",
          "default": 100
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press Logos",
      "category": "Social Proof",
      "blocks": [
        { "type": "logo", "settings": { "name": "SAT.1" } },
        { "type": "logo", "settings": { "name": "ELLE" } },
        { "type": "logo", "settings": { "name": "Gala" } },
        { "type": "logo", "settings": { "name": "ntv" } },
        { "type": "logo", "settings": { "name": "CHEFKOCH" } },
        { "type": "logo", "settings": { "name": "DONNA" } }
      ]
    }
  ]
}
{% endschema %}

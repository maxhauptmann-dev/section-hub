{{ 'section-faq-spotlight.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id
  assign bg = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign accent = section.settings.accent_color
  assign accent2 = section.settings.accent_end
  assign card_bg = section.settings.card_bg
  assign card_border = section.settings.card_border
  assign answer_color = section.settings.answer_color
  assign glow_color = section.settings.glow_color
  assign active_bg = section.settings.active_bg
  assign divider = section.settings.divider_color
  assign max_w = section.settings.max_width
  assign pad_y = section.settings.padding_y
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom
  assign q_size = section.settings.question_size
  assign a_size = section.settings.answer_size
  assign radius = section.settings.border_radius
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign heading_align = section.settings.heading_align
  assign show_number = section.settings.show_number
  assign show_icon = section.settings.show_icon
  assign open_first = section.settings.open_first
  assign glow_style = section.settings.glow_style
  assign divider_style = section.settings.divider_style
  assign accent_line = section.settings.accent_line
  assign number_style = section.settings.number_style
-%}

<div
  id="faq-sl-{{ sid }}"
  class="faq-sl"
  style="
    --faq-sl-bg:{{ bg }};
    --faq-sl-text:{{ text_color }};
    --faq-sl-accent:{{ accent }};
    --faq-sl-accent2:{{ accent2 }};
    --faq-sl-card-bg:{{ card_bg }};
    --faq-sl-card-border:{{ card_border }};
    --faq-sl-answer:{{ answer_color }};
    --faq-sl-glow:{{ glow_color }};
    --faq-sl-active-bg:{{ active_bg }};
    --faq-sl-divider:{{ divider }};
    --faq-sl-max-w:{{ max_w }}px;
    --faq-sl-pad-y:{{ pad_y }}px;
    --faq-sl-mt:{{ mt }}px;
    --faq-sl-mb:{{ mb }}px;
    --faq-sl-q-size:{{ q_size }}px;
    --faq-sl-a-size:{{ a_size }}px;
    --faq-sl-radius:{{ radius }}px;
  "
>
  <div class="faq-sl__inner">
    {%- if heading != blank or subheading != blank -%}
      <div class="faq-sl__header" style="text-align:{{ heading_align }}">
        {%- if heading != blank -%}
          <h2 class="faq-sl__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="faq-sl__sub">{{ subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="faq-sl__list">
      {%- assign idx = 0 -%}
      {%- for block in section.blocks -%}
        {%- assign idx = idx | plus: 1 -%}
        {%- liquid
          assign q = block.settings.question
          assign a = block.settings.answer
          assign icon = block.settings.icon
          assign is_open = false
          if open_first and idx == 1
            assign is_open = true
          endif
        -%}
        <div
          class="faq-sl__item{% if is_open %} faq-sl__item--open{% endif %}{% if glow_style == 'border' %} faq-sl__item--glow-border{% endif %}{% if glow_style == 'shadow' %} faq-sl__item--glow-shadow{% endif %}{% if glow_style == 'both' %} faq-sl__item--glow-border faq-sl__item--glow-shadow{% endif %}{% if accent_line %} faq-sl__item--accent-line{% endif %}"
          data-faq-sl-item="{{ sid }}"
          {{ block.shopify_attributes }}
        >
          <button
            class="faq-sl__question"
            aria-expanded="{{ is_open }}"
            data-faq-sl-toggle="{{ sid }}"
          >
            {%- if show_number -%}
              <span class="faq-sl__num{% if number_style == 'gradient' %} faq-sl__num--grad{% endif %}{% if number_style == 'outline' %} faq-sl__num--outline{% endif %}">{{ idx | prepend: '0' | slice: -2, 2 }}</span>
            {%- endif -%}
            {%- if icon != blank -%}
              <span class="faq-sl__emoji">{{ icon }}</span>
            {%- endif -%}
            <span class="faq-sl__q-text">{{ q }}</span>
            {%- if show_icon -%}
              <span class="faq-sl__toggle" aria-hidden="true">
                <span class="faq-sl__toggle-line faq-sl__toggle-h"></span>
                <span class="faq-sl__toggle-line faq-sl__toggle-v"></span>
              </span>
            {%- endif -%}
          </button>
          <div class="faq-sl__answer"{% if is_open %} style="grid-template-rows:1fr"{% endif %}>
            <div class="faq-sl__answer-wrap">
              <div class="faq-sl__answer-inner">{{ a }}</div>
            </div>
          </div>
          {%- if divider_style != 'none' and forloop.last == false -%}
            <div class="faq-sl__divider{% if divider_style == 'gradient' %} faq-sl__divider--grad{% endif %}{% if divider_style == 'dashed' %} faq-sl__divider--dashed{% endif %}"></div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
(function(){
  var sid='{{ sid }}',root=document.getElementById('faq-sl-'+sid);
  if(!root)return;
  root.addEventListener('click',function(e){
    var btn=e.target.closest('[data-faq-sl-toggle="'+sid+'"]');
    if(!btn)return;
    var item=btn.closest('.faq-sl__item');
    var ans=item.querySelector('.faq-sl__answer');
    var open=item.classList.contains('faq-sl__item--open');
    root.querySelectorAll('[data-faq-sl-item="'+sid+'"].faq-sl__item--open').forEach(function(o){
      if(o!==item){
        o.classList.remove('faq-sl__item--open');
        o.querySelector('.faq-sl__question').setAttribute('aria-expanded','false');
        o.querySelector('.faq-sl__answer').style.gridTemplateRows='0fr';
      }
    });
    if(open){
      item.classList.remove('faq-sl__item--open');
      btn.setAttribute('aria-expanded','false');
      ans.style.gridTemplateRows='0fr';
    }else{
      item.classList.add('faq-sl__item--open');
      btn.setAttribute('aria-expanded','true');
      ans.style.gridTemplateRows='1fr';
    }
  });
})();
</script>

{% schema %}
{
  "name": "SIQ - FAQ Spotlight",

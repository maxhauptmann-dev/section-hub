{% comment %}
  SectionHub – Collection Marquee Tape  (cmt-)
  Infinite scrolling marquee loop of collections
{% endcomment %}

{%- assign sid = section.id -%}
{%- assign heading_font = section.settings.heading_font -%}
{%- assign body_font    = section.settings.body_font -%}
{%- assign dir          = section.settings.direction -%}

<style>
  {{ heading_font | font_face }}
  {{ body_font | font_face }}

  #cmt-{{ sid }} {
    --cmt-bg: {{ section.settings.bg_color }};
    --cmt-accent: {{ section.settings.accent_color }};
    --cmt-heading-color: {{ section.settings.heading_color }};
    --cmt-text-color: {{ section.settings.text_color }};
    --cmt-card-text: {{ section.settings.card_text_color }};
    --cmt-heading-ff: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --cmt-heading-fw: {{ heading_font.weight }};
    --cmt-heading-fs: {{ heading_font.style }};
    --cmt-body-ff: {{ body_font.family }}, {{ body_font.fallback_families }};
    --cmt-body-fw: {{ body_font.weight }};
    --cmt-card-w: {{ section.settings.card_width }}px;
    --cmt-card-h: {{ section.settings.card_height }}px;
    --cmt-radius: {{ section.settings.card_radius }}px;
    --cmt-gap: {{ section.settings.card_gap }}px;
    --cmt-speed: {{ section.settings.speed }}s;
    --cmt-py: {{ section.settings.padding_y }}px;
    --cmt-px: {{ section.settings.padding_x }}px;
  }

  @keyframes cmt-scroll-left {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @keyframes cmt-scroll-right {
    from { transform: translateX(-50%); }
    to   { transform: translateX(0); }
  }
</style>

<section id="cmt-{{ sid }}" class="cmt-wrap" data-cmt-reveal>
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subtext != blank -%}
    <div class="cmt-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="cmt-header__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="cmt-header__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="cmt-header__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%} Row 1 {%- endcomment -%}
  <div class="cmt-tape" data-cmt-tape>
    <div class="cmt-track cmt-track--{{ dir }}" data-cmt-track>
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        {%- assign col_obj = collections[col] -%}
        {%- assign card_title = block.settings.title -%}
        {%- if card_title == blank and col_obj != blank -%}
          {%- assign card_title = col_obj.title -%}
        {%- endif -%}
        {%- assign link_url = block.settings.link -%}
        {%- if link_url == blank and col_obj != blank -%}
          {%- assign link_url = col_obj.url -%}
        {%- endif -%}
        {%- assign card_image = block.settings.image -%}
        {%- if card_image == blank and col_obj != blank -%}
          {%- assign card_image = col_obj.image -%}
        {%- endif -%}

        <a class="cmt-card" href="{{ link_url | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="cmt-card__media">
            {%- if card_image != blank -%}
              <img
                class="cmt-card__img"
                src="{{ card_image | image_url: width: 800 }}"
                srcset="{{ card_image | image_url: width: 400 }} 400w,
                        {{ card_image | image_url: width: 600 }} 600w,
                        {{ card_image | image_url: width: 800 }} 800w"
                sizes="{{ section.settings.card_width }}px"
                alt="{{ card_title | escape }}"
                loading="lazy"
              >
            {%- else -%}
              <div class="cmt-card__placeholder">
                <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
              </div>
            {%- endif -%}
            <div class="cmt-card__gradient"></div>
          </div>
          <div class="cmt-card__label">
            {%- if block.settings.tag != blank -%}
              <span class="cmt-card__tag">{{ block.settings.tag }}</span>
            {%- endif -%}
            {%- if card_title != blank -%}
              <span class="cmt-card__title">{{ card_title }}</span>
            {%- endif -%}
            {%- if block.settings.subtitle != blank -%}
              <span class="cmt-card__subtitle">{{ block.settings.subtitle }}</span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}

      {%- comment -%} Duplicate for seamless loop {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        {%- assign col_obj = collections[col] -%}
        {%- assign card_title = block.settings.title -%}
        {%- if card_title == blank and col_obj != blank -%}
          {%- assign card_title = col_obj.title -%}
        {%- endif -%}
        {%- assign link_url = block.settings.link -%}
        {%- if link_url == blank and col_obj != blank -%}
          {%- assign link_url = col_obj.url -%}
        {%- endif -%}
        {%- assign card_image = block.settings.image -%}
        {%- if card_image == blank and col_obj != blank -%}
          {%- assign card_image = col_obj.image -%}
        {%- endif -%}

        <a class="cmt-card" href="{{ link_url | default: '#' }}" aria-hidden="true" tabindex="-1">
          <div class="cmt-card__media">
            {%- if card_image != blank -%}
              <img class="cmt-card__img" src="{{ card_image | image_url: width: 800 }}" alt="" loading="lazy">
            {%- else -%}
              <div class="cmt-card__placeholder">
                <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
              </div>
            {%- endif -%}
            <div class="cmt-card__gradient"></div>
          </div>
          <div class="cmt-card__label">
            {%- if block.settings.tag != blank -%}
              <span class="cmt-card__tag">{{ block.settings.tag }}</span>
            {%- endif -%}
            {%- if card_title != blank -%}
              <span class="cmt-card__title">{{ card_title }}</span>
            {%- endif -%}
            {%- if block.settings.subtitle != blank -%}
              <span class="cmt-card__subtitle">{{ block.settings.subtitle }}</span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} Optional Row 2 (reverse) {%- endcomment -%}
  {%- if section.settings.double_row -%}
    {%- assign rev_dir = 'right' -%}
    {%- if dir == 'right' -%}
      {%- assign rev_dir = 'left' -%}
    {%- endif -%}
    <div class="cmt-tape cmt-tape--row2" data-cmt-tape>
      <div class="cmt-track cmt-track--{{ rev_dir }}" data-cmt-track>
        {%- for block in section.blocks -%}
          {%- assign col = block.settings.collection -%}
          {%- assign col_obj = collections[col] -%}
          {%- assign card_title = block.settings.title -%}
          {%- if card_title == blank and col_obj != blank -%}
            {%- assign card_title = col_obj.title -%}
          {%- endif -%}
          {%- assign link_url = block.settings.link -%}
          {%- if link_url == blank and col_obj != blank -%}
            {%- assign link_url = col_obj.url -%}
          {%- endif -%}
          {%- assign card_image = block.settings.image -%}
          {%- if card_image == blank and col_obj != blank -%}
            {%- assign card_image = col_obj.image -%}
          {%- endif -%}

          <a class="cmt-card" href="{{ link_url | default: '#' }}" aria-hidden="true" tabindex="-1">
            <div class="cmt-card__media">
              {%- if card_image != blank -%}
                <img class="cmt-card__img" src="{{ card_image | image_url: width: 800 }}" alt="{{ card_title | escape }}" loading="lazy">
              {%- else -%}
                <div class="cmt-card__placeholder">
                  <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                </div>
              {%- endif -%}
              <div class="cmt-card__gradient"></div>
            </div>
            <div class="cmt-card__label">
              {%- if card_title != blank -%}
                <span class="cmt-card__title">{{ card_title }}</span>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}

        {%- for block in section.blocks -%}
          {%- assign col = block.settings.collection -%}
          {%- assign col_obj = collections[col] -%}
          {%- assign card_title = block.settings.title -%}
          {%- if card_title == blank and col_obj != blank -%}
            {%- assign card_title = col_obj.title -%}
          {%- endif -%}
          {%- assign link_url = block.settings.link -%}
          {%- if link_url == blank and col_obj != blank -%}
            {%- assign link_url = col_obj.url -%}
          {%- endif -%}
          {%- assign card_image = block.settings.image -%}
          {%- if card_image == blank and col_obj != blank -%}
            {%- assign card_image = col_obj.image -%}
          {%- endif -%}

          <a class="cmt-card" href="{{ link_url | default: '#' }}" aria-hidden="true" tabindex="-1">
            <div class="cmt-card__media">
              {%- if card_image != blank -%}
                <img class="cmt-card__img" src="{{ card_image | image_url: width: 800 }}" alt="" loading="lazy">
              {%- else -%}
                <div class="cmt-card__placeholder">
                  <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
                </div>
              {%- endif -%}
              <div class="cmt-card__gradient"></div>
            </div>
            <div class="cmt-card__label">
              {%- if card_title != blank -%}
                <span class="cmt-card__title">{{ card_title }}</span>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

<script>
  (function(){
    var wrap = document.getElementById('cmt-{{ sid }}');
    if(!wrap) return;

    /* pause on hover */
    var tapes = wrap.querySelectorAll('[data-cmt-tape]');
    tapes.forEach(function(tape){
      tape.addEventListener('mouseenter', function(){
        var track = tape.querySelector('[data-cmt-track]');
        if(track) track.style.animationPlayState = 'paused';
      });
      tape.addEventListener('mouseleave', function(){
        var track = tape.querySelector('[data-cmt-track]');
        if(track) track.style.animationPlayState = 'running';
      });
    });

    /* scroll reveal */
    if('IntersectionObserver' in window){
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(en){
          if(en.isIntersecting){
            en.target.classList.add('cmt-visible');
            io.unobserve(en.target);
          }
        });
      }, {threshold: 0.1});
      io.observe(wrap);
    } else {
      wrap.classList.add('cmt-visible');
    }
  })();
</script>

{% schema %}
{
  "name": "SIQ - Collection Marquee",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Browse"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our collections"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Endlessly curated — hover to explore, click to shop."
    },
    {
      "type": "header",
      "content": "Card Dimensions"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card Width (px)",
      "min": 200,
      "max": 480,
      "step": 10,
      "default": 320,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_height",
      "label": "Card Height (px)",
      "min": 180,
      "max": 420,
      "step": 10,
      "default": 280,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card Gap (px)",
      "min": 8,
      "max": 40,
      "step": 4,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card Radius (px)",
      "min": 0,

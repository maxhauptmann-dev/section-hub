{%- comment -%}
  Section Hub — Before / After Results v2
  Two-column layout: before/after drag-slider + flexible content blocks.
  Content blocks (heading, text, bullet, review, button, spacer, divider,
  custom liquid) are freely addable, removable, and reorderable.
{%- endcomment -%}

{%- assign sid = section.id -%}
{%- assign hf = section.settings.heading_font -%}
{%- assign bf = section.settings.body_font -%}
{{ hf | font_face: font_display: 'swap' }}
{{ bf | font_face: font_display: 'swap' }}

{%- assign img_pos = section.settings.image_position | default: 'center center' -%}

<style>
/* ── Reset ── */
#bar-{{ sid }},#bar-{{ sid }} *,#bar-{{ sid }} *::before,#bar-{{ sid }} *::after{box-sizing:border-box;}

/* ── Root ── */
#bar-{{ sid }}{
  --c-bg:{{ section.settings.bg_color }};
  --c-card:{{ section.settings.card_bg }};
  --c-text:{{ section.settings.text_color }};
  --c-muted:{{ section.settings.muted_color }};
  --c-highlight:{{ section.settings.highlight_color }};
  --c-bullet:{{ section.settings.bullet_color }};
  --c-btn-bg:{{ section.settings.button_bg }};
  --c-btn-text:{{ section.settings.button_text_color }};
  --c-btn-hover:{{ section.settings.button_hover_bg }};
  --c-review-bg:{{ section.settings.review_bg }};
  --c-review-text:{{ section.settings.review_text_color }};
  --c-star:{{ section.settings.star_color }};
  --c-handle:{{ section.settings.slider_color }};
  --c-line:{{ section.settings.slider_line_color }};
  --c-accent:{{ section.settings.accent_color }};
  --r-card:{{ section.settings.card_radius }}px;
  --r-img:{{ section.settings.image_radius }}px;
  --r-btn:{{ section.settings.button_radius }}px;
  --r-review:{{ section.settings.review_radius }}px;
  --mw:{{ section.settings.max_width }}px;
  --handle-size:{{ section.settings.handle_size }}px;
  --line-w:{{ section.settings.line_width }}px;
  --slider-start:{{ section.settings.slider_start }}%;
  --font-heading:{{ hf.family }},{{ hf.fallback_families }};
  --font-body:{{ bf.family }},{{ bf.fallback_families }};
  --font-h-style:{{ hf.style }};
  --font-b-style:{{ bf.style }};
  --img-pos:{{ img_pos }};
  background:var(--c-bg);
  color:var(--c-text);
  padding:{{ section.settings.pt_mobile }}px 0 {{ section.settings.pb_mobile }}px;
  font-family:var(--font-body);
  font-style:var(--font-b-style);
  -webkit-font-smoothing:antialiased;
}
@media(min-width:750px){
  #bar-{{ sid }}{padding:{{ section.settings.pt }}px 0 {{ section.settings.pb }}px;}
}

/* ── Wrap ── */
#bar-{{ sid }} .bar-wrap{
  width:90%;max-width:var(--mw);margin:0 auto;
}

/* ── Card ── */
#bar-{{ sid }} .bar-card{
  background:var(--c-card);
  border-radius:var(--r-card);
  {% if section.settings.card_shadow %}box-shadow:0 4px 28px rgba(0,0,0,.08);{% endif %}
  {% if section.settings.card_border %}border:1.5px solid {{ section.settings.card_border_color }};{% endif %}
  padding:{{ section.settings.card_padding_mobile }}px;
  display:flex;flex-direction:column;gap:28px;
  overflow:hidden;
}
@media(min-width:750px){
  #bar-{{ sid }} .bar-card{
    padding:{{ section.settings.card_padding }}px;
    flex-direction:row;
    align-items:center;
    gap:{{ section.settings.desktop_gap }}px;
  }
  #bar-{{ sid }} .bar-card.bar-layout-image-right{ flex-direction:row-reverse; }
}

/* ── Image column ── */
#bar-{{ sid }} .bar-image-col{
  width:100%;flex-shrink:0;
}
@media(min-width:750px){
  #bar-{{ sid }} .bar-image-col{
    width:{{ section.settings.image_col_width }}%;
    max-width:{{ section.settings.image_col_width }}%;
  }
}

/* ── Slider ── */
#bar-{{ sid }} .bar-slider{
  position:relative;overflow:hidden;
  border-radius:var(--r-img);
  aspect-ratio:{{ section.settings.aspect_ratio }};
  background:#e8e8e8;
  cursor:ew-resize;touch-action:pan-y;
  user-select:none;-webkit-user-select:none;
  {% if section.settings.image_shadow %}box-shadow:0 8px 32px rgba(0,0,0,.14);{% endif %}
}
#bar-{{ sid }} .bar-img{
  position:absolute;inset:0;width:100%;height:100%;
}
#bar-{{ sid }} .bar-img img{
  width:100%;height:100%;
  object-fit:{{ section.settings.image_fit }};
  object-position:var(--img-pos,center center);
  display:block;pointer-events:none;
}
#bar-{{ sid }} .bar-img-after{z-index:1;}
#bar-{{ sid }} .bar-img-before{
  z-index:2;
  clip-path:inset(0 calc(100% - var(--slider-start)) 0 0);
}

/* ── Labels ── */
{%- if section.settings.label_style != 'hidden' -%}
#bar-{{ sid }} .bar-label{
  position:absolute;z-index:4;pointer-events:none;
  font-family:var(--font-body);
  font-size:{{ section.settings.label_size }}px;
  font-weight:700;letter-spacing:.06em;text-transform:uppercase;line-height:1;
  {%- if section.settings.label_style == 'pill' -%}
    top:14px;padding:5px 14px;border-radius:10px;
    background:{{ section.settings.label_bg }};color:{{ section.settings.label_text }};
    backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
  {%- else -%}
    bottom:14px;color:#fff;text-shadow:0 1px 6px rgba(0,0,0,.6);
  {%- endif -%}
}
#bar-{{ sid }} .bar-label-before{left:14px;}
#bar-{{ sid }} .bar-label-after{right:14px;}
{%- endif -%}

/* ── Handle ── */
#bar-{{ sid }} .bar-handle{
  position:absolute;top:0;bottom:0;
  left:var(--slider-start);z-index:5;
  transform:translateX(-50%);width:var(--line-w);
  display:flex;flex-direction:column;align-items:center;
  pointer-events:none;
}
#bar-{{ sid }} .bar-handle-line{flex:1;width:var(--line-w);background:var(--c-line);opacity:.9;}
#bar-{{ sid }} .bar-handle-knob{
  width:var(--handle-size);height:var(--handle-size);flex-shrink:0;
  border-radius:50%;background:var(--c-handle);color:var(--c-accent);
  display:flex;align-items:center;justify-content:center;
  pointer-events:auto;cursor:ew-resize;
  box-shadow:0 2px 12px rgba(0,0,0,.22);
  transition:transform .15s,box-shadow .15s;
}
#bar-{{ sid }} .bar-slider.dragging .bar-handle-knob,
#bar-{{ sid }} .bar-handle-knob:hover{
  transform:scale(1.1);box-shadow:0 4px 20px rgba(0,0,0,.3);
}
#bar-{{ sid }} .bar-handle-knob svg{
  width:calc(var(--handle-size)*.44);height:calc(var(--handle-size)*.44);pointer-events:none;
}

/* ── Text column ── */
#bar-{{ sid }} .bar-text-col{
  text-align:{{ section.settings.text_alignment }};
  display:flex;flex-direction:column;min-width:0;flex:1;
  {% if section.settings.text_alignment == 'center' %}align-items:center;{% elsif section.settings.text_alignment == 'right' %}align-items:flex-end;{% else %}align-items:flex-start;{% endif %}
}
#bar-{{ sid }} .bar-block{
  width:100%;
  {% if section.settings.text_alignment == 'center' %}display:flex;flex-direction:column;align-items:center;{% elsif section.settings.text_alignment == 'right' %}display:flex;flex-direction:column;align-items:flex-end;{% endif %}
}

/* ── Block: Heading ── */
#bar-{{ sid }} .bar-heading{
  font-family:var(--font-heading);font-style:var(--font-h-style);
  font-weight:{{ section.settings.heading_weight }};
  letter-spacing:{{ section.settings.heading_letter_spacing }}em;
  line-height:1.15;color:var(--c-text);margin:0;
}
#bar-{{ sid }} .bar-heading.bar-h-lg{font-size:{{ section.settings.heading_size_mobile }}px;}
#bar-{{ sid }} .bar-heading.bar-h-md{font-size:calc({{ section.settings.heading_size_mobile }}px * .7);}
#bar-{{ sid }} .bar-heading.bar-h-sm{font-size:calc({{ section.settings.heading_size_mobile }}px * .5);}
@media(min-width:750px){
  #bar-{{ sid }} .bar-heading.bar-h-lg{font-size:{{ section.settings.heading_size }}px;}
  #bar-{{ sid }} .bar-heading.bar-h-md{font-size:calc({{ section.settings.heading_size }}px * .7);}
  #bar-{{ sid }} .bar-heading.bar-h-sm{font-size:calc({{ section.settings.heading_size }}px * .5);}
}
#bar-{{ sid }} .bar-heading-highlight{color:var(--c-highlight);}

/* ── Block: Body ── */
#bar-{{ sid }} .bar-body{
  font-family:var(--font-body);font-style:var(--font-b-style);
  line-height:1.65;color:var(--c-text);margin:0;
}
#bar-{{ sid }} .bar-body--muted{color:var(--c-muted);}
#bar-{{ sid }} .bar-body p{margin:0 0 .6em;}
#bar-{{ sid }} .bar-body p:last-child{margin-bottom:0;}

/* ── Block: Bullet ── */
#bar-{{ sid }} .bar-bullet{
  display:flex;align-items:flex-start;gap:10px;
  font-family:var(--font-body);
  line-height:1.3;color:var(--c-text);margin:0;
  {% if section.settings.text_alignment == 'center' %}justify-content:center;{% endif %}
  {% if section.settings.text_alignment == 'right' %}justify-content:flex-end;{% endif %}
}
#bar-{{ sid }} .bar-bullet-icon{
  flex-shrink:0;margin-top:1px;color:var(--c-bullet);
}

/* ── Block: Review ── */
#bar-{{ sid }} .bar-review{
  background:var(--c-review-bg);border-radius:var(--r-review);
  width:100%;
  {% if section.settings.review_border %}border:1.5px solid {{ section.settings.review_border_color }};{% endif %}
}
#bar-{{ sid }} .bar-stars{
  display:flex;gap:3px;
  {% if section.settings.text_alignment == 'center' %}justify-content:center;{% elsif section.settings.text_alignment == 'right' %}justify-content:flex-end;{% endif %}
}
#bar-{{ sid }} .bar-star{color:var(--c-star);flex-shrink:0;}
#bar-{{ sid }} .bar-review-title{
  font-family:var(--font-heading);font-style:var(--font-h-style);
  font-weight:{{ section.settings.heading_weight }};
  letter-spacing:{{ section.settings.heading_letter_spacing }}em;
  color:var(--c-review-text);margin:0;
}
#bar-{{ sid }} .bar-review-text{
  font-family:var(--font-body);font-style:var(--font-b-style);
  line-height:1.6;color:var(--c-review-text);margin:0;opacity:.85;
}
#bar-{{ sid }} .bar-review-author{
  font-family:var(--font-body);
  color:var(--c-review-text);opacity:.6;font-style:italic;margin:0;
}

/* ── Block: Button ── */
#bar-{{ sid }} .bar-btn{
  display:inline-block;
  font-family:var(--font-body);font-style:var(--font-b-style);
  font-weight:700;text-decoration:none;
  border-radius:var(--r-btn);
  background:var(--c-btn-bg);color:var(--c-btn-text);
  border:none;cursor:pointer;
  transition:background .2s,opacity .2s,transform .15s;
  line-height:1;letter-spacing:.02em;
}
#bar-{{ sid }} .bar-btn:hover{
  background:var(--c-btn-hover);
  transform:translateY(-1px);
}

/* ── Intro swing ── */
@keyframes bar-swing-b-{{ sid }}{
  0%{clip-path:inset(0 calc(100% - var(--slider-start)) 0 0);}
  35%{clip-path:inset(0 22% 0 0);}
  65%{clip-path:inset(0 72% 0 0);}
  100%{clip-path:inset(0 calc(100% - var(--slider-start)) 0 0);}
}
@keyframes bar-swing-h-{{ sid }}{
  0%{left:var(--slider-start);}
  35%{left:78%;}
  65%{left:28%;}
  100%{left:var(--slider-start);}
}
#bar-{{ sid }} .bar-slider.intro .bar-img-before{
  animation:bar-swing-b-{{ sid }} 1.6s cubic-bezier(.4,0,.2,1) both;
}
#bar-{{ sid }} .bar-slider.intro .bar-handle{
  animation:bar-swing-h-{{ sid }} 1.6s cubic-bezier(.4,0,.2,1) both;
}
</style>

<section id="bar-{{ sid }}">
  <div class="bar-wrap">
    <div class="bar-card{% if section.settings.layout == 'image-right' %} bar-layout-image-right{% endif %}">

      {%- comment -%}── Image column ──{%- endcomment -%}
      <div class="bar-image-col">
        <div class="bar-slider" data-slider tabindex="-1">

          <div class="bar-img bar-img-after">
            {%- if section.settings.image_after != blank -%}
              {{ section.settings.image_after | image_url: width: 1200 | image_tag:
                loading: 'lazy',
                widths: '400,700,900,1200',
                sizes: '(max-width:749px) 90vw, 50vw'
              }}
            {%- else -%}
              <div style="width:100%;height:100%;background:#e0e0e0;display:flex;align-items:center;justify-content:center;">{{ 'image' | placeholder_svg_tag }}</div>
            {%- endif -%}
            {%- unless section.settings.label_style == 'hidden' -%}
              <span class="bar-label bar-label-after">{{ section.settings.label_after }}</span>
            {%- endunless -%}
          </div>

          <div class="bar-img bar-img-before" data-before>
            {%- if section.settings.image_before != blank -%}
              {{ section.settings.image_before | image_url: width: 1200 | image_tag:
                loading: 'lazy',
                widths: '400,700,900,1200',
                sizes: '(max-width:749px) 90vw, 50vw'
              }}
            {%- else -%}
              <div style="width:100%;height:100%;background:#c8c8c8;display:flex;align-items:center;justify-content:center;">{{ 'image' | placeholder_svg_tag }}</div>
            {%- endif -%}
            {%- unless section.settings.label_style == 'hidden' -%}
              <span class="bar-label bar-label-before">{{ section.settings.label_before }}</span>
            {%- endunless -%}
          </div>

          <div class="bar-handle" data-handle tabindex="0" role="slider"
               aria-valuenow="{{ section.settings.slider_start }}"
               aria-valuemin="0" aria-valuemax="100" aria-label="Drag to compare">
            <div class="bar-handle-line"></div>
            <div class="bar-handle-knob">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 6l-4 6 4 6"/><path d="M15 6l4 6-4 6"/>
              </svg>
            </div>
            <div class="bar-handle-line"></div>
          </div>

        </div>
      </div>

      {%- comment -%}── Text column — flexible blocks ──{%- endcomment -%}
      <div class="bar-text-col">
        {%- for block in section.blocks -%}
          <div class="bar-block" {{ block.shopify_attributes }}>
          {%- case block.type -%}

            {%- comment -%}═══ HEADING ═══{%- endcomment -%}
            {%- when 'heading' -%}
              <{{ block.settings.tag | default: 'h2' }}
                class="bar-heading bar-h-{{ block.settings.size }}"
                style="margin-bottom:{{ block.settings.mb }}px;">
                {%- if block.settings.prefix != blank -%}
                  {{ block.settings.prefix }}&#32;
                {%- endif -%}
                {%- if block.settings.highlight != blank -%}
                  <span class="bar-heading-highlight"{% if block.settings.highlight_color != blank %} style="color:{{ block.settings.highlight_color }};"{% endif %}>{{ block.settings.highlight }}</span>
                  {%- if block.settings.suffix != blank -%}
                    &#32;{{ block.settings.suffix }}
                  {%- endif -%}
                {%- elsif block.settings.text != blank -%}
                  {{ block.settings.text }}
                {%- endif -%}
              </{{ block.settings.tag | default: 'h2' }}>

            {%- comment -%}═══ BODY TEXT ═══{%- endcomment -%}
            {%- when 'text' -%}
              <div class="bar-body{% if block.settings.muted %} bar-body--muted{% endif %}"
                style="font-size:{{ block.settings.font_size }}px;margin-bottom:{{ block.settings.mb }}px;">
                {{ block.settings.text }}
              </div>

            {%- comment -%}═══ BULLET ═══{%- endcomment -%}
            {%- when 'bullet' -%}
              <div class="bar-bullet"
                style="font-size:{{ block.settings.font_size }}px;font-weight:{{ block.settings.weight }};margin-bottom:{{ block.settings.mb }}px;">
                {%- if block.settings.icon != 'none' -%}
                  {%- case block.settings.icon -%}
                    {%- when 'check' -%}
                      <svg class="bar-bullet-icon" width="{{ block.settings.icon_size }}" height="{{ block.settings.icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                    {%- when 'check-circle' -%}
                      <svg class="bar-bullet-icon" width="{{ block.settings.icon_size }}" height="{{ block.settings.icon_size }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 100 20A10 10 0 0012 2zm-1.5 13.5l-3-3 1.4-1.4 1.6 1.6 4.1-4.1 1.4 1.4-5.5 5.5z"/></svg>
                    {%- when 'check-square' -%}
                      <svg class="bar-bullet-icon" width="{{ block.settings.icon_size }}" height="{{ block.settings.icon_size }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 3H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V5a2 2 0 00-2-2zm-8.5 12.5l-3-3 1.4-1.4 1.6 1.6 4.1-4.1 1.4 1.4-5.5 5.5z"/></svg>
                    {%- when 'star' -%}
                      <svg class="bar-bullet-icon" width="{{ block.settings.icon_size }}" height="{{ block.settings.icon_size }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    {%- when 'arrow' -%}
                      <svg class="bar-bullet-icon" width="{{ block.settings.icon_size }}" height="{{ block.settings.icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    {%- when 'dot' -%}
                      <svg class="bar-bullet-icon" width="{{ block.settings.icon_size }}" height="{{ block.settings.icon_size }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="5"/></svg>
                  {%- endcase -%}
                {%- endif -%}
                {{ block.settings.text }}
              </div>

            {%- comment -%}═══ REVIEW ═══{%- endcomment -%}
            {%- when 'review' -%}
              <div class="bar-review"
                style="padding:{{ block.settings.padding }}px;margin-bottom:{{ block.settings.mb }}px;{% if block.settings.bg_color != blank %}background:{{ block.settings.bg_color }};{% endif %}">

                {%- assign star_count = block.settings.stars | times: 1 -%}
                {%- if star_count > 0 -%}
                  <div class="bar-stars" style="margin-bottom:8px;">
                    {%- assign full_stars = star_count | floor -%}
                    {%- assign star_rem = star_count | minus: full_stars -%}
                    {%- assign show_half = false -%}
                    {%- if star_rem >= 0.4 -%}{%- assign show_half = true -%}{%- endif -%}
                    {%- assign half_at = full_stars | plus: 1 -%}
                    {%- for i in (1..5) -%}
                      {%- if i <= full_stars -%}
                        <svg class="bar-star" width="{{ block.settings.star_size }}" height="{{ block.settings.star_size }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      {%- elsif show_half and i == half_at -%}
                        <svg class="bar-star" width="{{ block.settings.star_size }}" height="{{ block.settings.star_size }}" viewBox="0 0 24 24" aria-hidden="true"><defs><linearGradient id="hg-{{ sid }}-{{ forloop.index }}"><stop offset="50%" stop-color="currentColor"/><stop offset="50%" stop-color="transparent"/></linearGradient></defs><path fill="url(#hg-{{ sid }}-{{ forloop.index }})" stroke="currentColor" stroke-width="1.5" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      {%- else -%}
                        <svg class="bar-star" width="{{ block.settings.star_size }}" height="{{ block.settings.star_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" style="opacity:.35"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                {%- if block.settings.title != blank -%}
                  <p class="bar-review-title" style="font-size:{{ block.settings.title_size }}px;margin-bottom:6px;">{{ block.settings.title }}</p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="bar-review-text" style="font-size:{{ block.settings.text_size }}px;margin-bottom:8px;">{{ block.settings.text }}</p>
                {%- endif -%}
                {%- if block.settings.author != blank -%}
                  <p class="bar-review-author" style="font-size:{{ block.settings.author_size }}px;">{{ block.settings.author }}</p>
                {%- endif -%}
              </div>

            {%- comment -%}═══ BUTTON ═══{%- endcomment -%}
            {%- when 'button' -%}
              <a class="bar-btn"
                href="{{ block.settings.link | default: '#' }}"
                style="font-size:{{ block.settings.font_size }}px;padding:{{ block.settings.padding_y }}px {{ block.settings.padding_x }}px;margin-bottom:{{ block.settings.mb }}px;{% if block.settings.bg_color != blank %}background:{{ block.settings.bg_color }};{% endif %}{% if block.settings.text_color != blank %}color:{{ block.settings.text_color }};{% endif %}">
                {{ block.settings.label }}
              </a>

            {%- comment -%}═══ SPACER ═══{%- endcomment -%}
            {%- when 'spacer' -%}
              <div style="height:{{ block.settings.height }}px;"></div>

            {%- comment -%}═══ DIVIDER ═══{%- endcomment -%}
            {%- when 'divider' -%}
              <hr style="border:none;border-top:{{ block.settings.thickness }}px {{ block.settings.style }} {{ block.settings.color }};width:{{ block.settings.width }};margin:0 0 {{ block.settings.mb }}px;{% if section.settings.text_alignment == 'left' %}margin-left:0;{% elsif section.settings.text_alignment == 'right' %}margin-right:0;{% endif %}">

            {%- comment -%}═══ CUSTOM LIQUID ═══{%- endcomment -%}
            {%- when 'liquid' -%}
              <div style="margin-bottom:{{ block.settings.mb }}px;width:100%;">
                {{ block.settings.code }}
              </div>

          {%- endcase -%}
          </div>

        {%- endfor -%}
      </div>

    </div>

<script>
(function(){
  var root = document.getElementById('bar-{{ sid }}');
  if(!root) return;
  var sl = root.querySelector('[data-slider]');
  if(!sl) return;
  var before = sl.querySelector('[data-before]');
  var handle = sl.querySelector('[data-handle]');
  if(!before||!handle) return;
  var dragging = false;
  var startPct = {{ section.settings.slider_start }};

  if(typeof IntersectionObserver!=='undefined'){
    var io = new IntersectionObserver(function(e){
      if(e[0].isIntersecting){
        sl.classList.add('intro');
        io.disconnect();
        setTimeout(function(){sl.classList.remove('intro');},1700);
      }
    },{threshold:.3});
    io.observe(sl);
  }

  function setPos(cx){
    var r = sl.getBoundingClientRect();
    var p = Math.max(2,Math.min(98,((cx-r.left)/r.width)*100));
    before.style.clipPath='inset(0 '+(100-p)+'% 0 0)';
    handle.style.left=p+'%';
    handle.setAttribute('aria-valuenow',Math.round(p));
  }
  function onDown(e){
    e.stopPropagation();e.preventDefault();
    sl.classList.remove('intro');
    dragging=true;sl.classList.add('dragging');
    setPos(e.touches?e.touches[0].clientX:e.clientX);
  }
  function onMove(e){
    if(!dragging) return;e.preventDefault();
    setPos(e.touches?e.touches[0].clientX:e.clientX);
  }
  function onUp(){if(!dragging)return;dragging=false;sl.classList.remove('dragging');}

  sl.addEventListener('mousedown',onDown);
  sl.addEventListener('touchstart',onDown,{passive:false});
  window.addEventListener('mousemove',onMove,{passive:false});
  window.addEventListener('touchmove',onMove,{passive:false});
  window.addEventListener('mouseup',onUp);
  window.addEventListener('touchend',onUp);

  handle.addEventListener('keydown',function(e){
    var c=parseFloat(handle.style.left)||startPct;
    var s=e.shiftKey?10:3;
    var r=sl.getBoundingClientRect();
    if(e.key==='ArrowLeft'){e.preventDefault();setPos(r.left+r.width*Math.max(2,c-s)/100);}
    if(e.key==='ArrowRight'){e.preventDefault();setPos(r.left+r.width*Math.min(98,c+s)/100);}
  });
})();
</script>


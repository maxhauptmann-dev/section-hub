{{ 'section-faq-flip-cards.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id
  assign bg = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign accent = section.settings.accent_color
  assign accent2 = section.settings.accent_end
  assign front_bg = section.settings.front_bg
  assign front_border = section.settings.front_border
  assign back_bg = section.settings.back_bg
  assign back_text = section.settings.back_text
  assign back_border = section.settings.back_border
  assign icon_bg = section.settings.icon_bg
  assign max_w = section.settings.max_width
  assign pad_y = section.settings.padding_y
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom
  assign q_size = section.settings.question_size
  assign a_size = section.settings.answer_size
  assign radius = section.settings.border_radius
  assign columns = section.settings.columns
  assign gap = section.settings.gap
  assign card_height = section.settings.card_height
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign heading_align = section.settings.heading_align
  assign flip_hint = section.settings.flip_hint
  assign front_shadow = section.settings.front_shadow
  assign back_gradient = section.settings.back_gradient
-%}

<div
  id="faq-fc-{{ sid }}"
  class="faq-fc"
  style="
    --faq-fc-bg:{{ bg }};
    --faq-fc-text:{{ text_color }};
    --faq-fc-accent:{{ accent }};
    --faq-fc-accent2:{{ accent2 }};
    --faq-fc-front-bg:{{ front_bg }};
    --faq-fc-front-border:{{ front_border }};
    --faq-fc-back-bg:{{ back_bg }};
    --faq-fc-back-text:{{ back_text }};
    --faq-fc-back-border:{{ back_border }};
    --faq-fc-icon-bg:{{ icon_bg }};
    --faq-fc-max-w:{{ max_w }}px;
    --faq-fc-pad-y:{{ pad_y }}px;
    --faq-fc-mt:{{ mt }}px;
    --faq-fc-mb:{{ mb }}px;
    --faq-fc-q-size:{{ q_size }}px;
    --faq-fc-a-size:{{ a_size }}px;
    --faq-fc-radius:{{ radius }}px;
    --faq-fc-cols:{{ columns }};
    --faq-fc-gap:{{ gap }}px;
    --faq-fc-height:{{ card_height }}px;
  "
>
  <div class="faq-fc__inner">
    {%- if heading != blank or subheading != blank -%}
      <div class="faq-fc__header" style="text-align:{{ heading_align }}">
        {%- if heading != blank -%}
          <h2 class="faq-fc__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="faq-fc__sub">{{ subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="faq-fc__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign q = block.settings.question
          assign a = block.settings.answer
          assign icon = block.settings.icon
          assign card_color = block.settings.card_color
        -%}
        <div
          class="faq-fc__card-wrap{% if front_shadow %} faq-fc__card-wrap--shadow{% endif %}"
          data-faq-fc-card="{{ sid }}"
          {{ block.shopify_attributes }}
        >
          <div class="faq-fc__card">
            <!-- Front -->
            <div class="faq-fc__front">
              {%- if icon != blank -%}
                <span class="faq-fc__icon">{{ icon }}</span>
              {%- endif -%}
              <p class="faq-fc__question">{{ q }}</p>
              {%- if flip_hint -%}
                <span class="faq-fc__hint">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
                  Tap to reveal
                </span>
              {%- endif -%}
            </div>
            <!-- Back -->
            <div class="faq-fc__back{% if back_gradient %} faq-fc__back--gradient{% endif %}" {% if card_color != blank %}style="--faq-fc-card-color:{{ card_color }}"{% endif %}>
              <div class="faq-fc__answer">{{ a }}</div>
              <button class="faq-fc__back-btn" data-faq-fc-close="{{ sid }}" aria-label="Flip back">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
(function(){
  var sid='{{ sid }}',root=document.getElementById('faq-fc-'+sid);
  if(!root)return;
  root.addEventListener('click',function(e){
    var closeBtn=e.target.closest('[data-faq-fc-close="'+sid+'"]');
    if(closeBtn){
      var wrap=closeBtn.closest('[data-faq-fc-card="'+sid+'"]');
      if(wrap)wrap.classList.remove('faq-fc__card-wrap--flipped');
      return;
    }
    var cardEl=e.target.closest('[data-faq-fc-card="'+sid+'"]');
    if(!cardEl)return;
    /* Only flip if clicking on front side */
    var front=e.target.closest('.faq-fc__front');
    if(front||!cardEl.classList.contains('faq-fc__card-wrap--flipped')){
      cardEl.classList.toggle('faq-fc__card-wrap--flipped');
    }
  });
})();
</script>


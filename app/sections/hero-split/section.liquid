      "min": 24,
      "max": 96,
      "step": 1,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "heading_font_size_mobile",
      "label": "Font size – mobile",
      "min": 20,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 36

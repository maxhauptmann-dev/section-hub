      "id": "subheading",
      "label": "Subheading",
      "default": "premium spirits for your home bar."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "the art of mixology."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "P" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "jetzt shoppen."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "solid"
    },
    {
      "type": "checkbox",
      "id": "button_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Section height",
      "min": 400,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Image height – mobile",
      "min": 200,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 350
    },
    {
      "type": "range",
      "id": "text_width",
      "label": "Text card width",
      "info": "Percentage of section width",
      "min": 30,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 42
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "full", "label": "Full width" },
        { "value": "page", "label": "Page width (1200px)" },
        { "value": "narrow", "label": "Narrow (1000px)" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "section_custom_width",
      "label": "Custom width",
      "min": 800,
      "max": 1800,
      "step": 10,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "section_roundness",
      "label": "Section roundness",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Card styling"
    },
    {
      "type": "range",
      "id": "card_roundness",
      "label": "Card roundness",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",

      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "card_padding_x",
      "label": "Card padding – horizontal",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "card_padding_y_mobile",
      "label": "Card padding vertical – mobile",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "card_padding_x_mobile",
      "label": "Card padding horizontal – mobile",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",

        },
        {
          "type": "card",
          "settings": {
            "tag": "Quality",
            "heading": "Built to Last",
            "text": "Backed by our lifetime guarantee — designed to age beautifully and stand the test of time.",
            "btn_text": "Discover"
          }
        }
      ]
    }
  ]
}

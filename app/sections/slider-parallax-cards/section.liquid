    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#f0f7f4"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#2d8a6e"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a2e28"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#5a7268"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#ffffff"

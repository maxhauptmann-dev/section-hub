      "label": "Subtext",
      "default": "Scroll through our highlights and discover what sets our approach apart."
    },
    {
      "type": "header",
      "content": "Card Dimensions"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card Width (px)",
      "min": 260,
      "max": 440,
      "step": 10,
      "default": 340,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image Height (px)",
      "min": 180,

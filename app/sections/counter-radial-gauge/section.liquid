      "default": "Performance"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Results at a Glance"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Watch our achievements come to life as each metric fills its gauge."
    },
    {
      "type": "header",
      "content": "Ring settings"
    },
    {
      "type": "range",
      "id": "ring_size",
      "label": "Ring diameter",
      "min": 100,
      "max": 240,
      "step": 10,
      "default": 160,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "stroke_width",
      "label": "Ring stroke width",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "ring_cap",
      "label": "Ring line cap",
      "options": [
        { "value": "round", "label": "Rounded" },
        { "value": "butt", "label": "Flat" }
      ],
      "default": "round"
    },
    {
      "type": "checkbox",
      "id": "show_track",
      "label": "Show background track",
      "default": true,
      "info": "Faint ring behind the progress arc"
    },
    {
      "type": "checkbox",
      "id": "show_glow",
      "label": "Show glow effect",
      "default": true,
      "info": "Subtle radial glow behind each gauge"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "range",
      "id": "grid_gap",

      "min": 12,
      "max": 60,
      "step": 4,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 24,
      "step": 4,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "count_duration",
      "label": "Count-up duration",
      "min": 500,
      "max": 4000,
      "step": 250,
      "default": 2000,
      "unit": "ms"
    },
    {
      "type": "range",
      "id": "stagger_delay",
      "label": "Stagger delay",
      "min": 0,
      "max": 400,
      "step": 50,
      "default": 150,
      "unit": "ms"
    },
    {
      "type": "header",
      "content": "Section size"
    },
    {
      "type": "range",

{{ 'section-product-wave-carousel.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id
  assign bg = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign accent = section.settings.accent_color
  assign card_bg = section.settings.card_bg
  assign card_border = section.settings.card_border
  assign price_color = section.settings.price_color
  assign badge_bg = section.settings.badge_bg
  assign badge_text = section.settings.badge_text
  assign pad_y = section.settings.padding_y
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom
  assign speed = section.settings.speed
  assign wave_height = section.settings.wave_height
  assign wave_speed = section.settings.wave_speed
  assign gap = section.settings.gap
  assign card_w = section.settings.card_width
  assign radius = section.settings.border_radius
  assign pause = section.settings.pause_hover
  assign direction = section.settings.direction
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign heading_align = section.settings.heading_align
  assign total = section.blocks.size
-%}

{%- if total > 0 -%}
<div
  id="pwc-{{ sid }}"
  class="pwc{% if pause %} pwc--pause{% endif %}"
  style="
    --pwc-bg:{{ bg }};
    --pwc-text:{{ text_color }};
    --pwc-accent:{{ accent }};
    --pwc-card-bg:{{ card_bg }};
    --pwc-card-border:{{ card_border }};
    --pwc-price:{{ price_color }};
    --pwc-badge-bg:{{ badge_bg }};
    --pwc-badge-text:{{ badge_text }};
    --pwc-pad-y:{{ pad_y }}px;
    --pwc-mt:{{ mt }}px;
    --pwc-mb:{{ mb }}px;
    --pwc-speed:{{ speed }}s;
    --pwc-wave-h:{{ wave_height }}px;
    --pwc-wave-s:{{ wave_speed }}s;
    --pwc-gap:{{ gap }}px;
    --pwc-card-w:{{ card_w }}px;
    --pwc-radius:{{ radius }}px;
  "
>
  <div class="pwc__top">
    {%- if heading != blank or subheading != blank -%}
      <div class="pwc__header" style="text-align:{{ heading_align }}">
        {%- if heading != blank -%}
          <h2 class="pwc__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="pwc__sub">{{ subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="pwc__track">
    <div class="pwc__ribbon pwc__ribbon--{{ direction }}">
      {%- for pass in (1..3) -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign product = block.settings.product
            assign product_obj = all_products[product]
            assign title = block.settings.title
            assign price = block.settings.price
            assign badge = block.settings.badge
            assign img = block.settings.image
            assign link = block.settings.link

            if title == blank and product_obj != blank
              assign title = product_obj.title
            endif
            if price == blank and product_obj != blank
              assign price = product_obj.price | money
            endif
            if img == blank and product_obj != blank and product_obj.featured_image != blank
              assign img = product_obj.featured_image
            endif
            if link == blank and product_obj != blank
              assign link = product_obj.url
            endif
          -%}
          <div class="pwc__card" style="--pwc-wave-d:{{ forloop.index0 | times: 3 }};" {{ block.shopify_attributes }}>
            <a href="{{ link | default: '#' }}" class="pwc__card-link" {% if title != blank %}aria-label="{{ title | escape }}"{% endif %}>
              <div class="pwc__card-media">
                {%- if img != blank -%}
                  <img src="{{ img | image_url: width: 500 }}" alt="{{ title | escape }}" class="pwc__card-img" loading="lazy">
                {%- else -%}
                  <div class="pwc__card-ph">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                  </div>
                {%- endif -%}
                {%- if badge != blank -%}
                  <span class="pwc__badge">{{ badge }}</span>
                {%- endif -%}
              </div>
              {%- if title != blank or price != blank -%}
                <div class="pwc__card-info">
                  {%- if title != blank -%}
                    <h3 class="pwc__card-title">{{ title }}</h3>
                  {%- endif -%}
                  {%- if price != blank -%}
                    <span class="pwc__card-price">{{ price }}</span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </a>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "SIQ - Wave Carousel",
  "tag": "section",
  "class": "section-product-wave-carousel",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trending Now"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our most popular products, always in motion."
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Scroll Animation"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll speed",
      "min": 15,
      "max": 80,
      "step": 5,
      "default": 35,
      "unit": "s"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Wave Motion"
    },
    {
      "type": "range",
      "id": "wave_height",
      "label": "Wave height",
      "min": 4,
      "max": 30,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "wave_speed",
      "label": "Wave speed",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 3,
      "unit": "s"
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width",
      "min": 160,
      "max": 320,
      "step": 10,
      "default": 220,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 8,
      "max": 32,
      "step": 4,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Card radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#fafafa"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#6366f1"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#e2e8f0"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#0f172a"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge background",
      "default": "#ef4444"
    },
    {
      "type": "color",
      "id": "badge_text",
      "label": "Badge text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical padding",
      "min": 20,
      "max": 100,
      "step": 4,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Product Name"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$49.00"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SIQ - Wave Carousel",
      "blocks": [
        { "type": "product_card", "settings": { "title": "Premium Hoodie", "price": "$89.00", "badge": "New" } },
        { "type": "product_card", "settings": { "title": "Classic Sneakers", "price": "$129.00", "badge": "Hot" } },
        { "type": "product_card", "settings": { "title": "Leather Jacket", "price": "$249.00" } },
        { "type": "product_card", "settings": { "title": "Minimal Watch", "price": "$199.00", "badge": "Sale" } },
        { "type": "product_card", "settings": { "title": "Canvas Backpack", "price": "$69.00" } },
        { "type": "product_card", "settings": { "title": "Sunglasses Pro", "price": "$159.00", "badge": "Best Seller" } },
        { "type": "product_card", "settings": { "title": "Wool Beanie", "price": "$35.00" } },
        { "type": "product_card", "settings": { "title": "Running Shorts", "price": "$55.00" } }
      ]
    }
  ]
}
{% endschema %}

{% comment %}
  Section Hub – Footer Horizon v1.0
  Sleek horizontal-split footer with scroll-to-top, feature strip,
  accordion navigation on mobile, gradient newsletter, and trust bar.
  Prefix: fh-
{% endcomment %}

{%- liquid
  assign sid = section.id
  assign bg = section.settings.bg_color
  assign text_c = section.settings.text_color
  assign heading_c = section.settings.heading_color
  assign muted_c = section.settings.muted_color
  assign accent = section.settings.accent_color
  assign accent2 = section.settings.accent2_color
  assign border_c = section.settings.border_color

  assign brand_name = section.settings.brand_name
  assign brand_desc = section.settings.brand_text
  assign brand_logo = section.settings.brand_logo
  assign show_top_btn = section.settings.show_scroll_top

  assign nl_heading = section.settings.nl_heading
  assign nl_sub = section.settings.nl_sub
  assign nl_placeholder = section.settings.nl_placeholder
  assign nl_btn = section.settings.nl_button_text

  assign show_payments = section.settings.show_payments
  assign copyright = section.settings.copyright_text
  assign show_feature_strip = section.settings.show_feature_strip

  assign social_fb = section.settings.social_facebook
  assign social_ig = section.settings.social_instagram
  assign social_yt = section.settings.social_youtube
  assign social_tt = section.settings.social_tiktok
  assign social_tw = section.settings.social_twitter
  assign social_pt = section.settings.social_pinterest

  assign sec_width = section.settings.section_width
  assign pad_sides = section.settings.padding_sides
-%}

<style>
  #fh-{{ sid }}{
    --fh-bg:{{ bg }};
    --fh-text:{{ text_c }};
    --fh-heading:{{ heading_c }};
    --fh-muted:{{ muted_c }};
    --fh-accent:{{ accent }};
    --fh-accent2:{{ accent2 }};
    --fh-border:{{ border_c }};
    --fh-ps:{{ pad_sides }}px;
    --fh-max-w:{% if sec_width == 'full' %}100%{% elsif sec_width == 'wide' %}1400px{% else %}1200px{% endif %};
  }
</style>

<footer id="fh-{{ sid }}" class="fh-wrap">

  {%- comment -%} ── Feature Strip ── {%- endcomment -%}
  {%- if show_feature_strip -%}
    <div class="fh-strip">
      <div class="fh-inner fh-strip__inner">
        {%- for block in section.blocks -%}
          {%- if block.type == 'feature' -%}
            <div class="fh-strip__item" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <span class="fh-strip__icon">{{ block.settings.icon }}</span>
              {%- endif -%}
              <div class="fh-strip__text">
                {%- if block.settings.title != blank -%}
                  <strong class="fh-strip__title">{{ block.settings.title }}</strong>
                {%- endif -%}
                {%- if block.settings.desc != blank -%}
                  <span class="fh-strip__desc">{{ block.settings.desc }}</span>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ── Newsletter ── {%- endcomment -%}
  {%- assign has_newsletter = false -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'newsletter' -%}
      {%- assign has_newsletter = true -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if has_newsletter -%}
    <div class="fh-newsletter">
      <div class="fh-inner fh-newsletter__inner">
        <div class="fh-newsletter__content">
          {%- if nl_heading != blank -%}
            <h3 class="fh-newsletter__heading">{{ nl_heading }}</h3>
          {%- endif -%}
          {%- if nl_sub != blank -%}
            <p class="fh-newsletter__sub">{{ nl_sub }}</p>
          {%- endif -%}
        </div>
        {%- form 'customer', id: 'fh-nl-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="fh-newsletter__form">
            <input type="email" name="contact[email]" class="fh-newsletter__input" placeholder="{{ nl_placeholder }}" required autocomplete="email">
            <button type="submit" class="fh-newsletter__btn">{{ nl_btn }}</button>
          </div>
        {%- endform -%}
      </div>
      <div class="fh-newsletter__gradient"></div>
    </div>
  {%- endif -%}

  {%- comment -%} ── Main Body ── {%- endcomment -%}
  <div class="fh-body">
    <div class="fh-inner">
      <div class="fh-main">

        {%- comment -%} Left: Brand + Social {%- endcomment -%}
        <div class="fh-left">
          {%- if brand_logo != blank -%}
            <img src="{{ brand_logo | image_url: width: 400 }}" alt="{{ brand_name | escape }}" class="fh-brand__logo" loading="lazy">
          {%- endif -%}
          {%- if brand_name != blank -%}
            <h3 class="fh-brand__name">{{ brand_name }}</h3>
          {%- endif -%}
          {%- if brand_desc != blank -%}
            <p class="fh-brand__desc">{{ brand_desc }}</p>
          {%- endif -%}

          {%- if social_fb != blank or social_ig != blank or social_yt != blank or social_tt != blank or social_tw != blank or social_pt != blank -%}
            <div class="fh-social">
              {%- if social_fb != blank -%}
                <a href="{{ social_fb }}" class="fh-social__link" aria-label="Facebook" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9.198 21.5h4v-8.01h3.604l.396-3.98h-4V7.5a1 1 0 0 1 1-1h3v-4h-3a5 5 0 0 0-5 5v2.01h-2l-.396 3.98h2.396v8.01Z"/></svg>
                </a>
              {%- endif -%}
              {%- if social_ig != blank -%}
                <a href="{{ social_ig }}" class="fh-social__link" aria-label="Instagram" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"/></svg>
                </a>
              {%- endif -%}
              {%- if social_yt != blank -%}
                <a href="{{ social_yt }}" class="fh-social__link" aria-label="YouTube" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.9 31.9 0 0 0 0 12a31.9 31.9 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1c.3-1.9.5-3.8.5-5.8s-.2-3.9-.5-5.8ZM9.5 15.6V8.4l6.3 3.6-6.3 3.6Z"/></svg>
                </a>
              {%- endif -%}
              {%- if social_tt != blank -%}
                <a href="{{ social_tt }}" class="fh-social__link" aria-label="TikTok" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1 0-5.78 2.9 2.9 0 0 1 .88.14V9.01a6.35 6.35 0 0 0-1-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V9.65a8.35 8.35 0 0 0 4.88 1.56V7.76a4.82 4.82 0 0 1-1-1.07Z"/></svg>
                </a>
              {%- endif -%}
              {%- if social_tw != blank -%}
                <a href="{{ social_tw }}" class="fh-social__link" aria-label="X / Twitter" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>
              {%- endif -%}
              {%- if social_pt != blank -%}
                <a href="{{ social_pt }}" class="fh-social__link" aria-label="Pinterest" target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0a12 12 0 0 0-4.37 23.17c-.1-.94-.2-2.4.04-3.44l1.4-5.93s-.35-.72-.35-1.78c0-1.67.96-2.92 2.17-2.92 1.02 0 1.52.77 1.52 1.69 0 1.03-.66 2.57-.99 3.99-.28 1.19.59 2.15 1.76 2.15 2.12 0 3.75-2.23 3.75-5.47 0-2.86-2.05-4.86-4.99-4.86-3.39 0-5.39 2.55-5.39 5.18 0 1.03.39 2.13.89 2.73.1.12.11.22.08.34l-.33 1.36c-.05.22-.18.27-.41.16-1.55-.72-2.52-2.99-2.52-4.81 0-3.92 2.85-7.52 8.21-7.52 4.31 0 7.66 3.07 7.66 7.17 0 4.28-2.7 7.72-6.44 7.72-1.26 0-2.44-.65-2.85-1.43l-.77 2.96c-.28 1.08-1.04 2.43-1.55 3.26A12 12 0 1 0 12 0Z"/></svg>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} Right: Nav columns with accordion on mobile {%- endcomment -%}
        <div class="fh-right">
          {%- for block in section.blocks -%}
            {%- if block.type == 'nav_column' -%}
              <div class="fh-nav" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <button class="fh-nav__toggle" aria-expanded="false" type="button">
                    <span class="fh-nav__heading">{{ block.settings.heading }}</span>
                    <svg class="fh-nav__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                  </button>
                {%- endif -%}
                <ul class="fh-nav__list">
                  {%- if block.settings.link1_text != blank -%}
                    <li><a href="{{ block.settings.link1_url }}" class="fh-nav__link">{{ block.settings.link1_text }}</a></li>
                  {%- endif -%}
                  {%- if block.settings.link2_text != blank -%}
                    <li><a href="{{ block.settings.link2_url }}" class="fh-nav__link">{{ block.settings.link2_text }}</a></li>
                  {%- endif -%}
                  {%- if block.settings.link3_text != blank -%}
                    <li><a href="{{ block.settings.link3_url }}" class="fh-nav__link">{{ block.settings.link3_text }}</a></li>
                  {%- endif -%}
                  {%- if block.settings.link4_text != blank -%}
                    <li><a href="{{ block.settings.link4_url }}" class="fh-nav__link">{{ block.settings.link4_text }}</a></li>
                  {%- endif -%}
                  {%- if block.settings.link5_text != blank -%}
                    <li><a href="{{ block.settings.link5_url }}" class="fh-nav__link">{{ block.settings.link5_text }}</a></li>
                  {%- endif -%}
                  {%- if block.settings.link6_text != blank -%}
                    <li><a href="{{ block.settings.link6_url }}" class="fh-nav__link">{{ block.settings.link6_text }}</a></li>
                  {%- endif -%}
                </ul>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

      </div>
    </div>
  </div>

  {%- comment -%} ── Bottom Bar ── {%- endcomment -%}
  <div class="fh-bottom">
    <div class="fh-inner fh-bottom__inner">
      <div class="fh-bottom__left">
        {%- if copyright != blank -%}
          {%- assign yr = 'now' | date: '%Y' -%}
          <p class="fh-bottom__copy">{{ copyright | replace: '[year]', yr }}</p>
        {%- else -%}
          <p class="fh-bottom__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
        {%- endif -%}
      </div>
      {%- if show_payments -%}
        <div class="fh-bottom__pay">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ── Scroll to Top ── {%- endcomment -%}
  {%- if show_top_btn -%}
    <button class="fh-top" aria-label="Scroll to top" data-fh-top onclick="window.scrollTo({top:0,behavior:'smooth'})">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
    </button>
  {%- endif -%}

</footer>

<script>
(function(){
  /* Accordion toggle on mobile */
  var wrap = document.getElementById('fh-{{ sid }}');
  if(!wrap) return;
  var toggles = wrap.querySelectorAll('.fh-nav__toggle');
  toggles.forEach(function(btn){
    btn.addEventListener('click', function(){
      var expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      var list = btn.nextElementSibling;
      if(list){
        list.style.maxHeight = expanded ? '0' : list.scrollHeight + 'px';
      }
    });
  });

  /* Scroll to top visibility */
  var topBtn = wrap.querySelector('[data-fh-top]');
  if(topBtn){
    function checkScroll(){
      if(window.scrollY > 400){
        topBtn.classList.add('fh-top--visible');
      } else {
        topBtn.classList.remove('fh-top--visible');
      }
    }
    window.addEventListener('scroll', checkScroll, {passive:true});
    checkScroll();
  }
})();
</script>


{% comment %}
  SectionHub – Morphing Panels Slider  (smp-)
  Accordion panels that morph between collapsed/expanded states
{% endcomment %}

{%- assign sid = section.id -%}
{%- assign heading_font = section.settings.heading_font -%}
{%- assign body_font    = section.settings.body_font -%}

<style>
  {{ heading_font | font_face }}
  {{ body_font | font_face }}

  #smp-{{ sid }} {
    --smp-bg: {{ section.settings.bg_color }};
    --smp-accent: {{ section.settings.accent_color }};
    --smp-heading-color: {{ section.settings.heading_color }};
    --smp-text-color: {{ section.settings.text_color }};
    --smp-heading-ff: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --smp-heading-fw: {{ heading_font.weight }};
    --smp-heading-fs: {{ heading_font.style }};
    --smp-body-ff: {{ body_font.family }}, {{ body_font.fallback_families }};
    --smp-body-fw: {{ body_font.weight }};
    --smp-height: {{ section.settings.panel_height }}vh;
    --smp-radius: {{ section.settings.panel_radius }}px;
    --smp-gap: {{ section.settings.panel_gap }}px;
    --smp-py: {{ section.settings.padding_y }}px;
    --smp-px: {{ section.settings.padding_x }}px;
    --smp-overlay: {{ section.settings.overlay_color }};
    --smp-overlay-o: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
</style>

<section id="smp-{{ sid }}" class="smp-wrap" data-smp-reveal>
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subtext != blank -%}
    <div class="smp-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="smp-header__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="smp-header__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="smp-header__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="smp-panels" data-smp-panels>
    {%- for block in section.blocks -%}
      {%- assign is_first = false -%}
      {%- if forloop.first -%}{%- assign is_first = true -%}{%- endif -%}
      <div class="smp-panel{% if is_first %} smp-panel--active{% endif %}"
           data-smp-panel="{{ forloop.index0 }}"
           {{ block.shopify_attributes }}>

        <div class="smp-panel__media">
          {%- if block.settings.image != blank -%}
            <img
              class="smp-panel__img"
              src="{{ block.settings.image | image_url: width: 1200 }}"
              srcset="{{ block.settings.image | image_url: width: 600 }} 600w,
                      {{ block.settings.image | image_url: width: 900 }} 900w,
                      {{ block.settings.image | image_url: width: 1200 }} 1200w,
                      {{ block.settings.image | image_url: width: 1600 }} 1600w"
              sizes="(max-width:768px) 100vw, 60vw"
              alt="{{ block.settings.image.alt | escape }}"
              loading="lazy"
            >
          {%- else -%}
            <div class="smp-panel__placeholder">
              <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
            </div>
          {%- endif -%}
          <div class="smp-panel__overlay"></div>
        </div>

        <div class="smp-panel__collapsed">
          <span class="smp-panel__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <span class="smp-panel__vtitle">{{ block.settings.heading | default: 'Panel' }}</span>
        </div>

        <div class="smp-panel__content">
          {%- if block.settings.tag != blank -%}
            <span class="smp-panel__tag">{{ block.settings.tag }}</span>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h3 class="smp-panel__heading">{{ block.settings.heading }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="smp-panel__text">{{ block.settings.text }}</p>
          {%- endif -%}
          {%- if block.settings.btn_text != blank -%}
            <a class="smp-panel__btn" href="{{ block.settings.btn_link }}">
              {{ block.settings.btn_text }}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.show_counter -%}
    <div class="smp-counter">
      <span class="smp-counter__cur" data-smp-cur>01</span>
      <span class="smp-counter__sep">&mdash;</span>
      <span class="smp-counter__tot">{{ section.blocks.size | prepend: '0' | slice: -2, 2 }}</span>
    </div>
  {%- endif -%}

  {%- if section.settings.show_progress -%}
    <div class="smp-progress">
      <div class="smp-progress__bar" data-smp-bar></div>
    </div>
  {%- endif -%}
</section>

<script>
  (function(){
    var wrap   = document.getElementById('smp-{{ sid }}');
    if(!wrap) return;

    var panels = Array.from(wrap.querySelectorAll('[data-smp-panel]'));
    var curEl  = wrap.querySelector('[data-smp-cur]');
    var barEl  = wrap.querySelector('[data-smp-bar]');
    var count  = panels.length;
    if(count === 0) return;

    var active    = 0;
    var autoTimer = null;
    var auto      = {{ section.settings.autoplay | json }};
    var speed     = {{ section.settings.autoplay_speed }} * 1000;

    function goTo(idx){
      active = ((idx % count) + count) % count;

      panels.forEach(function(p, i){
        if(i === active){
          p.classList.add('smp-panel--active');
        } else {
          p.classList.remove('smp-panel--active');
        }
      });

      if(curEl){
        var num = active + 1;
        curEl.textContent = num < 10 ? '0' + num : '' + num;
      }
      if(barEl){
        barEl.style.width = ((active + 1) / count * 100) + '%';
      }
    }

    /* click to expand */
    panels.forEach(function(p, i){
      p.addEventListener('click', function(){
        if(i !== active){ goTo(i); startAuto(); }
      });
    });

    /* autoplay */
    function startAuto(){
      stopAuto();
      if(!auto) return;
      autoTimer = setInterval(function(){ goTo(active + 1); }, speed);
    }
    function stopAuto(){ clearInterval(autoTimer); }

    /* keyboard */
    wrap.setAttribute('tabindex', '0');
    wrap.addEventListener('keydown', function(e){
      if(e.key === 'ArrowRight' || e.key === 'ArrowDown'){ goTo(active + 1); startAuto(); }
      if(e.key === 'ArrowLeft' || e.key === 'ArrowUp'){ goTo(active - 1); startAuto(); }
    });

    /* touch swipe */
    var tx = 0;
    wrap.addEventListener('touchstart', function(e){ tx = e.touches[0].clientX; }, {passive:true});
    wrap.addEventListener('touchend', function(e){
      var dx = e.changedTouches[0].clientX - tx;
      if(Math.abs(dx) > 40){
        if(dx < 0) goTo(active + 1); else goTo(active - 1);
        startAuto();
      }
    }, {passive:true});

    /* scroll reveal */
    if('IntersectionObserver' in window){
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(en){
          if(en.isIntersecting){
            en.target.classList.add('smp-visible');
            goTo(0);
            startAuto();
            io.unobserve(en.target);
          }
        });
      }, {threshold: 0.15});
      io.observe(wrap);
    } else {
      wrap.classList.add('smp-visible');
      goTo(0);
      startAuto();
    }
  })();
</script>

{% schema %}
{
  "name": "SIQ - Morph Panels",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Portfolio"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Selected projects"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Explore our curated selection of recent work spanning identity, interiors, and architecture."
    },
    {
      "type": "header",
      "content": "Panel Layout"
    },
    {
      "type": "range",
      "id": "panel_height",
      "label": "Panel Height (vh)",
      "min": 40,
      "max": 90,
      "step": 5,
      "default": 65,
      "unit": "vh"
    },
    {
      "type": "range",
      "id": "panel_gap",
      "label": "Panel Gap (px)",
      "min": 0,
      "max": 16,
      "step": 2,
      "default": 6,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "panel_radius",
      "label": "Border Radius (px)",

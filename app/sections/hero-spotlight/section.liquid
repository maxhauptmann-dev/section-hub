      "label": "Mesh blob 1 color",
      "default": "#6c63ff"
    },
    {
      "type": "color",
      "id": "mesh_color2",
      "label": "Mesh blob 2 color",
      "default": "#c9a96e"
    },
    {
      "type": "range",
      "id": "mesh_blur",
      "label": "Mesh blur",
      "min": 40,
      "max": 200,
      "step": 20,
      "default": 100,
      "unit": "px"
    },
    {
      "type": "range",

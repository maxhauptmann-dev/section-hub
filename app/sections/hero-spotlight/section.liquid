      "type": "checkbox",
      "id": "enable_noise",
      "label": "Enable noise texture",
      "default": true
    },
    {
      "type": "range",
      "id": "noise_opacity",
      "label": "Noise opacity",
      "min": 2,
      "max": 15,
      "step": 1,
      "default": 5,
      "unit": "%"
    },
    {
      "type": "header",

{% comment %}
  SectionHub – Featured Collection Storyboard  (fcb-)
  Horizontal-scroll filmstrip with snap panels
{% endcomment %}

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font    = section.settings.body_font
  assign col          = section.settings.collection
  assign col_obj      = collections[col]
  assign limit        = section.settings.products_limit
  assign show_vendor  = section.settings.show_vendor
  assign show_price   = section.settings.show_price
  assign show_badge   = section.settings.show_sale_badge
  assign overlay_pos  = section.settings.overlay_position
-%}

<style>
  {{ heading_font | font_face }}
  {{ body_font | font_face }}

  #fcb-{{ section.id }} {
    --fcb-bg: {{ section.settings.bg_color }};
    --fcb-heading-c: {{ section.settings.heading_color }};
    --fcb-text-c: {{ section.settings.text_color }};
    --fcb-accent: {{ section.settings.accent_color }};
    --fcb-badge-bg: {{ section.settings.badge_color }};
    --fcb-heading-ff: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --fcb-heading-fw: {{ heading_font.weight }};
    --fcb-heading-fs: {{ heading_font.style }};
    --fcb-body-ff: {{ body_font.family }}, {{ body_font.fallback_families }};
    --fcb-body-fw: {{ body_font.weight }};
    --fcb-radius: {{ section.settings.card_radius }}px;
    --fcb-panel-h: {{ section.settings.panel_height }}px;
    --fcb-py: {{ section.settings.padding_top }}px;
    --fcb-pb: {{ section.settings.padding_bottom }}px;
    --fcb-px: {{ section.settings.padding_sides }}px;
    --fcb-max-w: {{ section.settings.max_width }}px;
    --fcb-overlay-bg: rgba({{ section.settings.overlay_color | color_extract: 'red' }}, {{ section.settings.overlay_color | color_extract: 'green' }}, {{ section.settings.overlay_color | color_extract: 'blue' }}, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
  }
</style>

<section id="fcb-{{ section.id }}" class="fcb-wrap">

  {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subtext != blank -%}
    <div class="fcb-header" data-fcb-el>
      {%- if section.settings.eyebrow != blank -%}
        <span class="fcb-header__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="fcb-header__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="fcb-header__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if col_obj != blank and col_obj.products_count > 0 -%}

    <div class="fcb-filmstrip" data-fcb-strip>
      <div class="fcb-track" data-fcb-track>
        {%- for product in col_obj.products limit: limit -%}
          <div class="fcb-panel" data-fcb-panel>
            {%- comment -%} Background image {%- endcomment -%}
            <div class="fcb-panel__bg">
              {%- if product.featured_image -%}
                <img
                  src="{{ product.featured_image | image_url: width: 1200 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  class="fcb-panel__img"
                >
              {%- else -%}
                <div class="fcb-panel__placeholder">
                  {{ 'product-1' | placeholder_svg_tag: 'fcb-panel__svg' }}
                </div>
              {%- endif -%}
              <div class="fcb-panel__gradient"></div>
            </div>

            {%- if show_badge -%}
              {%- if product.compare_at_price > product.price -%}
                <span class="fcb-badge">Sale</span>
              {%- endif -%}
            {%- endif -%}

            {%- comment -%} Glassmorphism info card {%- endcomment -%}
            <div class="fcb-panel__card fcb-panel__card--{{ overlay_pos }}">
              <span class="fcb-panel__counter">{{ forloop.index }} / {{ limit }}</span>
              {%- if show_vendor and product.vendor != blank -%}
                <span class="fcb-panel__vendor">{{ product.vendor }}</span>
              {%- endif -%}
              <h3 class="fcb-panel__title">{{ product.title }}</h3>
              {%- if show_price -%}
                <div class="fcb-panel__price">
                  {%- if product.compare_at_price > product.price -%}
                    <span class="fcb-panel__price-old">{{ product.compare_at_price | money }}</span>
                  {%- endif -%}
                  <span class="fcb-panel__price-now">{{ product.price | money }}</span>
                </div>
              {%- endif -%}
              <a href="{{ product.url }}" class="fcb-panel__btn">
                {{ section.settings.btn_text }}
                <span class="fcb-panel__arrow">→</span>
              </a>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- comment -%} Progress bar {%- endcomment -%}
      <div class="fcb-progress">
        <div class="fcb-progress__bar" data-fcb-bar></div>
      </div>

      {%- comment -%} Navigation {%- endcomment -%}
      <div class="fcb-controls">
        <button class="fcb-ctrl fcb-ctrl--prev" data-fcb-prev aria-label="Previous">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18L9 12L15 6"/></svg>
        </button>
        <span class="fcb-controls__count" data-fcb-count>1 / {{ limit }}</span>
        <button class="fcb-ctrl fcb-ctrl--next" data-fcb-next aria-label="Next">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18L15 12L9 6"/></svg>
        </button>
      </div>
    </div>

    {%- if section.settings.shop_all_text != blank -%}
      <div class="fcb-footer" data-fcb-el>
        <a href="{{ col_obj.url }}" class="fcb-footer__link">
          {{ section.settings.shop_all_text }} →
        </a>
      </div>
    {%- endif -%}

  {%- else -%}
    <div class="fcb-empty" data-fcb-el>
      <p class="fcb-empty__text">Select a collection to display products.</p>
    </div>
  {%- endif -%}

</section>

<script>
(function(){
  var wrap = document.getElementById('fcb-{{ section.id }}');
  if (!wrap) return;

  /* Reveal */
  var obs = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (e.isIntersecting){ e.target.classList.add('fcb-visible'); obs.unobserve(e.target); }
    });
  }, { threshold: 0.1 });
  wrap.querySelectorAll('[data-fcb-el]').forEach(function(el){ obs.observe(el); });

  var track = wrap.querySelector('[data-fcb-track]');
  var panels = wrap.querySelectorAll('[data-fcb-panel]');
  var bar = wrap.querySelector('[data-fcb-bar]');
  var countEl = wrap.querySelector('[data-fcb-count]');
  var prevBtn = wrap.querySelector('[data-fcb-prev]');
  var nextBtn = wrap.querySelector('[data-fcb-next]');
  var total = panels.length;
  if (!track || total === 0) return;

  function updateProgress(){
    var maxScroll = track.scrollWidth - track.clientWidth;
    if (maxScroll <= 0) return;
    var pct = (track.scrollLeft / maxScroll) * 100;
    if (bar) bar.style.width = pct + '%';

    /* Determine current panel */
    var panelW = panels[0].offsetWidth;
    var idx = Math.round(track.scrollLeft / panelW);
    if (idx < 0) idx = 0;
    if (idx >= total) idx = total - 1;
    if (countEl) countEl.textContent = (idx + 1) + ' / ' + total;
  }

  track.addEventListener('scroll', updateProgress);
  updateProgress();

  var scrollAmt = function(){ return panels[0] ? panels[0].offsetWidth : 400; };
  if (prevBtn) prevBtn.addEventListener('click', function(){ track.scrollBy({ left: -scrollAmt(), behavior: 'smooth' }); });
  if (nextBtn) nextBtn.addEventListener('click', function(){ track.scrollBy({ left: scrollAmt(), behavior: 'smooth' }); });

  /* Keyboard */
  wrap.setAttribute('tabindex', '0');
  wrap.addEventListener('keydown', function(e){
    if (e.key === 'ArrowLeft') { track.scrollBy({ left: -scrollAmt(), behavior: 'smooth' }); e.preventDefault(); }
    if (e.key === 'ArrowRight') { track.scrollBy({ left: scrollAmt(), behavior: 'smooth' }); e.preventDefault(); }
  });
})();
</script>

{% schema %}
{
  "name": "FC Storyboard",
  "tag": "section",
  "class": "fcb-section",
  "settings": [
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Max products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Scroll The Collection"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Every product tells a story. Swipe to explore."
    },
    {
      "type": "header",
      "content": "Panels"
    },
    {
      "type": "range",
      "id": "panel_height",
      "label": "Panel height",
      "min": 350,
      "max": 650,
      "step": 10,
      "default": 480,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Panel radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "overlay_position",
      "label": "Info card position",
      "options": [
        { "value": "bl", "label": "Bottom Left" },
        { "value": "br", "label": "Bottom Right" },
        { "value": "tl", "label": "Top Left" },
        { "value": "tr", "label": "Top Right" }
      ],
      "default": "bl"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max section width",
      "min": 900,
      "max": 1600,
      "step": 20,
      "default": 1300,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay tint",
      "default": "#0a0a1e"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 10,
      "max": 80,
      "step": 5,
      "default": 50,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Product Details"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sale_badge",
      "label": "Show sale badge",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button text",
      "default": "View Product"
    },
    {
      "type": "text",
      "id": "shop_all_text",
      "label": "Shop All link text",
      "default": "Explore Full Collection"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "space_grotesk_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "inter_n4"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#1a1a2e"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#f0f0f8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text",
      "default": "#9090aa"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#e8c170"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Sale badge",
      "default": "#ef4444"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 20,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_sides",
      "label": "Side padding",
      "min": 16,
      "max": 80,
      "step": 4,
      "default": 28,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "SS - FC Storyboard",
      "settings": {
        "eyebrow": "The Story",
        "heading": "Scroll The Collection",
        "subtext": "Every product tells a story. Swipe to explore.",
        "products_limit": 6,
        "panel_height": 480,
        "overlay_position": "bl",
        "overlay_opacity": 50,
        "show_vendor": true,
        "show_price": true,
        "show_sale_badge": true,
        "btn_text": "View Product",
        "shop_all_text": "Explore Full Collection"
      }
    }
  ]
}
{% endschema %}

{% comment %}
  Section Hub – Trust Badges
  Display trust signals with icons. Flexible column layout with
  full color, spacing, and typography controls.
{% endcomment %}

{{ 'section-trust-badges.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign cols   = section.settings.columns
  assign cols_m = section.settings.columns_mobile
  assign layout = section.settings.layout
-%}

<section
  class="sh-trust sh-trust--{{ layout }}"
  style="
    --sh-trust-bg: {{ section.settings.background_color }};
    --sh-trust-text: {{ section.settings.text_color }};
    --sh-trust-accent: {{ section.settings.accent_color }};
    --sh-trust-icon-size: {{ section.settings.icon_size }}px;
    --sh-trust-cols: {{ cols }};
    --sh-trust-cols-m: {{ cols_m }};
    --sh-trust-gap: {{ section.settings.gap }}px;
    --sh-trust-pad-y: {{ section.settings.padding_y }}px;
    --sh-trust-pad-x: {{ section.settings.padding_x }}px;
    --sh-trust-border: {{ section.settings.border_color }};
    --sh-trust-title-size: {{ section.settings.title_size }}px;
    --sh-trust-desc-size: {{ section.settings.description_size }}px;
    --sh-trust-radius: {{ section.settings.card_roundness }}px;
  "
>
  <div class="sh-trust__container">
    {% if section.settings.heading != blank %}
      <div class="sh-trust__header">
        {% if section.settings.eyebrow != blank %}
          <span class="sh-trust__eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        <h2 class="sh-trust__heading">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="sh-trust__grid">
      {% for block in section.blocks %}
        <div class="sh-trust__item" {{ block.shopify_attributes }}>
          {% if block.settings.icon != 'none' %}
            <div class="sh-trust__icon">
              {% case block.settings.icon %}
                {% when 'shipping' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                {% when 'secure' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
                {% when 'return' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
                {% when 'support' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                {% when 'quality' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                {% when 'gift' %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13"/><path d="M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7"/><path d="M7.5 8a2.5 2.5 0 0 1 0-5C9 3 12 8 12 8s3-5 4.5-5a2.5 2.5 0 0 1 0 5"/></svg>
              {% endcase %}
            </div>
          {% endif %}

          {% if block.settings.custom_image != blank %}
            <div class="sh-trust__custom-icon">
              <img
                src="{{ block.settings.custom_image | image_url: width: 120 }}"
                alt="{{ block.settings.title | escape }}"
                width="60"
                height="60"
                loading="lazy"
              >
            </div>
          {% endif %}

          {% if block.settings.title != blank %}
            <h3 class="sh-trust__title">{{ block.settings.title }}</h3>
          {% endif %}
          {% if block.settings.description != blank %}
            <p class="sh-trust__desc">{{ block.settings.description }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SIQ - Trust Badges",
  "tag": "section",
  "class": "sh-trust-root",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout Style",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "inline", "label": "Inline Row" },
        { "value": "cards", "label": "Cards" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns – Desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns – Mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon Size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "card_roundness",
      "label": "Card Roundness",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_x",
      "label": "Horizontal Padding",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title Size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description Size",
      "min": 11,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / Icon Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#e5e7eb"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "shipping", "label": "Shipping" },
            { "value": "secure", "label": "Secure" },
            { "value": "return", "label": "Return" },
            { "value": "support", "label": "Support" },
            { "value": "quality", "label": "Quality" },
            { "value": "gift", "label": "Gift" }
          ],
          "default": "shipping"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Icon Image",
          "info": "Overrides the built-in icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "On all orders over $50"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SIQ - Trust Badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "shipping", "title": "Free Shipping", "description": "On orders over $50" } },
        { "type": "badge", "settings": { "icon": "secure", "title": "Secure Payment", "description": "256-bit SSL encryption" } },
        { "type": "badge", "settings": { "icon": "return", "title": "Easy Returns", "description": "30-day return policy" } },
        { "type": "badge", "settings": { "icon": "support", "title": "24/7 Support", "description": "We're here to help" } }
      ]
    }
  ]
}
{% endschema %}

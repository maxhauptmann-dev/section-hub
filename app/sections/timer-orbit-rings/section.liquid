    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Our next big thing is almost here. Be the first to experience something extraordinary."
    },
    {
      "type": "header",
      "content": "Target Date"
    },
    {
      "type": "range",
      "id": "target_year",
      "label": "Year",
      "min": 2025,
      "max": 2030,
      "step": 1,
      "default": 2026
    },
    {
      "type": "range",
      "id": "target_month",
      "label": "Month",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "target_day",
      "label": "Day",
      "min": 1,
      "max": 31,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "target_hour",
      "label": "Hour",
      "min": 0,
      "max": 23,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "target_minute",
      "label": "Minute",
      "min": 0,
      "max": 59,
      "step": 1,
      "default": 0
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "label_days",
      "label": "Days Label",
      "default": "Days"
    },
    {
      "type": "text",
      "id": "label_hours",
      "label": "Hours Label",
      "default": "Hours"
    },
    {
      "type": "text",
      "id": "label_minutes",
      "label": "Minutes Label",
      "default": "Minutes"
    },
    {
      "type": "text",
      "id": "label_seconds",

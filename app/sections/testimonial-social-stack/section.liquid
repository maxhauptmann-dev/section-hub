{{ 'section-testimonial-social-stack.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id
  assign bg = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign accent = section.settings.accent_color
  assign card_bg = section.settings.card_bg
  assign card_border = section.settings.card_border
  assign quote_color = section.settings.quote_color
  assign name_color = section.settings.name_color
  assign handle_color = section.settings.handle_color
  assign meta_color = section.settings.meta_color
  assign like_color = section.settings.like_color
  assign verified_color = section.settings.verified_color
  assign max_w = section.settings.max_width
  assign pad_y = section.settings.padding_y
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom
  assign q_size = section.settings.quote_size
  assign radius = section.settings.border_radius
  assign columns = section.settings.columns
  assign gap = section.settings.gap
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign heading_align = section.settings.heading_align
  assign show_likes = section.settings.show_likes
  assign show_reactions = section.settings.show_reactions
  assign show_date = section.settings.show_date
  assign show_verified = section.settings.show_verified
  assign show_source = section.settings.show_source
  assign card_shadow = section.settings.card_shadow
  assign hover_lift = section.settings.hover_lift
  assign layout = section.settings.layout
-%}

<div
  id="ts-stack-{{ sid }}"
  class="ts-stack"
  style="
    --ts-bg:{{ bg }};
    --ts-text:{{ text_color }};
    --ts-accent:{{ accent }};
    --ts-card-bg:{{ card_bg }};
    --ts-card-border:{{ card_border }};
    --ts-quote:{{ quote_color }};
    --ts-name:{{ name_color }};
    --ts-handle:{{ handle_color }};
    --ts-meta:{{ meta_color }};
    --ts-like:{{ like_color }};
    --ts-verified:{{ verified_color }};
    --ts-max-w:{{ max_w }}px;
    --ts-pad-y:{{ pad_y }}px;
    --ts-mt:{{ mt }}px;
    --ts-mb:{{ mb }}px;
    --ts-q-size:{{ q_size }}px;
    --ts-radius:{{ radius }}px;
    --ts-cols:{{ columns }};
    --ts-gap:{{ gap }}px;
  "
>
  <div class="ts-stack__inner">
    {%- if heading != blank or subheading != blank -%}
      <div class="ts-stack__header" style="text-align:{{ heading_align }}">
        {%- if heading != blank -%}
          <h2 class="ts-stack__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="ts-stack__sub">{{ subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="ts-stack__grid{% if layout == 'masonry' %} ts-stack__grid--masonry{% endif %}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign quote = block.settings.quote
          assign name = block.settings.name
          assign handle = block.settings.handle
          assign date = block.settings.date
          assign likes = block.settings.likes
          assign reaction = block.settings.reaction
          assign source = block.settings.source
          assign verified = block.settings.verified
          assign photo = block.settings.photo
        -%}
        <div
          class="ts-stack__card{% if card_shadow %} ts-stack__card--shadow{% endif %}{% if hover_lift %} ts-stack__card--lift{% endif %}"
          {{ block.shopify_attributes }}
        >
          <!-- Post header -->
          <div class="ts-stack__post-header">
            {%- if photo != blank -%}
              <img
                class="ts-stack__avatar"
                src="{{ photo | image_url: width: 80 }}"
                alt="{{ name | escape }}"
                width="40"
                height="40"
                loading="lazy"
              >
            {%- else -%}
              <span class="ts-stack__avatar-ph">{{ name | slice: 0, 1 }}</span>
            {%- endif -%}
            <div class="ts-stack__user-info">
              <div class="ts-stack__name-row">
                <span class="ts-stack__name">{{ name }}</span>
                {%- if show_verified and verified -%}
                  <svg class="ts-stack__verified" width="16" height="16" viewBox="0 0 24 24" fill="var(--ts-verified)"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" fill="var(--ts-verified)"/><path d="M9 12l2 2 4-4" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
                {%- endif -%}
              </div>
              {%- if handle != blank -%}
                <span class="ts-stack__handle">{{ handle }}</span>
              {%- endif -%}
            </div>
            {%- if show_source and source != blank -%}
              <span class="ts-stack__source">{{ source }}</span>
            {%- endif -%}
          </div>

          <!-- Post body -->
          <p class="ts-stack__quote">{{ quote }}</p>

          <!-- Post footer -->
          <div class="ts-stack__footer">
            {%- if show_likes and likes != blank -%}
              <span class="ts-stack__likes">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="var(--ts-like)" stroke="none"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
                {{ likes }}
              </span>
            {%- endif -%}
            {%- if show_reactions and reaction != blank -%}
              <span class="ts-stack__reaction">{{ reaction }}</span>
            {%- endif -%}
            {%- if show_date and date != blank -%}
              <span class="ts-stack__date">{{ date }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>


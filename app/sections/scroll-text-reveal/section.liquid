{% comment %} SIQ - Scroll Text Reveal {% endcomment %}

{%- liquid
  assign str_id = 'str-' | append: section.id

  assign str_fw = 400
  if section.settings.font_weight == 'medium'
    assign str_fw = 500
  elsif section.settings.font_weight == 'semibold'
    assign str_fw = 600
  elsif section.settings.font_weight == 'bold'
    assign str_fw = 700
  elsif section.settings.font_weight == 'black'
    assign str_fw = 900
  endif
-%}

<style>
  #{{ str_id }} {
    --str-bg: {{ section.settings.bg_color }};
    --str-lit: {{ section.settings.text_color }};
    --str-muted: {{ section.settings.muted_color }};
    --str-fs: {{ section.settings.font_size_desktop }}px;
    --str-fs-m: {{ section.settings.font_size_mobile }}px;
    --str-fw: {{ str_fw }};
    --str-lh: calc({{ section.settings.line_height }} / 100);
    --str-max-w: {{ section.settings.max_width }}px;
    --str-py: {{ section.settings.padding_y }}px;
    --str-px: {{ section.settings.padding_x }}px;
    --str-py-m: {{ section.settings.padding_y_mobile }}px;
    --str-px-m: {{ section.settings.padding_x_mobile }}px;
    --str-align: {{ section.settings.text_align }};
  }
</style>

<section id="{{ str_id }}" class="str" data-str-root>
  <div class="str__content">
    {%- for block in section.blocks %}
      {%- if block.type == 'text' %}
        <div class="str__text" data-str-block {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
      {%- endif %}
    {%- endfor %}
  </div>
</section>

<script>
(function(){
  var root = document.querySelector('#{{ str_id }}[data-str-root]');
  if (!root) return;

  /* ── Step 1: split every text block into character spans via JS ── */
  var blocks = root.querySelectorAll('[data-str-block]');
  blocks.forEach(function(block) {
    var raw = block.textContent;
    block.innerHTML = '';
    for (var i = 0; i < raw.length; i++) {
      var ch = raw[i];
      if (ch === ' ') {
        var sp = document.createElement('span');
        sp.className = 'str__space';
        sp.textContent = ' ';
        block.appendChild(sp);
      } else {
        var s = document.createElement('span');
        s.className = 'str__char';
        s.textContent = ch;
        block.appendChild(s);
      }
    }
  });

  /* on mobile: just light every char and stop */
  if (window.matchMedia('(max-width: 767px)').matches) {
    root.querySelectorAll('.str__char').forEach(function(c){ c.classList.add('is-lit'); });
    return;
  }

  var chars = root.querySelectorAll('.str__char');
  var total = chars.length;
  if (total === 0) return;

  /* ── group characters into visual lines by their offsetTop ── */
  var lines = [];      /* array of { top, chars[] } */
  var currentTop = -1;

  function buildLines() {
    lines = [];
    currentTop = -1;
    for (var i = 0; i < total; i++) {
      var t = chars[i].offsetTop;
      if (t !== currentTop) {
        lines.push({ top: t, chars: [] });
        currentTop = t;
      }
      lines[lines.length - 1].chars.push(chars[i]);
    }
  }

  buildLines();
  window.addEventListener('resize', function() { buildLines(); });

  /* ── trigger point: how far up each line's Y should be to start/finish ── */
  /* A line starts revealing when its Y enters the trigger zone (e.g. 80% from top)
     and finishes revealing when it reaches the upper trigger (e.g. 35% from top).
     This means lines further down start later, creating the stagger. */
  var triggerStart = {{ section.settings.trigger_start | default: 85 }} / 100;  /* line enters reveal zone */
  var triggerEnd   = {{ section.settings.trigger_end | default: 35 }} / 100;    /* line fully revealed */

  function onScroll() {
    var wh = window.innerHeight;
    var startY = wh * triggerStart;  /* e.g. 85% down = near bottom */
    var endY   = wh * triggerEnd;    /* e.g. 35% down = above center */
    var range  = startY - endY;      /* the scroll distance to go from 0% → 100% for one line */
    if (range <= 0) return;

    for (var li = 0; li < lines.length; li++) {
      var line = lines[li];
      /* use the first char's position to determine line Y */
      var lineRect = line.chars[0].getBoundingClientRect();
      var lineY = lineRect.top + lineRect.height * 0.5;

      /* progress for this line: 0 = just entered at bottom, 1 = fully revealed */
      var progress = (startY - lineY) / range;
      if (progress < 0) progress = 0;
      if (progress > 1) progress = 1;

      var litCount = Math.round(progress * line.chars.length);

      for (var ci = 0; ci < line.chars.length; ci++) {
        if (ci < litCount) {
          line.chars[ci].classList.add('is-lit');
        } else {
          line.chars[ci].classList.remove('is-lit');
        }
      }
    }
  }

  var ticking = false;
  window.addEventListener('scroll', function() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(function() {
        onScroll();
        ticking = false;
      });
    }
  }, { passive: true });

  onScroll();
})();
</script>

{% schema %}
{
  "name": "Scroll Text Reveal",
  "tag": "section",
  "class": "str-section",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1a1a2e"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Revealed text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Hidden text color",
      "default": "#ffffff2e"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "min": 24,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Font size – desktop",
      "default": 48
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Font size – mobile",
      "default": 28
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        { "value": "normal", "label": "Normal (400)" },
        { "value": "medium", "label": "Medium (500)" },
        { "value": "semibold", "label": "Semi-bold (600)" },
        { "value": "bold", "label": "Bold (700)" },
        { "value": "black", "label": "Black (900)" }
      ],
      "default": "normal"
    },
    {
      "type": "range",
      "id": "line_height",
      "min": 100,
      "max": 200,
      "step": 5,
      "label": "Line height (÷100)",
      "default": 135,
      "info": "135 = 1.35 line height"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "label": "Max content width",
      "default": 1100
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Vertical padding – desktop",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_x",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding – desktop",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_y_mobile",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Vertical padding – mobile",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_x_mobile",
      "min": 12,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Horizontal padding – mobile",
      "default": 20
    },
    {
      "type": "header",
      "content": "Scroll behavior"
    },
    {
      "type": "range",
      "id": "trigger_start",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Reveal starts at",
      "default": 85,
      "info": "Viewport position (from top) where text starts revealing. 85% = near bottom."
    },
    {
      "type": "range",
      "id": "trigger_end",
      "min": 5,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Reveal ends at",
      "default": 35,
      "info": "Viewport position (from top) where text is fully revealed. 35% = above center."
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Accessories play a crucial role in defining your look. From unique handbags to eye-catching accessory, these finishing touches can elevate any outfit."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scroll Text Reveal",
      "blocks": [
        {
          "type": "text",
          "settings": {
            "text": "Accessories play a crucial role in defining your look. From unique handbags to eye-catching accessory, these finishing touches can elevate any outfit."
          }
        }
      ]
    }
  ]
}
{% endschema %}

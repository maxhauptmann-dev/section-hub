{% comment %}
  Section Hub – Testimonial Scrolling Cards
  Infinite marquee scroll of testimonial cards with image/video, star rating,
  comment text and author name. Like Testimonial #12 but scrolling.
{% endcomment %}

{{ 'section-testimonial-scrolling.css' | asset_url | stylesheet_tag }}

{%- assign shape_class = 'ts-shape--rounded' -%}
{%- if section.settings.image_shape == 'circle' -%}
  {%- assign shape_class = 'ts-shape--circle' -%}
{%- elsif section.settings.image_shape == 'square' -%}
  {%- assign shape_class = 'ts-shape--square' -%}
{%- endif -%}

<section class="ts-scroll" id="ts-scroll-{{ section.id }}" style="
  --ts-bg: {{ section.settings.background_color }};
  --ts-text: {{ section.settings.text_color }};
  --ts-accent: {{ section.settings.accent_color }};
  --ts-card-bg: {{ section.settings.card_background }};
  --ts-card-width: {{ section.settings.card_width }}px;
  --ts-img-height: {{ section.settings.image_height }}px;
  --ts-gap: {{ section.settings.gap }}px;
  --ts-speed: {{ section.settings.scroll_speed }}s;
  --ts-border-radius: {{ section.settings.border_radius }}px;
  --ts-heading-size: {{ section.settings.heading_size }}px;
  --ts-padding-top: {{ section.settings.padding_top }}px;
  --ts-padding-bottom: {{ section.settings.padding_bottom }}px;
  --ts-rows: {{ section.settings.rows }};
  --ts-card-border: {{ section.settings.card_border_color }};
">
  <div class="ts-scroll__container">
    {% if section.settings.heading != blank %}
      <div class="ts-scroll__header">
        {% if section.settings.subheading != blank %}
          <span class="ts-scroll__subheading">{{ section.settings.subheading }}</span>
        {% endif %}
        <h2 class="ts-scroll__heading">{{ section.settings.heading }}</h2>
        {% if section.settings.description != blank %}
          <p class="ts-scroll__desc">{{ section.settings.description }}</p>
        {% endif %}
      </div>
    {% endif %}

    {%- comment -%} Marquee rows {%- endcomment -%}
    {% for row in (1..section.settings.rows) %}
      <div class="ts-scroll__marquee {% if row == 2 %}ts-scroll__marquee--reverse{% endif %}" aria-hidden="{% if row > 1 %}true{% else %}false{% endif %}">
        <div class="ts-scroll__track">
          {%- comment -%} First set: real blocks with editor attributes {%- endcomment -%}
          {% for block in section.blocks %}
              <div class="ts-scroll__card {% unless block.settings.video != blank or block.settings.video_url != blank or block.settings.image != blank %}ts-scroll__card--no-media{% endunless %}" {{ block.shopify_attributes }}>
                {%- comment -%} Media: Image or Video (optional) {%- endcomment -%}
                {% if block.settings.video != blank or block.settings.video_url != blank or block.settings.image != blank %}
                  <div class="ts-scroll__media {{ shape_class }}">
                    {% if block.settings.video != blank %}
                      <div class="ts-scroll__video-wrap">
                        {{ block.settings.video | video_tag: autoplay: false, controls: false, muted: true, loop: true, class: 'ts-scroll__video' }}
                        <button class="ts-scroll__play-btn" aria-label="Play video" onclick="var v=this.parentElement.querySelector('video');if(v.paused){v.play();this.classList.add('playing');}else{v.pause();this.classList.remove('playing');}">
                          <svg width="40" height="40" viewBox="0 0 48 48" fill="none">
                            <circle cx="24" cy="24" r="24" fill="rgba(0,0,0,0.45)"/>
                            <polygon points="19,15 35,24 19,33" fill="#fff"/>
                          </svg>
                        </button>
                      </div>
                    {% elsif block.settings.video_url != blank %}
                      <div class="ts-scroll__video-wrap">
                        {% if block.settings.video_url.type == 'youtube' %}
                          <iframe
                            src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}?autoplay=0&mute=1&controls=1"
                            class="ts-scroll__iframe"
                            allow="autoplay; encrypted-media"
                            allowfullscreen
                            loading="lazy"
                          ></iframe>
                        {% elsif block.settings.video_url.type == 'vimeo' %}
                          <iframe
                            src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}?autoplay=0&muted=1"
                            class="ts-scroll__iframe"
                            allow="autoplay; encrypted-media"
                            allowfullscreen
                            loading="lazy"
                          ></iframe>
                        {% endif %}
                      </div>
                    {% elsif block.settings.image != blank %}
                      <img
                        src="{{ block.settings.image | image_url: width: 800 }}"
                        alt="{{ block.settings.alt | default: block.settings.author_name | default: 'Testimonial' }}"
                        class="ts-scroll__img"
                        loading="lazy"
                        width="{{ section.settings.card_width }}"
                        height="{{ section.settings.image_height }}"
                      >
                    {% endif %}
                  </div>
                {% endif %}

                {%- comment -%} Card body: stars, comment, author with profile image {%- endcomment -%}
                <div class="ts-scroll__body">
                  {% if block.settings.rating > 0 %}
                    <div class="ts-scroll__stars">
                      {% for i in (1..5) %}
                        <svg class="ts-star {% if i <= block.settings.rating %}ts-star--filled{% else %}ts-star--empty{% endif %}" viewBox="0 0 24 24">
                          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2z"/>
                        </svg>
                      {% endfor %}
                    </div>
                  {% endif %}

                  {% if block.settings.comment != blank %}
                    <p class="ts-scroll__comment">{{ block.settings.comment }}</p>
                  {% endif %}

                  {% if block.settings.author_name != blank or block.settings.profile_image != blank %}
                    <div class="ts-scroll__author-row">
                      {% if block.settings.profile_image != blank %}
                        <img
                          src="{{ block.settings.profile_image | image_url: width: 80 }}"
                          alt="{{ block.settings.author_name | default: 'Profile' }}"
                          class="ts-scroll__avatar"
                          loading="lazy"
                          width="36"
                          height="36"
                        >
                      {% endif %}
                      {% if block.settings.author_name != blank %}
                        <span class="ts-scroll__author">{{ block.settings.author_name }}</span>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endfor %}

          {%- comment -%} Clone sets 2–4 for seamless infinite loop with few cards {%- endcomment -%}
          {% for clone in (1..3) %}
            {% for block in section.blocks %}
              <div class="ts-scroll__card ts-scroll__card--clone {% unless block.settings.video != blank or block.settings.video_url != blank or block.settings.image != blank %}ts-scroll__card--no-media{% endunless %}">
                {% if block.settings.video != blank or block.settings.video_url != blank or block.settings.image != blank %}
                  <div class="ts-scroll__media {{ shape_class }}">
                    {% if block.settings.video != blank %}
                      <div class="ts-scroll__video-wrap">
                        {{ block.settings.video | video_tag: autoplay: false, controls: false, muted: true, loop: true, class: 'ts-scroll__video' }}
                        <button class="ts-scroll__play-btn" aria-label="Play video" onclick="var v=this.parentElement.querySelector('video');if(v.paused){v.play();this.classList.add('playing');}else{v.pause();this.classList.remove('playing');}">
                          <svg width="40" height="40" viewBox="0 0 48 48" fill="none">
                            <circle cx="24" cy="24" r="24" fill="rgba(0,0,0,0.45)"/>
                            <polygon points="19,15 35,24 19,33" fill="#fff"/>
                          </svg>
                        </button>
                      </div>
                    {% elsif block.settings.video_url != blank %}
                      <div class="ts-scroll__video-wrap">
                        {% if block.settings.video_url.type == 'youtube' %}
                          <iframe src="https://www.youtube.com/embed/{{ block.settings.video_url.id }}?autoplay=0&mute=1&controls=1" class="ts-scroll__iframe" allow="autoplay; encrypted-media" allowfullscreen loading="lazy"></iframe>
                        {% elsif block.settings.video_url.type == 'vimeo' %}
                          <iframe src="https://player.vimeo.com/video/{{ block.settings.video_url.id }}?autoplay=0&muted=1" class="ts-scroll__iframe" allow="autoplay; encrypted-media" allowfullscreen loading="lazy"></iframe>
                        {% endif %}
                      </div>
                    {% elsif block.settings.image != blank %}
                      <img
                        src="{{ block.settings.image | image_url: width: 800 }}"
                        alt="{{ block.settings.alt | default: block.settings.author_name | default: 'Testimonial' }}"
                        class="ts-scroll__img"
                        loading="lazy"
                        width="{{ section.settings.card_width }}"
                        height="{{ section.settings.image_height }}"
                      >
                    {% endif %}
                  </div>
                {% endif %}

                <div class="ts-scroll__body">
                  {% if block.settings.rating > 0 %}
                    <div class="ts-scroll__stars">
                      {% for i in (1..5) %}
                        <svg class="ts-star {% if i <= block.settings.rating %}ts-star--filled{% else %}ts-star--empty{% endif %}" viewBox="0 0 24 24">
                          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2z"/>
                        </svg>
                      {% endfor %}
                    </div>
                  {% endif %}
                  {% if block.settings.comment != blank %}
                    <p class="ts-scroll__comment">{{ block.settings.comment }}</p>
                  {% endif %}
                  {% if block.settings.author_name != blank or block.settings.profile_image != blank %}
                    <div class="ts-scroll__author-row">
                      {% if block.settings.profile_image != blank %}
                        <img
                          src="{{ block.settings.profile_image | image_url: width: 80 }}"
                          alt="{{ block.settings.author_name | default: 'Profile' }}"
                          class="ts-scroll__avatar"
                          loading="lazy"
                          width="36"
                          height="36"
                        >
                      {% endif %}
                      {% if block.settings.author_name != blank %}
                        <span class="ts-scroll__author">{{ block.settings.author_name }}</span>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          {% endfor %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Scrolling Testimonials",
  "tag": "section",
  "class": "section-testimonial-scrolling",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by everyone, everywhere"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "TESTIMONIALS"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Don't miss out."
    },
    {
      "type": "header",
      "content": "Card Settings"
    },
    {
      "type": "range",
      "id": "card_width",
      "min": 160,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Card Width",
      "default": 220
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 100,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "Image / Video Height",
      "default": 260
    },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Image Shape",
      "options": [
        { "value": "rounded", "label": "Rounded" },
        { "value": "circle",  "label": "Circle" },
        { "value": "square",  "label": "Square" }
      ],
      "default": "rounded"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Border Radius",
      "default": 12
    },
    {
      "type": "range",
      "id": "gap",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "label": "Gap Between Cards",
      "default": 16
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "rows",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Number of Rows",
      "default": 1
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "s",
      "label": "Scroll Speed (higher = slower)",
      "default": 50
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 56,
      "step": 2,
      "unit": "px",
      "label": "Heading Size",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#f5f0eb"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card Border",
      "default": "#e5e5e5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Star Color",
      "default": "#1a1a1a"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "header",
          "content": "Media"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (Shopify hosted)"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Video URL (YouTube/Vimeo)",
          "accept": ["youtube", "vimeo"]
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt Text"
        },
        {
          "type": "header",
          "content": "Review"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "Star Rating (0 = hidden)",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "comment",
          "label": "Comment / Review Text",
          "default": "Amazing product, I love it!"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author / Username",
          "default": "@customer"
        },
        {
          "type": "image_picker",
          "id": "profile_image",
          "label": "Profile Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrolling Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "author_name": "@light__mcqueen", "rating": 5, "comment": "All my friends want them too now, at least I was the first one to get them..!" } },
        { "type": "testimonial", "settings": { "author_name": "@decwithpatty", "rating": 5, "comment": "I use it every day early in the morning and on our dining table, it is so convenient and cool" } },
        { "type": "testimonial", "settings": { "author_name": "@traceyy", "rating": 5, "comment": "the perfect candle replacement, obsessed with our lamps!" } },
        { "type": "testimonial", "settings": { "author_name": "@kidzworld", "rating": 4, "comment": "Our kids love these everywhere, even when doing their homework!" } },
        { "type": "testimonial", "settings": { "author_name": "@homebylisa", "rating": 5, "comment": "Gorgeous quality and so versatile. Highly recommend!" } },
        { "type": "testimonial", "settings": { "author_name": "@modernliving", "rating": 5, "comment": "Shipped fast, looks even better in person." } }
      ]
    }
  ]
}
{% endschema %}
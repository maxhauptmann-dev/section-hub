{% comment %}
  Section Hub – Shop the Look Carousel v1.0
  Swipeable lookbook with lifestyle images, hotspot dots, and multi-product
  cards per look. Product images swap on hover.
{% endcomment %}

{{ 'section-shop-the-look-carousel.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign eyebrow  = section.settings.eyebrow
  assign heading   = section.settings.heading
  assign btn_text  = section.settings.button_text
-%}

<section class="stlc" id="stlc-{{ section.id }}" style="
  --stlc-bg: {{ section.settings.bg_color }};
  --stlc-text: {{ section.settings.text_color }};
  --stlc-eyebrow-size: {{ section.settings.eyebrow_size }}px;
  --stlc-heading-size: {{ section.settings.heading_size }}px;
  --stlc-btn-bg: {{ section.settings.btn_bg }};
  --stlc-btn-text: {{ section.settings.btn_text_color }};
  --stlc-btn-radius: {{ section.settings.btn_radius }}px;
  --stlc-dot-color: {{ section.settings.dot_color }};
  --stlc-dot-inactive: {{ section.settings.dot_inactive }};
  --stlc-hotspot-bg: {{ section.settings.hotspot_bg }};
  --stlc-hotspot-size: {{ section.settings.hotspot_size }}px;
  --stlc-badge-bg: {{ section.settings.badge_bg }};
  --stlc-badge-text: {{ section.settings.badge_text_color }};
  --stlc-card-bg: {{ section.settings.card_bg }};
  --stlc-card-radius: {{ section.settings.card_radius }}px;
  --stlc-heart-color: {{ section.settings.heart_color }};
  --stlc-image-radius: {{ section.settings.image_radius }}px;
  --stlc-arrow-size: {{ section.settings.arrow_size }}px;
  --stlc-pt: {{ section.settings.padding_top }}px;
  --stlc-pb: {{ section.settings.padding_bottom }}px;
  --stlc-product-img-ratio: {{ section.settings.product_img_ratio }};
  --stlc-product-img-fit: {{ section.settings.product_img_fit }};
  --stlc-product-img-bg: {{ section.settings.product_img_bg }};
  --stlc-product-card-max-width: {{ section.settings.product_card_max_width }}px;
">

  {%- if eyebrow != blank or heading != blank -%}
    <div class="stlc__header">
      {%- if eyebrow != blank -%}
        <p class="stlc__eyebrow">{{ eyebrow }}</p>
      {%- endif -%}
      {%- if heading != blank -%}
        <h2 class="stlc__heading">{{ heading }}</h2>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%}
    ─── Build looks data ───
    Each "look" block starts a new look. Following "product" blocks belong to it.
  {%- endcomment -%}
  {%- assign look_count = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'look' -%}
      {%- assign look_count = look_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}

  <div class="stlc__slider" data-section-id="{{ section.id }}">
    {%- comment -%} Prev / Next arrows {%- endcomment -%}
    <button class="stlc__arrow stlc__arrow--prev" data-dir="prev" aria-label="Previous look" disabled>
      <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="stlc__arrow stlc__arrow--next" data-dir="next" aria-label="Next look">
      <svg viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"/></svg>
    </button>

    <div class="stlc__track">
      <div class="stlc__slides">

        {%- assign in_look = false -%}
        {%- assign current_look_index = -1 -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'look' -%}
            {%- comment -%} Close previous look slide {%- endcomment -%}
            {%- if in_look -%}
                    </div>{%- comment -%} .stlc__product-slides {%- endcomment -%}
                  </div>{%- comment -%} .stlc__product-slider {%- endcomment -%}
                  <div class="stlc__product-dots" data-look-dots></div>
                </div>{%- comment -%} .stlc__products {%- endcomment -%}
              </div>{%- comment -%} .stlc__slide {%- endcomment -%}
            {%- endif -%}

            {%- assign in_look = true -%}
            {%- assign current_look_index = current_look_index | plus: 1 -%}
            {%- assign product_index = 0 -%}

            <div class="stlc__slide" {{ block.shopify_attributes }}>
              {%- comment -%} Lifestyle image with hotspots {%- endcomment -%}
              <div class="stlc__image-wrap">
                {%- if block.settings.image != blank -%}
                  <img
                    src="{{ block.settings.image | image_url: width: 900 }}"
                    srcset="{{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1200 }} 1200w"
                    sizes="(max-width: 860px) 90vw, 50vw"
                    alt="{{ block.settings.image_alt | default: heading | default: 'Look' }}"
                    loading="{% if current_look_index == 0 %}eager{% else %}lazy{% endif %}"
                    width="900"
                    height="1200"
                  >
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'stlc__placeholder' }}
                {%- endif -%}

                {%- comment -%}
                  Hotspot positions – up to 5 per look.
                  Each has x% / y% and links to a product index.
                {%- endcomment -%}
                {%- for n in (1..5) -%}
                  {%- assign hs_x_key = 'hotspot_' | append: n | append: '_x' -%}
                  {%- assign hs_y_key = 'hotspot_' | append: n | append: '_y' -%}
                  {%- assign hs_idx_key = 'hotspot_' | append: n | append: '_product' -%}
                  {%- assign hx = block.settings[hs_x_key] -%}
                  {%- assign hy = block.settings[hs_y_key] -%}
                  {%- assign hp = block.settings[hs_idx_key] -%}
                  {%- if hx > 0 and hy > 0 -%}
                    <button
                      class="stlc__hotspot"
                      style="left:{{ hx }}%;top:{{ hy }}%"
                      data-product-idx="{{ hp | minus: 1 }}"
                      aria-label="Show product {{ hp }}"
                    ></button>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              {%- comment -%} Product cards area {%- endcomment -%}
              <div class="stlc__products">
                <div class="stlc__product-slider">
                  <div class="stlc__product-slides">

          {%- elsif block.type == 'product' and in_look -%}
            {%- assign prod = block.settings.product -%}
            {%- assign product_index = product_index | plus: 1 -%}

            <div class="stlc__product-card" {{ block.shopify_attributes }}>
              <div class="stlc__product-img-wrap">
                {%- if block.settings.badge != blank -%}
                  <span class="stlc__badge">{{ block.settings.badge }}</span>
                {%- endif -%}

                {%- if section.settings.show_wishlist -%}
                  <button class="stlc__wishlist" aria-label="Add to wishlist">
                    <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  </button>
                {%- endif -%}

                {%- if prod != blank -%}
                  <img
                    class="stlc__product-img stlc__product-img--primary"
                    src="{{ prod.featured_image | image_url: width: 600 }}"
                    alt="{{ prod.title }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                  {%- if prod.images.size > 1 -%}
                    <img
                      class="stlc__product-img stlc__product-img--hover"
                      src="{{ prod.images[1] | image_url: width: 600 }}"
                      alt="{{ prod.title }} – alternate view"
                      loading="lazy"
                      width="600"
                      height="600"
                    >
                  {%- endif -%}
                {%- elsif block.settings.custom_image != blank -%}
                  <img
                    class="stlc__product-img stlc__product-img--primary"
                    src="{{ block.settings.custom_image | image_url: width: 600 }}"
                    alt="{{ block.settings.custom_title | default: 'Product' }}"
                    loading="lazy"
                    width="600"
                    height="600"
                  >
                  {%- if block.settings.custom_hover_image != blank -%}
                    <img
                      class="stlc__product-img stlc__product-img--hover"
                      src="{{ block.settings.custom_hover_image | image_url: width: 600 }}"
                      alt="{{ block.settings.custom_title | default: 'Product' }} – alternate view"
                      loading="lazy"
                      width="600"
                      height="600"
                    >
                  {%- endif -%}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag }}
                {%- endif -%}
              </div>

              {%- comment -%} Title & Price {%- endcomment -%}
              {%- if prod != blank -%}
                <p class="stlc__product-title">{{ block.settings.custom_title | default: prod.title }}</p>
                <p class="stlc__product-price">{{ prod.price | money }}</p>
              {%- else -%}
                {%- if block.settings.custom_title != blank -%}
                  <p class="stlc__product-title">{{ block.settings.custom_title }}</p>
                {%- endif -%}
                {%- if block.settings.custom_price != blank -%}
                  <p class="stlc__product-price">{{ block.settings.custom_price }}</p>
                {%- endif -%}
              {%- endif -%}

              {%- if btn_text != blank -%}
                {%- assign link = '#' -%}
                {%- if prod != blank -%}{%- assign link = prod.url -%}{%- endif -%}
                {%- if block.settings.custom_link != blank -%}{%- assign link = block.settings.custom_link -%}{%- endif -%}
                <a href="{{ link }}" class="stlc__product-btn">{{ btn_text }}</a>
              {%- endif -%}
            </div>

          {%- endif -%}
        {%- endfor -%}

        {%- comment -%} Close last look {%- endcomment -%}
        {%- if in_look -%}
                  </div>{%- comment -%} .stlc__product-slides {%- endcomment -%}
                </div>{%- comment -%} .stlc__product-slider {%- endcomment -%}
                <div class="stlc__product-dots" data-look-dots></div>
              </div>{%- comment -%} .stlc__products {%- endcomment -%}
            </div>{%- comment -%} .stlc__slide {%- endcomment -%}
        {%- endif -%}

      </div>{%- comment -%} .stlc__slides {%- endcomment -%}
    </div>{%- comment -%} .stlc__track {%- endcomment -%}
  </div>{%- comment -%} .stlc__slider {%- endcomment -%}
</section>

<script>
(function() {
  var root = document.getElementById('stlc-{{ section.id }}');
  if (!root) return;

  /* ─── Look Carousel ─── */
  var slides = root.querySelector('.stlc__slides');
  var allSlides = root.querySelectorAll('.stlc__slide');
  var prevBtn = root.querySelector('.stlc__arrow--prev');
  var nextBtn = root.querySelector('.stlc__arrow--next');
  var total = allSlides.length;
  var current = 0;

  function goToLook(idx) {
    if (idx < 0 || idx >= total) return;
    current = idx;
    slides.style.transform = 'translateX(-' + (current * 100) + '%)';
    prevBtn.disabled = current === 0;
    nextBtn.disabled = current === total - 1;
  }

  prevBtn.addEventListener('click', function() { goToLook(current - 1); });
  nextBtn.addEventListener('click', function() { goToLook(current + 1); });

  /* Touch swipe for looks */
  var touchStartX = 0;
  var touchDiff = 0;
  var swiping = false;

  slides.addEventListener('touchstart', function(e) {
    touchStartX = e.touches[0].clientX;
    swiping = true;
  }, { passive: true });

  slides.addEventListener('touchmove', function(e) {
    if (!swiping) return;
    touchDiff = e.touches[0].clientX - touchStartX;
  }, { passive: true });

  slides.addEventListener('touchend', function() {
    if (!swiping) return;
    swiping = false;
    if (Math.abs(touchDiff) > 50) {
      if (touchDiff < 0) goToLook(current + 1);
      else goToLook(current - 1);
    }
    touchDiff = 0;
  });

  if (total <= 1) {
    prevBtn.style.display = 'none';
    nextBtn.style.display = 'none';
  }

  /* ─── Product Dot Navigation per Look ─── */
  allSlides.forEach(function(slide) {
    var productSlides = slide.querySelector('.stlc__product-slides');
    var cards = slide.querySelectorAll('.stlc__product-card');
    var dotsWrap = slide.querySelector('[data-look-dots]');
    var productCount = cards.length;
    var currentProduct = 0;

    if (productCount <= 1 && dotsWrap) {
      dotsWrap.style.display = 'none';
    }

    /* Build dots */
    if (dotsWrap && productCount > 1) {
      for (var d = 0; d < productCount; d++) {
        var dot = document.createElement('button');
        dot.className = 'stlc__product-dot' + (d === 0 ? ' stlc__product-dot--active' : '');
        dot.setAttribute('aria-label', 'Product ' + (d + 1));
        dot.dataset.idx = d;
        dotsWrap.appendChild(dot);
      }

      dotsWrap.addEventListener('click', function(e) {
        var btn = e.target.closest('.stlc__product-dot');
        if (!btn) return;
        goToProduct(parseInt(btn.dataset.idx));
      });
    }

    function goToProduct(idx) {
      if (idx < 0 || idx >= productCount) return;
      currentProduct = idx;
      productSlides.style.transform = 'translateX(-' + (currentProduct * 100) + '%)';
      /* Update dots */
      var dots = dotsWrap ? dotsWrap.querySelectorAll('.stlc__product-dot') : [];
      dots.forEach(function(d, i) {
        d.classList.toggle('stlc__product-dot--active', i === currentProduct);
      });
      /* Update hotspot active state */
      var hotspots = slide.querySelectorAll('.stlc__hotspot');
      hotspots.forEach(function(hs) {
        hs.classList.toggle('stlc__hotspot--active', parseInt(hs.dataset.productIdx) === currentProduct);
      });
    }

    /* Hotspot click → navigate to product */
    var hotspots = slide.querySelectorAll('.stlc__hotspot');
    hotspots.forEach(function(hs) {
      hs.addEventListener('click', function() {
        var pIdx = parseInt(hs.dataset.productIdx);
        if (!isNaN(pIdx) && pIdx >= 0 && pIdx < productCount) {
          goToProduct(pIdx);
        }
      });
    });
  });

  /* Init arrow state */
  goToLook(0);
})();
</script>

{% schema %}
{
  "name": "SIQ - Shop Look Carousel",
  "tag": "section",
  "class": "section-stlc",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "SHOP THE LOOKS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CARMENS FAVORITES"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Product Button Text",
      "default": "PRODUKT ANZEIGEN"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show Wishlist Heart",
      "default": true
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Eyebrow Size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Active Dot Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "dot_inactive",
      "label": "Inactive Dot Color",
      "default": "#cccccc"
    },
    {
      "type": "color",
      "id": "hotspot_bg",
      "label": "Hotspot Background",
      "default": "rgba(255,255,255,0.85)"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge Background",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heart_color",
      "label": "Wishlist Heart Color",
      "default": "#1a1a1a"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image Roundness",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card Roundness",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Product Image"
    },
    {
      "type": "select",
      "id": "product_img_ratio",
      "label": "Image Aspect Ratio",
      "options": [
        { "value": "1 / 1",  "label": "Square (1:1)" },
        { "value": "3 / 4",  "label": "Portrait (3:4)" },
        { "value": "2 / 3",  "label": "Portrait tall (2:3)" },
        { "value": "4 / 3",  "label": "Landscape (4:3)" },
        { "value": "4 / 5",  "label": "Portrait (4:5)" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "select",
      "id": "product_img_fit",
      "label": "Image Fit",
      "options": [
        { "value": "cover",   "label": "Cover (fill, may crop)" },
        { "value": "contain", "label": "Contain (show full image)" }
      ],
      "default": "cover"
    },
    {
      "type": "color",
      "id": "product_img_bg",
      "label": "Image Background Color",
      "default": "#f5f5f5",
      "info": "Visible when using 'Contain' fit or transparent images"
    },
    {
      "type": "range",
      "id": "product_card_max_width",
      "label": "Product Card Max Width",
      "min": 200,
      "max": 600,
      "step": 20,
      "unit": "px",
      "default": 400
    },
    {
      "type": "range",
      "id": "btn_radius",
      "label": "Button Roundness",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "hotspot_size",
      "label": "Hotspot Dot Size",
      "min": 20,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "arrow_size",
      "label": "Arrow Size",
      "min": 36,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Lifestyle Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image Alt Text"
        },
        {
          "type": "header",
          "content": "Hotspot 1"
        },
        {
          "type": "range",
          "id": "hotspot_1_x",
          "label": "Hotspot 1 – X Position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 0
        },
        {
          "type": "range",
          "id": "hotspot_1_y",
          "label": "Hotspot 1 – Y Position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 0
        },
        {
          "type": "range",
          "id": "hotspot_1_product",
          "label": "Hotspot 1 – Product #",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 1,
          "info": "Which product card this hotspot links to (1 = first product)"
        },
        {
          "type": "header",
          "content": "Hotspot 2"
        },
        {
          "type": "range",
          "id": "hotspot_2_x",
          "label": "Hotspot 2 – X Position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 0
        },
        {
          "type": "range",
          "id": "hotspot_2_y",
          "label": "Hotspot 2 – Y Position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 0
        },
        {
          "type": "range",
          "id": "hotspot_2_product",
          "label": "Hotspot 2 – Product #",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 2
        },
        {
          "type": "header",
          "content": "Hotspot 3"
        },
        {
          "type": "range",
          "id": "hotspot_3_x",
          "label": "Hotspot 3 – X Position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 0
        },
        {
          "type": "range",
          "id": "hotspot_3_y",
          "label": "Hotspot 3 – Y Position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 0
        },
        {
          "type": "range",
          "id": "hotspot_3_product",
          "label": "Hotspot 3 – Product #",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 3
        },
        {
          "type": "header",
          "content": "Hotspot 4"
        },
        {
          "type": "range",
          "id": "hotspot_4_x",
          "label": "Hotspot 4 – X Position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 0
        },
        {
          "type": "range",
          "id": "hotspot_4_y",
          "label": "Hotspot 4 – Y Position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 0
        },
        {
          "type": "range",
          "id": "hotspot_4_product",
          "label": "Hotspot 4 – Product #",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 4
        },
        {

<style>
  {% render 'styles.css' %}
</style>

{%- assign segments_data = '' -%}
{%- for block in section.blocks -%}
  {%- if block.type == 'segment' -%}
    {%- unless forloop.first -%}{%- assign segments_data = segments_data | append: '|||' -%}{%- endunless -%}
    {%- assign segments_data = segments_data | append: block.settings.label | append: '::' | append: block.settings.discount_code | append: '::' | append: block.settings.color | append: '::' | append: block.settings.text_color | append: '::' | append: block.settings.probability | append: '::' | append: block.settings.win_message -%}
  {%- endif -%}
{%- endfor -%}

<!-- Overlay -->
<div class="swp-overlay" id="swpOverlay"
  data-trigger="{{ section.settings.trigger_type }}"
  data-delay="{{ section.settings.trigger_delay }}"
  data-scroll="{{ section.settings.trigger_scroll }}"
  data-cookie-days="{{ section.settings.cookie_days }}"
  data-section-id="{{ section.id }}"
  style="
    --swp-overlay-bg: {{ section.settings.overlay_bg }};
    --swp-modal-bg: {{ section.settings.modal_bg }};
    --swp-text-color: {{ section.settings.text_color }};
    --swp-modal-radius: {{ section.settings.modal_radius }}px;
    --swp-accent: {{ section.settings.accent_color }};
    --swp-pointer-color: {{ section.settings.pointer_color }};
    --swp-wheel-border: {{ section.settings.wheel_border_color }};
    --swp-center-bg: {{ section.settings.center_bg }};
    --swp-center-text: {{ section.settings.center_text_color }};
    --swp-input-border: {{ section.settings.input_border }};
    --swp-input-bg: {{ section.settings.input_bg }};
    --swp-input-radius: {{ section.settings.input_radius }}px;
    --swp-btn-bg: {{ section.settings.btn_bg }};
    --swp-btn-text: {{ section.settings.btn_text_color }};
    --swp-btn-radius: {{ section.settings.btn_radius }}px;
    --swp-title-size: {{ section.settings.title_size | divided_by: 100.0 }}em;
    --swp-subtitle-size: {{ section.settings.subtitle_size | divided_by: 100.0 }}em;
  "
>
  <div class="swp-modal">
    <button class="swp-close" id="swpClose" aria-label="Close">&times;</button>

    <!-- Left: Wheel -->
    <div class="swp-wheel-panel">
      <div class="swp-wheel-container">
        <div class="swp-pointer"></div>
        <div class="swp-wheel" id="swpWheel">
          <canvas id="swpCanvas" width="560" height="560"></canvas>
        </div>
        <div class="swp-wheel-center" id="swpCenter">{{ section.settings.center_text }}</div>
      </div>
    </div>

    <!-- Right: Form / Result -->
    <div class="swp-form-panel">
      <!-- Form State -->
      <div id="swpFormState">
        {%- if section.settings.title != blank -%}
          <h2 class="swp-title">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="swp-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        <form class="swp-form" id="swpForm" onsubmit="return false;">
          <input
            class="swp-input"
            type="email"
            id="swpEmail"
            placeholder="{{ section.settings.email_placeholder }}"
            required
          >
          {%- if section.settings.show_name_field -%}
            <input
              class="swp-input"
              type="text"
              id="swpName"
              placeholder="{{ section.settings.name_placeholder }}"
            >
          {%- endif -%}
          <button type="submit" class="swp-spin-btn" id="swpSpinBtn">
            {{ section.settings.spin_button_text }}
          </button>
        </form>

        {%- if section.settings.terms_text != blank -%}
          <p class="swp-terms">{{ section.settings.terms_text }}</p>
        {%- endif -%}

        <button class="swp-no-thanks" id="swpNoThanks">
          {{ section.settings.no_thanks_text }}
        </button>
      </div>

      <!-- Result State -->
      <div class="swp-result" id="swpResult">
        <div class="swp-result-emoji">🎉</div>
        <h2 class="swp-result-title" id="swpResultTitle">Congratulations!</h2>
        <p class="swp-result-message" id="swpResultMessage"></p>
        <div class="swp-discount-code" id="swpDiscountCode"></div>
        <p class="swp-result-hint">{{ section.settings.copy_hint_text }}</p>
        <button class="swp-copy-btn" id="swpCopyBtn">{{ section.settings.copy_button_text }}</button>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  const overlay = document.getElementById('swpOverlay');
  if (!overlay) return;

  const sectionId = overlay.dataset.sectionId;
  const cookieKey = 'swp_shown_' + sectionId;
  const cookieDays = parseInt(overlay.dataset.cookieDays) || 7;

  // Check cookie
  function getCookie(name) {
    const v = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
    return v ? v.pop() : '';
  }
  function setCookie(name, val, days) {
    const d = new Date();
    d.setTime(d.getTime() + days * 86400000);
    document.cookie = name + '=' + val + ';expires=' + d.toUTCString() + ';path=/;SameSite=Lax';
  }

  if (getCookie(cookieKey) === '1') return;

  // Parse segments
  const rawSegments = {{ segments_data | json }};
  const segments = rawSegments.split('|||').map(s => {
    const p = s.split('::');
    return {
      label: p[0] || '',
      code: p[1] || '',
      color: p[2] || '#ff6b6b',
      textColor: p[3] || '#ffffff',
      probability: parseInt(p[4]) || 1,
      winMessage: p[5] || ''
    };
  }).filter(s => s.label);

  if (!segments.length) return;

  // Build probability pool
  const pool = [];
  segments.forEach((seg, i) => {
    for (let j = 0; j < seg.probability; j++) pool.push(i);
  });

  // Draw wheel
  const canvas = document.getElementById('swpCanvas');
  const ctx = canvas.getContext('2d');
  const size = canvas.width;
  const center = size / 2;
  const radius = center - 4;
  const segCount = segments.length;
  const arc = (2 * Math.PI) / segCount;

  function drawWheel() {
    ctx.clearRect(0, 0, size, size);
    segments.forEach((seg, i) => {
      const startAngle = i * arc - Math.PI / 2;
      const endAngle = startAngle + arc;

      // Segment
      ctx.beginPath();
      ctx.moveTo(center, center);
      ctx.arc(center, center, radius, startAngle, endAngle);
      ctx.closePath();
      ctx.fillStyle = seg.color;
      ctx.fill();

      // Border line
      ctx.beginPath();
      ctx.moveTo(center, center);
      ctx.arc(center, center, radius, startAngle, endAngle);
      ctx.closePath();
      ctx.strokeStyle = 'rgba(255,255,255,0.1)';
      ctx.lineWidth = 1;
      ctx.stroke();

      // Text
      ctx.save();
      ctx.translate(center, center);
      ctx.rotate(startAngle + arc / 2);
      ctx.textAlign = 'right';
      ctx.fillStyle = seg.textColor;
      ctx.font = 'bold ' + Math.max(12, Math.min(16, 200 / segCount)) + 'px sans-serif';
      ctx.fillText(seg.label, radius - 16, 5);
      ctx.restore();
    });
  }

  drawWheel();

  // Trigger logic
  const triggerType = overlay.dataset.trigger;
  const triggerDelay = parseInt(overlay.dataset.delay) || 3;
  const triggerScroll = parseInt(overlay.dataset.scroll) || 50;

  function showPopup() {
    overlay.classList.add('swp-overlay--visible');
  }

  if (triggerType === 'delay') {
    setTimeout(showPopup, triggerDelay * 1000);
  } else if (triggerType === 'scroll') {
    let triggered = false;
    window.addEventListener('scroll', function() {
      if (triggered) return;
      const scrollPct = (window.scrollY / (document.body.scrollHeight - window.innerHeight)) * 100;
      if (scrollPct >= triggerScroll) {
        triggered = true;
        showPopup();
      }
    });
  } else if (triggerType === 'exit') {
    let triggered = false;
    document.addEventListener('mouseleave', function(e) {
      if (triggered) return;
      if (e.clientY < 0) {
        triggered = true;
        showPopup();
      }
    });
  }

  // Close
  function closePopup() {
    overlay.classList.remove('swp-overlay--visible');
    setCookie(cookieKey, '1', cookieDays);
  }

  document.getElementById('swpClose').addEventListener('click', closePopup);
  document.getElementById('swpNoThanks').addEventListener('click', closePopup);
  overlay.addEventListener('click', function(e) {
    if (e.target === overlay) closePopup();
  });

  // Spin
  let isSpinning = false;
  const wheel = document.getElementById('swpWheel');
  const form = document.getElementById('swpForm');
  const spinBtn = document.getElementById('swpSpinBtn');

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    if (isSpinning) return;

    const emailInput = document.getElementById('swpEmail');
    if (!emailInput.value || !emailInput.validity.valid) {
      emailInput.focus();
      return;
    }

    isSpinning = true;
    spinBtn.disabled = true;

    // Pick winner from probability pool
    const winIndex = pool[Math.floor(Math.random() * pool.length)];
    const winSegment = segments[winIndex];

    // Calculate rotation – pointer is at 12 o'clock (top), segments are drawn
    // starting at -90° (also top). We need to land the winning segment's center
    // under the pointer after the wheel rotates clockwise.
    const segAngle = 360 / segCount;
    // The center of segment i sits at i * segAngle degrees from the top.
    // To bring it under the pointer we rotate by -(that angle) plus full turns.
    const targetAngle = -(winIndex * segAngle + segAngle / 2);
    const totalRotation = 360 * 5 + targetAngle;

    wheel.style.transform = 'rotate(' + totalRotation + 'deg)';

    // Show result after spin
    setTimeout(function() {
      document.getElementById('swpFormState').style.display = 'none';
      const result = document.getElementById('swpResult');
      result.classList.add('swp-result--visible');

      if (winSegment.code) {
        document.getElementById('swpResultTitle').textContent = '{{ section.settings.win_title }}';
        document.getElementById('swpResultMessage').textContent = winSegment.winMessage || '{{ section.settings.win_message }}';
        document.getElementById('swpDiscountCode').textContent = winSegment.code;
        document.getElementById('swpDiscountCode').style.display = 'inline-block';
        document.getElementById('swpCopyBtn').style.display = 'block';
      } else {
        document.getElementById('swpResultTitle').textContent = '{{ section.settings.lose_title }}';
        document.getElementById('swpResultMessage').textContent = '{{ section.settings.lose_message }}';
        document.getElementById('swpDiscountCode').style.display = 'none';
        document.getElementById('swpCopyBtn').style.display = 'none';
        document.querySelector('.swp-result-hint').style.display = 'none';
      }

      setCookie(cookieKey, '1', cookieDays);
    }, 4500);
  });

  // Copy code
  document.getElementById('swpCopyBtn').addEventListener('click', function() {
    const code = document.getElementById('swpDiscountCode').textContent;
    if (navigator.clipboard) {
      navigator.clipboard.writeText(code);
    }
    this.textContent = '{{ section.settings.copied_text }}';
    setTimeout(function() {
      document.getElementById('swpCopyBtn').textContent = '{{ section.settings.copy_button_text }}';
    }, 2000);
  });
})();
</script>


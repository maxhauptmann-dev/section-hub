{% comment %}
  Section Hub – Scroll Highlight Text v1.0
  Apple-style sticky text where words highlight from muted to vivid
  as the user scrolls. Cinematic editorial experience.
  Prefix: shht-
{% endcomment %}

{%- liquid
  assign heading_font  = section.settings.heading_font
  assign body_font     = section.settings.body_font
  assign bg_color      = section.settings.bg_color
  assign accent        = section.settings.accent_color
  assign muted_color   = section.settings.muted_color
  assign highlight     = section.settings.highlight_color
  assign use_gradient   = section.settings.use_gradient
  assign grad_from     = section.settings.grad_from
  assign grad_to       = section.settings.grad_to
  assign text_size     = section.settings.text_size
  assign text_lh       = section.settings.text_line_height
  assign text_align    = section.settings.text_alignment
  assign max_w         = section.settings.content_max_width
  assign padding_h_desktop = section.settings.padding_h_desktop
  assign padding_h_mobile  = section.settings.padding_h_mobile
  assign scroll_per    = section.settings.scroll_per_block
  assign bg_image      = section.settings.bg_image
  assign bg_img_op     = section.settings.bg_image_opacity
  assign show_noise    = section.settings.show_noise
  assign noise_op      = section.settings.noise_opacity
  assign show_progress = section.settings.show_side_progress
  assign show_side_lbl = section.settings.show_side_label
  assign side_text     = section.settings.side_label_text
  assign cta_style     = section.settings.cta_style
  assign btn_radius    = section.settings.cta_radius

  assign block_count   = section.blocks.size
  assign total_words   = 0
-%}

{%- comment -%} Count total words across all blocks {%- endcomment -%}
{%- for block in section.blocks -%}
  {%- assign wc = block.settings.text | split: ' ' | size -%}
  {%- assign total_words = total_words | plus: wc -%}
{%- endfor -%}

{%- assign total_scroll = scroll_per | times: block_count | plus: 100 -%}

<style>
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}

  .shht-wrap--{{ section.id }} {
    --shht-bg: {{ bg_color }};
    --shht-accent: {{ accent }};
    --shht-muted: {{ muted_color }};
    --shht-highlight: {{ highlight }};
    --shht-grad-from: {{ grad_from }};
    --shht-grad-to: {{ grad_to }};
    --shht-heading-ff: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --shht-heading-fw: {{ heading_font.weight }};
    --shht-heading-fs: {{ heading_font.style }};
    --shht-body-ff: {{ body_font.family }}, {{ body_font.fallback_families }};
    --shht-body-fw: {{ body_font.weight }};
    --shht-body-fs: {{ body_font.style }};
    --shht-text-size: {{ text_size }}px;
    --shht-text-lh: {{ text_lh | divided_by: 10.0 }};
    --shht-align: {{ text_align }};
    --shht-max-w: {{ max_w }}px;
    --shht-padding-h-desktop: {{ padding_h_desktop }}px;
    --shht-padding-h-mobile: {{ padding_h_mobile }}px;
    --shht-bg-img-op: {{ bg_img_op | divided_by: 100.0 }};
    --shht-noise-op: {{ noise_op | divided_by: 100.0 }};
    --shht-btn-radius: {{ btn_radius }}px;
  }
</style>

<section class="shht-wrap shht-wrap--{{ section.id }}" data-section-id="{{ section.id }}">

  {%- if bg_image != blank -%}
    <div class="shht-bg-image">
      <img
        src="{{ bg_image | image_url: width: 1920 }}"
        alt=""
        loading="lazy"
        width="{{ bg_image.width }}"
        height="{{ bg_image.height }}"
      >
    </div>
  {%- endif -%}

  {%- if show_noise -%}
    <div class="shht-noise"></div>
  {%- endif -%}

  <div class="shht-scroll" style="height: {{ total_scroll }}vh;" data-shht-scroll data-shht-total-words="{{ total_words }}">

    <div class="shht-sticky">

      {%- comment -%} Side label {%- endcomment -%}
      {%- if show_side_lbl and side_text != blank -%}
        <div class="shht-side-label">{{ side_text }}</div>
      {%- endif -%}

      {%- comment -%} Side progress {%- endcomment -%}
      {%- if show_progress -%}
        <div class="shht-progress-side" data-shht-pips>
          {%- for block in section.blocks -%}
            <div class="shht-progress-pip{% if forloop.first %} shht-pip--active{% endif %}" data-shht-pip="{{ forloop.index0 }}"></div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="shht-content">

        {%- if section.settings.eyebrow != blank -%}
          <div class="shht-eyebrow shht-visible">{{ section.settings.eyebrow }}</div>
        {%- endif -%}

        {%- assign global_word_index = 0 -%}
        {%- for block in section.blocks -%}
          <p class="shht-paragraph" data-shht-paragraph="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            {%- assign words = block.settings.text | split: ' ' -%}
            {%- for word in words -%}
              <span class="shht-word{% if use_gradient %} shht-word--gradient{% endif %}" data-shht-word="{{ global_word_index }}">{{ word }}</span> {%- assign global_word_index = global_word_index | plus: 1 -%}
            {%- endfor -%}
          </p>
        {%- endfor -%}

      </div>

      {%- if section.settings.cta_text != blank -%}
        <div class="shht-cta" data-shht-cta>
          <a href="{{ section.settings.cta_link | default: '#' }}" class="shht-cta__btn shht-cta__btn--{{ cta_style }}">
            {{ section.settings.cta_text }}
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      {%- endif -%}

    </div>
  </div>

</section>

<script>
  (function() {
    var section = document.querySelector('.shht-wrap--{{ section.id }}');
    if (!section) return;

    var scrollEl = section.querySelector('[data-shht-scroll]');
    var words = section.querySelectorAll('[data-shht-word]');
    var pips = section.querySelectorAll('[data-shht-pip]');
    var paragraphs = section.querySelectorAll('[data-shht-paragraph]');
    var cta = section.querySelector('[data-shht-cta]');

    if (!scrollEl || words.length === 0) return;

    var totalWords = words.length;
    var blockCount = paragraphs.length;
    var ticking = false;

    /* Build a word-to-paragraph mapping */
    var paragraphWordRanges = [];
    var idx = 0;
    paragraphs.forEach(function(p, pi) {
      var pWords = p.querySelectorAll('[data-shht-word]');
      paragraphWordRanges.push({ start: idx, end: idx + pWords.length - 1, index: pi });
      idx += pWords.length;
    });

    function update() {
      var rect = scrollEl.getBoundingClientRect();
      var scrolled = Math.max(0, -rect.top);
      var totalHeight = scrollEl.offsetHeight - window.innerHeight;

      if (totalHeight <= 0) return;

      var progress = Math.min(scrolled / totalHeight, 1);

      /* How many words should be highlighted */
      var activeCount = Math.round(progress * totalWords);

      words.forEach(function(w, i) {
        w.classList.toggle('shht-word--active', i < activeCount);
      });

      /* Update pips – which paragraph is currently being highlighted */
      var currentParagraph = 0;
      for (var p = 0; p < paragraphWordRanges.length; p++) {
        if (activeCount > paragraphWordRanges[p].start) {
          currentParagraph = p;
        }
      }

      pips.forEach(function(pip, i) {
        pip.classList.toggle('shht-pip--active', i === currentParagraph);
      });

      /* Show CTA when near the end */
      if (cta) {
        cta.classList.toggle('shht-visible', progress > 0.85);
      }

      ticking = false;
    }

    window.addEventListener('scroll', function() {
      if (!ticking) {
        requestAnimationFrame(update);
        ticking = true;
      }
    }, { passive: true });

    update();
  })();
</script>

{% schema %}
{
  "name": "SIQ - Highlight Text",
  "tag": "section",
  "class": "shht-section",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Our Philosophy"
    },
    {
      "type": "header",
      "content": "Text styling"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 24,
      "max": 72,
      "step": 4,
      "default": 44,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_line_height",
      "label": "Line height",
      "min": 10,
      "max": 20,
      "step": 1,
      "default": 13,
      "info": "In tenths (13 = 1.3)"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 600,
      "max": 1200,
      "step": 50,
      "default": 900,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_h_desktop",
      "label": "Horizontal padding (desktop)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "px",
      "info": "Left and right padding on desktop (1200px+)"
    },
    {
      "type": "range",
      "id": "padding_h_mobile",
      "label": "Horizontal padding (mobile)",
      "min": 8,
      "max": 50,
      "step": 2,
      "default": 16,
      "unit": "px",
      "info": "Left and right padding on mobile (under 750px)"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#60a5fa"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted word color",
      "default": "rgba(255,255,255,0.12)",
      "info": "Color of words before they are highlighted."
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlighted word color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Gradient mode"
    },
    {
      "type": "checkbox",
      "id": "use_gradient",
      "label": "Use gradient on highlighted words",
      "default": false,
      "info": "Instead of a solid color, highlighted words get a gradient fill."
    },
    {
      "type": "color",
      "id": "grad_from",
      "label": "Gradient from",
      "default": "#60a5fa"
    },
    {
      "type": "color",
      "id": "grad_to",
      "label": "Gradient to",
      "default": "#c084fc"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Text font",
      "default": "space_grotesk_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "UI font (eyebrow, button)",
      "default": "inter_n4"
    },
    {
      "type": "header",
      "content": "Scroll behaviour"
    },
    {
      "type": "range",
      "id": "scroll_per_block",
      "label": "Scroll per text block",
      "min": 80,
      "max": 250,
      "step": 10,
      "default": 150,
      "unit": "vh",
      "info": "How far the user scrolls per paragraph."
    },
    {
      "type": "header",
      "content": "Background image"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "bg_image_opacity",
      "label": "Image opacity",
      "min": 0,
      "max": 40,
      "step": 5,
      "default": 15,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Noise texture"
    },
    {
      "type": "checkbox",
      "id": "show_noise",
      "label": "Show noise texture",
      "default": true
    },
    {
      "type": "range",
      "id": "noise_opacity",
      "label": "Noise opacity",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 4,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Side indicators"
    },
    {
      "type": "checkbox",
      "id": "show_side_progress",
      "label": "Show side progress pips",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_side_label",
      "label": "Show side label",
      "default": true
    },
    {
      "type": "text",
      "id": "side_label_text",
      "label": "Side label text",
      "default": "Scroll to Read"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button text",
      "default": "Explore Further"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "CTA style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "outline", "label": "Outline" },
        { "value": "glass", "label": "Glass / Frosted" }
      ],
      "default": "glass"
    },
    {
      "type": "range",
      "id": "cta_radius",
      "label": "CTA border radius",
      "min": 0,
      "max": 40,
      "step": 4,
      "default": 8,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "paragraph",
      "name": "Text Block",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "We believe in the power of design to transform experiences and create lasting impressions."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SIQ - Highlight Text",
      "blocks": [
        {
          "type": "paragraph",
          "settings": {
            "text": "We craft experiences that go beyond the surface. Every detail is intentional, every interaction is considered, every moment is designed to resonate."
          }
        },
        {
          "type": "paragraph",
          "settings": {
            "text": "Our process begins with listening. We immerse ourselves in your world, understanding the subtle nuances that make your brand unique and irreplaceable."
          }
        },
        {
          "type": "paragraph",
          "settings": {
            "text": "The result is work that speaks for itself. Clean, purposeful, and unmistakably yours."
          }
        }
      ]
    }
  ]
}
{% endschema %}

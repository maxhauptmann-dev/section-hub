{% comment %}
  SectionHub – Upsell Carousel Drawer  (ucd-)
  Horizontal snap carousel with glassmorphism cards
{% endcomment %}

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font    = section.settings.body_font
  assign show_vendor  = section.settings.show_vendor
  assign show_price   = section.settings.show_price
  assign show_badge   = section.settings.show_savings
  assign img_ratio    = section.settings.image_ratio
  assign auto_play    = section.settings.auto_play
  assign auto_speed   = section.settings.auto_speed
-%}

<style>
  {{ heading_font | font_face }}
  {{ body_font | font_face }}

  #ucd-{{ section.id }} {
    --ucd-bg: {{ section.settings.bg_color }};
    --ucd-heading-c: {{ section.settings.heading_color }};
    --ucd-text-c: {{ section.settings.text_color }};
    --ucd-accent: {{ section.settings.accent_color }};
    --ucd-card-bg: {{ section.settings.card_bg }};
    --ucd-card-border: {{ section.settings.card_border }};
    --ucd-badge-bg: {{ section.settings.badge_color }};
    --ucd-btn-bg: {{ section.settings.btn_bg }};
    --ucd-btn-c: {{ section.settings.btn_color }};
    --ucd-heading-ff: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --ucd-heading-fw: {{ heading_font.weight }};
    --ucd-heading-fs: {{ heading_font.style }};
    --ucd-body-ff: {{ body_font.family }}, {{ body_font.fallback_families }};
    --ucd-body-fw: {{ body_font.weight }};
    --ucd-radius: {{ section.settings.card_radius }}px;
    --ucd-py: {{ section.settings.padding_top }}px;
    --ucd-pb: {{ section.settings.padding_bottom }}px;
    --ucd-px: {{ section.settings.padding_sides }}px;
    --ucd-max-w: {{ section.settings.max_width }}px;
    --ucd-img-ratio: {{ img_ratio }};
  }
</style>

<section id="ucd-{{ section.id }}" class="ucd-wrap">

  {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
    <div class="ucd-header" data-ucd-el>
      {%- if section.settings.eyebrow != blank -%}
        <span class="ucd-header__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="ucd-header__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="ucd-header__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%} Navigation arrows + track wrapper {%- endcomment -%}
  <div class="ucd-slider-outer" data-ucd-el>
    <button class="ucd-nav ucd-nav--prev" data-ucd-prev aria-label="Previous">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <div class="ucd-track-viewport">
      <div class="ucd-track" data-ucd-track>
        {%- for block in section.blocks -%}
          {%- if block.type == 'product_card' -%}
            {%- assign p = block.settings.product -%}

            <div class="ucd-card" data-ucd-card {{ block.shopify_attributes }}>
              {%- comment -%} Glassmorphism layer {%- endcomment -%}
              <div class="ucd-card__glass"></div>

              {%- comment -%} Image {%- endcomment -%}
              <div class="ucd-card__media">
                {%- if block.settings.custom_image != blank -%}
                  <img
                    src="{{ block.settings.custom_image | image_url: width: 480 }}"
                    alt="{{ p.title | default: 'Product' | escape }}"
                    loading="lazy"
                    class="ucd-card__img"
                  >
                {%- elsif p != blank and p.featured_image -%}
                  <img
                    src="{{ p.featured_image | image_url: width: 480 }}"
                    alt="{{ p.featured_image.alt | default: p.title | escape }}"
                    loading="lazy"
                    class="ucd-card__img"
                  >
                {%- else -%}
                  <div class="ucd-card__placeholder">
                    {{ 'product-1' | placeholder_svg_tag: 'ucd-card__svg' }}
                  </div>
                {%- endif -%}

                {%- if show_badge and p != blank and p.compare_at_price > p.price -%}
                  {%- assign save_pct = p.compare_at_price | minus: p.price | times: 100 | divided_by: p.compare_at_price -%}
                  <span class="ucd-card__badge">Save {{ save_pct }}%</span>
                {%- endif -%}
              </div>

              {%- comment -%} Info {%- endcomment -%}
              <div class="ucd-card__info">
                {%- if p != blank -%}
                  {%- if show_vendor and p.vendor != blank -%}
                    <span class="ucd-card__vendor">{{ p.vendor }}</span>
                  {%- endif -%}
                  <h3 class="ucd-card__title">
                    <a href="{{ p.url }}">{{ p.title }}</a>
                  </h3>

                  {%- if show_price -%}
                    <div class="ucd-card__price">
                      {%- if p.compare_at_price > p.price -%}
                        <span class="ucd-card__price-old">{{ p.compare_at_price | money }}</span>
                      {%- endif -%}
                      <span class="ucd-card__price-now">{{ p.price | money }}</span>
                    </div>
                  {%- endif -%}

                  {%- if block.settings.label_text != blank -%}
                    <p class="ucd-card__label">{{ block.settings.label_text }}</p>
                  {%- endif -%}

                  <a href="{{ p.url }}" class="ucd-card__btn">
                    {{ section.settings.btn_text }}
                  </a>
                {%- else -%}
                  <p class="ucd-card__empty">Select a product</p>
                {%- endif -%}
              </div>
            </div>

          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <button class="ucd-nav ucd-nav--next" data-ucd-next aria-label="Next">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M7.5 5L12.5 10L7.5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>

  {%- comment -%} Dots & progress {%- endcomment -%}
  <div class="ucd-footer" data-ucd-el>
    <div class="ucd-dots" data-ucd-dots></div>
    <div class="ucd-progress"><div class="ucd-progress__bar" data-ucd-bar></div></div>
  </div>

</section>

<script>
(function(){
  var root = document.getElementById('ucd-{{ section.id }}');
  if (!root) return;

  /* Entrance animation */
  var obs = new IntersectionObserver(function(es){
    es.forEach(function(e){
      if (e.isIntersecting){ e.target.classList.add('ucd-visible'); obs.unobserve(e.target); }
    });
  },{ threshold: 0.15 });
  root.querySelectorAll('[data-ucd-el]').forEach(function(el){ obs.observe(el); });

  /* Carousel logic */
  var track  = root.querySelector('[data-ucd-track]');
  var cards  = root.querySelectorAll('[data-ucd-card]');
  var dots   = root.querySelector('[data-ucd-dots]');
  var bar    = root.querySelector('[data-ucd-bar]');
  var prev   = root.querySelector('[data-ucd-prev]');
  var next   = root.querySelector('[data-ucd-next]');
  var total  = cards.length;
  if (total < 1) return;

  /* Build dots */
  for (var i = 0; i < total; i++){
    var d = document.createElement('button');
    d.className = 'ucd-dot' + (i === 0 ? ' ucd-dot--active' : '');
    d.setAttribute('aria-label', 'Go to slide ' + (i+1));
    d.dataset.idx = i;
    dots.appendChild(d);
  }
  var allDots = dots.querySelectorAll('.ucd-dot');

  function update(){
    var vp = track.parentElement;
    var sl = vp.scrollLeft;
    var sw = vp.scrollWidth - vp.clientWidth;
    var pct = sw > 0 ? sl / sw : 0;
    bar.style.width = (pct * 100) + '%';

    var idx = 0;
    var minDist = Infinity;
    cards.forEach(function(c, ci){
      var dist = Math.abs(c.offsetLeft - sl - vp.offsetLeft);
      if (dist < minDist){ minDist = dist; idx = ci; }
    });
    allDots.forEach(function(dd, di){ dd.classList.toggle('ucd-dot--active', di === idx); });
  }

  track.parentElement.addEventListener('scroll', update, { passive: true });

  function scrollTo(idx){
    if (idx < 0) idx = total - 1;
    if (idx >= total) idx = 0;
    cards[idx].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
  }

  prev.addEventListener('click', function(){
    var vp = track.parentElement;
    var cur = Math.round(vp.scrollLeft / (cards[0].offsetWidth + 20));
    scrollTo(cur - 1);
  });
  next.addEventListener('click', function(){
    var vp = track.parentElement;
    var cur = Math.round(vp.scrollLeft / (cards[0].offsetWidth + 20));
    scrollTo(cur + 1);
  });
  dots.addEventListener('click', function(e){
    var btn = e.target.closest('.ucd-dot');
    if (btn) scrollTo(parseInt(btn.dataset.idx));
  });

  /* Autoplay */
  var autoPlay = {{ auto_play }};
  var autoSpeed = {{ auto_speed }};
  if (autoPlay && total > 1){
    var intv;
    function startAuto(){ intv = setInterval(function(){
      var vp = track.parentElement;
      var cur = Math.round(vp.scrollLeft / (cards[0].offsetWidth + 20));
      scrollTo(cur + 1);
    }, autoSpeed); }
    startAuto();
    root.addEventListener('mouseenter', function(){ clearInterval(intv); });
    root.addEventListener('mouseleave', function(){ startAuto(); });
  }

  update();
})();
</script>

{% schema %}
{
  "name": "Upsell Carousel",
  "tag": "section",
  "class": "ucd-section",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "You Might Also Like"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complete Your Look"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Hand-picked products that pair perfectly with your selection."
    },
    {
      "type": "header",
      "content": "Carousel"
    },
    {
      "type": "checkbox",
      "id": "auto_play",
      "label": "Auto-play",
      "default": false
    },
    {
      "type": "range",
      "id": "auto_speed",
      "label": "Auto-play interval",
      "min": 2000,
      "max": 8000,
      "step": 500,
      "default": 4000,
      "unit": "ms"
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "1 / 1", "label": "Square 1:1" },
        { "value": "4 / 5", "label": "Portrait 4:5" },
        { "value": "3 / 4", "label": "Portrait 3:4" },
        { "value": "16 / 9", "label": "Landscape 16:9" }
      ],
      "default": "1 / 1"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 28,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max section width",
      "min": 900,
      "max": 1400,
      "step": 20,
      "default": 1200,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Product Details"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_savings",
      "label": "Show savings badge",
      "default": true
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button text",
      "default": "View Product"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "playfair_display_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "inter_n4"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#f4f2ee"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Card border",
      "default": "#e8e4de"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text",
      "default": "#6b6b6b"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#b8864e"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge",
      "default": "#d64545"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button bg",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 20,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_sides",
      "label": "Side padding",
      "min": 16,
      "max": 80,
      "step": 4,
      "default": 28,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Slide",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom image (optional)"
        },
        {
          "type": "text",
          "id": "label_text",
          "label": "Short label",
          "default": "Perfect pairing"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SS - Upsell Carousel",
      "settings": {
        "eyebrow": "You Might Also Like",
        "heading": "Complete Your Look",
        "subtext": "Hand-picked products that pair perfectly with your selection.",
        "auto_play": false,
        "show_vendor": true,
        "show_price": true,
        "show_savings": true,
        "btn_text": "View Product"
      },
      "blocks": [
        { "type": "product_card", "settings": { "label_text": "Perfect pairing" } },
        { "type": "product_card", "settings": { "label_text": "Customers love this" } },
        { "type": "product_card", "settings": { "label_text": "Limited edition" } },
        { "type": "product_card", "settings": { "label_text": "Trending now" } }
      ]
    }
  ]
}
{% endschema %}

{{ 'featured-collection-tabs.css' | asset_url | stylesheet_tag }}

<div class="featured-collection-tabs-section color-{{ section.settings.color_scheme }}" style="
  --max-width: {{ section.settings.max_width }}%;
  --primary-color: {{ section.settings.primary_color }};
  --secondary-color: {{ section.settings.secondary_color }};
  --accent-color: {{ section.settings.accent_color }};
  --border-color: {{ section.settings.border_color }};
  --section-padding-top: {{ section.settings.section_padding_top }}px;
  --section-padding-bottom: {{ section.settings.section_padding_bottom }}px;
  --section-padding-sides: {{ section.settings.section_padding_sides }}rem;
  --section-padding-sides-mobile: {{ section.settings.section_padding_sides_mobile }}rem;
  --section-margin-top: {{ section.settings.section_margin_top }}px;
  --section-margin-bottom: {{ section.settings.section_margin_bottom }}px;
  --section-border-thickness: {{ section.settings.section_border_thickness }}px;
  --section-border-radius: {{ section.settings.section_border_radius }}px;
">
  <div class="page-width">
    <div class="section-header" style="text-align: {{ section.settings.alignment }};">
      {% if section.settings.heading != blank %}
        <h2 class="section-heading {% if section.settings.use_custom_heading_font %}custom-heading-font{% endif %}" 
            style="{% if section.settings.use_custom_heading_font %}font-size: {{ section.settings.heading_font_size }}px; line-height: {{ section.settings.heading_line_height }}%;{% endif %}">
          {{ section.settings.heading }}
        </h2>
      {% endif %}
      
      {% if section.settings.text != blank %}
        <div class="section-description">
          {{ section.settings.text }}
        </div>
      {% endif %}
    </div>

    <div class="tabs-wrapper">
      <div class="tab-buttons" role="tablist">
        {% for block in section.blocks %}
          {% if block.type == 'collection' %}
            <button 
              class="tab-button {% if forloop.first %}active{% endif %} {% if section.settings.use_custom_tab_font %}custom-tab-font{% endif %}"
              style="
                {% if section.settings.use_custom_tab_font %}
                  font-size: {{ section.settings.tab_font_size }}px;
                  font-size-mobile: {{ section.settings.tab_font_size_mobile }}px;
                {% endif %}
                {% if section.settings.tab_background %}
                  background-color: {{ section.settings.tab_bg_color }};
                  border-radius: {{ section.settings.tab_border_radius }}px;
                  border: {{ section.settings.tab_border_thickness }}px solid {{ section.settings.accent_color }};
                {% endif %}
              "
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="tab-panel-{{ block.id }}"
              data-tab-index="{{ forloop.index0 }}">
              {{ block.settings.tab_label }}
            </button>
          {% endif %}
        {% endfor %}
      </div>

      <div class="tab-panels">
        {% for block in section.blocks %}
          {% if block.type == 'collection' %}
            <div 
              id="tab-panel-{{ block.id }}" 
              class="tab-panel {% if forloop.first %}active{% endif %}"
              role="tabpanel"
              data-tab-index="{{ forloop.index0 }}">
              
              <div class="product-slider" data-products-desktop="{{ section.settings.products_to_show }}" data-products-mobile="{{ section.settings.products_to_show_mobile }}">
                {% if section.settings.show_navigation_arrows_desktop %}
                  <button class="slider-arrow slider-arrow-prev desktop-only" 
                          aria-label="Previous"
                          style="
                            width: {{ section.settings.arrow_size }}px;
                            height: {{ section.settings.arrow_size }}px;
                            border-radius: {{ section.settings.arrow_border_radius }}px;
                            border: {{ section.settings.arrow_border_thickness }}px solid {{ section.settings.accent_color }};
                            left: {{ section.settings.arrow_position_horizontal }}%;
                            top: {{ section.settings.arrow_position_vertical }}%;
                          ">
                    <svg width="{{ section.settings.arrow_icon_size }}" height="{{ section.settings.arrow_icon_size }}" viewBox="0 0 24 24" fill="none">
                      <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                {% endif %}

                {% if section.settings.show_navigation_arrows_mobile %}
                  <button class="slider-arrow slider-arrow-prev mobile-only" 
                          aria-label="Previous"
                          style="
                            width: {{ section.settings.arrow_size }}px;
                            height: {{ section.settings.arrow_size }}px;
                            border-radius: {{ section.settings.arrow_border_radius }}px;
                            border: {{ section.settings.arrow_border_thickness }}px solid {{ section.settings.accent_color }};
                          ">
                    <svg width="{{ section.settings.arrow_icon_size }}" height="{{ section.settings.arrow_icon_size }}" viewBox="0 0 24 24" fill="none">
                      <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                {% endif %}

                <div class="product-grid">
                  {% assign collection = collections[block.settings.collection] %}
                  {% if collection != blank and collection.products_count > 0 %}
                    {% for product in collection.products limit: 20 %}
                      <div class="product-card">
                        <div class="product-image" 
                             style="
                               aspect-ratio: {% if section.settings.image_aspect_ratio == 'square' %}1/1{% elsif section.settings.image_aspect_ratio == 'portrait' %}3/4{% elsif section.settings.image_aspect_ratio == 'landscape' %}4/3{% else %}auto{% endif %};
                             ">
                          {% if product.featured_image %}
                            <img 
                              src="{{ product.featured_image | image_url: width: 600 }}"
                              alt="{{ product.featured_image.alt | escape }}"
                              loading="lazy"
                              {% if section.settings.image_hover_type == 'zoom' %}class="hover-zoom"{% endif %}>
                          {% else %}
                            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                          {% endif %}
                        </div>

                        {% if section.settings.show_vendor %}
                          <div class="product-vendor {% if section.settings.use_custom_vendor_font %}custom-vendor-font{% endif %}"
                               style="{% if section.settings.use_custom_vendor_font %}font-size: {{ section.settings.vendor_font_size }}px;{% endif %}">
                            {{ product.vendor }}
                          </div>
                        {% endif %}

                        <h3 class="product-title {% if section.settings.use_custom_title_font %}custom-title-font{% endif %}"
                            style="{% if section.settings.use_custom_title_font %}font-size: {{ section.settings.title_font_size }}px; line-height: {{ section.settings.title_line_height }}%;{% endif %}">
                          <a href="{{ product.url }}">{{ product.title }}</a>
                        </h3>

                        {% if section.settings.show_product_details %}
                          <div class="product-details {% if section.settings.use_custom_details_font %}custom-details-font{% endif %}"
                               style="{% if section.settings.use_custom_details_font %}font-size: {{ section.settings.details_font_size }}px;{% endif %}">
                            {{ product.metafields.custom.description }}
                          </div>
                        {% endif %}

                        {% if section.settings.show_price %}
                          <div class="product-price {% if section.settings.use_custom_price_font %}custom-price-font{% endif %}"
                               style="{% if section.settings.use_custom_price_font %}font-size: {{ section.settings.price_font_size }}px;{% endif %}">
                            {% if product.compare_at_price > product.price %}
                              <span class="price-compare">{{ product.compare_at_price | money }}</span>
                            {% endif %}
                            <span class="price-regular">{{ product.price | money }}</span>
                          </div>
                        {% endif %}

                        {% if section.settings.show_compare_price and product.compare_at_price > product.price %}
                          <div class="product-compare-price">
                            {{ product.compare_at_price | money }}
                          </div>
                        {% endif %}

                        {% if section.settings.product_button_label != blank %}
                          <a href="{{ product.url }}" 
                             class="product-button {% if section.settings.product_button_style == 'outline' %}button-outline{% else %}button-solid{% endif %} {% if section.settings.use_custom_button_font %}custom-button-font{% endif %} {% if section.settings.full_width_button_mobile %}full-width-mobile{% endif %}"
                             style="
                               {% if section.settings.use_custom_button_font %}font-size: {{ section.settings.button_font_size }}px;{% endif %}
                               border-radius: {{ section.settings.button_border_radius }}px;
                               border-width: {{ section.settings.button_border_thickness }}px;
                             "
                             {% if section.settings.open_link_new_tab %}target="_blank"{% endif %}>
                            {{ section.settings.product_button_label }}
                          </a>
                        {% endif %}
                      </div>
                    {% endfor %}
                  {% else %}
                    <p>{{ 'sections.featured_collection.no_products' | t }}</p>
                  {% endif %}
                </div>

                {% if section.settings.show_navigation_arrows_desktop %}
                  <button class="slider-arrow slider-arrow-next desktop-only" 
                          aria-label="Next"
                          style="
                            width: {{ section.settings.arrow_size }}px;
                            height: {{ section.settings.arrow_size }}px;
                            border-radius: {{ section.settings.arrow_border_radius }}px;
                            border: {{ section.settings.arrow_border_thickness }}px solid {{ section.settings.accent_color }};
                            right: {{ section.settings.arrow_position_horizontal }}%;
                            top: {{ section.settings.arrow_position_vertical }}%;
                          ">
                    <svg width="{{ section.settings.arrow_icon_size }}" height="{{ section.settings.arrow_icon_size }}" viewBox="0 0 24 24" fill="none">
                      <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                {% endif %}

                {% if section.settings.show_navigation_arrows_mobile %}
                  <button class="slider-arrow slider-arrow-next mobile-only" 
                          aria-label="Next"
                          style="
                            width: {{ section.settings.arrow_size }}px;
                            height: {{ section.settings.arrow_size }}px;
                            border-radius: {{ section.settings.arrow_border_radius }}px;
                            border: {{ section.settings.arrow_border_thickness }}px solid {{ section.settings.accent_color }};
                          ">
                    <svg width="{{ section.settings.arrow_icon_size }}" height="{{ section.settings.arrow_icon_size }}" viewBox="0 0 24 24" fill="none">
                      <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                {% endif %}
              </div>

              {% if section.settings.show_shop_all_button %}
                <div class="shop-all-wrapper">
                  <a href="{{ collections[block.settings.collection].url }}" 
                     class="shop-all-button {% if section.settings.shop_all_button_style == 'outline' %}button-outline{% else %}button-solid{% endif %} {% if section.settings.use_custom_shop_all_font %}custom-shop-all-font{% endif %} {% if section.settings.full_width_shop_all_mobile %}full-width-mobile{% endif %}"
                     style="
                       {% if section.settings.use_custom_shop_all_font %}font-size: {{ section.settings.shop_all_font_size }}px;{% endif %}
                       border-radius: {{ section.settings.shop_all_border_radius }}px;
                       border-width: {{ section.settings.shop_all_border_thickness }}px;
                     "
                     {% if section.settings.open_link_new_tab %}target="_blank"{% endif %}>
                    {{ section.settings.shop_all_button_label }}
                  </a>
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<script>
  class FeaturedCollectionTabs extends HTMLElement {
    constructor() {
      super();
      this.init();
    }

    init() {
      const tabButtons = this.querySelectorAll('.tab-button');
      const tabPanels = this.querySelectorAll('.tab-panel');

      tabButtons.forEach((button, index) => {
        button.addEventListener('click', () => {
          // Remove active class from all buttons and panels
          tabButtons.forEach(btn => {
            btn.classList.remove('active');
            btn.setAttribute('aria-selected', 'false');
          });
          tabPanels.forEach(panel => panel.classList.remove('active'));

          // Add active class to clicked button and corresponding panel
          button.classList.add('active');
          button.setAttribute('aria-selected', 'true');
          tabPanels[index].classList.add('active');

          // Initialize slider for the active panel
          this.initSlider(tabPanels[index]);
        });
      });

      // Initialize slider for the first (active) panel
      const activePanel = this.querySelector('.tab-panel.active');
      if (activePanel) {
        this.initSlider(activePanel);
      }
    }

    initSlider(panel) {
      const slider = panel.querySelector('.product-slider');
      const grid = slider.querySelector('.product-grid');
      const prevButton = slider.querySelector('.slider-arrow-prev');
      const nextButton = slider.querySelector('.slider-arrow-next');
      const cards = grid.querySelectorAll('.product-card');
      
      const isMobile = window.innerWidth < 768;
      const productsToShow = isMobile 
        ? parseFloat(slider.dataset.productsMobile) 
        : parseFloat(slider.dataset.productsDesktop);

      let currentIndex = 0;
      const maxIndex = Math.max(0, cards.length - Math.floor(productsToShow));

      const updateSlider = () => {
        const cardWidth = cards[0]?.offsetWidth || 0;
        const gap = 16; // Default gap
        const offset = currentIndex * (cardWidth + gap);
        grid.style.transform = `translateX(-${offset}px)`;

        if (prevButton) prevButton.disabled = currentIndex === 0;
        if (nextButton) nextButton.disabled = currentIndex >= maxIndex;
      };

      if (prevButton) {
        prevButton.addEventListener('click', () => {
          if (currentIndex > 0) {
            currentIndex--;
            updateSlider();
          }
        });
      }

      if (nextButton) {
        nextButton.addEventListener('click', () => {
          if (currentIndex < maxIndex) {
            currentIndex++;
            updateSlider();
          }
        });
      }

      // Initial update
      updateSlider();

      // Update on window resize
      let resizeTimer;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          currentIndex = 0;
          updateSlider();
        }, 250);
      });
    }
  }

  customElements.define('featured-collection-tabs', FeaturedCollectionTabs);

  // Wrap the section in the custom element
  document.addEventListener('DOMContentLoaded', () => {
    const sections = document.querySelectorAll('.featured-collection-tabs-section');
    sections.forEach(section => {
      const wrapper = document.createElement('featured-collection-tabs');
      section.parentNode.insertBefore(wrapper, section);
      wrapper.appendChild(section);
    });
  });
</script>


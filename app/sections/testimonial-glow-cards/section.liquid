{{ 'section-testimonial-glow-cards.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id
  assign bg = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign glow1 = section.settings.glow_color_1
  assign glow2 = section.settings.glow_color_2
  assign glow3 = section.settings.glow_color_3
  assign card_bg = section.settings.card_bg
  assign card_border = section.settings.card_border
  assign quote_color = section.settings.quote_color
  assign name_color = section.settings.name_color
  assign role_color = section.settings.role_color
  assign star_color = section.settings.star_color
  assign badge_color = section.settings.badge_color
  assign max_w = section.settings.max_width
  assign pad_y = section.settings.padding_y
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom
  assign q_size = section.settings.quote_size
  assign radius = section.settings.border_radius
  assign columns = section.settings.columns
  assign gap = section.settings.gap
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign heading_align = section.settings.heading_align
  assign show_stars = section.settings.show_stars
  assign show_badge = section.settings.show_badge
  assign show_photo = section.settings.show_photo
  assign glow_anim = section.settings.glow_animation
  assign glassmorphism = section.settings.glassmorphism
  assign glow_speed = section.settings.glow_speed
-%}

<div
  id="tg-glow-{{ sid }}"
  class="tg-glow"
  style="
    --tg-bg:{{ bg }};
    --tg-text:{{ text_color }};
    --tg-glow1:{{ glow1 }};
    --tg-glow2:{{ glow2 }};
    --tg-glow3:{{ glow3 }};
    --tg-card-bg:{{ card_bg }};
    --tg-card-border:{{ card_border }};
    --tg-quote:{{ quote_color }};
    --tg-name:{{ name_color }};
    --tg-role:{{ role_color }};
    --tg-star:{{ star_color }};
    --tg-badge:{{ badge_color }};
    --tg-max-w:{{ max_w }}px;
    --tg-pad-y:{{ pad_y }}px;
    --tg-mt:{{ mt }}px;
    --tg-mb:{{ mb }}px;
    --tg-q-size:{{ q_size }}px;
    --tg-radius:{{ radius }}px;
    --tg-cols:{{ columns }};
    --tg-gap:{{ gap }}px;
    --tg-glow-speed:{{ glow_speed }}s;
  "
>
  <!-- Ambient bg orbs -->
  <div class="tg-glow__ambient">
    <div class="tg-glow__orb tg-glow__orb--1"></div>
    <div class="tg-glow__orb tg-glow__orb--2"></div>
    <div class="tg-glow__orb tg-glow__orb--3"></div>
  </div>

  <div class="tg-glow__inner">
    {%- if heading != blank or subheading != blank -%}
      <div class="tg-glow__header" style="text-align:{{ heading_align }}">
        {%- if heading != blank -%}
          <h2 class="tg-glow__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if subheading != blank -%}
          <p class="tg-glow__sub">{{ subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="tg-glow__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign quote = block.settings.quote
          assign name = block.settings.name
          assign role = block.settings.role
          assign rating = block.settings.rating
          assign photo = block.settings.photo
          assign badge = block.settings.badge
        -%}
        <div
          class="tg-glow__card{% if glow_anim %} tg-glow__card--animated{% endif %}{% if glassmorphism %} tg-glow__card--glass{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="tg-glow__card-border" aria-hidden="true"></div>
          <div class="tg-glow__card-content">
            <div class="tg-glow__card-top">
              <div class="tg-glow__author-row">
                {%- if show_photo -%}
                  {%- if photo != blank -%}
                    <img class="tg-glow__avatar" src="{{ photo | image_url: width: 80 }}" alt="{{ name | escape }}" width="40" height="40" loading="lazy">
                  {%- else -%}
                    <span class="tg-glow__avatar-ph">{{ name | slice: 0, 1 }}</span>
                  {%- endif -%}
                {%- endif -%}
                <div>
                  <span class="tg-glow__name">{{ name }}</span>
                  {%- if role != blank -%}
                    <span class="tg-glow__role">{{ role }}</span>
                  {%- endif -%}
                </div>
              </div>
              {%- if show_badge and badge != blank -%}
                <span class="tg-glow__badge">{{ badge }}</span>
              {%- endif -%}
            </div>

            {%- if show_stars -%}
              <div class="tg-glow__stars" aria-label="{{ rating }} out of 5 stars">
                {%- for i in (1..5) -%}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="{% if i <= rating %}var(--tg-star){% else %}none{% endif %}" stroke="var(--tg-star)" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                {%- endfor -%}
              </div>
            {%- endif -%}

            <blockquote class="tg-glow__quote">{{ quote }}</blockquote>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "SIQ - Glow Reviews",
  "tag": "section",
  "class": "section-testimonial-glow-cards",
  "settings": [
    {
      "type": "header",

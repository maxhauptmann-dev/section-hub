      "id": "title",
      "label": "Headline",
      "default": "Get 20% Off Your First Order"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle / Description",
      "default": "Sign up now for your exclusive welcome discount and shop our best-selling products."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Side Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image Alt Text",
      "default": "Newsletter signup"
    },
    {
      "type": "header",
      "content": "Form Fields"
    },
    {
      "type": "checkbox",
      "id": "show_name_field",
      "label": "Show Name Field",
      "default": true
    },
    {
      "type": "text",
      "id": "name_placeholder",

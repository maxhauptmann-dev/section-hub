      "default": "No thanks, I don't want discounts"
    },
    {
      "type": "header",
      "content": "Success State"
    },
    {
      "type": "text",
      "id": "success_emoji",
      "label": "Success Emoji",
      "default": "🎉"
    },
    {
      "type": "text",
      "id": "success_title",
      "label": "Success Title",
      "default": "Welcome aboard!"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "Here is your discount code:"
    },
    {
      "type": "text",
      "id": "copy_hint",
      "label": "Copy Hint Text",
      "default": "Click the code or button to copy"
    },
    {
      "type": "text",
      "id": "copy_btn_text",
      "label": "Copy Button Text",
      "default": "Copy Code"
    },
    {

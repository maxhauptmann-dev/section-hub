{% comment %}
  Section Hub – Newsletter Popup v1.0
  Email signup popup with image, customizable fields, and discount code display.
{% endcomment %}

{{ 'section-newsletter-popup.css' | asset_url | stylesheet_tag }}

<!-- Overlay -->
<div class="nlp-overlay" id="nlpOverlay-{{ section.id }}"
  data-trigger="{{ section.settings.trigger_type }}"
  data-delay="{{ section.settings.trigger_delay }}"
  data-scroll="{{ section.settings.trigger_scroll }}"
  data-cookie-days="{{ section.settings.cookie_days }}"
  data-section-id="{{ section.id }}"
  data-discount-code="{{ section.settings.discount_code }}"
  style="
    --nlp-overlay-bg: {{ section.settings.overlay_bg }};
    --nlp-modal-bg: {{ section.settings.modal_bg }};
    --nlp-modal-radius: {{ section.settings.modal_radius }}px;
    --nlp-max-width: {{ section.settings.modal_width }}px;
    --nlp-heading-color: {{ section.settings.heading_color }};
    --nlp-text-color: {{ section.settings.text_color }};
    --nlp-accent: {{ section.settings.accent_color }};
    --nlp-title-size: {{ section.settings.title_size | divided_by: 100.0 }}em;
    --nlp-subtitle-size: {{ section.settings.subtitle_size | divided_by: 100.0 }}em;
    --nlp-input-border: {{ section.settings.input_border }};
    --nlp-input-bg: {{ section.settings.input_bg }};
    --nlp-input-radius: {{ section.settings.input_radius }}px;
    --nlp-btn-bg: {{ section.settings.btn_bg }};
    --nlp-btn-text: {{ section.settings.btn_text_color }};
    --nlp-btn-radius: {{ section.settings.btn_radius }}px;
    --nlp-close-bg: {{ section.settings.close_bg }};
    --nlp-close-color: {{ section.settings.close_color }};
    --nlp-placeholder-color: {{ section.settings.placeholder_color }};
  "
>
  <div class="nlp-modal">
    <button class="nlp-close" id="nlpClose-{{ section.id }}" aria-label="Close">&times;</button>

    <!-- Left: Form -->
    <div class="nlp-form-panel">
      <!-- Form State -->
      <div id="nlpFormState-{{ section.id }}">
        {%- if section.settings.logo != blank -%}
          <div class="nlp-logo">
            <img
              src="{{ section.settings.logo | image_url: width: 300 }}"
              alt="{{ shop.name }}"
              width="150"
              height="44"
              loading="lazy"
            >
          </div>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h2 class="nlp-title">{{ section.settings.title }}</h2>
        {%- endif -%}

        {%- if section.settings.subtitle != blank -%}
          <p class="nlp-subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        <form class="nlp-form" id="nlpForm-{{ section.id }}" onsubmit="return false;">
          {%- if section.settings.show_name_field -%}
            <input
              class="nlp-input"
              type="text"
              id="nlpName-{{ section.id }}"
              placeholder="{{ section.settings.name_placeholder }}"
            >
          {%- endif -%}
          <input
            class="nlp-input"
            type="email"
            id="nlpEmail-{{ section.id }}"
            placeholder="{{ section.settings.email_placeholder }}"
            required
          >
          <button type="submit" class="nlp-submit-btn" id="nlpSubmitBtn-{{ section.id }}">
            {{ section.settings.btn_text }}
          </button>
        </form>

        {%- if section.settings.terms_text != blank -%}
          <p class="nlp-terms">{{ section.settings.terms_text }}</p>
        {%- endif -%}

        {%- if section.settings.show_no_thanks -%}
          <button class="nlp-no-thanks" id="nlpNoThanks-{{ section.id }}">
            {{ section.settings.no_thanks_text }}
          </button>
        {%- endif -%}
      </div>

      <!-- Success State -->
      <div class="nlp-success" id="nlpSuccess-{{ section.id }}">
        <div class="nlp-success-emoji">{{ section.settings.success_emoji }}</div>
        <h2 class="nlp-success-title" id="nlpSuccessTitle-{{ section.id }}">{{ section.settings.success_title }}</h2>
        <p class="nlp-success-message">{{ section.settings.success_message }}</p>

        {%- if section.settings.discount_code != blank -%}
          <div class="nlp-discount-code" id="nlpDiscountCode-{{ section.id }}">
            {{ section.settings.discount_code }}
          </div>
          <p class="nlp-copy-hint">{{ section.settings.copy_hint }}</p>
          <button class="nlp-copy-btn" id="nlpCopyBtn-{{ section.id }}">
            {{ section.settings.copy_btn_text }}
          </button>
        {%- endif -%}
      </div>
    </div>

    <!-- Right: Image -->
    <div class="nlp-image-panel{% if section.settings.image == blank %} nlp-image-panel--empty{% endif %}">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 800 }}"
          alt="{{ section.settings.image_alt | default: section.settings.title }}"
          loading="lazy"
        >
      {%- endif -%}
    </div>
  </div>
</div>

<script>
(function() {
  var sid = {{ section.id | json }};
  var overlay = document.getElementById('nlpOverlay-' + sid);
  if (!overlay) return;

  var sectionId = overlay.dataset.sectionId;
  var cookieKey = 'nlp_shown_' + sectionId;
  var cookieDays = parseInt(overlay.dataset.cookieDays) || 7;

  /* ── Cookie helpers ── */
  function getCookie(name) {
    var v = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
    return v ? v.pop() : '';
  }
  function setCookie(name, val, days) {
    var d = new Date();
    d.setTime(d.getTime() + days * 86400000);
    document.cookie = name + '=' + val + ';expires=' + d.toUTCString() + ';path=/;SameSite=Lax';
  }

  // Don't show if already shown
  if (getCookie(cookieKey) === '1') return;

  /* ── Show / Close ── */
  function showPopup() {
    overlay.classList.add('nlp-overlay--visible');
  }
  function closePopup() {
    overlay.classList.remove('nlp-overlay--visible');
    setCookie(cookieKey, '1', cookieDays);
  }

  /* ── Trigger ── */
  var triggerType = overlay.dataset.trigger;
  var triggerDelay = parseInt(overlay.dataset.delay) || 3;
  var triggerScroll = parseInt(overlay.dataset.scroll) || 50;

  if (triggerType === 'delay') {
    setTimeout(showPopup, triggerDelay * 1000);
  } else if (triggerType === 'scroll') {
    var scrollTriggered = false;
    window.addEventListener('scroll', function() {
      if (scrollTriggered) return;
      var pct = (window.scrollY / (document.body.scrollHeight - window.innerHeight)) * 100;
      if (pct >= triggerScroll) {
        scrollTriggered = true;
        showPopup();
      }
    });
  } else if (triggerType === 'exit') {
    var exitTriggered = false;
    document.addEventListener('mouseleave', function(e) {
      if (exitTriggered) return;
      if (e.clientY < 0) {
        exitTriggered = true;
        showPopup();
      }
    });
  }

  /* ── Close handlers ── */
  document.getElementById('nlpClose-' + sid).addEventListener('click', closePopup);
  var noThanks = document.getElementById('nlpNoThanks-' + sid);
  if (noThanks) noThanks.addEventListener('click', closePopup);
  overlay.addEventListener('click', function(e) {
    if (e.target === overlay) closePopup();
  });

  /* ── Form submit ── */
  var form = document.getElementById('nlpForm-' + sid);
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var emailInput = document.getElementById('nlpEmail-' + sid);
    if (!emailInput.value || !emailInput.validity.valid) {
      emailInput.focus();
      return;
    }

    // Hide form, show success
    document.getElementById('nlpFormState-' + sid).style.display = 'none';
    var success = document.getElementById('nlpSuccess-' + sid);
    success.classList.add('nlp-success--visible');

    setCookie(cookieKey, '1', cookieDays);
  });

  /* ── Copy discount code ── */
  var copyBtn = document.getElementById('nlpCopyBtn-' + sid);
  var codeEl = document.getElementById('nlpDiscountCode-' + sid);
  if (copyBtn && codeEl) {
    function copyCode() {
      var code = codeEl.textContent.trim();
      if (navigator.clipboard) {
        navigator.clipboard.writeText(code);
      }
      copyBtn.textContent = {{ section.settings.copied_text | json }};
      setTimeout(function() {
        copyBtn.textContent = {{ section.settings.copy_btn_text | json }};
      }, 2000);
    }
    copyBtn.addEventListener('click', copyCode);
    codeEl.addEventListener('click', copyCode);
  }
})();
</script>

{% schema %}
{
  "name": "Newsletter Popup",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {

      "default": "Name"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email Placeholder",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "GET 20% OFF"
    },
    {
      "type": "header",
      "content": "Discount Code"
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount Code",
      "info": "Leave empty to not show a code after signup.",

        { "type": "card", "settings": { "icon": "🛡️", "title": "Lifetime Guarantee", "description": "We stand behind every product. If anything goes wrong, we make it right.", "badge": "Guarantee" } },
        { "type": "card", "settings": { "icon": "🌿", "title": "Sustainability First", "description": "Carbon-neutral production. Recyclable packaging. A commitment to the planet." } }
      ]
    }
  ]
}
{% endschema %}

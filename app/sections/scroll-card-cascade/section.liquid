    {
      "name": "SIQ - Card Cascade",
      "blocks": [
        { "type": "card", "settings": { "icon": "🚀", "title": "Lightning Fast Shipping", "description": "Orders shipped within 24 hours. Free express delivery on all orders over $99.", "badge": "Fast" } },

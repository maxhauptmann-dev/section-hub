{{ 'section-testimonial-hero-slider.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sid = section.id
  assign bg = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign accent = section.settings.accent_color
  assign accent2 = section.settings.accent_end
  assign quote_color = section.settings.quote_color
  assign name_color = section.settings.name_color
  assign role_color = section.settings.role_color
  assign star_color = section.settings.star_color
  assign dot_color = section.settings.dot_color
  assign dot_active = section.settings.dot_active
  assign max_w = section.settings.max_width
  assign pad_y = section.settings.padding_y
  assign mt = section.settings.margin_top
  assign mb = section.settings.margin_bottom
  assign q_size = section.settings.quote_size
  assign name_size = section.settings.name_size
  assign heading = section.settings.heading
  assign heading_align = section.settings.heading_align
  assign show_stars = section.settings.show_stars
  assign show_quote_mark = section.settings.show_quote_mark
  assign show_photo = section.settings.show_photo
  assign show_arrows = section.settings.show_arrows
  assign autoplay = section.settings.autoplay
  assign autoplay_speed = section.settings.autoplay_speed
  assign avatar_size = section.settings.avatar_size
  assign transition_style = section.settings.transition_style
-%}

<div
  id="th-slider-{{ sid }}"
  class="th-slider"
  style="
    --th-bg:{{ bg }};
    --th-text:{{ text_color }};
    --th-accent:{{ accent }};
    --th-accent2:{{ accent2 }};
    --th-quote:{{ quote_color }};
    --th-name:{{ name_color }};
    --th-role:{{ role_color }};
    --th-star:{{ star_color }};
    --th-dot:{{ dot_color }};
    --th-dot-active:{{ dot_active }};
    --th-max-w:{{ max_w }}px;
    --th-pad-y:{{ pad_y }}px;
    --th-mt:{{ mt }}px;
    --th-mb:{{ mb }}px;
    --th-q-size:{{ q_size }}px;
    --th-name-size:{{ name_size }}px;
    --th-avatar:{{ avatar_size }}px;
  "
>
  <div class="th-slider__inner">
    {%- if heading != blank -%}
      <h2 class="th-slider__heading" style="text-align:{{ heading_align }}">{{ heading }}</h2>
    {%- endif -%}

    <div class="th-slider__viewport">
      <div class="th-slider__track" data-th-track="{{ sid }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign quote = block.settings.quote
            assign name = block.settings.name
            assign role = block.settings.role
            assign rating = block.settings.rating
            assign photo = block.settings.photo
          -%}
          <div
            class="th-slider__slide{% if forloop.first %} th-slider__slide--active{% endif %}{% if transition_style == 'fade' %} th-slider__slide--fade{% endif %}"
            data-th-slide="{{ sid }}"
            {{ block.shopify_attributes }}
          >
            {%- if show_quote_mark -%}
              <div class="th-slider__qmark" aria-hidden="true">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" opacity=".3"><path d="M3 21c3 0 7-1 7-8V5c0-1.25-.76-2.02-2-2H4c-1.25 0-2 .75-2 1.97V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .01-1 1.01V21z"/><path d="M15 21c3 0 7-1 7-8V5c0-1.25-.76-2.02-2-2h-4c-1.25 0-2 .75-2 1.97V11c0 1.25.75 2 2 2h.5c0 0 .5 0 .5 1v1c0 1-1 2-2 2s-1 .01-1 1.01V21z"/></svg>
              </div>
            {%- endif -%}

            {%- if show_stars -%}
              <div class="th-slider__stars">
                {%- for i in (1..5) -%}
                  {%- if i <= rating -%}
                    <svg viewBox="0 0 24 24" fill="var(--th-star)" width="22" height="22"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="var(--th-star)" stroke-width="1.5" width="22" height="22"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14l-5-4.87 6.91-1.01L12 2z"/></svg>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

            <blockquote class="th-slider__quote">{{ quote }}</blockquote>

            <div class="th-slider__author">
              {%- if show_photo and photo != blank -%}
                <img
                  class="th-slider__avatar"
                  src="{{ photo | image_url: width: 160 }}"
                  alt="{{ name | escape }}"
                  width="{{ avatar_size }}"
                  height="{{ avatar_size }}"
                  loading="lazy"
                >
              {%- endif -%}
              <div class="th-slider__author-info">
                <span class="th-slider__name">{{ name }}</span>
                {%- if role != blank -%}
                  <span class="th-slider__role">{{ role }}</span>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if show_arrows -%}
        <button class="th-slider__arrow th-slider__arrow--prev" data-th-prev="{{ sid }}" aria-label="Previous review">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <button class="th-slider__arrow th-slider__arrow--next" data-th-next="{{ sid }}" aria-label="Next review">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      {%- endif -%}
    </div>

    <div class="th-slider__dots" data-th-dots="{{ sid }}"></div>
  </div>
</div>

<script>
(function(){
  var sid='{{ sid }}';
  var root=document.getElementById('th-slider-'+sid);
  if(!root)return;
  var slides=root.querySelectorAll('[data-th-slide="'+sid+'"]');
  var dotsWrap=root.querySelector('[data-th-dots="'+sid+'"]');
  var prev=root.querySelector('[data-th-prev="'+sid+'"]');
  var next=root.querySelector('[data-th-next="'+sid+'"]');
  var current=0;
  var total=slides.length;
  if(!total)return;

  function buildDots(){
    dotsWrap.innerHTML='';
    for(var i=0;i<total;i++){
      var d=document.createElement('button');
      d.className='th-slider__dot'+(i===0?' th-slider__dot--active':'');
      d.setAttribute('aria-label','Review '+(i+1));
      d.dataset.idx=i;
      d.addEventListener('click',function(){goTo(parseInt(this.dataset.idx));});
      dotsWrap.appendChild(d);
    }
  }

  function goTo(idx){
    slides[current].classList.remove('th-slider__slide--active');
    current=(idx%total+total)%total;
    slides[current].classList.add('th-slider__slide--active');
    var dots=dotsWrap.querySelectorAll('.th-slider__dot');
    dots.forEach(function(d,i){d.classList.toggle('th-slider__dot--active',i===current);});
  }

  if(prev)prev.addEventListener('click',function(){goTo(current-1);});
  if(next)next.addEventListener('click',function(){goTo(current+1);});
  buildDots();

  {% if autoplay %}
  var iv=setInterval(function(){goTo(current+1);},{{ autoplay_speed }}000);
  root.addEventListener('mouseenter',function(){clearInterval(iv);});
  root.addEventListener('mouseleave',function(){iv=setInterval(function(){goTo(current+1);},{{ autoplay_speed }}000);});
  {% endif %}
})();
</script>


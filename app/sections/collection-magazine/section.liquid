{% comment %}
  SectionHub – Collection Magazine  (cmg-)
  Editorial magazine-style collection grid
{% endcomment %}

{%- assign sid = section.id -%}
{%- assign heading_font = section.settings.heading_font -%}
{%- assign body_font    = section.settings.body_font -%}
{%- assign layout       = section.settings.layout -%}

<style>
  {{ heading_font | font_face }}
  {{ body_font | font_face }}

  #cmg-{{ sid }} {
    --cmg-bg: {{ section.settings.bg_color }};
    --cmg-accent: {{ section.settings.accent_color }};
    --cmg-heading-color: {{ section.settings.heading_color }};
    --cmg-text-color: {{ section.settings.text_color }};
    --cmg-overlay-color: {{ section.settings.overlay_color }};
    --cmg-card-text: {{ section.settings.card_text_color }};
    --cmg-heading-ff: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --cmg-heading-fw: {{ heading_font.weight }};
    --cmg-heading-fs: {{ heading_font.style }};
    --cmg-body-ff: {{ body_font.family }}, {{ body_font.fallback_families }};
    --cmg-body-fw: {{ body_font.weight }};
    --cmg-radius: {{ section.settings.card_radius }}px;
    --cmg-gap: {{ section.settings.card_gap }}px;
    --cmg-hero-ratio: {{ section.settings.hero_ratio }};
    --cmg-side-ratio: {{ section.settings.side_ratio }};
    --cmg-py: {{ section.settings.padding_y }}px;
    --cmg-px: {{ section.settings.padding_x }}px;
    --cmg-max-w: {{ section.settings.max_width }}px;
    --cmg-overlay-o: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
</style>

<section id="cmg-{{ sid }}" class="cmg-wrap" data-cmg-reveal>
  {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subtext != blank -%}
    <div class="cmg-header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="cmg-header__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="cmg-header__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="cmg-header__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="cmg-grid cmg-grid--{{ layout }}">
    {%- for block in section.blocks -%}
      {%- assign col = block.settings.collection -%}
      {%- assign col_obj = collections[col] -%}
      {%- assign card_title = block.settings.title -%}
      {%- if card_title == blank and col_obj != blank -%}
        {%- assign card_title = col_obj.title -%}
      {%- endif -%}
      {%- assign link_url = block.settings.link -%}
      {%- if link_url == blank and col_obj != blank -%}
        {%- assign link_url = col_obj.url -%}
      {%- endif -%}
      {%- assign card_image = block.settings.image -%}
      {%- if card_image == blank and col_obj != blank -%}
        {%- assign card_image = col_obj.image -%}
      {%- endif -%}

      {%- comment -%} Determine if this is a "hero" card based on layout {%- endcomment -%}
      {%- assign is_hero = false -%}
      {%- if layout == 'hero-left' and forloop.first -%}
        {%- assign is_hero = true -%}
      {%- endif -%}
      {%- if layout == 'hero-right' and forloop.first -%}
        {%- assign is_hero = true -%}
      {%- endif -%}
      {%- assign idx_mod = forloop.index0 | modulo: 3 -%}
      {%- if layout == 'alternating' and idx_mod == 0 -%}
        {%- assign is_hero = true -%}
      {%- endif -%}

      <a class="cmg-card{% if is_hero %} cmg-card--hero{% endif %}"
         href="{{ link_url | default: '#' }}"
         data-cmg-card
         style="--cmg-delay: {{ forloop.index0 | times: 0.1 }}s"
         {{ block.shopify_attributes }}>

        <div class="cmg-card__media">
          {%- if card_image != blank -%}
            <img
              class="cmg-card__img"
              src="{{ card_image | image_url: width: 1000 }}"
              srcset="{{ card_image | image_url: width: 500 }} 500w,
                      {{ card_image | image_url: width: 800 }} 800w,
                      {{ card_image | image_url: width: 1000 }} 1000w,
                      {{ card_image | image_url: width: 1400 }} 1400w"
              sizes="(max-width:768px) 100vw, {% if is_hero %}60vw{% else %}40vw{% endif %}"
              alt="{{ card_title | escape }}"
              loading="lazy"
            >
          {%- else -%}
            <div class="cmg-card__placeholder">
              <svg width="48" height="48" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
            </div>
          {%- endif -%}
          <div class="cmg-card__overlay"></div>
        </div>

        <div class="cmg-card__content">
          {%- if block.settings.tag != blank -%}
            <span class="cmg-card__tag">{{ block.settings.tag }}</span>
          {%- endif -%}
          {%- if card_title != blank -%}
            <h3 class="cmg-card__title">{{ card_title }}</h3>
          {%- endif -%}
          {%- if block.settings.subtitle != blank -%}
            <p class="cmg-card__subtitle">{{ block.settings.subtitle }}</p>
          {%- endif -%}
          {%- if block.settings.btn_text != blank -%}
            <span class="cmg-card__btn">
              {{ block.settings.btn_text }}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          {%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

<script>
  (function(){
    var wrap = document.getElementById('cmg-{{ sid }}');
    if(!wrap) return;

    var cards = Array.from(wrap.querySelectorAll('[data-cmg-card]'));

    /* staggered scroll reveal */
    if('IntersectionObserver' in window){
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(en){
          if(en.isIntersecting){
            en.target.classList.add('cmg-visible');
            io.unobserve(en.target);
          }
        });
      }, {threshold: 0.1, rootMargin: '0px 0px -40px 0px'});

      /* reveal wrap */
      var wrapObs = new IntersectionObserver(function(entries){
        entries.forEach(function(en){
          if(en.isIntersecting){
            en.target.classList.add('cmg-visible');
            /* then reveal cards staggered */
            cards.forEach(function(c){ io.observe(c); });
            wrapObs.unobserve(en.target);
          }
        });
      }, {threshold: 0.05});
      wrapObs.observe(wrap);
    } else {
      wrap.classList.add('cmg-visible');
      cards.forEach(function(c){ c.classList.add('cmg-visible'); });
    }
  })();
</script>

{% schema %}

      "id": "card_height",
      "label": "Card height",
      "min": 180,
      "max": 360,
      "step": 10,
      "default": 250,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 45,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "space_grotesk_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "inter_n4"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#0a0a12"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#f0f0f5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text",
      "default": "#9090a8"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#7c6bf5"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Glow color",
      "default": "#6c5ce7"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card fallback bg",

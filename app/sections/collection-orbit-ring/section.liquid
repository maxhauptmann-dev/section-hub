{% comment %}
  Section Hub – Collection Orbit Ring  (cor-)
  3D orbital carousel with auto-rotating collection cards.
{% endcomment %}

{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font    = section.settings.body_font

  assign bg           = section.settings.bg_color
  assign heading_c    = section.settings.heading_color
  assign text_c       = section.settings.text_color
  assign accent       = section.settings.accent_color
  assign glow_c       = section.settings.glow_color
  assign card_bg      = section.settings.card_bg

  assign orbit_r      = section.settings.orbit_radius
  assign card_w       = section.settings.card_width
  assign card_h       = section.settings.card_height
  assign card_radius  = section.settings.card_radius
  assign tilt_x       = section.settings.tilt_angle
  assign speed        = section.settings.speed
  assign direction    = section.settings.direction
  assign auto_play    = section.settings.auto_play
  assign pause_hover  = section.settings.pause_hover
  assign show_glow    = section.settings.show_glow
  assign overlay_o    = section.settings.overlay_opacity

  assign py           = section.settings.padding_top
  assign pb           = section.settings.padding_bottom
  assign px           = section.settings.padding_sides

  assign block_count  = section.blocks.size
  assign angle_step   = 360.0 | divided_by: block_count
-%}

<style>
  {{ heading_font | font_face }}
  {{ body_font | font_face }}

  #cor-{{ section.id }} {
    --cor-bg: {{ bg }};
    --cor-heading-c: {{ heading_c }};
    --cor-text-c: {{ text_c }};
    --cor-accent: {{ accent }};
    --cor-glow: {{ glow_c }};
    --cor-card-bg: {{ card_bg }};
    --cor-heading-ff: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --cor-heading-fw: {{ heading_font.weight }};
    --cor-heading-fs: {{ heading_font.style }};
    --cor-body-ff: {{ body_font.family }}, {{ body_font.fallback_families }};
    --cor-body-fw: {{ body_font.weight }};
    --cor-orbit-r: {{ orbit_r }}px;
    --cor-card-w: {{ card_w }}px;
    --cor-card-h: {{ card_h }}px;
    --cor-radius: {{ card_radius }}px;
    --cor-tilt: {{ tilt_x }}deg;
    --cor-speed: {{ speed }}s;
    --cor-overlay-o: {{ overlay_o | divided_by: 100.0 }};
    --cor-py: {{ py }}px;
    --cor-pb: {{ pb }}px;
    --cor-px: {{ px }}px;
  }
</style>

<section id="cor-{{ section.id }}" class="cor-wrap" data-cor-reveal>

  {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subtext != blank -%}
    <div class="cor-header" data-cor-el>
      {%- if section.settings.eyebrow != blank -%}
        <span class="cor-header__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="cor-header__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="cor-header__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if show_glow -%}
    <div class="cor-glow"></div>
  {%- endif -%}

  <div class="cor-scene">
    <div
      class="cor-ring{% if auto_play %} cor-ring--spin{% endif %}{% if direction == 'cw' %} cor-ring--cw{% else %} cor-ring--ccw{% endif %}{% if pause_hover %} cor-ring--pause{% endif %}"
      data-cor-ring
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign col_obj = collections[col]
          assign img = block.settings.image
          assign title = block.settings.title
          assign tag = block.settings.tag
          assign subtitle = block.settings.subtitle
          assign link = block.settings.link

          if title == blank and col_obj != blank
            assign title = col_obj.title
          endif
          if img == blank and col_obj != blank
            assign img = col_obj.image
          endif
          assign url = link
          if url == blank and col_obj != blank
            assign url = col_obj.url
          endif

          assign rotation = forloop.index0 | times: angle_step
        -%}

        <div
          class="cor-item"
          style="--cor-angle: {{ rotation }}deg;"
          {{ block.shopify_attributes }}
        >
          <a href="{{ url | default: '#' }}" class="cor-card" {% if url != blank %}aria-label="View {{ title }}"{% endif %}>
            <div class="cor-card__media">
              {%- if img != blank -%}
                <img
                  src="{{ img | image_url: width: 600 }}"
                  alt="{{ img.alt | default: title | escape }}"
                  width="300"
                  height="400"
                  loading="lazy"
                  class="cor-card__img"
                >
              {%- else -%}
                <div class="cor-card__placeholder">
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                </div>
              {%- endif -%}
              <div class="cor-card__gradient"></div>
            </div>

            <div class="cor-card__content">
              {%- if tag != blank -%}
                <span class="cor-card__tag">{{ tag }}</span>
              {%- endif -%}
              {%- if title != blank -%}
                <h3 class="cor-card__title">{{ title }}</h3>
              {%- endif -%}
              {%- if subtitle != blank -%}
                <p class="cor-card__subtitle">{{ subtitle }}</p>
              {%- endif -%}
            </div>

            <div class="cor-card__shine"></div>
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>

</section>

<script>
  (function(){
    var wrap = document.getElementById('cor-{{ section.id }}');
    if (!wrap) return;

    /* Scroll reveal */
    var obs = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting) {
          e.target.classList.add('cor-visible');
          obs.unobserve(e.target);
        }
      });
    }, { threshold: 0.15 });

    var header = wrap.querySelector('[data-cor-el]');
    if (header) obs.observe(header);
    obs.observe(wrap.querySelector('.cor-scene'));
  })();
</script>

{% schema %}
{
  "name": "Collection Orbit",
  "tag": "section",
  "class": "cor-section",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Discover"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore Our Universe"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Browse our collections in a whole new dimension."
    },
    {
      "type": "header",
      "content": "Orbit"
    },
    {
      "type": "range",
      "id": "orbit_radius",
      "label": "Orbit radius",
      "min": 200,
      "max": 500,
      "step": 10,
      "default": 320,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "tilt_angle",
      "label": "Tilt angle",
      "min": 40,
      "max": 75,
      "step": 1,
      "default": 60,
      "unit": "deg"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Rotation speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "default": 30,
      "unit": "s",
      "info": "Seconds per full rotation"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        { "value": "cw", "label": "Clockwise" },
        { "value": "ccw", "label": "Counter-clockwise" }
      ],
      "default": "cw"
    },
    {
      "type": "checkbox",
      "id": "auto_play",
      "label": "Auto-rotate",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pause_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_glow",
      "label": "Show glow effect",
      "default": true

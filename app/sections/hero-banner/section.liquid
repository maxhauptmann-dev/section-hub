<style>
  {% render 'styles.css' %}
</style>

{%- comment -%} Count how many media slides we have {%- endcomment -%}
{%- assign hb_slide_count = 0 -%}
{%- if section.settings.video != blank or section.settings.video_url != blank or section.settings.image != blank -%}
  {%- assign hb_slide_count = 1 -%}
{%- endif -%}
{%- if section.settings.video_2 != blank or section.settings.video_url_2 != blank or section.settings.image_2 != blank -%}
  {%- assign hb_slide_count = hb_slide_count | plus: 1 -%}
{%- endif -%}

<section class="hb-section" id="hb-{{ section.id }}" data-slide-count="{{ hb_slide_count }}" data-interval="{{ section.settings.slide_interval }}" style="
  --hb-height: {{ section.settings.section_height }}vh;
  --hb-height-mobile: {{ section.settings.section_height_mobile }}vh;
  --hb-bg-fallback: {{ section.settings.bg_fallback }};
  --hb-overlay: {{ section.settings.overlay_color }};
  --hb-text-color: {{ section.settings.text_color }};
  --hb-text-align: {{ section.settings.text_align }};
  --hb-content-items: {% if section.settings.text_align == 'left' %}flex-start{% elsif section.settings.text_align == 'right' %}flex-end{% else %}center{% endif %};
  --hb-content-max-width: {{ section.settings.content_max_width }}px;
  --hb-content-py: {{ section.settings.content_padding_y }}px;
  --hb-content-px: {{ section.settings.content_padding_x }}px;
  --hb-vertical-align: {% if section.settings.vertical_align == 'top' %}flex-start{% elsif section.settings.vertical_align == 'bottom' %}flex-end{% else %}center{% endif %};
  --hb-heading-size: {{ section.settings.heading_size | divided_by: 100.0 }}em;
  --hb-heading-weight: {{ section.settings.heading_weight }};
  --hb-subheading-size: {{ section.settings.subheading_size | divided_by: 100.0 }}em;
  --hb-desc-size: {{ section.settings.description_size | divided_by: 100.0 }}em;
  --hb-btn1-bg: {{ section.settings.btn1_bg }};
  --hb-btn1-text: {{ section.settings.btn1_text_color }};
  --hb-btn2-bg: {{ section.settings.btn2_bg }};
  --hb-btn2-text: {{ section.settings.btn2_text_color }};
  --hb-btn-radius: {{ section.settings.btn_radius }}px;
  --hb-btn-py: {{ section.settings.btn_padding_y }}px;
  --hb-btn-px: {{ section.settings.btn_padding_x }}px;
  --hb-btn-size: {{ section.settings.btn_font_size | divided_by: 100.0 }}em;
  --hb-btn-gap: {{ section.settings.btn_gap }}px;
  --hb-mt: {{ section.settings.margin_top }}px;
  --hb-mb: {{ section.settings.margin_bottom }}px;
">
  <!-- ========== SLIDE 1 — Desktop ========== -->
  <div class="hb-media hb-media--desktop hb-slide hb-slide--active" data-slide="0">
    {%- if section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          controls: false
      }}
    {%- elsif section.settings.video_url != blank -%}
      {%- if section.settings.video_url.type == 'youtube' -%}
        <iframe
          src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ section.settings.video_url.id }}&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1"
          allow="autoplay; encrypted-media"
          allowfullscreen
          style="position:absolute;inset:0;width:100%;height:100%;border:none;pointer-events:none;"
          loading="lazy"
        ></iframe>
      {%- elsif section.settings.video_url.type == 'vimeo' -%}
        <iframe
          src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1&muted=1&loop=1&background=1&playsinline=1"
          allow="autoplay; encrypted-media"
          allowfullscreen
          style="position:absolute;inset:0;width:100%;height:100%;border:none;pointer-events:none;"
          loading="lazy"
        ></iframe>
      {%- endif -%}
    {%- elsif section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 2400 }}"
        srcset="
          {{ section.settings.image | image_url: width: 1200 }} 1200w,
          {{ section.settings.image | image_url: width: 1800 }} 1800w,
          {{ section.settings.image | image_url: width: 2400 }} 2400w
        "
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: section.settings.heading }}"
        loading="eager"
        fetchpriority="high"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
      >
    {%- endif -%}
  </div>

  <!-- ========== SLIDE 2 — Desktop ========== -->
  {%- if hb_slide_count > 1 -%}
    <div class="hb-media hb-media--desktop hb-slide" data-slide="1">
      {%- if section.settings.video_2 != blank -%}
        {{
          section.settings.video_2
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            playsinline: true,
            controls: false
        }}
      {%- elsif section.settings.video_url_2 != blank -%}
        {%- if section.settings.video_url_2.type == 'youtube' -%}
          <iframe
            src="https://www.youtube.com/embed/{{ section.settings.video_url_2.id }}?autoplay=1&mute=1&loop=1&playlist={{ section.settings.video_url_2.id }}&controls=0&showinfo=0&rel=0&modestbranding=1&playsinline=1"
            allow="autoplay; encrypted-media"
            allowfullscreen
            style="position:absolute;inset:0;width:100%;height:100%;border:none;pointer-events:none;"
            loading="lazy"
          ></iframe>
        {%- elsif section.settings.video_url_2.type == 'vimeo' -%}
          <iframe
            src="https://player.vimeo.com/video/{{ section.settings.video_url_2.id }}?autoplay=1&muted=1&loop=1&background=1&playsinline=1"
            allow="autoplay; encrypted-media"
            allowfullscreen
            style="position:absolute;inset:0;width:100%;height:100%;border:none;pointer-events:none;"
            loading="lazy"
          ></iframe>
        {%- endif -%}
      {%- elsif section.settings.image_2 != blank -%}
        <img
          src="{{ section.settings.image_2 | image_url: width: 2400 }}"
          srcset="
            {{ section.settings.image_2 | image_url: width: 1200 }} 1200w,
            {{ section.settings.image_2 | image_url: width: 1800 }} 1800w,
            {{ section.settings.image_2 | image_url: width: 2400 }} 2400w
          "
          sizes="100vw"
          alt="{{ section.settings.image_2.alt | default: section.settings.heading }}"
          loading="eager"
          width="{{ section.settings.image_2.width }}"
          height="{{ section.settings.image_2.height }}"
        >
      {%- endif -%}
    </div>
  {%- endif -%}

  <!-- ========== SLIDE 1 — Mobile ========== -->
  <div class="hb-media hb-media--mobile hb-slide hb-slide--active" data-slide="0">
    {%- if section.settings.video_mobile != blank -%}
      {{
        section.settings.video_mobile
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          controls: false
      }}
    {%- elsif section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          controls: false
      }}
    {%- elsif section.settings.image_mobile != blank -%}
      <img
        src="{{ section.settings.image_mobile | image_url: width: 900 }}"
        srcset="
          {{ section.settings.image_mobile | image_url: width: 600 }} 600w,
          {{ section.settings.image_mobile | image_url: width: 900 }} 900w
        "
        sizes="100vw"
        alt="{{ section.settings.image_mobile.alt | default: section.settings.heading }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- elsif section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 900 }}"
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: section.settings.heading }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
  </div>

  <!-- ========== SLIDE 2 — Mobile ========== -->
  {%- if hb_slide_count > 1 -%}
    <div class="hb-media hb-media--mobile hb-slide" data-slide="1">
      {%- if section.settings.video_mobile_2 != blank -%}
        {{
          section.settings.video_mobile_2
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            playsinline: true,
            controls: false
        }}
      {%- elsif section.settings.video_2 != blank -%}
        {{
          section.settings.video_2
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            playsinline: true,
            controls: false
        }}
      {%- elsif section.settings.image_mobile != blank -%}
        <img
          src="{{ section.settings.image_mobile | image_url: width: 900 }}"
          sizes="100vw"
          alt="{{ section.settings.image_mobile.alt | default: section.settings.heading }}"
          loading="eager"
        >
      {%- elsif section.settings.image_2 != blank -%}
        <img
          src="{{ section.settings.image_2 | image_url: width: 900 }}"
          sizes="100vw"
          alt="{{ section.settings.image_2.alt | default: section.settings.heading }}"
          loading="eager"
        >
      {%- endif -%}
    </div>
  {%- endif -%}

  <!-- Overlay -->
  {%- if section.settings.show_overlay -%}
    <div class="hb-overlay"></div>
  {%- endif -%}

  <!-- Content -->
  <div class="hb-content">
    {%- if section.settings.subheading != blank -%}
      <p class="hb-subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="hb-heading">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <p class="hb-description">{{ section.settings.description }}</p>
    {%- endif -%}

    {%- if section.settings.btn1_text != blank or section.settings.btn2_text != blank -%}
      <div class="hb-buttons">
        {%- if section.settings.btn1_text != blank -%}
          <a href="{{ section.settings.btn1_link }}" class="hb-btn hb-btn--primary">
            {{ section.settings.btn1_text }}
          </a>
        {%- endif -%}
        {%- if section.settings.btn2_text != blank -%}
          <a href="{{ section.settings.btn2_link }}" class="hb-btn hb-btn--secondary">
            {{ section.settings.btn2_text }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <!-- Slide indicator dots -->
  {%- if hb_slide_count > 1 and section.settings.show_slide_dots -%}
    <div class="hb-scroll-indicator">
      <button class="hb-scroll-dot hb-scroll-dot--active" data-goto="0" aria-label="Slide 1"></button>
      <button class="hb-scroll-dot" data-goto="1" aria-label="Slide 2"></button>
    </div>
  {%- endif -%}
</section>

<!-- Slide switching script -->
{%- if hb_slide_count > 1 -%}
<script>
  (function(){
    var wrap = document.getElementById('hb-{{ section.id }}');
    if (!wrap) return;
    var interval = parseInt(wrap.dataset.interval, 10) * 1000;
    var current = 0;
    var total = parseInt(wrap.dataset.slideCount, 10);
    var dots = wrap.querySelectorAll('.hb-scroll-dot');

    function showSlide(idx) {
      wrap.querySelectorAll('.hb-slide').forEach(function(s) {
        var si = parseInt(s.dataset.slide, 10);
        if (si === idx) {
          s.classList.add('hb-slide--active');
        } else {
          s.classList.remove('hb-slide--active');
        }
      });
      dots.forEach(function(d, i) {
        d.classList.toggle('hb-scroll-dot--active', parseInt(d.dataset.goto, 10) === idx);
      });
      current = idx;
    }

    dots.forEach(function(d) {
      d.addEventListener('click', function() {
        showSlide(parseInt(d.dataset.goto, 10));
      });
    });

    setInterval(function() {
      showSlide((current + 1) % total);
    }, interval);
  })();
</script>
{%- endif -%}


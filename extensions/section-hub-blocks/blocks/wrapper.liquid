{% comment %}
  Section Hub - Wrapper Block
  Wraps the product info area in a card with optional benefit icons below
{% endcomment %}

{% if shop.metafields.sectioniq.premium == "active" %}

<style>
.sh-wrapper {
  background: {{ block.settings.bg_color }};
  border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
  border-radius: {{ block.settings.border_radius }}px;
  padding: {{ block.settings.padding }}px;
  {% if block.settings.shadow %}
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
  {% endif %}
  margin: 12px 0;
}

.sh-wrapper__benefits {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px {{ block.settings.benefits_gap }}px;
  margin-top: {{ block.settings.benefits_top }}px;
  padding-top: {{ block.settings.benefits_top }}px;
  border-top: 1px solid {{ block.settings.border_color }};
}

.sh-wrapper__benefit {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: {{ block.settings.benefits_size }}px;
  color: {{ block.settings.text_color }};
  line-height: 1.3;
}

.sh-wrapper__benefit-icon {
  flex-shrink: 0;
  font-size: {{ block.settings.benefits_size | plus: 2 }}px;
  line-height: 1;
}
</style>

<div class="sh-wrapper">
  {% comment %} App blocks don't wrap other content — this is a visual card with benefits below {% endcomment %}

  {% assign has_benefits = false %}
  {% if block.settings.benefit_1 != blank or block.settings.benefit_2 != blank or block.settings.benefit_3 != blank %}
    {% assign has_benefits = true %}
  {% endif %}

  {% if has_benefits %}
    <div class="sh-wrapper__benefits">
      {% if block.settings.benefit_1 != blank %}
        <span class="sh-wrapper__benefit">
          <span class="sh-wrapper__benefit-icon">{{ block.settings.benefit_1_icon }}</span>
          {{ block.settings.benefit_1 }}
        </span>
      {% endif %}

      {% if block.settings.benefit_2 != blank %}
        <span class="sh-wrapper__benefit">
          <span class="sh-wrapper__benefit-icon">{{ block.settings.benefit_2_icon }}</span>
          {{ block.settings.benefit_2 }}
        </span>
      {% endif %}

      {% if block.settings.benefit_3 != blank %}
        <span class="sh-wrapper__benefit">
          <span class="sh-wrapper__benefit-icon">{{ block.settings.benefit_3_icon }}</span>
          {{ block.settings.benefit_3 }}
        </span>
      {% endif %}
    </div>
  {% endif %}
</div>

{% else %}
<div style="padding:12px;margin:12px 0;background:#f8f5ff;border:1px solid #ddd6fe;border-radius:8px;text-align:center;font-size:13px;color:#6b7280;">
  👑 This block requires <strong style="color:#4f46e5;">SectionIQ Premium</strong>
</div>
{% endif %}

{% schema %}
{
  "name": "Wrapper",
  "target": "section",
  "settings": [
    {
      "type": "header",
      "content": "Container"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#e5e7eb"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#374151"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border Width",
      "min": 0,
      "max": 4,
      "step": 1,
      "default": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Padding",
      "min": 8,
      "max": 32,
      "step": 4,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "shadow",
      "label": "Box Shadow",
      "default": true
    },
    {
      "type": "header",
      "content": "Benefits"
    },
    {
      "type": "text",
      "id": "benefit_1_icon",
      "label": "Benefit 1 Icon",
      "default": "💳"
    },
    {
      "type": "text",
      "id": "benefit_1",
      "label": "Benefit 1",
      "default": "Pay later available"
    },
    {
      "type": "text",
      "id": "benefit_2_icon",
      "label": "Benefit 2 Icon",
      "default": "🔧"
    },
    {
      "type": "text",
      "id": "benefit_2",
      "label": "Benefit 2",
      "default": "All-Day fixes"
    },
    {
      "type": "text",
      "id": "benefit_3_icon",
      "label": "Benefit 3 Icon",
      "default": "🚚"
    },
    {
      "type": "text",
      "id": "benefit_3",
      "label": "Benefit 3",
      "default": "Free Shipping"
    },
    {
      "type": "range",
      "id": "benefits_gap",
      "label": "Gap Between Benefits",
      "min": 8,
      "max": 32,
      "step": 4,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "benefits_top",
      "label": "Top Spacing",
      "min": 4,
      "max": 20,
      "step": 4,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "benefits_size",
      "label": "Font Size",
      "min": 11,
      "max": 15,
      "step": 1,
      "default": 13,
      "unit": "px"
    }
  ]
}
{% endschema %}

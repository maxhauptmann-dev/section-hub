{% if shop.metafields.sectioniq.premium == "active" %}
<style>
.sh-ucs{margin:12px 0;padding:14px;background:{{ block.settings.bg }};border-radius:12px}
.sh-ucs__h{font-size:15px;font-weight:800;color:{{ block.settings.heading_c }};margin:0 0 10px;text-align:center}
.sh-ucs__g{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.sh-ucs__card{background:{{ block.settings.card_bg }};border-radius:10px;overflow:hidden;border:1px solid rgba(255,255,255,.06);transition:transform .3s,box-shadow .3s}
.sh-ucs__card:hover{transform:translateY(-3px);box-shadow:0 12px 32px rgba(0,0,0,.35)}
.sh-ucs__iw{aspect-ratio:4/5;overflow:hidden;position:relative}
.sh-ucs__img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s}
.sh-ucs__card:hover .sh-ucs__img{transform:scale(1.05)}
.sh-ucs__ph{width:100%;height:100%;background:rgba(255,255,255,.04);display:flex;align-items:center;justify-content:center;font-size:24px;color:rgba(255,255,255,.1)}
.sh-ucs__badge{position:absolute;top:6px;right:6px;background:#ef4444;color:#fff;font-size:10px;font-weight:800;padding:2px 7px;border-radius:5px}
.sh-ucs__tag{position:absolute;top:6px;left:6px;background:rgba(139,108,245,.15);color:{{ block.settings.accent }};font-size:9px;font-weight:800;letter-spacing:1px;text-transform:uppercase;padding:2px 6px;border-radius:4px}
.sh-ucs__body{padding:10px 12px 12px}
.sh-ucs__name{font-size:13px;font-weight:700;color:{{ block.settings.heading_c }};margin:0 0 4px;line-height:1.3}
.sh-ucs__pr{display:flex;gap:5px;align-items:baseline;margin-bottom:8px}
.sh-ucs__pn{font-size:14px;font-weight:800;color:{{ block.settings.heading_c }}}
.sh-ucs__po{font-size:11px;color:{{ block.settings.text_c }};text-decoration:line-through}
.sh-ucs__btn{display:block;width:100%;text-align:center;padding:8px;background:{{ block.settings.accent }};color:#fff;font-size:11px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;border:none;border-radius:6px;cursor:pointer}
@media(max-width:400px){.sh-ucs__g{grid-template-columns:1fr}}
</style>
<div class="sh-ucs">
<h3 class="sh-ucs__h">{{ block.settings.heading }}</h3>
<div class="sh-ucs__g">
{% for i in (1..2) %}
{%- assign n_id = 'p' | append: i | append: '_name' -%}
{%- assign pr_id = 'p' | append: i | append: '_price' -%}
{%- assign img_id = 'p' | append: i | append: '_image' -%}
{%- assign n = block.settings[n_id] -%}
{%- assign pr = block.settings[pr_id] -%}
{%- assign im = block.settings[img_id] -%}
{%- if n != blank -%}
<div class="sh-ucs__card">
<div class="sh-ucs__iw">
{% if im != blank %}<img class="sh-ucs__img" src="{{ im | image_url: width: 400 }}" alt="{{ n | escape }}" loading="lazy" width="400" height="500">{% else %}<div class="sh-ucs__ph">🛍️</div>{% endif %}
</div>
<div class="sh-ucs__body">
<div class="sh-ucs__name">{{ n }}</div>
{% if pr != blank %}<div class="sh-ucs__pr"><span class="sh-ucs__pn">{{ pr }}</span></div>{% endif %}
<button class="sh-ucs__btn" type="button">Add to Cart</button>
</div>
</div>
{%- endif -%}
{% endfor %}
</div>
</div>
{% else %}
<div style="padding:12px;margin:12px 0;background:#f8f5ff;border:1px solid #ddd6fe;border-radius:8px;text-align:center;font-size:13px;color:#6b7280;">👑 Requires <strong style="color:#4f46e5;">SectionIQ Premium</strong></div>
{% endif %}
{% schema %}
{
  "name": "SH - Upsell Stack",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bought Together" },
    { "type": "image_picker", "id": "p1_image", "label": "Product 1 Image" },
    { "type": "text", "id": "p1_name", "label": "Product 1 Name", "default": "Wireless Earbuds" },
    { "type": "text", "id": "p1_price", "label": "Product 1 Price", "default": "€49.95" },
    { "type": "image_picker", "id": "p2_image", "label": "Product 2 Image" },
    { "type": "text", "id": "p2_name", "label": "Product 2 Name", "default": "Phone Stand" },
    { "type": "text", "id": "p2_price", "label": "Product 2 Price", "default": "€19.95" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#0e0e18" },
    { "type": "color", "id": "card_bg", "label": "Card", "default": "#18182e" },
    { "type": "color", "id": "heading_c", "label": "Heading", "default": "#f0f0f8" },
    { "type": "color", "id": "text_c", "label": "Text", "default": "#8888a0" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#8b6cf5" }
  ]
}
{% endschema %}

{% comment %}
  Section Hub – Upsell Card Stack Block
  Dark-themed stacked product cards with glow effects
{% endcomment %}

{% if shop.metafields.sectioniq.premium == "active" %}

<style>
.sh-ucs {
  margin: {{ block.settings.margin_y }}px 0;
  padding: {{ block.settings.padding }}px;
  background: {{ block.settings.bg_color }};
  border-radius: {{ block.settings.outer_radius }}px;
  overflow: hidden;
}

.sh-ucs__header {
  text-align: center;
  margin-bottom: 16px;
}

.sh-ucs__eyebrow {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2.2px;
  text-transform: uppercase;
  color: {{ block.settings.accent_color }};
  margin-bottom: 4px;
}

.sh-ucs__heading {
  font-size: {{ block.settings.title_size }}px;
  font-weight: 800;
  color: {{ block.settings.heading_color }};
  margin: 0;
  line-height: 1.2;
}

.sh-ucs__grid {
  display: grid;
  gap: {{ block.settings.gap }}px;
}

{% if block.settings.columns == '2' %}
  .sh-ucs__grid { grid-template-columns: 1fr 1fr; }
{% elsif block.settings.columns == '3' %}
  .sh-ucs__grid { grid-template-columns: 1fr 1fr 1fr; }
{% else %}
  .sh-ucs__grid { grid-template-columns: 1fr; }
{% endif %}

.sh-ucs__card {
  position: relative;
  background: {{ block.settings.card_bg }};
  border-radius: {{ block.settings.card_radius }}px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.06);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.sh-ucs__card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
}

.sh-ucs__glow {
  position: absolute;
  inset: -1px;
  border-radius: {{ block.settings.card_radius }}px;
  background: linear-gradient(135deg, {{ block.settings.accent_color }} 0%, transparent 50%);
  opacity: 0;
  transition: opacity 0.35s ease;
  pointer-events: none;
  z-index: 0;
}

.sh-ucs__card:hover .sh-ucs__glow {
  opacity: 1;
}

.sh-ucs__img-wrap {
  position: relative;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  z-index: 1;
}

.sh-ucs__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.45s ease;
}

.sh-ucs__card:hover .sh-ucs__img {
  transform: scale(1.06);
}

.sh-ucs__img-ph {
  width: 100%;
  height: 100%;
  background: rgba(255, 255, 255, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  color: rgba(255, 255, 255, 0.1);
}

.sh-ucs__badge {
  position: absolute;
  top: 8px;
  right: 8px;
  background: {{ block.settings.badge_bg }};
  color: #fff;
  font-size: 11px;
  font-weight: 800;
  padding: 3px 9px;
  border-radius: 6px;
  z-index: 2;
  letter-spacing: 0.3px;
  box-shadow: 0 2px 8px rgba(239, 68, 68, 0.4);
}

.sh-ucs__shine {
  position: absolute;
  inset: 0;
  background: linear-gradient(105deg, transparent 40%, rgba(255, 255, 255, 0.06) 50%, transparent 60%);
  transform: translateX(-100%);
  pointer-events: none;
  z-index: 3;
}
.sh-ucs__card:hover .sh-ucs__shine {
  transform: translateX(100%);
  transition: transform 0.65s ease;
}

.sh-ucs__tag {
  position: absolute;
  top: 8px;
  left: 8px;
  background: rgba(139, 108, 245, 0.15);
  color: {{ block.settings.accent_color }};
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1.4px;
  text-transform: uppercase;
  padding: 3px 8px;
  border-radius: 4px;
  z-index: 2;
}

.sh-ucs__body {
  position: relative;
  z-index: 1;
  padding: 14px;
  background: {{ block.settings.card_bg }};
}

.sh-ucs__vendor {
  font-size: 10px;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  color: {{ block.settings.text_color }};
  margin-bottom: 3px;
}

.sh-ucs__name {
  font-size: {{ block.settings.font_size }}px;
  font-weight: 700;
  color: {{ block.settings.heading_color }};
  line-height: 1.3;
  margin: 0 0 6px;
}

.sh-ucs__prices {
  display: flex;
  align-items: baseline;
  gap: 6px;
  margin-bottom: 10px;
}

.sh-ucs__price-now {
  font-size: {{ block.settings.font_size | plus: 1 }}px;
  font-weight: 800;
  color: {{ block.settings.heading_color }};
}

.sh-ucs__price-old {
  font-size: {{ block.settings.font_size | minus: 1 }}px;
  color: {{ block.settings.text_color }};
  text-decoration: line-through;
  opacity: 0.5;
}

.sh-ucs__btn {
  display: block;
  width: 100%;
  text-align: center;
  padding: 10px;
  background: {{ block.settings.btn_bg }};
  color: {{ block.settings.btn_color }};
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  transition: box-shadow 0.25s ease, transform 0.25s ease;
}

.sh-ucs__btn:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 16px rgba(139, 108, 245, 0.4);
}

@media (max-width: 500px) {
  .sh-ucs__grid { grid-template-columns: 1fr !important; }
}
</style>

<div class="sh-ucs">

  {% if block.settings.eyebrow != blank or block.settings.heading != blank %}
    <div class="sh-ucs__header">
      {% if block.settings.eyebrow != blank %}
        <div class="sh-ucs__eyebrow">{{ block.settings.eyebrow }}</div>
      {% endif %}
      {% if block.settings.heading != blank %}
        <h3 class="sh-ucs__heading">{{ block.settings.heading }}</h3>
      {% endif %}
    </div>
  {% endif %}

  <div class="sh-ucs__grid">
    {% for i in (1..3) %}
      {%- assign name_id  = 'product_' | append: i | append: '_name' -%}
      {%- assign price_id = 'product_' | append: i | append: '_price' -%}
      {%- assign comp_id  = 'product_' | append: i | append: '_compare' -%}
      {%- assign img_id   = 'product_' | append: i | append: '_image' -%}
      {%- assign tag_id   = 'product_' | append: i | append: '_tag' -%}
      {%- assign badge_id = 'product_' | append: i | append: '_badge' -%}
      {%- assign vendor_id = 'product_' | append: i | append: '_vendor' -%}

      {%- assign name_val  = block.settings[name_id] -%}
      {%- assign price_val = block.settings[price_id] -%}
      {%- assign comp_val  = block.settings[comp_id] -%}
      {%- assign img_val   = block.settings[img_id] -%}
      {%- assign tag_val   = block.settings[tag_id] -%}
      {%- assign badge_val = block.settings[badge_id] -%}
      {%- assign vendor_val = block.settings[vendor_id] -%}

      {%- if name_val != blank -%}
        <div class="sh-ucs__card">
          <div class="sh-ucs__glow"></div>
          <div class="sh-ucs__img-wrap">
            {% if img_val != blank %}
              <img class="sh-ucs__img" src="{{ img_val | image_url: width: 500 }}" alt="{{ name_val | escape }}" loading="lazy" width="500" height="625">
            {% else %}
              <div class="sh-ucs__img-ph">🛍️</div>
            {% endif %}
            {% if badge_val != blank %}
              <span class="sh-ucs__badge">{{ badge_val }}</span>
            {% endif %}
            {% if tag_val != blank %}
              <span class="sh-ucs__tag">{{ tag_val }}</span>
            {% endif %}
            <div class="sh-ucs__shine"></div>
          </div>
          <div class="sh-ucs__body">
            {% if vendor_val != blank %}
              <div class="sh-ucs__vendor">{{ vendor_val }}</div>
            {% endif %}
            <div class="sh-ucs__name">{{ name_val }}</div>
            {% if price_val != blank %}
              <div class="sh-ucs__prices">
                <span class="sh-ucs__price-now">{{ price_val }}</span>
                {% if comp_val != blank %}
                  <span class="sh-ucs__price-old">{{ comp_val }}</span>
                {% endif %}
              </div>
            {% endif %}
            <button class="sh-ucs__btn" type="button">{{ block.settings.btn_text }}</button>
          </div>
        </div>
      {%- endif -%}
    {% endfor %}
  </div>

</div>

{% else %}
<div style="padding:12px;margin:12px 0;background:#f8f5ff;border:1px solid #ddd6fe;border-radius:8px;text-align:center;font-size:13px;color:#6b7280;">
  👑 This block requires <strong style="color:#4f46e5;">SectionIQ Premium</strong>
</div>
{% endif %}

{% schema %}
{

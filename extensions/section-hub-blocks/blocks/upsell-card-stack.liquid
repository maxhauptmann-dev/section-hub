    },
    {
      "type": "text",
      "id": "product_1_vendor",
      "label": "Vendor"
    },
    {
      "type": "text",
      "id": "product_1_price",
      "label": "Price",
      "default": "€49.95"
    },
    {
      "type": "text",
      "id": "product_1_compare",
      "label": "Compare Price",
      "default": "€69.95"
    },
    {
      "type": "text",
      "id": "product_1_tag",
      "label": "Tag",
      "default": "Best Seller"
    },
    {
      "type": "text",
      "id": "product_1_badge",
      "label": "Badge (e.g. -30%)",
      "default": "-29%"
    },
    {
      "type": "header",
      "content": "Product 2"
    },
    {
      "type": "image_picker",
      "id": "product_2_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "product_2_name",
      "label": "Name",
      "default": "Phone Stand"
    },
    {
      "type": "text",
      "id": "product_2_vendor",
      "label": "Vendor"
    },
    {
      "type": "text",
      "id": "product_2_price",
      "label": "Price",
      "default": "€19.95"
    },
    {
      "type": "text",
      "id": "product_2_compare",
      "label": "Compare Price"
    },
    {
      "type": "text",
      "id": "product_2_tag",
      "label": "Tag",
      "default": "Staff Pick"
    },
    {
      "type": "text",
      "id": "product_2_badge",
      "label": "Badge"
    },
    {
      "type": "header",
      "content": "Product 3"
    },
    {
      "type": "image_picker",
      "id": "product_3_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "product_3_name",
      "label": "Name",
      "default": "USB-C Cable"
    },
    {
      "type": "text",
      "id": "product_3_vendor",
      "label": "Vendor"
    },
    {
      "type": "text",
      "id": "product_3_price",
      "label": "Price",
      "default": "€12.95"
    },
    {
      "type": "text",
      "id": "product_3_compare",
      "label": "Compare Price"
    },
    {
      "type": "text",
      "id": "product_3_tag",
      "label": "Tag",
      "default": "Trending"

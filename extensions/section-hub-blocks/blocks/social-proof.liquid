{% if shop.metafields.sectioniq.premium == "active" %}
<style>
.sh-sp{display:flex;align-items:center;gap:12px;padding:14px 18px;background:{{ block.settings.background_color }};border:1px solid {{ block.settings.border_color }};border-radius:{{ block.settings.border_radius }}px;margin:8px 0}
.sh-sp__av{display:flex;align-items:center;flex-shrink:0}
.sh-sp__aw{position:relative;margin-left:-10px}
.sh-sp__aw:first-child{margin-left:0}
.sh-sp__ai{width:{{ block.settings.avatar_size }}px;height:{{ block.settings.avatar_size }}px;border-radius:50%;border:2px solid {{ block.settings.background_color }};object-fit:cover;display:block}
.sh-sp__ap{width:{{ block.settings.avatar_size }}px;height:{{ block.settings.avatar_size }}px;border-radius:50%;border:2px solid {{ block.settings.background_color }};background:{{ block.settings.text_color }};opacity:.2;display:flex;align-items:center;justify-content:center;font-size:{{ block.settings.avatar_size | divided_by: 2 }}px;color:{{ block.settings.background_color }};font-weight:700}
.sh-sp__bd{display:flex;flex-direction:column;gap:2px;min-width:0}
.sh-sp__nm{display:flex;align-items:center;flex-wrap:wrap;gap:6px;font-size:{{ block.settings.font_size }}px;color:{{ block.settings.text_color }};font-weight:700;line-height:1.3}
.sh-sp__ni{display:inline-flex;align-items:center;gap:3px}
.sh-sp__vb{display:inline-flex;align-items:center;justify-content:center;width:15px;height:15px;background:#1d9bf0;border-radius:50%;flex-shrink:0}
.sh-sp__vb svg{width:9px;height:9px}
.sh-sp__sep{opacity:.4;font-weight:400}
.sh-sp__tx{font-size:{{ block.settings.font_size | minus: 1 }}px;color:{{ block.settings.text_color }};opacity:.85;line-height:1.4}
</style>
{%- assign n1 = block.settings.user_name_1 | strip -%}{%- assign n2 = block.settings.user_name_2 | strip -%}
<div class="sh-sp"><div class="sh-sp__av">
{% if block.settings.user_image_1 != blank %}<div class="sh-sp__aw"><img class="sh-sp__ai" src="{{ block.settings.user_image_1 | image_url: width: 80 }}" alt="{{ n1 }}" width="80" height="80" loading="lazy"></div>{% elsif n1 != blank %}<div class="sh-sp__aw"><div class="sh-sp__ap">{{ n1 | slice: 0 }}</div></div>{% endif %}
{% if block.settings.user_image_2 != blank %}<div class="sh-sp__aw"><img class="sh-sp__ai" src="{{ block.settings.user_image_2 | image_url: width: 80 }}" alt="{{ n2 }}" width="80" height="80" loading="lazy"></div>{% elsif n2 != blank %}<div class="sh-sp__aw"><div class="sh-sp__ap">{{ n2 | slice: 0 }}</div></div>{% endif %}
</div><div class="sh-sp__bd">
{% if n1 != blank or n2 != blank %}<div class="sh-sp__nm">{% if n1 != blank %}<span class="sh-sp__ni">{{ block.settings.user_name_1 }}{% if block.settings.show_verified %}<span class="sh-sp__vb"><svg viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{% endif %}</span>{% endif %}{% if n1 != blank and n2 != blank %}<span class="sh-sp__sep">&amp;</span>{% endif %}{% if n2 != blank %}<span class="sh-sp__ni">{{ block.settings.user_name_2 }}{% if block.settings.show_verified %}<span class="sh-sp__vb"><svg viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{% endif %}</span>{% endif %}</div>{% endif %}
{% if block.settings.text != blank %}<div class="sh-sp__tx">{{ block.settings.text }}</div>{% endif %}
</div></div>
{% else %}
<div style="padding:12px;margin:12px 0;background:#f8f5ff;border:1px solid #ddd6fe;border-radius:8px;text-align:center;font-size:13px;color:#6b7280;">👑 Requires <strong style="color:#4f46e5;">SectionIQ Premium</strong></div>
{% endif %}
{% schema %}
{
  "name": "Social Proof",
  "target": "section",
  "settings": [
    { "type": "header", "content": "First User" },
    { "type": "image_picker", "id": "user_image_1", "label": "Image" },
    { "type": "text", "id": "user_name_1", "label": "Name", "default": "Ronaldo" },
    { "type": "header", "content": "Second User" },
    { "type": "image_picker", "id": "user_image_2", "label": "Image" },
    { "type": "text", "id": "user_name_2", "label": "Name", "default": "Messi" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "text", "label": "Text", "default": "and 1000+ others have purchased this product" },
    { "type": "checkbox", "id": "show_verified", "label": "Verified Badge", "default": true },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#1a1a2e" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#2a2a4a" },
    { "type": "range", "id": "border_radius", "label": "Radius", "min": 0, "max": 24, "step": 2, "default": 12, "unit": "px" },
    { "type": "range", "id": "avatar_size", "label": "Avatar Size", "min": 24, "max": 56, "step": 4, "default": 40, "unit": "px" },
    { "type": "range", "id": "font_size", "label": "Font Size", "min": 12, "max": 18, "step": 1, "default": 14, "unit": "px" }
  ]
}
{% endschema %}

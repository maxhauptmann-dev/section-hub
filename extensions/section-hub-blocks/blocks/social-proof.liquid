{% comment %}
  Section Hub - Social Proof Block
  Shows user avatars side by side with names + verified badges and a social proof text.
{% endcomment %}

{% if shop.metafields.sectioniq.premium == "active" %}

<style>
.sh-social-proof {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 18px;
  background: {{ block.settings.background_color }};
  border: 1px solid {{ block.settings.border_color }};
  border-radius: {{ block.settings.border_radius }}px;
  font-family: inherit;
  margin: 8px 0;
}

.sh-social-proof__avatars {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.sh-social-proof__avatar-wrap {
  position: relative;
  margin-left: -10px;
}

.sh-social-proof__avatar-wrap:first-child {
  margin-left: 0;
}

.sh-social-proof__avatar {
  width: {{ block.settings.avatar_size }}px;
  height: {{ block.settings.avatar_size }}px;
  border-radius: 50%;
  border: 2px solid {{ block.settings.background_color }};
  object-fit: cover;
  display: block;
}

.sh-social-proof__avatar-placeholder {
  width: {{ block.settings.avatar_size }}px;
  height: {{ block.settings.avatar_size }}px;
  border-radius: 50%;
  border: 2px solid {{ block.settings.background_color }};
  background: {{ block.settings.text_color }};
  opacity: 0.2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: {{ block.settings.avatar_size | divided_by: 2 }}px;
  color: {{ block.settings.background_color }};
  font-weight: 700;
}

.sh-social-proof__body {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.sh-social-proof__names {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  font-size: {{ block.settings.font_size }}px;
  color: {{ block.settings.text_color }};
  font-weight: 700;
  line-height: 1.3;
}

.sh-social-proof__name-item {
  display: inline-flex;
  align-items: center;
  gap: 3px;
}

.sh-social-proof__verified {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 15px;
  height: 15px;
  background: #1d9bf0;
  border-radius: 50%;
  flex-shrink: 0;
}

.sh-social-proof__verified svg {
  width: 9px;
  height: 9px;
}

.sh-social-proof__sep {
  opacity: 0.4;
  font-weight: 400;
}

.sh-social-proof__text {
  font-size: {{ block.settings.font_size | minus: 1 }}px;
  color: {{ block.settings.text_color }};
  opacity: 0.85;
  line-height: 1.4;
}
</style>

{% assign has_name_1 = block.settings.user_name_1 | strip %}
{% assign has_name_2 = block.settings.user_name_2 | strip %}

<div class="sh-social-proof">
  <div class="sh-social-proof__avatars">
    {% if block.settings.user_image_1 != blank %}
      <div class="sh-social-proof__avatar-wrap">
        <img class="sh-social-proof__avatar"
          src="{{ block.settings.user_image_1 | image_url: width: 80 }}"
          alt="{{ block.settings.user_name_1 }}"
          width="80" height="80" loading="lazy">
      </div>
    {% elsif has_name_1 != blank %}
      <div class="sh-social-proof__avatar-wrap">
        <div class="sh-social-proof__avatar-placeholder">
          {{ block.settings.user_name_1 | slice: 0 }}
        </div>
      </div>
    {% endif %}

    {% if block.settings.user_image_2 != blank %}
      <div class="sh-social-proof__avatar-wrap">
        <img class="sh-social-proof__avatar"
          src="{{ block.settings.user_image_2 | image_url: width: 80 }}"
          alt="{{ block.settings.user_name_2 }}"
          width="80" height="80" loading="lazy">
      </div>
    {% elsif has_name_2 != blank %}
      <div class="sh-social-proof__avatar-wrap">
        <div class="sh-social-proof__avatar-placeholder">
          {{ block.settings.user_name_2 | slice: 0 }}
        </div>
      </div>
    {% endif %}
  </div>

  <div class="sh-social-proof__body">
    {% if has_name_1 != blank or has_name_2 != blank %}
      <div class="sh-social-proof__names">
        {% if has_name_1 != blank %}
          <span class="sh-social-proof__name-item">
            {{ block.settings.user_name_1 }}
            {% if block.settings.show_verified %}
              <span class="sh-social-proof__verified">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5 13l4 4L19 7" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            {% endif %}
          </span>
        {% endif %}

        {% if has_name_1 != blank and has_name_2 != blank %}
          <span class="sh-social-proof__sep">&amp;</span>
        {% endif %}

        {% if has_name_2 != blank %}
          <span class="sh-social-proof__name-item">
            {{ block.settings.user_name_2 }}
            {% if block.settings.show_verified %}
              <span class="sh-social-proof__verified">
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5 13l4 4L19 7" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            {% endif %}
          </span>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.text != blank %}
      <div class="sh-social-proof__text">{{ block.settings.text }}</div>
    {% endif %}
  </div>
</div>

{% else %}
<div style="padding:12px;margin:12px 0;background:#f8f5ff;border:1px solid #ddd6fe;border-radius:8px;text-align:center;font-size:13px;color:#6b7280;">
  👑 This block requires <strong style="color:#4f46e5;">SectionIQ Premium</strong>
</div>
{% endif %}

{% schema %}
{
  "name": "Social Proof",
  "target": "section",
  "settings": [
    {
      "type": "header",
      "content": "First User"
    },
    {
      "type": "image_picker",
      "id": "user_image_1",
      "label": "Profile Image"
    },
    {
      "type": "text",
      "id": "user_name_1",
      "label": "Name",
      "default": "Ronaldo"
    },
    {
      "type": "header",
      "content": "Second User"
    },
    {
      "type": "image_picker",
      "id": "user_image_2",
      "label": "Profile Image"
    },
    {
      "type": "text",
      "id": "user_name_2",
      "label": "Name",
      "default": "Messi"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Social Proof Text",
      "default": "and 1000+ others have purchased this product"
    },
    {
      "type": "checkbox",
      "id": "show_verified",
      "label": "Show Verified Badge",
      "default": true
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#1a1a2e"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#2a2a4a"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "avatar_size",
      "label": "Avatar Size",
      "min": 24,
      "max": 56,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font Size",
      "min": 12,
      "max": 18,
      "step": 1,
      "default": 14,
      "unit": "px"
    }
  ]
}
{% endschema %}

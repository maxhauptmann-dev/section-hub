{% if shop.metafields.sectioniq.premium == "active" %}
<style>
.sh-sc{margin:12px 0}
.sh-sc__bar{display:flex;align-items:center;gap:10px;padding:{{ block.settings.padding }}px;background:{{ block.settings.bg_color }};border:1px solid {{ block.settings.border_color }};border-radius:{{ block.settings.border_radius }}px;flex-wrap:wrap}
.sh-sc__ic{font-size:22px;flex-shrink:0}
.sh-sc__tx{flex:1;min-width:180px}
.sh-sc__hl{font-size:{{ block.settings.font_size }}px;font-weight:700;color:{{ block.settings.text_color }};line-height:1.3}
.sh-sc__sb{font-size:{{ block.settings.font_size | minus: 2 }}px;color:{{ block.settings.text_color }};opacity:.6;margin-top:2px}
.sh-sc__tm{display:flex;gap:6px;flex-shrink:0}
.sh-sc__u{text-align:center;background:{{ block.settings.timer_bg }};border-radius:8px;padding:6px 10px;min-width:48px}
.sh-sc__uv{font-size:20px;font-weight:800;color:{{ block.settings.accent_color }};line-height:1;font-variant-numeric:tabular-nums}
.sh-sc__ul{font-size:10px;color:{{ block.settings.text_color }};opacity:.5;text-transform:uppercase;letter-spacing:.5px;margin-top:2px}
.sh-sc__sp{font-size:18px;font-weight:700;color:{{ block.settings.accent_color }};align-self:flex-start;padding-top:6px}
.sh-sc__pg{width:100%;height:4px;background:{{ block.settings.border_color }};border-radius:2px;overflow:hidden;margin-top:10px}
.sh-sc__pf{height:100%;background:linear-gradient(90deg,{{ block.settings.accent_color }},{{ block.settings.accent_color_end }});border-radius:2px;transition:width 1s linear}
</style>
<div class="sh-sc" data-cutoff-hour="{{ block.settings.cutoff_hour }}" data-cutoff-minute="{{ block.settings.cutoff_minute }}"><div class="sh-sc__bar"><span class="sh-sc__ic">{{ block.settings.icon }}</span><div class="sh-sc__tx"><div class="sh-sc__hl">{{ block.settings.headline }}</div><div class="sh-sc__sb">{{ block.settings.subtext }}</div></div><div class="sh-sc__tm"><div class="sh-sc__u"><div class="sh-sc__uv" data-sc-h>--</div><div class="sh-sc__ul">hrs</div></div><span class="sh-sc__sp">:</span><div class="sh-sc__u"><div class="sh-sc__uv" data-sc-m>--</div><div class="sh-sc__ul">min</div></div><span class="sh-sc__sp">:</span><div class="sh-sc__u"><div class="sh-sc__uv" data-sc-s>--</div><div class="sh-sc__ul">sec</div></div></div></div>{% if block.settings.show_progress %}<div class="sh-sc__pg"><div class="sh-sc__pf" data-sc-pg style="width:50%"></div></div>{% endif %}</div>
<script>
(function(){var c=document.currentScript.previousElementSibling;while(c&&!c.classList.contains('sh-sc'))c=c.previousElementSibling;if(!c)return;var cH=parseInt(c.dataset.cutoffHour)||16,cM=parseInt(c.dataset.cutoffMinute)||0,hE=c.querySelector('[data-sc-h]'),mE=c.querySelector('[data-sc-m]'),sE=c.querySelector('[data-sc-s]'),pE=c.querySelector('[data-sc-pg]');function p(n){return n<10?'0'+n:''+n}function t(){var n=new Date(),co=new Date();co.setHours(cH,cM,0,0);if(n>=co)co.setDate(co.getDate()+1);var d=co-n,ts=Math.floor(d/1000),h=Math.floor(ts/3600),m=Math.floor((ts%3600)/60),s=ts%60;if(hE)hE.textContent=p(h);if(mE)mE.textContent=p(m);if(sE)sE.textContent=p(s);if(pE){var tw=cH*3600+cM*60,el=tw-ts;if(el<0)el=0;pE.style.width=Math.max(0,Math.min(100,(1-el/tw)*100))+'%'}}t();setInterval(t,1000)})();
</script>
{% else %}
<div style="padding:12px;margin:12px 0;background:#f8f5ff;border:1px solid #ddd6fe;border-radius:8px;text-align:center;font-size:13px;color:#6b7280;">👑 Requires <strong style="color:#4f46e5;">SectionIQ Premium</strong></div>
{% endif %}
{% schema %}
{
  "name": "SH - Countdown Shipping",
  "target": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Order now for same-day shipping!" },
    { "type": "text", "id": "subtext", "label": "Sub Text", "default": "Free express delivery on orders over €50" },
    { "type": "text", "id": "icon", "label": "Icon", "default": "🚚" },
    { "type": "range", "id": "cutoff_hour", "label": "Cutoff Hour (24h)", "min": 0, "max": 23, "step": 1, "default": 16 },
    { "type": "range", "id": "cutoff_minute", "label": "Cutoff Minute", "min": 0, "max": 55, "step": 5, "default": 0 },
    { "type": "checkbox", "id": "show_progress", "label": "Show Progress Bar", "default": true },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1a1a1a" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#dc2626" },
    { "type": "color", "id": "accent_color_end", "label": "Gradient End", "default": "#f59e0b" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#fffbeb" },
    { "type": "color", "id": "timer_bg", "label": "Timer BG", "default": "#ffffff" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#fde68a" },
    { "type": "range", "id": "border_radius", "label": "Radius", "min": 0, "max": 20, "step": 2, "default": 12, "unit": "px" },
    { "type": "range", "id": "padding", "label": "Padding", "min": 8, "max": 32, "step": 2, "default": 14, "unit": "px" },
    { "type": "range", "id": "font_size", "label": "Font Size", "min": 12, "max": 18, "step": 1, "default": 14, "unit": "px" }
  ]
}
{% endschema %}

{% if shop.metafields.sectioniq.premium == "active" %}
<style>
.sh-usb{margin:12px 0;padding:14px;background:{{ block.settings.bg_color }};border:1px solid #e5e7eb;border-radius:12px;display:flex;gap:14px;align-items:center}
.sh-usb__img{width:110px;height:110px;border-radius:10px;object-fit:cover;flex-shrink:0}
.sh-usb__ph{width:110px;height:110px;border-radius:10px;background:#e5e7eb;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:24px;color:#9ca3af}
.sh-usb__info{flex:1;min-width:0}
.sh-usb__label{font-size:10px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase;color:{{ block.settings.accent }};margin-bottom:4px}
.sh-usb__name{font-size:16px;font-weight:700;color:#1a1a1a;margin:0 0 4px;line-height:1.3}
.sh-usb__prices{display:flex;gap:6px;align-items:baseline;margin-bottom:4px}
.sh-usb__now{font-size:16px;font-weight:800;color:#1a1a1a}
.sh-usb__was{font-size:13px;color:#9ca3af;text-decoration:line-through}
.sh-usb__badge{display:inline-block;background:#ef4444;color:#fff;font-size:11px;font-weight:700;padding:2px 8px;border-radius:5px;margin-bottom:6px}
.sh-usb__urgency{display:flex;align-items:center;gap:5px;font-size:11px;color:#ef4444;font-weight:600;margin-bottom:8px}
.sh-usb__dot{width:6px;height:6px;background:#ef4444;border-radius:50%;animation:sh-usb-p 1.5s infinite}
@keyframes sh-usb-p{0%,100%{opacity:1}50%{opacity:.3}}
.sh-usb__btn{display:inline-block;padding:8px 18px;background:{{ block.settings.accent }};color:#fff;font-size:12px;font-weight:700;border:none;border-radius:7px;cursor:pointer;text-transform:uppercase;letter-spacing:.5px}
.sh-usb__trust{display:flex;gap:10px;margin-top:8px;font-size:10px;color:#6b7280}
.sh-usb__trust span::before{content:'✓ ';color:{{ block.settings.accent }};font-weight:700}
@media(max-width:500px){.sh-usb{flex-direction:column}.sh-usb__img,.sh-usb__ph{width:100%;height:160px}}
</style>
<div class="sh-usb">
{% if block.settings.image != blank %}<img class="sh-usb__img" src="{{ block.settings.image | image_url: width: 240 }}" alt="{{ block.settings.name }}" loading="lazy" width="240" height="240">{% else %}<div class="sh-usb__ph">📦</div>{% endif %}
<div class="sh-usb__info">
{% if block.settings.label != blank %}<div class="sh-usb__label">{{ block.settings.label }}</div>{% endif %}
{% if block.settings.badge != blank %}<span class="sh-usb__badge">{{ block.settings.badge }}</span>{% endif %}
<h3 class="sh-usb__name">{{ block.settings.name }}</h3>
<div class="sh-usb__prices"><span class="sh-usb__now">{{ block.settings.price }}</span>{% if block.settings.compare != blank %}<span class="sh-usb__was">{{ block.settings.compare }}</span>{% endif %}</div>
<div class="sh-usb__urgency"><span class="sh-usb__dot"></span>Only a few left</div>
<button class="sh-usb__btn" type="button">Add to Cart</button>
<div class="sh-usb__trust"><span>Free Shipping</span><span>Easy Returns</span></div>
</div>
</div>
{% else %}
<div style="padding:12px;margin:12px 0;background:#f8f5ff;border:1px solid #ddd6fe;border-radius:8px;text-align:center;font-size:13px;color:#6b7280;">👑 Requires <strong style="color:#4f46e5;">SectionIQ Premium</strong></div>
{% endif %}
{% schema %}
{
  "name": "SH - Upsell Spotlight",
  "target": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Product Image" },
    { "type": "text", "id": "name", "label": "Product Name", "default": "Premium Leather Case" },
    { "type": "text", "id": "price", "label": "Price", "default": "€39.00" },
    { "type": "text", "id": "compare", "label": "Compare Price", "default": "€59.00" },
    { "type": "text", "id": "badge", "label": "Badge", "default": "-34%" },
    { "type": "text", "id": "label", "label": "Label", "default": "Pairs with your order" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#b8864e" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#fdfaf6" }
  ]
}
{% endschema %}

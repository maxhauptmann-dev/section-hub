{% if shop.metafields.sectioniq.premium == "active" %}
<style>
.sh-pay{margin:8px 0;text-align:{{ block.settings.alignment }}}
.sh-pay__lb{font-size:{{ block.settings.font_size }}px;font-weight:500;color:{{ block.settings.text_color }};margin-bottom:6px;display:flex;align-items:center;gap:4px;{% if block.settings.alignment == 'center' %}justify-content:center;{% endif %}{% if block.settings.alignment == 'right' %}justify-content:flex-end;{% endif %}}
.sh-pay__lb svg{width:14px;height:14px}
.sh-pay__ic{display:flex;flex-wrap:wrap;gap:6px;{% if block.settings.alignment == 'center' %}justify-content:center;{% endif %}{% if block.settings.alignment == 'right' %}justify-content:flex-end;{% endif %}}
.sh-pay__i{display:inline-flex;align-items:center;justify-content:center;width:{{ block.settings.icon_width }}px;height:{{ block.settings.icon_height }}px;background:{{ block.settings.icon_bg_color }};border:1px solid {{ block.settings.icon_border_color }};border-radius:{{ block.settings.border_radius }}px;padding:4px 6px}
.sh-pay__i svg{width:100%;height:100%;max-width:{{ block.settings.icon_width | minus: 12 }}px;max-height:{{ block.settings.icon_height | minus: 10 }}px}
</style>
<div class="sh-pay">{% if block.settings.label != blank %}<div class="sh-pay__lb"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>{{ block.settings.label }}</div>{% endif %}<div class="sh-pay__ic">
{% if block.settings.show_visa %}<div class="sh-pay__i"><svg viewBox="0 0 48 32"><text x="50%" y="55%" text-anchor="middle" dominant-baseline="middle" font-family="Arial,sans-serif" font-weight="bold" font-size="14" fill="#1a1f71">VISA</text></svg></div>{% endif %}
{% if block.settings.show_mastercard %}<div class="sh-pay__i"><svg viewBox="0 0 48 32"><circle cx="19" cy="16" r="10" fill="#eb001b" opacity=".8"/><circle cx="29" cy="16" r="10" fill="#f79e1b" opacity=".8"/></svg></div>{% endif %}
{% if block.settings.show_amex %}<div class="sh-pay__i"><svg viewBox="0 0 48 32"><rect width="48" height="32" rx="4" fill="#016fd0"/><text x="50%" y="55%" text-anchor="middle" dominant-baseline="middle" font-family="Arial,sans-serif" font-weight="bold" font-size="7" fill="#fff">AMEX</text></svg></div>{% endif %}
{% if block.settings.show_paypal %}<div class="sh-pay__i"><svg viewBox="0 0 48 32"><text x="50%" y="55%" text-anchor="middle" dominant-baseline="middle" font-family="Arial,sans-serif" font-weight="bold" font-style="italic" font-size="10" fill="#003087">Pay<tspan fill="#009cde">Pal</tspan></text></svg></div>{% endif %}
{% if block.settings.show_applepay %}<div class="sh-pay__i"><svg viewBox="0 0 48 32"><text x="50%" y="55%" text-anchor="middle" dominant-baseline="middle" font-family="Arial,sans-serif" font-weight="500" font-size="9" fill="#000"> Pay</text></svg></div>{% endif %}
{% if block.settings.show_googlepay %}<div class="sh-pay__i"><svg viewBox="0 0 48 32"><text x="50%" y="55%" text-anchor="middle" dominant-baseline="middle" font-family="Arial,sans-serif" font-weight="500" font-size="7" fill="#5f6368">G Pay</text></svg></div>{% endif %}
{% if block.settings.show_klarna %}<div class="sh-pay__i"><svg viewBox="0 0 48 32"><rect width="48" height="32" rx="4" fill="#ffb3c7"/><text x="50%" y="55%" text-anchor="middle" dominant-baseline="middle" font-family="Arial,sans-serif" font-weight="bold" font-size="9" fill="#0a0b09">Klarna</text></svg></div>{% endif %}
</div></div>
{% else %}
<div style="padding:12px;margin:12px 0;background:#f8f5ff;border:1px solid #ddd6fe;border-radius:8px;text-align:center;font-size:13px;color:#6b7280;">👑 Requires <strong style="color:#4f46e5;">SectionIQ Premium</strong></div>
{% endif %}
{% schema %}
{
  "name": "Payment Icons",
  "target": "section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Secure Payment With" },
    { "type": "header", "content": "Methods" },
    { "type": "checkbox", "id": "show_visa", "label": "Visa", "default": true },
    { "type": "checkbox", "id": "show_mastercard", "label": "Mastercard", "default": true },
    { "type": "checkbox", "id": "show_amex", "label": "Amex", "default": true },
    { "type": "checkbox", "id": "show_paypal", "label": "PayPal", "default": true },
    { "type": "checkbox", "id": "show_applepay", "label": "Apple Pay", "default": true },
    { "type": "checkbox", "id": "show_googlepay", "label": "Google Pay", "default": false },
    { "type": "checkbox", "id": "show_klarna", "label": "Klarna", "default": false },
    { "type": "header", "content": "Style" },
    { "type": "select", "id": "alignment", "label": "Align", "default": "left", "options": [{ "value": "left", "label": "Left" },{ "value": "center", "label": "Center" },{ "value": "right", "label": "Right" }] },
    { "type": "color", "id": "text_color", "label": "Label Color", "default": "#6b7280" },
    { "type": "color", "id": "icon_bg_color", "label": "Icon BG", "default": "#ffffff" },
    { "type": "color", "id": "icon_border_color", "label": "Icon Border", "default": "#e5e7eb" },
    { "type": "range", "id": "icon_width", "label": "Width", "min": 36, "max": 64, "step": 4, "default": 48, "unit": "px" },
    { "type": "range", "id": "icon_height", "label": "Height", "min": 24, "max": 44, "step": 4, "default": 32, "unit": "px" },
    { "type": "range", "id": "border_radius", "label": "Radius", "min": 0, "max": 12, "step": 2, "default": 4, "unit": "px" },
    { "type": "range", "id": "font_size", "label": "Font Size", "min": 11, "max": 16, "step": 1, "default": 13, "unit": "px" }
  ]
}
{% endschema %}

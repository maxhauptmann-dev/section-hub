{% if shop.metafields.sectioniq.premium == "active" %}
<style>
.sh-ucd{margin:12px 0;padding:14px;background:{{ block.settings.bg }};border:1px solid {{ block.settings.border }};border-radius:12px}
.sh-ucd__hdr{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.sh-ucd__h{font-size:15px;font-weight:800;color:{{ block.settings.heading_c }};margin:0}
.sh-ucd__nav{display:flex;gap:4px}
.sh-ucd__nb{width:28px;height:28px;border-radius:50%;border:1px solid {{ block.settings.border }};background:#fff;color:{{ block.settings.heading_c }};display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:14px}
.sh-ucd__nb:hover{background:{{ block.settings.heading_c }};color:#fff}
.sh-ucd__vp{overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}
.sh-ucd__vp::-webkit-scrollbar{display:none}
.sh-ucd__tr{display:flex;gap:10px}
.sh-ucd__c{flex:0 0 160px;scroll-snap-align:start;background:#fff;border:1px solid {{ block.settings.border }};border-radius:10px;overflow:hidden;transition:transform .3s,box-shadow .3s}
.sh-ucd__c:hover{transform:translateY(-3px);box-shadow:0 8px 24px rgba(0,0,0,.08)}
.sh-ucd__iw{aspect-ratio:1/1;overflow:hidden}
.sh-ucd__img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s}
.sh-ucd__c:hover .sh-ucd__img{transform:scale(1.05)}
.sh-ucd__ph{width:100%;height:100%;background:#f0ece6;display:flex;align-items:center;justify-content:center;font-size:22px;color:#ccc5bb}
.sh-ucd__badge{position:absolute;top:6px;left:6px;background:#d64545;color:#fff;font-size:10px;font-weight:700;padding:2px 7px;border-radius:12px}
.sh-ucd__bd{padding:10px 10px 12px}
.sh-ucd__nm{font-size:13px;font-weight:700;color:{{ block.settings.heading_c }};line-height:1.3;margin:0 0 3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sh-ucd__pr{font-size:14px;font-weight:800;color:{{ block.settings.heading_c }};margin-bottom:8px}
.sh-ucd__btn{display:block;width:100%;text-align:center;padding:7px;background:{{ block.settings.heading_c }};color:#fff;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;border:none;border-radius:6px;cursor:pointer}
</style>
<div class="sh-ucd">
<div class="sh-ucd__hdr">
<h3 class="sh-ucd__h">{{ block.settings.heading }}</h3>
<div class="sh-ucd__nav"><button class="sh-ucd__nb" data-sh-ucd-p aria-label="Prev">‹</button><button class="sh-ucd__nb" data-sh-ucd-n aria-label="Next">›</button></div>
</div>
<div class="sh-ucd__vp" data-sh-ucd-vp>
<div class="sh-ucd__tr">
{% for i in (1..3) %}
{%- assign n_id = 'p' | append: i | append: '_name' -%}
{%- assign pr_id = 'p' | append: i | append: '_price' -%}
{%- assign img_id = 'p' | append: i | append: '_image' -%}
{%- assign n = block.settings[n_id] -%}
{%- assign pr = block.settings[pr_id] -%}
{%- assign im = block.settings[img_id] -%}
{%- if n != blank -%}
<div class="sh-ucd__c">
<div class="sh-ucd__iw" style="position:relative">
{% if im != blank %}<img class="sh-ucd__img" src="{{ im | image_url: width: 360 }}" alt="{{ n | escape }}" loading="lazy" width="360" height="360">{% else %}<div class="sh-ucd__ph">📦</div>{% endif %}
</div>
<div class="sh-ucd__bd">
<div class="sh-ucd__nm">{{ n }}</div>
{% if pr != blank %}<div class="sh-ucd__pr">{{ pr }}</div>{% endif %}
<button class="sh-ucd__btn" type="button">View</button>
</div>
</div>
{%- endif -%}
{% endfor %}
</div>
</div>
</div>
<script>
(function(){var c=document.currentScript.previousElementSibling;while(c&&!c.classList.contains('sh-ucd'))c=c.previousElementSibling;if(!c)return;var v=c.querySelector('[data-sh-ucd-vp]');c.querySelector('[data-sh-ucd-p]').addEventListener('click',function(){v.scrollBy({left:-170,behavior:'smooth'})});c.querySelector('[data-sh-ucd-n]').addEventListener('click',function(){v.scrollBy({left:170,behavior:'smooth'})})})();
</script>
{% else %}
<div style="padding:12px;margin:12px 0;background:#f8f5ff;border:1px solid #ddd6fe;border-radius:8px;text-align:center;font-size:13px;color:#6b7280;">👑 Requires <strong style="color:#4f46e5;">SectionIQ Premium</strong></div>
{% endif %}
{% schema %}
{
  "name": "SH - Upsell Carousel",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete Your Look" },
    { "type": "image_picker", "id": "p1_image", "label": "Product 1 Image" },
    { "type": "text", "id": "p1_name", "label": "Product 1 Name", "default": "Silk Scarf" },
    { "type": "text", "id": "p1_price", "label": "Product 1 Price", "default": "€34.95" },
    { "type": "image_picker", "id": "p2_image", "label": "Product 2 Image" },
    { "type": "text", "id": "p2_name", "label": "Product 2 Name", "default": "Leather Belt" },
    { "type": "text", "id": "p2_price", "label": "Product 2 Price", "default": "€29.00" },
    { "type": "image_picker", "id": "p3_image", "label": "Product 3 Image" },
    { "type": "text", "id": "p3_name", "label": "Product 3 Name", "default": "Sunglasses" },
    { "type": "text", "id": "p3_price", "label": "Product 3 Price", "default": "€22.00" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#f4f2ee" },
    { "type": "color", "id": "border", "label": "Border", "default": "#e8e4de" },
    { "type": "color", "id": "heading_c", "label": "Heading", "default": "#1a1a1a" }
  ]
}
{% endschema %}

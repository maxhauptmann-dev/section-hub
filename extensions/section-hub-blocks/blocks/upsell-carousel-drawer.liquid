{% comment %}
  Section Hub – Upsell Carousel Drawer Block
  Horizontal snap carousel with glassmorphism cards, navigation, dots & progress
{% endcomment %}

{% if shop.metafields.sectioniq.premium == "active" %}

<style>
.sh-ucd {
  margin: {{ block.settings.margin_y }}px 0;
  padding: {{ block.settings.padding }}px;
  background: {{ block.settings.bg_color }};
  border: 1px solid {{ block.settings.border_color }};
  border-radius: {{ block.settings.outer_radius }}px;
  overflow: hidden;
}

.sh-ucd__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}

.sh-ucd__titles {
  flex: 1;
}

.sh-ucd__eyebrow {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: {{ block.settings.accent_color }};
  margin-bottom: 2px;
}

.sh-ucd__heading {
  font-size: {{ block.settings.title_size }}px;
  font-weight: 800;
  color: {{ block.settings.heading_color }};
  margin: 0;
  line-height: 1.2;
}

.sh-ucd__nav {
  display: flex;
  gap: 6px;
}

.sh-ucd__nav-btn {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 1px solid {{ block.settings.border_color }};
  background: {{ block.settings.card_bg }};
  color: {{ block.settings.heading_color }};
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  font-size: 16px;
  transition: all 0.2s ease;
}

.sh-ucd__nav-btn:hover {
  background: {{ block.settings.heading_color }};
  color: {{ block.settings.card_bg }};
  border-color: {{ block.settings.heading_color }};
}

.sh-ucd__viewport {
  overflow-x: auto;
  overflow-y: hidden;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}

.sh-ucd__viewport::-webkit-scrollbar {
  display: none;
}

.sh-ucd__track {
  display: flex;
  gap: {{ block.settings.gap }}px;
}

.sh-ucd__card {
  flex: 0 0 {{ block.settings.card_width }}px;
  scroll-snap-align: start;
  background: {{ block.settings.card_bg }};
  border: 1px solid {{ block.settings.border_color }};
  border-radius: {{ block.settings.card_radius }}px;
  overflow: hidden;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.sh-ucd__card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 36px rgba(0, 0, 0, 0.08);
}

.sh-ucd__glass {
  position: absolute;
  inset: 0;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.6) 0%, rgba(255, 255, 255, 0.15) 100%);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.sh-ucd__card:hover .sh-ucd__glass {
  opacity: 1;
}

.sh-ucd__img-wrap {
  position: relative;
  aspect-ratio: 1 / 1;
  overflow: hidden;
}

.sh-ucd__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.45s ease;
}

.sh-ucd__card:hover .sh-ucd__img {
  transform: scale(1.06);
}

.sh-ucd__img-ph {
  width: 100%;
  height: 100%;
  background: #f0ece6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  color: #ccc5bb;
}

.sh-ucd__badge {
  position: absolute;
  top: 8px;
  left: 8px;
  background: {{ block.settings.badge_bg }};
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  padding: 3px 9px;
  border-radius: 20px;
  z-index: 2;
}

.sh-ucd__body {
  padding: 12px 14px 14px;
  display: flex;
  flex-direction: column;
  position: relative;
}

.sh-ucd__vendor {
  font-size: 9px;
  letter-spacing: 1.2px;
  text-transform: uppercase;
  color: {{ block.settings.text_color }};
  margin-bottom: 3px;
}

.sh-ucd__name {
  font-size: {{ block.settings.font_size }}px;
  font-weight: 700;
  color: {{ block.settings.heading_color }};
  line-height: 1.3;
  margin: 0 0 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sh-ucd__price-row {
  display: flex;
  align-items: baseline;
  gap: 6px;
  margin-bottom: 6px;
}

.sh-ucd__price-now {
  font-size: {{ block.settings.font_size | plus: 1 }}px;
  font-weight: 800;
  color: {{ block.settings.heading_color }};
}

.sh-ucd__price-old {
  font-size: {{ block.settings.font_size | minus: 1 }}px;
  color: {{ block.settings.text_color }};
  text-decoration: line-through;
  opacity: 0.45;
}

.sh-ucd__label {
  font-size: 11px;
  color: {{ block.settings.accent_color }};
  font-style: italic;
  margin-bottom: 8px;
}

.sh-ucd__btn {
  display: block;
  width: 100%;
  text-align: center;
  padding: 9px;
  background: {{ block.settings.btn_bg }};
  color: {{ block.settings.btn_color }};
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  border: none;
  border-radius: 7px;
  cursor: pointer;
  transition: opacity 0.2s ease;
}

.sh-ucd__btn:hover {
  opacity: 0.88;
}

.sh-ucd__footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  margin-top: 14px;
}

.sh-ucd__dots {
  display: flex;
  gap: 6px;
}

.sh-ucd__dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  border: none;
  padding: 0;
  background: {{ block.settings.border_color }};
  cursor: pointer;
  transition: background 0.25s ease, transform 0.25s ease;
}

.sh-ucd__dot--active {
  background: {{ block.settings.accent_color }};
  transform: scale(1.3);
}

.sh-ucd__progress {
  width: 100px;
  height: 3px;
  background: {{ block.settings.border_color }};
  border-radius: 3px;
  overflow: hidden;
}

.sh-ucd__progress-bar {
  height: 100%;
  width: 0%;
  background: {{ block.settings.accent_color }};
  border-radius: 3px;
  transition: width 0.15s linear;
}
</style>

<div class="sh-ucd">

  <div class="sh-ucd__header">
    <div class="sh-ucd__titles">
      {% if block.settings.eyebrow != blank %}
        <div class="sh-ucd__eyebrow">{{ block.settings.eyebrow }}</div>
      {% endif %}
      {% if block.settings.heading != blank %}
        <h3 class="sh-ucd__heading">{{ block.settings.heading }}</h3>
      {% endif %}
    </div>
    <div class="sh-ucd__nav">
      <button class="sh-ucd__nav-btn" data-sh-ucd-prev aria-label="Previous">‹</button>
      <button class="sh-ucd__nav-btn" data-sh-ucd-next aria-label="Next">›</button>
    </div>
  </div>

  <div class="sh-ucd__viewport" data-sh-ucd-vp>
    <div class="sh-ucd__track" data-sh-ucd-track>
      {% for i in (1..4) %}
        {%- assign name_id   = 'product_' | append: i | append: '_name' -%}
        {%- assign price_id  = 'product_' | append: i | append: '_price' -%}
        {%- assign comp_id   = 'product_' | append: i | append: '_compare' -%}
        {%- assign img_id    = 'product_' | append: i | append: '_image' -%}
        {%- assign label_id  = 'product_' | append: i | append: '_label' -%}
        {%- assign badge_id  = 'product_' | append: i | append: '_badge' -%}
        {%- assign vendor_id = 'product_' | append: i | append: '_vendor' -%}

        {%- assign name_val   = block.settings[name_id] -%}
        {%- assign price_val  = block.settings[price_id] -%}
        {%- assign comp_val   = block.settings[comp_id] -%}
        {%- assign img_val    = block.settings[img_id] -%}
        {%- assign label_val  = block.settings[label_id] -%}
        {%- assign badge_val  = block.settings[badge_id] -%}
        {%- assign vendor_val = block.settings[vendor_id] -%}

        {%- if name_val != blank -%}
          <div class="sh-ucd__card" data-sh-ucd-card>
            <div class="sh-ucd__img-wrap">
              {% if img_val != blank %}
                <img class="sh-ucd__img" src="{{ img_val | image_url: width: 480 }}" alt="{{ name_val | escape }}" loading="lazy" width="480" height="480">
              {% else %}
                <div class="sh-ucd__img-ph">📦</div>
              {% endif %}
              {% if badge_val != blank %}
                <span class="sh-ucd__badge">{{ badge_val }}</span>
              {% endif %}
            </div>
            <div class="sh-ucd__body">
              {% if vendor_val != blank %}
                <div class="sh-ucd__vendor">{{ vendor_val }}</div>
              {% endif %}
              <div class="sh-ucd__name">{{ name_val }}</div>
              {% if price_val != blank %}
                <div class="sh-ucd__price-row">
                  <span class="sh-ucd__price-now">{{ price_val }}</span>
                  {% if comp_val != blank %}
                    <span class="sh-ucd__price-old">{{ comp_val }}</span>
                  {% endif %}
                </div>
              {% endif %}
              {% if label_val != blank %}
                <div class="sh-ucd__label">{{ label_val }}</div>
              {% endif %}
              <button class="sh-ucd__btn" type="button">{{ block.settings.btn_text }}</button>
            </div>
          </div>
        {%- endif -%}
      {% endfor %}
    </div>
  </div>

  <div class="sh-ucd__footer">
    <div class="sh-ucd__dots" data-sh-ucd-dots></div>
    <div class="sh-ucd__progress"><div class="sh-ucd__progress-bar" data-sh-ucd-bar></div></div>
  </div>

</div>

<script>
(function(){
  var container = document.currentScript.previousElementSibling;
  while(container && !container.classList.contains('sh-ucd')){
    container = container.previousElementSibling;
  }
  if(!container) return;

  var vp    = container.querySelector('[data-sh-ucd-vp]');
  var cards = container.querySelectorAll('[data-sh-ucd-card]');
  var dots  = container.querySelector('[data-sh-ucd-dots]');
  var bar   = container.querySelector('[data-sh-ucd-bar]');
  var prev  = container.querySelector('[data-sh-ucd-prev]');
  var next  = container.querySelector('[data-sh-ucd-next]');
  var total = cards.length;
  if(total < 1) return;

  for(var i = 0; i < total; i++){
    var d = document.createElement('button');
    d.className = 'sh-ucd__dot' + (i === 0 ? ' sh-ucd__dot--active' : '');
    d.setAttribute('aria-label','Slide '+(i+1));
    d.dataset.idx = i;
    dots.appendChild(d);
  }
  var allDots = dots.querySelectorAll('.sh-ucd__dot');

  function update(){
    var sl = vp.scrollLeft;
    var sw = vp.scrollWidth - vp.clientWidth;
    var pct = sw > 0 ? sl / sw : 0;
    bar.style.width = (pct * 100) + '%';
    var idx = 0, minD = Infinity;
    cards.forEach(function(c, ci){
      var dist = Math.abs(c.offsetLeft - sl);
      if(dist < minD){ minD = dist; idx = ci; }
    });
    allDots.forEach(function(dd, di){ dd.classList.toggle('sh-ucd__dot--active', di === idx); });
  }

  vp.addEventListener('scroll', update, { passive: true });

  var scrollAmt = parseInt('{{ block.settings.card_width }}') + parseInt('{{ block.settings.gap }}');

  prev.addEventListener('click', function(){ vp.scrollBy({ left: -scrollAmt, behavior: 'smooth' }); });
  next.addEventListener('click', function(){ vp.scrollBy({ left: scrollAmt, behavior: 'smooth' }); });
  dots.addEventListener('click', function(e){
    var btn = e.target.closest('.sh-ucd__dot');
    if(btn) cards[parseInt(btn.dataset.idx)].scrollIntoView({ behavior:'smooth', block:'nearest', inline:'start' });
  });

  update();
})();
</script>

{% else %}
<div style="padding:12px;margin:12px 0;background:#f8f5ff;border:1px solid #ddd6fe;border-radius:8px;text-align:center;font-size:13px;color:#6b7280;">
  👑 This block requires <strong style="color:#4f46e5;">SectionIQ Premium</strong>
</div>
{% endif %}


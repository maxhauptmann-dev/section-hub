{% comment %}
  Section Hub - Benefit Boxes Block
  Trust-building benefit badges (Free Shipping, Free Returns, etc.)
{% endcomment %}

{% if shop.metafields.sectioniq.premium == "active" %}

<style>
.sh-benefits {
  display: flex;
  flex-wrap: wrap;
  gap: {{ block.settings.gap }}px;
  margin: 8px 0;
  {% if block.settings.alignment == 'center' %}justify-content: center;{% endif %}
  {% if block.settings.alignment == 'right' %}justify-content: flex-end;{% endif %}
}

.sh-benefits__item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: {{ block.settings.padding_y }}px {{ block.settings.padding_x }}px;
  background: {{ block.settings.background_color }};
  border: 1px solid {{ block.settings.border_color }};
  border-radius: {{ block.settings.border_radius }}px;
  font-size: {{ block.settings.font_size }}px;
  font-weight: 500;
  color: {{ block.settings.text_color }};
  line-height: 1.3;
  flex: 1 1 {% if block.settings.min_width > 0 %}{{ block.settings.min_width }}px{% else %}auto{% endif %};
  max-width: 100%;
  text-align: center;
}

.sh-benefits__icon {
  font-size: {{ block.settings.icon_size }}px;
  flex-shrink: 0;
}
</style>

<div class="sh-benefits">
  {% if block.settings.benefit_1 != blank %}
    <div class="sh-benefits__item">
      <span class="sh-benefits__icon">{{ block.settings.icon_1 }}</span>
      <span>{{ block.settings.benefit_1 }}</span>
    </div>
  {% endif %}

  {% if block.settings.benefit_2 != blank %}
    <div class="sh-benefits__item">
      <span class="sh-benefits__icon">{{ block.settings.icon_2 }}</span>
      <span>{{ block.settings.benefit_2 }}</span>
    </div>
  {% endif %}

  {% if block.settings.benefit_3 != blank %}
    <div class="sh-benefits__item">
      <span class="sh-benefits__icon">{{ block.settings.icon_3 }}</span>
      <span>{{ block.settings.benefit_3 }}</span>
    </div>
  {% endif %}
</div>

{% else %}
<div style="padding:12px;margin:12px 0;background:#f8f5ff;border:1px solid #ddd6fe;border-radius:8px;text-align:center;font-size:13px;color:#6b7280;">
  👑 This block requires <strong style="color:#4f46e5;">SectionIQ Premium</strong>
</div>
{% endif %}

{% schema %}
{
  "name": "Benefit Boxes",
  "target": "section",
  "settings": [
    {
      "type": "header",
      "content": "Benefit 1"
    },
    {
      "type": "text",
      "id": "icon_1",
      "label": "Icon (Emoji)",
      "default": "🚚"
    },
    {
      "type": "text",
      "id": "benefit_1",
      "label": "Text",
      "default": "Free Shipping"
    },
    {
      "type": "header",
      "content": "Benefit 2"
    },
    {
      "type": "text",
      "id": "icon_2",
      "label": "Icon (Emoji)",
      "default": "↩️"
    },
    {
      "type": "text",
      "id": "benefit_2",
      "label": "Text",
      "default": "Free Returns"
    },
    {
      "type": "header",
      "content": "Benefit 3"
    },
    {
      "type": "text",
      "id": "icon_3",
      "label": "Icon (Emoji)",
      "default": "💬"
    },
    {
      "type": "text",
      "id": "benefit_3",
      "label": "Text",
      "default": "24/7 Support"
    },
    {
      "type": "header",
      "content": "Layout & Style"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap Between Items",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f0fdf4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#166534"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#bbf7d0"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font Size",
      "min": 11,
      "max": 16,
      "step": 1,
      "default": 13,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon Size",
      "min": 12,
      "max": 24,
      "step": 2,
      "default": 16,
      "unit": "px"
    }
  ]
}
{% endschema %}

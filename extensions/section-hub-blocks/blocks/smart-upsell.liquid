{% if shop.metafields.sectioniq.premium == "active" %}
<style>
.sh-su{margin:12px 0}
.sh-su__hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.sh-su__t{font-size:{{ block.settings.title_size }}px;font-weight:700;color:{{ block.settings.text_color }};display:flex;align-items:center;gap:6px}
.sh-su__nv{display:flex;gap:6px}
.sh-su__nb{width:30px;height:30px;border:1px solid {{ block.settings.border_color }};background:{{ block.settings.bg_color }};border-radius:50%;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:14px;color:{{ block.settings.text_color }};transition:all .15s}
.sh-su__nb:hover{background:{{ block.settings.accent_color }};color:#fff;border-color:{{ block.settings.accent_color }}}
.sh-su__tr{display:flex;gap:{{ block.settings.gap }}px;overflow-x:auto;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding-bottom:4px}
.sh-su__tr::-webkit-scrollbar{display:none}
.sh-su__c{flex:0 0 {{ block.settings.card_width }}px;scroll-snap-align:start;background:{{ block.settings.card_bg }};border:1px solid {{ block.settings.border_color }};border-radius:{{ block.settings.border_radius }}px;overflow:hidden;transition:box-shadow .2s,transform .2s}
.sh-su__c:hover{box-shadow:0 4px 16px rgba(0,0,0,.08);transform:translateY(-2px)}
.sh-su__iw{position:relative;aspect-ratio:1/1;overflow:hidden;background:#f3f4f6}
.sh-su__im{width:100%;height:100%;object-fit:cover;display:block}
.sh-su__ph{width:100%;height:100%;background:linear-gradient(135deg,#e5e7eb,#d1d5db);display:flex;align-items:center;justify-content:center;font-size:28px;color:#9ca3af}
.sh-su__tg{position:absolute;top:8px;left:8px;background:{{ block.settings.accent_color }};color:#fff;font-size:10px;font-weight:700;padding:2px 8px;border-radius:4px;text-transform:uppercase;letter-spacing:.5px}
.sh-su__bd{padding:10px 12px 12px}
.sh-su__nm{font-size:{{ block.settings.font_size }}px;font-weight:600;color:{{ block.settings.text_color }};white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-bottom:4px}
.sh-su__pr{display:flex;align-items:baseline;gap:6px;margin-bottom:8px}
.sh-su__pn{font-size:{{ block.settings.font_size | plus: 2 }}px;font-weight:800;color:{{ block.settings.accent_color }}}
.sh-su__po{font-size:{{ block.settings.font_size | minus: 1 }}px;color:{{ block.settings.text_color }};opacity:.4;text-decoration:line-through}
.sh-su__bt{width:100%;padding:8px 0;border:none;border-radius:{{ block.settings.button_radius }}px;background:{{ block.settings.button_bg }};color:{{ block.settings.button_text }};font-size:13px;font-weight:700;cursor:pointer;transition:opacity .15s}
.sh-su__bt:hover{opacity:.9}
</style>
<div class="sh-su"><div class="sh-su__hd"><div class="sh-su__t">{{ block.settings.icon }} {{ block.settings.title }}</div><div class="sh-su__nv"><button class="sh-su__nb" data-su-p aria-label="Previous">‹</button><button class="sh-su__nb" data-su-n aria-label="Next">›</button></div></div>
<div class="sh-su__tr" data-su-tr>
{% for i in (1..4) %}{%- assign ni = 'product_' | append: i | append: '_name' -%}{%- assign pi = 'product_' | append: i | append: '_price' -%}{%- assign ti = 'product_' | append: i | append: '_tag' -%}{%- assign ii = 'product_' | append: i | append: '_image' -%}{%- assign nv = block.settings[ni] -%}{%- assign pv = block.settings[pi] -%}{%- assign tv = block.settings[ti] -%}{%- assign iv = block.settings[ii] -%}{%- if nv != blank -%}
<div class="sh-su__c"><div class="sh-su__iw">{% if iv != blank %}<img class="sh-su__im" src="{{ iv | image_url: width: 400 }}" alt="{{ nv }}" loading="lazy" width="400" height="400">{% else %}<div class="sh-su__ph">🛍️</div>{% endif %}{% if tv != blank %}<span class="sh-su__tg">{{ tv }}</span>{% endif %}</div><div class="sh-su__bd"><div class="sh-su__nm">{{ nv }}</div><div class="sh-su__pr"><span class="sh-su__pn">{{ pv }}</span>{%- if i == 1 or i == 2 -%}{%- assign ci = 'product_' | append: i | append: '_compare_price' -%}{%- assign cv = block.settings[ci] -%}{% if cv != blank %}<span class="sh-su__po">{{ cv }}</span>{% endif %}{%- endif -%}</div><button class="sh-su__bt" type="button">{{ block.settings.button_label }}</button></div></div>
{%- endif -%}{% endfor %}
</div></div>
<script>
(function(){var c=document.currentScript.previousElementSibling;while(c&&!c.classList.contains('sh-su'))c=c.previousElementSibling;if(!c)return;var t=c.querySelector('[data-su-tr]'),s=parseInt('{{ block.settings.card_width }}')+parseInt('{{ block.settings.gap }}');c.querySelector('[data-su-p]').addEventListener('click',function(){t.scrollBy({left:-s,behavior:'smooth'})});c.querySelector('[data-su-n]').addEventListener('click',function(){t.scrollBy({left:s,behavior:'smooth'})})})();
</script>
{% else %}
<div style="padding:12px;margin:12px 0;background:#f8f5ff;border:1px solid #ddd6fe;border-radius:8px;text-align:center;font-size:13px;color:#6b7280;">👑 Requires <strong style="color:#4f46e5;">SectionIQ Premium</strong></div>
{% endif %}
{% schema %}
{
  "name": "SH - Smart Upsell",
  "target": "section",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "title", "label": "Title", "default": "You might also like" },
    { "type": "text", "id": "icon", "label": "Title Icon", "default": "🛍️" },
    { "type": "text", "id": "button_label", "label": "Button Label", "default": "Add to Cart" },
    { "type": "header", "content": "Product 1" },
    { "type": "text", "id": "product_1_name", "label": "Name", "default": "Wireless Earbuds Pro" },
    { "type": "text", "id": "product_1_price", "label": "Price", "default": "€49.95" },
    { "type": "text", "id": "product_1_compare_price", "label": "Compare Price", "default": "€69.95" },
    { "type": "text", "id": "product_1_tag", "label": "Tag", "default": "Bestseller" },
    { "type": "image_picker", "id": "product_1_image", "label": "Image" },
    { "type": "header", "content": "Product 2" },
    { "type": "text", "id": "product_2_name", "label": "Name", "default": "Leather Phone Case" },
    { "type": "text", "id": "product_2_price", "label": "Price", "default": "€24.95" },
    { "type": "text", "id": "product_2_compare_price", "label": "Compare Price" },
    { "type": "text", "id": "product_2_tag", "label": "Tag", "default": "New" },
    { "type": "image_picker", "id": "product_2_image", "label": "Image" },
    { "type": "header", "content": "Products 3 & 4" },
    { "type": "text", "id": "product_3_name", "label": "Product 3 Name", "default": "Charging Dock" },
    { "type": "text", "id": "product_3_price", "label": "Product 3 Price", "default": "€34.95" },
    { "type": "text", "id": "product_3_tag", "label": "Product 3 Tag", "default": "Sale" },
    { "type": "image_picker", "id": "product_3_image", "label": "Product 3 Image" },
    { "type": "text", "id": "product_4_name", "label": "Product 4 Name", "default": "Screen Protector" },
    { "type": "text", "id": "product_4_price", "label": "Product 4 Price", "default": "€9.95" },
    { "type": "image_picker", "id": "product_4_image", "label": "Product 4 Image" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "card_width", "label": "Card Width", "min": 120, "max": 220, "step": 10, "default": 160, "unit": "px" },
    { "type": "range", "id": "gap", "label": "Gap", "min": 4, "max": 16, "step": 2, "default": 10, "unit": "px" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1a1a1a" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#6366f1" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "card_bg", "label": "Card", "default": "#ffffff" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#e5e7eb" },
    { "type": "color", "id": "button_bg", "label": "Button BG", "default": "#1a1a1a" },
    { "type": "color", "id": "button_text", "label": "Button Text", "default": "#ffffff" },
    { "type": "range", "id": "border_radius", "label": "Radius", "min": 0, "max": 20, "step": 2, "default": 12, "unit": "px" },
    { "type": "range", "id": "button_radius", "label": "Btn Radius", "min": 0, "max": 12, "step": 2, "default": 8, "unit": "px" },
    { "type": "range", "id": "font_size", "label": "Font Size", "min": 12, "max": 16, "step": 1, "default": 13, "unit": "px" },
    { "type": "range", "id": "title_size", "label": "Title Size", "min": 14, "max": 22, "step": 1, "default": 16, "unit": "px" }
  ]
}
{% endschema %}

{% comment %}Section Hub - Badges Block{% endcomment %}
{% if shop.metafields.sectioniq.premium == "active" %}
<style>
.sh-badges{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0}
.sh-badges__tag{display:inline-flex;align-items:center;gap:5px;padding:4px 12px;border-radius:{{ block.settings.border_radius }}px;font-size:{{ block.settings.font_size }}px;font-weight:600;line-height:1.4;letter-spacing:.3px}
.sh-badges__tag svg{flex-shrink:0}
</style>
{%- capture i_flame -%}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0011 12c0-1.3-.8-2.5-2-3.5C10.3 7 12 5 12 5s6 4.5 6 10a6 6 0 01-12 0c0-1.3.5-2.7 1.4-3.8"/><path d="M12 19a3 3 0 002.5-4.5"/></svg>{%- endcapture -%}
{%- capture i_star -%}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>{%- endcapture -%}
{%- capture i_bolt -%}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>{%- endcapture -%}
{%- capture i_check -%}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/></svg>{%- endcapture -%}
{%- capture i_shield -%}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>{%- endcapture -%}
{%- capture i_diamond -%}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 6-10 13L2 9z"/><path d="M2 9h20"/><path d="M10 3l-2 6 4 13 4-13-2-6"/></svg>{%- endcapture -%}
{%- capture i_heart -%}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>{%- endcapture -%}
{%- capture i_percent -%}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>{%- endcapture -%}
<div class="sh-badges">
{% for i in (1..5) %}{%- assign bk = 'badge_' | append: i -%}{%- assign ik = 'icon_' | append: i -%}{%- assign bgk = 'bg_' | append: i -%}{%- assign tk = 'text_' | append: i -%}{%- assign bt = block.settings[bk] -%}{%- assign ic = block.settings[ik] -%}{%- assign bg = block.settings[bgk] -%}{%- assign tc = block.settings[tk] -%}
{% if bt != blank %}<span class="sh-badges__tag" style="background:{{ bg }};color:{{ tc }};">{% case ic %}{% when 'flame' %}{{ i_flame }}{% when 'star' %}{{ i_star }}{% when 'bolt' %}{{ i_bolt }}{% when 'check' %}{{ i_check }}{% when 'shield' %}{{ i_shield }}{% when 'diamond' %}{{ i_diamond }}{% when 'heart' %}{{ i_heart }}{% when 'percent' %}{{ i_percent }}{% endcase %}{{ bt }}</span>{% endif %}
{% endfor %}
</div>
{% else %}
<div style="padding:12px;margin:12px 0;background:#f8f5ff;border:1px solid #ddd6fe;border-radius:8px;text-align:center;font-size:13px;color:#6b7280;">This block requires <strong style="color:#4f46e5;">SectionIQ Premium</strong></div>
{% endif %}
{% schema %}
{"name":"Badges","target":"section","settings":[{"type":"header","content":"Badge 1"},{"type":"select","id":"icon_1","label":"Icon","default":"flame","options":[{"value":"none","label":"None"},{"value":"flame","label":"Flame"},{"value":"star","label":"Star"},{"value":"bolt","label":"Lightning"},{"value":"check","label":"Checkmark"},{"value":"shield","label":"Shield"},{"value":"diamond","label":"Diamond"},{"value":"heart","label":"Heart"},{"value":"percent","label":"Discount"}]},{"type":"text","id":"badge_1","label":"Text","default":"Trending"},{"type":"color","id":"bg_1","label":"Background","default":"#fef2f2"},{"type":"color","id":"text_1","label":"Text Color","default":"#dc2626"},{"type":"header","content":"Badge 2"},{"type":"select","id":"icon_2","label":"Icon","default":"star","options":[{"value":"none","label":"None"},{"value":"flame","label":"Flame"},{"value":"star","label":"Star"},{"value":"bolt","label":"Lightning"},{"value":"check","label":"Checkmark"},{"value":"shield","label":"Shield"},{"value":"diamond","label":"Diamond"},{"value":"heart","label":"Heart"},{"value":"percent","label":"Discount"}]},{"type":"text","id":"badge_2","label":"Text","default":"Bestseller"},{"type":"color","id":"bg_2","label":"Background","default":"#fefce8"},{"type":"color","id":"text_2","label":"Text Color","default":"#ca8a04"},{"type":"header","content":"Badge 3"},{"type":"select","id":"icon_3","label":"Icon","default":"bolt","options":[{"value":"none","label":"None"},{"value":"flame","label":"Flame"},{"value":"star","label":"Star"},{"value":"bolt","label":"Lightning"},{"value":"check","label":"Checkmark"},{"value":"shield","label":"Shield"},{"value":"diamond","label":"Diamond"},{"value":"heart","label":"Heart"},{"value":"percent","label":"Discount"}]},{"type":"text","id":"badge_3","label":"Text","default":"Only a few left"},{"type":"color","id":"bg_3","label":"Background","default":"#fff7ed"},{"type":"color","id":"text_3","label":"Text Color","default":"#ea580c"},{"type":"header","content":"Badge 4"},{"type":"select","id":"icon_4","label":"Icon","default":"shield","options":[{"value":"none","label":"None"},{"value":"flame","label":"Flame"},{"value":"star","label":"Star"},{"value":"bolt","label":"Lightning"},{"value":"check","label":"Checkmark"},{"value":"shield","label":"Shield"},{"value":"diamond","label":"Diamond"},{"value":"heart","label":"Heart"},{"value":"percent","label":"Discount"}]},{"type":"text","id":"badge_4","label":"Text","default":"Verified Quality"},{"type":"color","id":"bg_4","label":"Background","default":"#f0fdf4"},{"type":"color","id":"text_4","label":"Text Color","default":"#16a34a"},{"type":"header","content":"Badge 5"},{"type":"select","id":"icon_5","label":"Icon","default":"diamond","options":[{"value":"none","label":"None"},{"value":"flame","label":"Flame"},{"value":"star","label":"Star"},{"value":"bolt","label":"Lightning"},{"value":"check","label":"Checkmark"},{"value":"shield","label":"Shield"},{"value":"diamond","label":"Diamond"},{"value":"heart","label":"Heart"},{"value":"percent","label":"Discount"}]},{"type":"text","id":"badge_5","label":"Text","default":"Premium Choice"},{"type":"color","id":"bg_5","label":"Background","default":"#eff6ff"},{"type":"color","id":"text_5","label":"Text Color","default":"#2563eb"},{"type":"header","content":"Style"},{"type":"range","id":"border_radius","label":"Border Radius","min":0,"max":24,"step":2,"default":20,"unit":"px"},{"type":"range","id":"font_size","label":"Font Size","min":11,"max":16,"step":1,"default":13,"unit":"px"}]}
{% endschema %}
